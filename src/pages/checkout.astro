  }

  .btn-empty-action {
    display: inline-flex;
    max-width: 260px;
    margin: 0 auto;
    text-decoration: none;
  }
</style>

<script>
  import productsData from '../data/products.json';
  import { siteConfig } from '../data/site';
  import { formatWhatsAppOrderMessage, type CartItem } from '../lib/whatsapp';

  const STORAGE_BAG_KEY = 'lumera_bag_v1';
  const STORAGE_FALLBACK_KEY = 'lumera_bag';
  const STORAGE_CUSTOMER_KEY = 'lumera_customer';

  interface CheckoutLineItem {
    id: string;
    slug: string;
    name: string;
    brand: string;
    sizeDisplay: string;
    concentration: string;
    priceMinor: number;
    priceDisplay: string;
    image: string;
    quantity: number;
  }

  let checkoutItems: CheckoutLineItem[] = [];

  // Helper to sync updated quantities back to cart in localStorage
  function syncBagStorage() {
    const urlParams = new URLSearchParams(window.location.search);
    if (!urlParams.get('product')) {
      const payload = checkoutItems.map((it) => ({ id: it.id, quantity: it.quantity }));
      try {
        localStorage.setItem(STORAGE_BAG_KEY, JSON.stringify(payload));
        localStorage.setItem(STORAGE_FALLBACK_KEY, JSON.stringify(payload));
        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new CustomEvent('bag-updated'));
      } catch (e) {}
    }
  }

  // 1. Determine items to checkout
  function loadCheckoutItems() {
    const urlParams = new URLSearchParams(window.location.search);
    const productSlug = urlParams.get('product');
    const qtyParam = parseInt(urlParams.get('qty') || '1', 10);

    if (productSlug) {
      // Direct Single Product Buy Now
      const match = productsData.find((p) => p.slug === productSlug || p.id === productSlug);
      if (match) {
        checkoutItems = [
          {
            id: match.id,
            slug: match.slug,
            name: match.name,
            brand: match.brand,
            sizeDisplay: match.sizeDisplay,
            concentration: match.concentration,
            priceMinor: match.priceMinor,
            priceDisplay: match.priceDisplay,
            image: match.image,
            quantity: Math.max(1, qtyParam)
          }
        ];
      }
    } else {
      // Otherwise, load from localStorage cart (checking primary lumera_bag_v1 and fallback lumera_bag)
      try {
        const bagData = localStorage.getItem(STORAGE_BAG_KEY) || localStorage.getItem(STORAGE_FALLBACK_KEY);
        const stored: { id: string; quantity: number }[] = bagData ? JSON.parse(bagData) : [];
        checkoutItems = stored
          .map((it) => {
            const match = productsData.find((p) => p.id === it.id);
            if (!match) return null;
            return {
              id: match.id,
              slug: match.slug,
              name: match.name,
              brand: match.brand,
              sizeDisplay: match.sizeDisplay,
              concentration: match.concentration,
              priceMinor: match.priceMinor,
              priceDisplay: match.priceDisplay,
              image: match.image,
              quantity: it.quantity
            };
          })
          .filter((it): it is CheckoutLineItem => it !== null);
      } catch {
        checkoutItems = [];
      }
    }

    // Configure Back Link to return directly to product page or shop
    const backLink = document.getElementById('checkout-back-link') as HTMLAnchorElement;
    const backText = document.getElementById('checkout-back-text');

    if (checkoutItems.length === 1 && checkoutItems[0].slug) {
      const targetSlug = checkoutItems[0].slug;
      if (backLink) backLink.href = `/perfumes/${targetSlug}/`;
      if (backText) backText.textContent = `Back`;
    } else if (document.referrer && document.referrer.includes('/perfumes/')) {
      if (backLink) backLink.href = document.referrer;
      if (backText) backText.textContent = 'Back';
    } else {
      if (backLink) backLink.href = '/shop/';
      if (backText) backText.textContent = 'Back to Store';
    }
  }

  // 2. Render summary UI and Cart items
  function renderCheckoutSummary() {
    const mainGrid = document.getElementById('checkout-main-grid');
    const emptyState = document.getElementById('checkout-empty');
    const stickyBottom = document.getElementById('mobile-checkout-sticky');
    const listEl = document.getElementById('checkout-items-list');
    const mobileListEl = document.getElementById('mobile-items-list');
    const subtotalEl = document.getElementById('summary-subtotal');
    const totalEl = document.getElementById('summary-total');
    const btnAmountEl = document.getElementById('btn-order-amount');
    const mobileThumbBox = document.getElementById('mobile-thumb-preview');
    const mobileItemText = document.getElementById('mobile-summary-item-text');
    const mobileTotalPrev = document.getElementById('mobile-total-preview');
    const mobileSubtotalEl = document.getElementById('mobile-subtotal');
    const mobileStickyAmount = document.getElementById('mobile-sticky-amount');

    if (!checkoutItems.length) {
      if (mainGrid) mainGrid.hidden = true;
      if (emptyState) emptyState.hidden = false;
      if (stickyBottom) stickyBottom.style.display = 'none';
      return;
    }

    if (mainGrid) mainGrid.hidden = false;
    if (emptyState) emptyState.hidden = true;
    if (stickyBottom) stickyBottom.style.display = '';

    const subtotalMinor = checkoutItems.reduce((sum, it) => sum + it.priceMinor * it.quantity, 0);
    const formattedTotal = `${(subtotalMinor / 100).toFixed(0)} QAR`;

    if (subtotalEl) subtotalEl.textContent = formattedTotal;
    if (totalEl) totalEl.textContent = formattedTotal;
    if (btnAmountEl) btnAmountEl.textContent = formattedTotal;
    if (mobileTotalPrev) mobileTotalPrev.textContent = formattedTotal;
    if (mobileSubtotalEl) mobileSubtotalEl.textContent = formattedTotal;
    if (mobileStickyAmount) mobileStickyAmount.textContent = formattedTotal;

    // Mobile Header Preview
    if (mobileThumbBox && checkoutItems.length > 0) {
      mobileThumbBox.innerHTML = `<img src="${checkoutItems[0].image}" alt="${checkoutItems[0].name}" class="mobile-summary-thumb" />`;
    }
    if (mobileItemText && checkoutItems.length > 0) {
      const first = checkoutItems[0];
      const count = checkoutItems.reduce((acc, it) => acc + it.quantity, 0);
      mobileItemText.textContent = `${first.name} · ${first.sizeDisplay} (${count} ${count > 1 ? 'items' : 'item'})`;
    }

    // Generate item markup
    const itemsHtml = checkoutItems
      .map(
        (item) => `
      <li class="cart-item-row" data-id="${item.id}">
        <div class="cart-item-thumb-box">
          <img src="${item.image}" alt="${item.brand} ${item.name}" class="cart-item-thumb" />
        </div>
        <div class="cart-item-details">
          <strong class="cart-item-title">${item.name}</strong>
          <span class="cart-item-meta">${item.brand} · ${item.sizeDisplay}</span>
          <div class="cart-item-qty">
            <span>Qty:</span>
            <button type="button" class="cart-qty-btn" data-action="dec" data-id="${item.id}" aria-label="Decrease quantity">−</button>
            <strong style="color: #1A1A1A; min-width: 14px; text-align: center;">${item.quantity}</strong>
            <button type="button" class="cart-qty-btn" data-action="inc" data-id="${item.id}" aria-label="Increase quantity">+</button>
          </div>
        </div>
        <span class="cart-item-price">${((item.priceMinor * item.quantity) / 100).toFixed(0)} QAR</span>
      </li>
    `
      )
      .join('');

    if (listEl) listEl.innerHTML = itemsHtml;
    if (mobileListEl) mobileListEl.innerHTML = itemsHtml;

    // Attach quantity stepper events to both desktop & mobile lists
    document.querySelectorAll('.cart-qty-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.getAttribute('data-id');
        const action = target.getAttribute('data-action');
        const it = checkoutItems.find((x) => x.id === id);
        if (!it) return;

        if (action === 'inc' && it.quantity < 10) {
          it.quantity++;
        } else if (action === 'dec') {
          if (it.quantity > 1) {
            it.quantity--;
          } else {
            checkoutItems = checkoutItems.filter((x) => x.id !== id);
          }
        }
        renderCheckoutSummary();
        syncBagStorage();
      });
    });
  }

  // 3. Form Inputs & Validation (Only 4 Clean Fields!)
  const fullNameInput = document.getElementById('input-full-name') as HTMLInputElement;
  const phoneInput = document.getElementById('input-phone') as HTMLInputElement;
  const municipalitySelect = document.getElementById('select-municipality') as HTMLSelectElement;
  const addressInput = document.getElementById('input-address') as HTMLInputElement;
  const notesInput = document.getElementById('input-notes') as HTMLTextAreaElement;

  // Mobile Summary Accordion Toggle
  const mobileSummaryToggle = document.getElementById('mobile-summary-toggle');
  const mobileBreakdown = document.getElementById('mobile-summary-breakdown');
  const mobileChevron = document.getElementById('mobile-chevron');

  mobileSummaryToggle?.addEventListener('click', () => {
    if (!mobileBreakdown) return;
    const isHidden = mobileBreakdown.hidden;
    mobileBreakdown.hidden = !isHidden;
    mobileSummaryToggle.setAttribute('aria-expanded', String(!isHidden));
    if (mobileChevron) {
      mobileChevron.classList.toggle('is-open', !isHidden);
    }
  });

  // Toggle delivery notes
  const notesToggleBtn = document.getElementById('btn-notes-toggle');
  const notesCollapsible = document.getElementById('notes-collapsible');
  const notesIcon = document.getElementById('notes-toggle-icon');

  notesToggleBtn?.addEventListener('click', () => {
    if (!notesCollapsible) return;
    const isHidden = notesCollapsible.hidden;
    notesCollapsible.hidden = !isHidden;
    if (notesIcon) notesIcon.textContent = isHidden ? '−' : '+';
    if (isHidden && notesInput) notesInput.focus();
  });

  // Hydrate from localStorage
  try {
    const saved = localStorage.getItem(STORAGE_CUSTOMER_KEY);
    if (saved) {
      const data = JSON.parse(saved);
      if (fullNameInput && (data.fullName || data.firstName)) {
        fullNameInput.value = data.fullName || `${data.firstName || ''} ${data.lastName || ''}`.trim();
      }
      if (phoneInput && data.phone) phoneInput.value = data.phone;
      if (municipalitySelect && data.municipality) municipalitySelect.value = data.municipality;
      if (addressInput && data.address) addressInput.value = data.address;
      if (notesInput && data.notes) notesInput.value = data.notes;
    }
  } catch {}

  function validateForm(): boolean {
    let isValid = true;

    const name = fullNameInput?.value.trim() || '';
    const ph = phoneInput?.value.trim().replace(/[^0-9]/g, '') || '';
    const addr = addressInput?.value.trim() || '';

    // Full Name
    const errName = document.getElementById('err-full-name');
    if (!name) {
      fullNameInput?.classList.add('has-error');
      errName?.classList.add('is-visible');
      isValid = false;
    } else {
      fullNameInput?.classList.remove('has-error');
      errName?.classList.remove('is-visible');
    }

    // Phone (+974)
    const errPhone = document.getElementById('err-phone');
    const phoneWrapper = phoneInput?.closest('.phone-wrapper');
    if (!ph || ph.length < 7) {
      phoneWrapper?.classList.add('has-error');
      errPhone?.classList.add('is-visible');
      isValid = false;
    } else {
      phoneWrapper?.classList.remove('has-error');
      errPhone?.classList.remove('is-visible');
    }

    // Address
    const errAddr = document.getElementById('err-address');
    if (!addr) {
      addressInput?.classList.add('has-error');
      errAddr?.classList.add('is-visible');
      isValid = false;
    } else {
      addressInput?.classList.remove('has-error');
      errAddr?.classList.remove('is-visible');
    }

    if (isValid) {
      // Save to localStorage for convenience
      try {
        localStorage.setItem(
          STORAGE_CUSTOMER_KEY,
          JSON.stringify({
            fullName: name,
            phone: ph,
            municipality: municipalitySelect?.value || 'Doha',
            address: addr,
            notes: notesInput?.value.trim() || ''
          })
        );
      } catch {}
    }

    return isValid;
  }

  // 4. One-Click Submit to WhatsApp
  function submitOrderToWhatsApp() {
    if (!checkoutItems.length) return;
    if (!validateForm()) {
      const firstErr = document.querySelector('.has-error');
      firstErr?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    const name = fullNameInput?.value.trim() || '';
    const ph = phoneInput?.value.trim() || '';
    const muni = municipalitySelect?.value || 'Doha';
    const addr = addressInput?.value.trim() || '';
    const notes = notesInput?.value.trim() || '';

    const fullAddress = `${addr}, ${muni}, Qatar`;

    const items: CartItem[] = checkoutItems.map((it) => ({
      id: it.id,
      name: it.name,
      brand: it.brand,
      sizeDisplay: it.sizeDisplay,
      concentration: it.concentration,
      priceMinor: it.priceMinor,
      quantity: it.quantity
    }));

    const customer = {
      fullName: name,
      phone: ph.startsWith('+') ? ph : `+974 ${ph}`,
      address: fullAddress,
      city: muni,
      notes: notes,
      paymentMethod: 'Payment upon delivery (Cash / Card POS) or WhatsApp Link'
    };

    const msg = formatWhatsAppOrderMessage(items, customer);
    const phone = siteConfig.whatsappNumber.replace(/[^0-9]/g, '');
    const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

    const win = window.open(waUrl, '_blank');
    if (!win || win.closed || typeof win.closed === 'undefined') {
      window.location.href = waUrl;
    }
  }

  document.getElementById('btn-submit-order')?.addEventListener('click', submitOrderToWhatsApp);
  document.getElementById('btn-mobile-sticky-submit')?.addEventListener('click', submitOrderToWhatsApp);

  // Initialize
  loadCheckoutItems();
  renderCheckoutSummary();
</script>
