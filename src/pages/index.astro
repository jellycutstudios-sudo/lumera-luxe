---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../data/products.json';
import { siteConfig } from '../data/site';

// Hero Slides featuring Real Iconic Luxury Perfumes (Responsive Desktop 16:9 & Mobile 4:5)
const heroSlides = [
  {
    id: 'chanel-n5',
    title: 'Chanel N°5',
    mobileImage: '/assets/hero/mobile/hero-chanel-n5-mobile.webp',
    desktopImage: '/assets/hero/desktop/hero-chanel-n5-desktop.webp',
    alt: 'Chanel N°5 Eau de Parfum flacon with white camellias on sunlit travertine stone',
    ctaText: 'Discover N°5',
    ctaLink: '/perfumes/chanel-n-5/'
  },
  {
    id: 'ysl-libre',
    title: 'YSL Libre',
    mobileImage: '/assets/hero/mobile/hero-ysl-libre-mobile.webp',
    desktopImage: '/assets/hero/desktop/hero-ysl-libre-desktop.webp',
    alt: 'Yves Saint Laurent Libre Eau de Parfum with golden Cassandre emblem and amber crystal',
    ctaText: 'Discover Libre',
    ctaLink: '/perfumes/yves-saint-laurent-libre/'
  },
  {
    id: 'good-girl',
    title: 'Carolina Herrera Good Girl',
    mobileImage: '/assets/hero/mobile/hero-good-girl-mobile.webp',
    desktopImage: '/assets/hero/desktop/hero-good-girl-desktop.webp',
    alt: 'Carolina Herrera Good Girl Eau de Parfum midnight stiletto flacon with gold stiletto heel',
    ctaText: 'Discover Good Girl',
    ctaLink: '/perfumes/carolina-herrera-good-girl/'
  },
  {
    id: 'black-orchid',
    title: 'Tom Ford Black Orchid',
    mobileImage: '/assets/hero/mobile/hero-black-orchid-mobile.webp',
    desktopImage: '/assets/hero/desktop/hero-black-orchid-desktop.webp',
    alt: 'Tom Ford Black Orchid fluted black glass flacon with 24K gold plate and dark orchids',
    ctaText: 'Discover Black Orchid',
    ctaLink: '/perfumes/tom-ford-black-orchid/'
  }
];

const selectedScents = productsData.filter((p) => p.featured);

// 4 Olfactive Category representations using LUMÈRA LUXE Brand Photography
const categories = [
  {
    label: 'Fresh & Citrus',
    href: '/shop/?family=fresh',
    img: '/assets/brand/family-fresh-citrus.webp',
    alt: 'Fresh & Citrus perfumes featuring Dolce & Gabbana Light Blue and Acqua di Parma Colonia'
  },
  {
    label: 'Floral & Rose',
    href: '/shop/?family=floral',
    img: '/assets/brand/family-floral-rose.webp',
    alt: 'Floral & Rose perfumes featuring Chloé and Miss Dior'
  },
  {
    label: 'Amber & Oriental',
    href: '/shop/?family=oriental',
    img: '/assets/brand/family-amber-oriental.webp',
    alt: 'Amber & Oriental perfumes featuring YSL Black Opium and Chanel Coco Mademoiselle'
  },
  {
    label: 'Woody & Earthy',
    href: '/shop/?family=woody',
    img: '/assets/brand/family-woody-fresh.webp',
    alt: 'Woody & Earthy perfumes featuring Terre d’Hermès and Le Labo Santal 33'
  }
];

// Google Search Knowledge Graph & AEO (Answer Engine Optimization) Schemas
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://lumeraluxe.com.qa/#website',
      'url': 'https://lumeraluxe.com.qa/',
      'name': 'LUMÈRA LUXE',
      'description': 'Where Luxury Meets Affordability. Curated designer and niche fragrances in Doha, Qatar.',
      'inLanguage': ['en', 'ar'],
      'potentialAction': {
        '@type': 'SearchAction',
        'target': 'https://lumeraluxe.com.qa/shop/?search={search_term_string}',
        'query-input': 'required name=search_term_string'
      }
    },
    {
      '@type': 'Store',
      '@id': 'https://lumeraluxe.com.qa/#store',
      'name': 'LUMÈRA LUXE',
      'legalName': 'Lumera Luxe Perfumes and Cosmetics W.L.L.',
      'alternateName': 'لوميرا لوكس للعطور ومستحضرات التجميل ذ.م.م',
      'url': 'https://lumeraluxe.com.qa/',
      'logo': 'https://lumeraluxe.com.qa/assets/lumera-favicon.png',
      'image': 'https://lumeraluxe.com.qa/assets/hero/hero-floral-parfum.webp',
      'description': 'Curated luxury and designer fragrances in Doha, Qatar. Concierge doorstep delivery with verified authentic batch codes.',
      'telephone': '+97466675166',
      'email': 'concierge@lumeraluxe.qa',
      'priceRange': '$$',
      'currenciesAccepted': 'QAR',
      'paymentAccepted': 'Cash on Delivery, Credit Card POS upon arrival, Bank Transfer',
      'address': {
        '@type': 'PostalAddress',
        'addressLocality': 'Doha',
        'addressRegion': 'Ad-Dawhah',
        'addressCountry': 'QA'
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': 25.2854,
        'longitude': 51.5310
      },
      'areaServed': [
        { '@type': 'AdministrativeArea', 'name': 'Qatar' },
        { '@type': 'City', 'name': 'Doha' },
        { '@type': 'City', 'name': 'Lusail' },
        { '@type': 'City', 'name': 'The Pearl-Qatar' },
        { '@type': 'City', 'name': 'Al Rayyan' },
        { '@type': 'City', 'name': 'Al Wakrah' }
      ],
      'sameAs': [
        'https://www.instagram.com/lumera.luxe974',
        'https://www.tiktok.com/@luxescentqatar'
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://lumeraluxe.com.qa/#faq',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': 'Are LUMÈRA LUXE perfumes 100% genuine and authentic in Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Yes, 100%. Every perfume in the LUMÈRA LUXE collection is strictly verified for authentic origin, imported from authorized European distributors with genuine batch codes and original sealed packaging.'
          }
        },
        {
          '@type': 'Question',
          'name': 'How does perfume delivery work in Doha and across Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'LUMÈRA LUXE offers express doorstep delivery across all Qatar municipalities, including Doha, The Pearl, Lusail, Al Rayyan, and Al Wakrah. Orders confirmed through our official WhatsApp concierge (+974 6667 5166) are scheduled for prompt courier delivery.'
          }
        },
        {
          '@type': 'Question',
          'name': 'What payment methods are accepted for orders in Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Payment is fulfilled upon doorstep arrival in Qatar via Cash or Card on Delivery using a portable POS machine, or via verified direct corporate bank transfer.'
          }
        },
        {
          '@type': 'Question',
          'name': 'Which perfume brands are available at LUMÈRA LUXE Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'LUMÈRA LUXE curates over 200 authentic fragrances from world-renowned fragrance houses, including Chanel, Dior, Baccarat Rouge / Maison Francis Kurkdjian, Tom Ford, Creed, Yves Saint Laurent, Giorgio Armani, Gucci, Byredo, Parfums de Marly, and Narciso Rodriguez.'
          }
        }
      ]
    }
  ]
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(homeStructuredData)} />
  <div class="minimal-storefront">
    <!-- HERO EDITORIAL SLIDER (LUMÈRA LUXE Brand Photography) -->
    <section class="hero-editorial-section" aria-label="Featured Collections Carousel">
      <div class="container">
        <div class="hero-editorial-stage" id="hero-slider" role="region" aria-roledescription="carousel" aria-label="LUMÈRA LUXE Collections">
          <div class="hero-slides-track">
            {heroSlides.map((slide, idx) => (
              <a
                href={slide.ctaLink}
                class={`hero-slide ${idx === 0 ? 'is-active' : ''}`}
                data-slide-index={idx}
                role="group"
                aria-roledescription="slide"
                aria-label={`${idx + 1} of ${heroSlides.length}: ${slide.title}`}
                aria-hidden={idx === 0 ? 'false' : 'true'}
                tabindex={idx === 0 ? 0 : -1}
              >
                <picture class="hero-slide-picture">
                  <source
                    media="(max-width: 768px)"
                    srcset={slide.mobileImage}
                    type="image/webp"
                  />
                  <source
                    media="(min-width: 769px)"
                    srcset={slide.desktopImage}
                    type="image/webp"
                  />
                  <img
                    src={slide.desktopImage}
                    alt={slide.alt}
                    class="hero-slide-image"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    fetchpriority={idx === 0 ? 'high' : 'auto'}
                    width="1024"
                    height="576"
                  />
                </picture>
              </a>
            ))}
          </div>

          <!-- Quiet Luxury Floating Island Card (Bottom Corner) -->
          <aside class="hero-island-card" aria-label="Current Collection">
            <div class="hero-island-meta">
              {heroSlides.map((slide, idx) => (
                <div class={`hero-meta-slide ${idx === 0 ? 'is-active' : ''}`} data-meta-index={idx}>
                  <h1 class="hero-meta-title">{slide.title}</h1>
                  <a href={slide.ctaLink} class="hero-meta-link">
                    <span>{slide.ctaText}</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              ))}
            </div>

            <div class="hero-island-controls">
              <span class="hero-counter" id="hero-counter" aria-live="polite">01 / 0{heroSlides.length}</span>
              <div class="hero-arrow-duo">
                <button
                  type="button"
                  class="hero-arrow-btn"
                  id="hero-prev-btn"
                  aria-label="Previous slide"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>
                <button
                  type="button"
                  class="hero-arrow-btn"
                  id="hero-next-btn"
                  aria-label="Next slide"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- 1. SCENT FAMILIES (Olfactive Exploration) -->
    <section class="section-home" id="scent-families" style="scroll-margin-top: 5rem;">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">Scent Families</h2>
          <a href="/shop/" class="see-all-link">Explore All</a>
        </div>

        <div class="categories-row">
          {
            categories.map((cat) => (
              <a href={cat.href} class="category-item">
                <div class="category-image-frame">
                  <img src={cat.img} alt={cat.alt} class="category-img" loading="eager" width="280" height="340" />
                </div>
                <span class="category-caption">{cat.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 2. THE CURATED EDIT (Single Focused 4-Product Showcase) -->
    <section class="section-home">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">Curated Fragrances</h2>
          <a href="/shop/" class="see-all-link">See All ({productsData.length})</a>
        </div>

        <div class="grid-products">
          {
            selectedScents.slice(0, 4).map((product, idx) => (
              <ProductCard product={product} priority={idx < 2} />
            ))
          }
        </div>

        <div class="curated-footer-cta">
          <a href="/shop/" class="btn-luxury-explore">
            <span>Explore Entire Collection</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- COMING SOON EDITORIAL SHOWCASE (Pure Visual) -->
    <section class="section-home section-teaser-banner">
      <div class="container">
        <a href="/our-story/" class="teaser-banner-frame" aria-label="LUMÈRA LUXE The Signature Collection Coming Soon">
          <img
            src="/assets/brand/story-signature-collection.webp"
            alt="LUMÈRA LUXE The Signature Collection - Coming Soon - The Light She Carries"
            class="teaser-banner-img"
            loading="lazy"
            width="1024"
            height="576"
          />
        </a>
      </div>
    </section>

    <!-- 3. BRAND ETHOS & DOHA PACKAGING CRAFT -->
    <section class="section-home">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">The House</h2>
        </div>

        <div class="about-grid">
          <div class="about-media-col">
            <div class="about-image-frame">
              <img
                src="/assets/brand/brand-five-bottles.webp"
                alt="LUMÈRA LUXE architectural perfume collection on stepped plinths"
                class="about-editorial-img"
                loading="lazy"
                width="600"
                height="600"
              />
            </div>
          </div>

          <div class="about-text-col">
            <h3 class="about-editorial-heading">
              Expressing presence through scent: subtle, intimate, and memorable.
            </h3>
            <p class="about-paragraph">
              LUMÈRA LUXE was established in Qatar with an uncompromising conviction: bringing connoisseur-level perfumery within graceful reach. Every creation in our boutique is individually examined for authentic origin, genuine concentration, and scent integrity.
            </p>
            <p class="about-paragraph">
              We believe perfume is a personal art form that transcends words. Each bottle is selected with care, hand-packed in Doha, and delivered directly to your door across Qatar.
            </p>
            <div class="about-action">
              <a href="/our-story/" class="link-underline">Discover Our Story</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. QATAR CONCIERGE -->
    <section class="concierge-section">
      <div class="container">
        <div class="concierge-card">
          <span class="concierge-kicker">Maison Concierge · Doha</span>
          <h2 class="concierge-title">Personal Scent Consultation</h2>
          <p class="concierge-subtitle">
            Need guidance selecting notes, finding a rare edition, or scheduling doorstep delivery in Qatar? Speak directly with our fragrance specialist.
          </p>

          <!-- Minimalist 3-Pillar Badge Ribbon -->
          <div class="concierge-badges-strip">
            <span class="concierge-badge-pill">
              <span class="badge-bullet"></span>
              100% Verified Provenance
            </span>
            <span class="concierge-badge-pill">
              <span class="badge-bullet"></span>
              Doorstep Delivery in Qatar
            </span>
            <span class="concierge-badge-pill">
              <span class="badge-bullet"></span>
              Direct WhatsApp Guidance
            </span>
          </div>

          <div class="concierge-cta-row">
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello LUMÈRA LUXE, I would like personal assistance choosing a fragrance from your curated collection.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp-concierge"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
              </svg>
              <span>Connect on WhatsApp</span>
            </a>
            <span class="concierge-note">Immediate response daily across Doha</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .minimal-storefront {
    padding-top: 12px;
    padding-bottom: clamp(4rem, 6vw, 6rem);
  }

  .hero-editorial-section {
    margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
  }

  .section-home {
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  /* Scent Families / Categories Row */
  .categories-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.75rem);
  }

  @media (min-width: 860px) {
    .categories-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .category-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .category-item:hover {
    transform: translateY(-3px);
  }

  .category-image-frame {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #F7F6F4;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    margin-bottom: 0.85rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: all var(--transition-fast);
  }

  .category-item:hover .category-image-frame {
    border-color: #D2CDC5;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
  }

  .category-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .category-item:hover .category-img {
    transform: scale(1.05);
  }

  .category-caption {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-main);
    transition: color var(--transition-fast);
  }

  .category-item:hover .category-caption {
    color: var(--color-brand-cognac);
  }

  /* Curated Footer CTA */
  .curated-footer-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 3.5vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-luxury-explore {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
    text-decoration: none;
    padding: 0.85rem 1.75rem;
    border: 1px solid var(--color-text-main);
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
  }

  .btn-luxury-explore:hover {
    background-color: var(--color-text-main);
    color: #FFFFFF;
  }

  /* About Us Two-Column */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 5rem;
    }
  }

  .about-image-frame {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 520px;
    background-color: #F7F6F4;
    overflow: hidden;
    border-radius: var(--border-radius-sm);
  }

  .about-editorial-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-editorial-heading {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-text-main);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .about-paragraph {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .about-action {
    margin-top: 1.75rem;
  }

  /* Qatar Concierge Section (Clean & Minimalist) */
  .concierge-section {
    margin-top: clamp(4.5rem, 8vw, 7rem);
    margin-bottom: clamp(4.5rem, 8vw, 7rem);
    width: 100%;
  }

  .concierge-card {
    background-color: #FAF9F6;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    padding: clamp(2rem, 4vw, 3.25rem) clamp(1.25rem, 3.5vw, 2.5rem);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .concierge-kicker {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-cognac);
    margin-bottom: 0.6rem;
  }

  .concierge-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.95rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.015em;
    color: var(--color-text-main);
    margin-bottom: 0.65rem;
  }

  .concierge-subtitle {
    font-family: var(--font-body);
    font-size: 0.84375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 500px;
    margin: 0 auto clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .concierge-badges-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-bottom: clamp(1.35rem, 2.5vw, 1.85rem);
  }

  .concierge-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.71875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-text-main);
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .badge-bullet {
    width: 5px;
    height: 5px;
