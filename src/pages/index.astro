---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../data/products.json';
import { siteConfig } from '../data/site';

// Select representative items
const heroShowcase = productsData[1]; // Boucheron Quatre en Bleu
const selectedScents = productsData.filter((p) => p.featured);
const curatedGrid = productsData.slice(4, 12);

// 4 Category representations
const categories = [
  {
    label: 'Perfume Collection',
    href: '/shop/',
    img: '/assets/products/boucheron-quatre-en-bleu.png',
    alt: 'LUMÈRA LUXE Perfume'
  },
  {
    label: 'Amber & Oriental',
    href: '/shop/?family=oriental',
    img: '/assets/products/dolce-gabbana-devotion.png',
    alt: 'Amber and Oriental Fragrances'
  },
  {
    label: 'Floral & Rose',
    href: '/shop/?family=floral',
    img: '/assets/products/carolina-herrera-ch-women.png',
    alt: 'Floral Fragrances'
  },
  {
    label: 'Woody & Fresh',
    href: '/shop/?family=woody',
    img: '/assets/products/chanel-n-5.png',
    alt: 'Woody and Fresh Scent Notes'
  }
];
---

<BaseLayout>
  <div class="minimal-storefront">
    <!-- HERO EDITORIAL (Byredo Reference Style) -->
    <section class="hero-editorial-section">
      <div class="container">
        <div class="hero-editorial-stage">
          <img
            src="/assets/lumera-hero-editorial.jpg"
            alt="LUMÈRA LUXE Haute Parfumerie Campaign"
            class="hero-editorial-image"
            loading="eager"
            fetchpriority="high"
            width="1440"
            height="810"
          />

          <!-- Floating Frosted Quick-Shop Card (Bottom Right) -->
          <aside class="hero-floating-card">
            <a
              href={`/perfumes/${heroShowcase.slug}/`}
              class="hero-card-link"
              aria-label={`View ${heroShowcase.name} details`}
            >
              <div class="hero-card-thumb-wrap">
                <img
                  src={heroShowcase.image}
                  alt={heroShowcase.fullName}
                  class="hero-card-thumb"
                  width="68"
                  height="80"
                />
              </div>
              <div class="hero-card-meta">
                <span class="hero-card-cat">PERFUME</span>
                <h2 class="hero-card-title">{heroShowcase.name}</h2>
                <span class="hero-card-price">{heroShowcase.priceDisplay}</span>
                <span class="hero-card-size">{heroShowcase.sizeDisplay}</span>
              </div>
            </a>

            <button
              type="button"
              class="hero-card-bag-btn"
              data-action="add-to-bag"
              data-id={heroShowcase.id}
              data-name={heroShowcase.name}
              data-brand={heroShowcase.brand}
              data-size={heroShowcase.sizeDisplay}
              data-concentration={heroShowcase.concentration}
              data-price={heroShowcase.priceMinor}
              data-image={heroShowcase.image}
              aria-label={`Quick add ${heroShowcase.name} to bag`}
              title="Add to Bag"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
            </button>
          </aside>
        </div>
      </div>
    </section>

    <!-- 1. BESTSELLERS (Byredo 4-Column Showcase) -->
    <section class="section-home">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">Bestsellers</h2>
          <a href="/shop/" class="see-all-link">See All</a>
        </div>

        <div class="grid-products">
          {
            selectedScents.slice(0, 4).map((product) => (
              <ProductCard product={product} />
            ))
          }
        </div>

        <div class="bestsellers-indicator" aria-hidden="true">
          <div class="bestsellers-indicator-bar"></div>
        </div>
      </div>
    </section>

    <!-- 2. CATEGORIES (Byredo Style Scent Family Exploration) -->
    <section class="section-home">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">Categories</h2>
          <a href="/shop/" class="see-all-link">See All</a>
        </div>

        <div class="categories-row">
          {
            categories.map((cat) => (
              <a href={cat.href} class="category-item">
                <div class="category-image-frame">
                  <img src={cat.img} alt={cat.alt} class="category-img" loading="eager" width="280" height="340" />
                </div>
                <span class="category-caption">{cat.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 2. ABOUT US (Editorial Two-Column with Packaging Image) -->
    <section class="section-home">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">About Us</h2>
        </div>

        <div class="about-grid">
          <div class="about-media-col">
            <div class="about-image-frame">
              <img
                src="/assets/editorial-gift-boxes.jpg"
                alt="LUMÈRA LUXE bespoke luxury fragrance packaging"
                class="about-editorial-img"
                loading="lazy"
                width="600"
                height="600"
              />
            </div>
          </div>

          <div class="about-text-col">
            <h3 class="about-editorial-heading">
              Expressing emotions and presence through scent—invisible, yet unforgettable.
            </h3>
            <p class="about-paragraph">
              LUMÈRA LUXE was established in Doha with an uncompromising conviction: bringing connoisseur-level perfumery within graceful reach. Every creation in our boutique is individually examined for authentic origin, genuine concentration, and scent integrity.
            </p>
            <p class="about-paragraph">
              We believe perfume is an intimate art form—one that transcends language and borders. Each bottle becomes a personal reflection of identity, paired with hand-packed attention and discreet concierge delivery across Qatar.
            </p>
            <div class="about-action">
              <a href="/our-story/" class="link-underline">Read More</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. CONCIERGE BANNER (Byredo Frosted Banner Style) -->
    <section class="concierge-banner-section">
      <div class="container">
        <div class="frosted-banner">
          <div class="frosted-banner-content">
            <h2 class="frosted-banner-title">
              Connect with LUMÈRA LUXE Concierge
            </h2>
            <p class="frosted-banner-subtitle">
              Personal scent consultations, availability confirmation, and priority courier delivery in Qatar.
            </p>

            <form
              class="minimal-concierge-form"
              onsubmit="event.preventDefault(); const val = document.getElementById('concierge-input').value; window.open('https://wa.me/97466675166?text=' + encodeURIComponent('Hello LUMÈRA LUXE, ' + (val ? val : 'I would like assistance with fragrance selection.')), '_blank');"
            >
              <div class="form-underline-wrap">
                <input
                  type="text"
                  id="concierge-input"
                  class="minimal-input"
                  placeholder="ENTER YOUR FRAGRANCE PREFERENCE OR INQUIRY..."
                  required
                />
                <button type="submit" class="minimal-submit-btn" aria-label="Send WhatsApp Inquiry">
                  Request
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. SELECTED FRAGRANCES (Asymmetric Byredo Showcase) -->
    <section class="section-home">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">Selected Fragrances</h2>
          <a href="/shop/" class="see-all-link">See All</a>
        </div>

        <div class="asymmetric-showcase-grid">
          <!-- Large Showcase Card on Left -->
          <div class="showcase-primary">
            <ProductCard product={heroShowcase} isLarge={true} priority={true} />
          </div>

          <!-- Secondary Grid on Right -->
          <div class="showcase-secondary-list">
            {
              selectedScents.slice(0, 2).map((prod) => (
                <div class="showcase-secondary-item">
                  <ProductCard product={prod} />
                </div>
              ))
            }

            <div class="showcase-navigation-row">
              <a href="/shop/" class="nav-arrow-btn" aria-label="Previous fragrances">←</a>
              <a href="/shop/" class="nav-arrow-btn" aria-label="Next fragrances">→</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. COMPLETE COLLECTION PREVIEW -->
    <section class="section-home">
      <div class="container">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">Discover the Collection</h2>
          <a href="/shop/" class="see-all-link">View All ({productsData.length})</a>
        </div>

        <div class="grid-products">
          {curatedGrid.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .minimal-storefront {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
  }

  .section-home {
    margin-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  /* 1. Categories Row (4 Borderless Columns) */
  .categories-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  @media (min-width: 860px) {
    .categories-row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .category-item {
    display: flex;
    flex-direction: column;
    transition: opacity var(--transition-fast);
  }

  .category-item:hover {
    opacity: 0.75;
  }

  .category-image-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 2.25rem);
    margin-bottom: 0.85rem;
    transition: all var(--transition-fast);
  }

  .category-item:hover .category-image-frame {
    border-color: #D2CDC5;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }

  .category-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .category-caption {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  /* 2. About Us Two-Column */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 5rem;
    }
  }

  .about-image-frame {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #F7F6F4;
    overflow: hidden;
  }

  .about-editorial-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-editorial-heading {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-text-main);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .about-paragraph {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .about-action {
    margin-top: 1.75rem;
  }

  /* 3. Frosted Concierge Banner */
  .concierge-banner-section {
    margin-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .frosted-banner {
    position: relative;
    width: 100%;
    background-color: #F5F4F0;
    background-image: url('/assets/concierge-banner-bg.jpg');
    background-size: cover;
    background-position: center;
    padding: clamp(3.5rem, 6vw, 5.5rem) clamp(1.5rem, 4vw, 3rem);
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .frosted-banner-content {
    max-width: 580px;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .frosted-banner-title {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .frosted-banner-subtitle {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .minimal-concierge-form {
    width: 100%;
  }

  .form-underline-wrap {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-text-main);
    padding-bottom: 0.5rem;
  }

  .minimal-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
  }

  .minimal-input::placeholder {
    color: var(--color-text-light);
  }

  .minimal-submit-btn {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
    padding-left: 1rem;
    cursor: pointer;
  }

  .minimal-submit-btn:hover {
    color: var(--color-accent);
  }

  /* 4. Asymmetrical Showcase Grid (Like "Candles" in Byredo) */
  .asymmetric-showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 860px) {
    .asymmetric-showcase-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 3.5rem;
    }
  }

  .showcase-secondary-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .showcase-navigation-row {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    padding-top: 1rem;
  }

  .nav-arrow-btn {
    font-size: 1.15rem;
    color: var(--color-text-main);
    transition: transform var(--transition-fast);
  }

  .nav-arrow-btn:hover {
    transform: translateX(2px);
  }
</style>
