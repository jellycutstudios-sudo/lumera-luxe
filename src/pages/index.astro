<script>
  function initHeroSlider() {
    const slider = document.getElementById('hero-slider');
    if (!slider || slider.dataset.initialized) return;

    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.hero-slide'));
    const controls = slider.querySelector<HTMLElement>('.hero-controls');
    const purchase = slider.querySelector<HTMLAnchorElement>('.btn-hero-shop-now');
    const current = document.getElementById('hero-current-slide');
    const track = document.getElementById('hero-slides-track');
    const prevBtn = slider.querySelector<HTMLButtonElement>('#hero-prev-btn');
    const nextBtn = slider.querySelector<HTMLButtonElement>('#hero-next-btn');
    const rotation = slider.querySelector<HTMLButtonElement>('.hero-rotation');
    const progress = slider.querySelector<HTMLElement>('.hero-progress span');
    const status = document.getElementById('hero-slide-status');
    if (slides.length <= 1 || !controls || !purchase || !track || !rotation || !progress) return;
    const purchaseLink = purchase;

    slider.dataset.initialized = 'true';
    controls.hidden = false;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canHover = window.matchMedia('(hover: hover)');
    const controller = new AbortController();
    const { signal } = controller;
    let currentIndex = 0;
    let paused = reducedMotion.matches;
    let visible = false;
    let touching = false;
    let progressAnimation: Animation | undefined;

    const resetProgress = () => {
      progressAnimation?.cancel();
      progressAnimation = undefined;
    };

    const syncPlayback = () => {
      if (signal.aborted) return;
      const focused = document.activeElement;
      const hasFocus = focused !== rotation && slider.contains(focused);
      const hovered = canHover.matches && slider.matches(':hover');
      if (paused || !visible || document.hidden || touching || hasFocus || hovered) {
        progressAnimation?.pause();
        return;
      }
      if (progressAnimation) {
        progressAnimation.play();
        return;
      }

      const animation = progress.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], 4500);
      progressAnimation = animation;
      animation.onfinish = () => {
        if (progressAnimation === animation) goToSlide(currentIndex + 1, false);
      };
    };

    const setPaused = (value: boolean) => {
      paused = value;
      const label = paused ? 'Play slideshow' : 'Pause slideshow';
      rotation.setAttribute('aria-label', label);
      rotation.title = label;
      rotation.toggleAttribute('data-paused', paused);
      syncPlayback();
    };

    function goToSlide(index: number, announce = true) {
      currentIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, idx) => {
        const active = idx === currentIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.inert = !active;
      });
      if (current) current.textContent = String(currentIndex + 1).padStart(2, '0');
      const activeSlide = slides[currentIndex];
      const { checkoutHref, productTitle } = activeSlide.dataset;
      if (checkoutHref && productTitle) {
        purchaseLink.href = checkoutHref;
        purchaseLink.setAttribute('aria-label', `Buy now: ${productTitle}`);
      }
      if (status && announce) status.textContent = activeSlide.getAttribute('aria-label');
      resetProgress();
      syncPlayback();
    }

    setPaused(paused);
    rotation.addEventListener('click', () => setPaused(!paused));
    slider.addEventListener('pointerenter', syncPlayback);
    slider.addEventListener('pointerleave', syncPlayback);
    slider.addEventListener('focusin', syncPlayback);
    slider.addEventListener('focusout', () => requestAnimationFrame(syncPlayback));
    document.addEventListener('visibilitychange', syncPlayback, { signal });
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) setPaused(true);
    }, { signal });

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.intersectionRatio >= .5;
      syncPlayback();
    }, { threshold: .5 });
    observer.observe(slider);

    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));
    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    controls.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      goToSlide(currentIndex + (event.key === 'ArrowLeft' ? -1 : 1));
    });

    let touchStartX = 0;
    let touchStartY = 0;
    track.addEventListener('touchstart', (event) => {
      touching = true;
      touchStartX = event.changedTouches[0].clientX;
      touchStartY = event.changedTouches[0].clientY;
      syncPlayback();
    }, { passive: true });
    track.addEventListener('touchend', (event) => {
      touching = false;
      const touch = event.changedTouches[0];
      const dx = touch.clientX - touchStartX;
      const dy = touch.clientY - touchStartY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
        goToSlide(currentIndex + (dx < 0 ? 1 : -1));
      }
      syncPlayback();
    }, { passive: true });
    track.addEventListener('touchcancel', () => {
      touching = false;
      syncPlayback();
    }, { passive: true });

    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      observer.disconnect();
      resetProgress();
    }, { once: true });
  }

  function initHouseCarousel() {
    const section = document.getElementById('fragrance-houses');
    const track = document.getElementById('home-house-track');
    const controls = section?.querySelector<HTMLElement>('.home-house-controls');
    const rotation = controls?.querySelector<HTMLButtonElement>('.home-house-rotation');
    if (!section || !track || !controls || !rotation || track.dataset.ready) return;

    const cards = Array.from(track.querySelectorAll<HTMLAnchorElement>('.home-house-link'));
    if (cards.length < 2) return;
    track.dataset.ready = 'true';
    controls.hidden = false;

    // Repeat the rail on both sides so the visible cards also wrap at the seam.
    const copyCards = () => cards.map((card) => {
      const copy = card.cloneNode(true) as HTMLAnchorElement;
      copy.tabIndex = -1;
      copy.setAttribute('aria-hidden', 'true');
      return copy;
    });
    const before = copyCards();
    const after = copyCards();
    track.prepend(...before);
    track.append(...after);
    const railCards = [...before, ...cards, ...after];
    track.scrollTo({ left: cards[0].offsetLeft, behavior: 'instant' });

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canHover = window.matchMedia('(hover: hover)');
    let paused = reducedMotion.matches;
    let visible = false;
    let lastScroll = 0;
    let settleTimer: number;
    let touching = false;

    const recenter = () => {
      if (touching || track.contains(document.activeElement)) return;
      const start = cards[0].offsetLeft;
      const period = after[0].offsetLeft - start;
      if (period <= 0) return;

      const offset = track.scrollLeft - start;
      // Allow for fractional card widths at the snap points.
      if (offset >= -2 && offset < period - 2) return;
      const wrapped = ((offset % period) + period) % period;
      track.scrollTo({ left: start + (wrapped >= period - 2 ? 0 : wrapped), behavior: 'instant' });
    };

    const settle = () => {
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(recenter, 160);
    };

    const move = (direction: number) => {
      recenter();
      const left = track.scrollLeft;
      const stops = railCards.map((card) => card.offsetLeft);
      const target = direction > 0
        ? stops.find((stop) => stop > left + 2)
        : stops.findLast((stop) => stop < left - 2);

      if (target !== undefined) {
        track.scrollTo({ left: target, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
      }
    };

    const syncRotationLabel = () => {
      const label = paused ? 'Play auto-scroll' : 'Pause auto-scroll';
      rotation.setAttribute('aria-label', label);
      rotation.title = label;
      rotation.toggleAttribute('data-paused', paused);
    };

    syncRotationLabel();
    rotation.addEventListener('click', () => {
      paused = !paused;
      syncRotationLabel();
    });
    controls.querySelectorAll<HTMLButtonElement>('[data-house-direction]').forEach((button) => {
      button.addEventListener('click', () => move(Number(button.dataset.houseDirection)));
    });
    track.addEventListener('scroll', () => {
      lastScroll = Date.now();
      settle();
    }, { passive: true });
    track.addEventListener('touchstart', () => { touching = true; }, { passive: true });
    const endTouch = () => {
      touching = false;
      settle();
    };
    track.addEventListener('touchend', endTouch, { passive: true });
    track.addEventListener('touchcancel', endTouch, { passive: true });

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }, { threshold: .5 });
    observer.observe(track);

    function respectMotionPreference(event: MediaQueryListEvent) {
      if (event.matches) {
        paused = true;
        syncRotationLabel();
      }
    }
    reducedMotion.addEventListener('change', respectMotionPreference);

    const interval = window.setInterval(() => {
      if (!visible || paused || touching || document.hidden || Date.now() - lastScroll < 1500) return;
      if (section.contains(document.activeElement) || (canHover.matches && section.matches(':hover'))) return;
      move(1);
    }, 3000);

    document.addEventListener('astro:before-swap', () => {
      window.clearInterval(interval);
      window.clearTimeout(settleTimer);
      observer.disconnect();
      reducedMotion.removeEventListener('change', respectMotionPreference);
    }, { once: true });
  }

  function initHome() {
    initHeroSlider();
    initHouseCarousel();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHome);
  } else {
    initHome();
  }
  document.addEventListener('astro:page-load', initHome);
</script>
