---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import StorefrontEdit from '../components/StorefrontEdit.astro';
import { discoverySlugs, hasSpecialPrice, isEligibleForShowcase, occasions } from '../data/storefront-edits';
import productsData from '../data/products.json';
import { siteConfig } from '../data/site';

const catalog = productsData.filter((product) => !product.isDraft);
const heroSlides = [
  {
    title: 'Chanel N°5',
    mobileImage: '/assets/hero/mobile/hero-chanel-n5-campaign.webp',
    desktopImage: '/assets/hero/desktop/hero-chanel-n5-campaign.webp',
    alt: 'Chanel N°5: Forever Iconic. The perfume bottle sits on sunlit stone beside white camellias.',
    slug: 'chanel-n-5'
  },
  {
    title: 'YSL Libre',
    mobileImage: '/assets/hero/mobile/hero-ysl-libre-campaign.webp',
    desktopImage: '/assets/hero/desktop/hero-ysl-libre-campaign.webp',
    alt: 'Yves Saint Laurent Libre: Freedom, Bottled. The gold perfume bottle sits beside a white orchid.',
    slug: 'yves-saint-laurent-libre'
  },
  {
    title: 'Black Orchid',
    mobileImage: '/assets/hero/mobile/hero-black-orchid-campaign.webp',
    desktopImage: '/assets/hero/desktop/hero-black-orchid-campaign.webp',
    alt: 'Tom Ford Black Orchid: The Art of Allure. The black perfume bottle sits among dark orchids.',
    slug: 'tom-ford-black-orchid'
  },
  {
    title: 'Good Girl',
    mobileImage: '/assets/hero/mobile/hero-good-girl-campaign.webp',
    desktopImage: '/assets/hero/desktop/hero-good-girl-campaign.webp',
    alt: 'Carolina Herrera Good Girl: Own the Night. The blue and gold stiletto bottle sits beside white flowers.',
    slug: 'carolina-herrera-good-girl'
  }
].flatMap((slide) => {
  const product = catalog.find((item) => item.slug === slide.slug);
  return product ? [{ ...slide, checkoutHref: `/checkout/?product=${encodeURIComponent(product.slug)}&qty=1` }] : [];
});
const firstHeroSlide = heroSlides[0];

const discoveryScents = discoverySlugs.flatMap((slug) => catalog.filter((product) => product.slug === slug));
const specialScents = catalog.filter((product) => hasSpecialPrice(product) && isEligibleForShowcase(product))
  .sort((a, b) => a.priceMinor / (a.stickerPriceMinor ?? 1) - b.priceMinor / (b.stickerPriceMinor ?? 1))
  .slice(0, 4);
const featuredHouses = [
  { name: 'Chanel', logo: 'chanel.svg' },
  { name: 'Dior', logo: 'dior.svg' },
  { name: 'Yves Saint Laurent', logo: 'yves-saint-laurent.svg' },
  { name: 'Tom Ford', logo: 'tom-ford.svg' },
  { name: 'Guerlain', logo: 'guerlain.svg' },
  { name: 'Boucheron', logo: 'boucheron.svg' },
  { name: 'Dolce & Gabbana', logo: 'dolce-gabbana.svg', logoSize: 'wide' },
  { name: 'Paco Rabanne', logo: 'paco-rabanne.svg', logoSize: 'wide' },
  { name: 'Burberry', logo: 'burberry.svg', logoSize: 'compact' },
  { name: 'Gucci', logo: 'gucci.svg', logoSize: 'compact' },
  { name: 'Narciso Rodriguez', logo: 'narciso-rodriguez.svg', logoSize: 'wide' }
]
  .map((house) => ({ ...house, count: catalog.filter((product) => product.brand === house.name).length }))
  .filter((house) => house.count > 0);

// Hand-curated flagship perfumes for the home page showcase (leading with global icon YSL Libre)
const curatedHomeSlugs = [
  'yves-saint-laurent-libre',
  'boucheron-quatre-en-bleu',
  'chanel-n-5',
  'dolce-gabbana-devotion'
];

const selectedScents = curatedHomeSlugs
  .map((slug) => catalog.find((p) => p.slug === slug))
  .filter(Boolean) as typeof productsData;

// 4 Olfactive Category representations using LUMÈRA LUXE Brand Photography
const categories = [
  {
    label: 'Fresh & Citrus',
    href: '/shop/?family=fresh',
    img: '/assets/brand/family-fresh-citrus.webp',
    alt: 'Fresh & Citrus perfumes featuring Dolce & Gabbana Light Blue and Acqua di Parma Colonia'
  },
  {
    label: 'Floral & Rose',
    href: '/shop/?family=floral',
    img: '/assets/brand/family-floral-rose.webp',
    alt: 'Floral & Rose perfumes featuring Chloé and Miss Dior'
  },
  {
    label: 'Amber & Oriental',
    href: '/shop/?family=oriental',
    img: '/assets/brand/family-amber-oriental.webp',
    alt: 'Amber & Oriental perfumes featuring YSL Black Opium and Chanel Coco Mademoiselle'
  },
  {
    label: 'Woody & Earthy',
    href: '/shop/?family=woody',
    img: '/assets/brand/family-woody-fresh.webp',
    alt: 'Woody & Earthy perfumes featuring Terre d’Hermès and Le Labo Santal 33'
  }
];

// Google Search Knowledge Graph & AEO (Answer Engine Optimization) Schemas
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://lumeraluxe.com.qa/#website',
      'url': 'https://lumeraluxe.com.qa/',
      'name': 'LUMÈRA LUXE',
      'description': 'Where Luxury Meets Affordability. Curated designer and niche fragrances in Doha, Qatar.',
      'inLanguage': ['en', 'ar'],
      'potentialAction': {
        '@type': 'SearchAction',
        'target': 'https://lumeraluxe.com.qa/shop/?search={search_term_string}',
        'query-input': 'required name=search_term_string'
      }
    },
    {
      '@type': 'Store',
      '@id': 'https://lumeraluxe.com.qa/#store',
      'name': 'LUMÈRA LUXE',
      'legalName': 'Lumera Luxe Perfumes and Cosmetics W.L.L.',
      'alternateName': 'لوميرا لوكس للعطور ومستحضرات التجميل ذ.م.م',
      'url': 'https://lumeraluxe.com.qa/',
      'logo': 'https://lumeraluxe.com.qa/assets/lumera-favicon.png',
      'image': 'https://lumeraluxe.com.qa/assets/brand/hero-floral-collection.webp',
      'description': 'Curated luxury and designer fragrances in Doha, Qatar. Concierge doorstep delivery with verified authentic batch codes.',
      'telephone': '+97466675166',
      'email': siteConfig.customerSupportEmail,
      'priceRange': '$$',
      'currenciesAccepted': 'QAR',
      'paymentAccepted': 'Cash on Delivery, Credit Card POS upon arrival, Bank Transfer',
      'address': {
        '@type': 'PostalAddress',
        'addressLocality': 'Doha',
        'addressRegion': 'Ad-Dawhah',
        'addressCountry': 'QA'
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': 25.2854,
        'longitude': 51.5310
      },
      'areaServed': [
        { '@type': 'AdministrativeArea', 'name': 'Qatar' },
        { '@type': 'City', 'name': 'Doha' },
        { '@type': 'City', 'name': 'Lusail' },
        { '@type': 'City', 'name': 'The Pearl-Qatar' },
        { '@type': 'City', 'name': 'Al Rayyan' },
        { '@type': 'City', 'name': 'Al Wakrah' }
      ],
      'sameAs': [
        'https://www.instagram.com/lumera.luxe974',
        'https://www.tiktok.com/@luxescentqatar'
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://lumeraluxe.com.qa/#faq',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': 'Are LUMÈRA LUXE perfumes 100% genuine and authentic in Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Yes, 100%. Every perfume in the LUMÈRA LUXE collection is strictly verified for authentic origin, imported from authorized European distributors with genuine batch codes and original sealed packaging.'
          }
        },
        {
          '@type': 'Question',
          'name': 'How does perfume delivery work in Doha and across Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'LUMÈRA LUXE offers express doorstep delivery across all Qatar municipalities, including Doha, The Pearl, Lusail, Al Rayyan, and Al Wakrah. Orders confirmed through our official WhatsApp concierge (+974 6667 5166) are delivered within six hours of confirmation.'
          }
        },
        {
          '@type': 'Question',
          'name': 'What payment methods are accepted for orders in Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Payment is fulfilled upon doorstep arrival in Qatar via Cash or Card on Delivery using a portable POS machine, or via verified direct corporate bank transfer.'
          }
        },
        {
          '@type': 'Question',
          'name': 'Which perfume brands are available at LUMÈRA LUXE Qatar?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'LUMÈRA LUXE curates 175 authentic fragrances from world-renowned fragrance houses, including Chanel, Dior, Baccarat Rouge / Maison Francis Kurkdjian, Tom Ford, Creed, Yves Saint Laurent, Giorgio Armani, Gucci, Byredo, Parfums de Marly, and Narciso Rodriguez.'
          }
        }
      ]
    }
  ]
};
---

<BaseLayout>
  <!-- Priority LCP Image Preload for Mobile & Desktop -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href={firstHeroSlide?.mobileImage}
    media="(max-width: 680px)"
    type="image/webp"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={firstHeroSlide?.desktopImage}
    media="(width > 680px)"
    type="image/webp"
    fetchpriority="high"
  />

  <script type="application/ld+json" set:html={JSON.stringify(homeStructuredData)} />
  <div class="minimal-storefront">
    <h1 class="sr-only">LUMÈRA LUXE fragrance boutique in Qatar</h1>
    <section class="hero-editorial-section" aria-label="Featured Fragrances Showcase">
      <div class="container">
        <div class="hero-editorial-stage" id="hero-slider" role="region" aria-roledescription="carousel" aria-label="LUMÈRA LUXE Featured Perfumes">
          {firstHeroSlide && (
            <a
              href={firstHeroSlide.checkoutHref}
              class="btn-hero-shop-now"
              aria-label={`Buy now: ${firstHeroSlide.title}`}
            >
              Buy now <span aria-hidden="true">↗</span>
            </a>
          )}
          <div class="hero-slides-track" id="hero-slides-track">
            {heroSlides.map((slide, idx) => (
              <div
                class={`hero-slide ${idx === 0 ? 'is-active' : ''}`}
                inert={idx !== 0}
                role="group"
                aria-roledescription="slide"
                aria-label={`${idx + 1} of ${heroSlides.length}: ${slide.title}`}
                aria-hidden={idx === 0 ? 'false' : 'true'}
                data-checkout-href={slide.checkoutHref}
                data-product-title={slide.title}
              >
                <picture class="hero-slide-picture">
                  <source media="(max-width: 680px)" srcset={slide.mobileImage} type="image/webp" width="896" height="1200" />
                  <img
                    src={slide.desktopImage}
                    alt={slide.alt}
                    class="hero-slide-image"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    fetchpriority={idx === 0 ? 'high' : 'low'}
                    decoding={idx === 0 ? 'sync' : 'async'}
                    width="1920"
                    height="1072"
                  />
                </picture>
              </div>
            ))}
          </div>
          <div class="hero-controls" hidden>
            <div class="hero-progress" aria-hidden="true"><span></span></div>
            <button type="button" class="rail-icon-btn hero-rotation" aria-label="Pause slideshow" title="Pause slideshow" aria-controls="hero-slides-track">
              <svg class="rotation-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6v12m6-12v12" /></svg>
              <svg class="rotation-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9 6 9 6-9 6z" /></svg>
            </button>
            <button type="button" class="rail-icon-btn" id="hero-prev-btn" aria-label="Previous slide" aria-controls="hero-slides-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m14.5 6-6 6 6 6" /></svg>
            </button>
            <span class="hero-slide-count" aria-hidden="true"><span id="hero-current-slide">01</span><span class="hero-count-divider">/</span>{String(heroSlides.length).padStart(2, '0')}</span>
            <button type="button" class="rail-icon-btn" id="hero-next-btn" aria-label="Next slide" aria-controls="hero-slides-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9.5 6 6 6-6 6" /></svg>
            </button>
          </div>
          <span class="sr-only" id="hero-slide-status" aria-live="polite"></span>
        </div>
      </div>
    </section>

    <section class="section-home" id="fragrance-houses" aria-labelledby="fragrance-houses-title">
      <div class="container">
        <div class="section-header-minimal home-house-heading">
          <div>
            <p class="home-kicker">Designer & niche</p>
            <h2 class="section-title-minimal" id="fragrance-houses-title">Shop by House</h2>
          </div>
          <div class="home-house-controls" role="group" aria-label="Shop by House controls" hidden>
            <button type="button" class="rail-icon-btn home-house-rotation" aria-label="Pause auto-scroll" title="Pause auto-scroll" aria-controls="home-house-track">
              <svg class="rotation-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6v12m6-12v12" /></svg>
              <svg class="rotation-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9 6 9 6-9 6z" /></svg>
            </button>
            <button type="button" class="rail-icon-btn" data-house-direction="-1" aria-label="Previous house" aria-controls="home-house-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m14.5 6-6 6 6 6" /></svg>
            </button>
            <button type="button" class="rail-icon-btn" data-house-direction="1" aria-label="Next house" aria-controls="home-house-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9.5 6 6 6-6 6" /></svg>
            </button>
          </div>
        </div>
        <div class="home-house-track" id="home-house-track">
          {featuredHouses.map(({ name, logo, logoSize, count }) => (
            <a class="home-house-link" href={`/shop/?brand=${encodeURIComponent(name)}`}>
              <span class="home-house-logo" data-logo-size={logoSize}>
                <img src={`/assets/brand/houses/${logo}`} alt={name} loading="lazy" decoding="async" />
              </span>
              <span class="home-house-count">{count} {count === 1 ? 'fragrance' : 'fragrances'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <StorefrontEdit
      id="discovery-edit"
      kicker="Explore something different"
      title="Fragrance Discoveries"
      href="/shop/?edit=discovery"
      products={discoveryScents}
    />

    <!-- Signature fragrances -->
    <section class="section-home" id="section-curated-showcase">
      <div class="container">
        <div class="section-header-minimal">
          <div>
            <p class="home-kicker">The LUMÈRA LUXE selection</p>
            <h2 class="section-title-minimal" id="curated-section-title">Signature Fragrances</h2>
          </div>
          <a href="/shop/" class="see-all-link">See All ({catalog.length})</a>
        </div>

        <div class="grid-products home-preview-grid">
          {
            selectedScents.slice(0, 4).map((product) => (
              <ProductCard product={product} priority={false} />
            ))
          }
        </div>

      </div>
    </section>

    <section class="section-home" id="shop-by-occasion" aria-labelledby="occasion-title">
      <div class="container">
        <div class="section-header-minimal">
          <div>
            <p class="home-kicker">A scent for the moment</p>
            <h2 class="section-title-minimal" id="occasion-title">Shop by Occasion</h2>
          </div>
        </div>
        <div class="home-browse-grid">
          {occasions.map((occasion) => (
            <a class="home-browse-card" href={`/shop/?edit=${occasion.id}`}>
              <img src={occasion.image} alt="" width="640" height="480" loading="lazy" decoding="async" />
              <span class="home-browse-title">{occasion.title} <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <StorefrontEdit
      id="special-prices"
      kicker="Selected bottles"
      title="Special Prices"
      href="/shop/?edit=special-prices"
      products={specialScents}
    />

    <!-- 1. SCENT FAMILIES (Olfactive Exploration) -->
    <section class="section-home" id="scent-families" aria-labelledby="scent-families-title">
      <div class="container">
        <div class="section-header-minimal">
          <div>
            <p class="home-kicker">Explore by notes</p>
            <h2 class="section-title-minimal" id="scent-families-title">Scent Families</h2>
          </div>
          <a href="/shop/" class="see-all-link">Explore All</a>
        </div>

        <div class="home-browse-grid">
          {categories.map((category) => (
            <a href={category.href} class="home-browse-card">
              <img src={category.img} alt={category.alt} loading="lazy" decoding="async" width="640" height="480" />
              <span class="home-browse-title">{category.label} <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-home" aria-labelledby="shopping-help-title">
      <div class="container">
        <div class="section-header-minimal">
          <div>
            <p class="home-kicker">Personal service</p>
            <h2 class="section-title-minimal" id="shopping-help-title">Find Your Fragrance</h2>
          </div>
        </div>
        <div class="shopping-help-grid">
          <article class="shopping-help-card">
            <h3>Find your signature scent</h3>
            <p>Answer four questions to discover fragrances matched to your taste.</p>
            <a href="/fragrance-finder/" class="shopping-help-link">Take the fragrance quiz <span aria-hidden="true">↗</span></a>
          </article>
          <article class="shopping-help-card home-concierge-card">
            <h3>Talk to our concierge</h3>
            <p>Ask for a recommendation, check availability, or place an order for delivery across Qatar.</p>
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello LUMÈRA LUXE, I would like help choosing a fragrance.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="shopping-help-link"
            >Chat on WhatsApp <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section-home" aria-labelledby="home-story-title">
      <div class="container">
        <div class="section-header-minimal">
          <div>
            <p class="home-kicker">The house</p>
            <h2 class="section-title-minimal" id="home-story-title">Authentic European Fragrances</h2>
          </div>
        </div>
        <div class="home-story-card">
          <img
            src="/assets/brand/brand-perfume-curation.webp"
            alt="Designer perfume bottles arranged among pink blossoms"
            loading="lazy"
            decoding="async"
            width="1024"
            height="768"
          />
          <div class="home-story-copy">
            <h3>A collection chosen with care</h3>
            <p>We select designer and niche perfumes from verified European distributors and deliver them across Qatar.</p>
            <a href="/our-story/" class="shopping-help-link">Our story <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-home home-faq-section" id="shopping-help" aria-labelledby="home-faq-title">
      <div class="container">
        <div class="home-faq-grid">
          <div>
            <p class="home-kicker">Good to know</p>
            <h2 class="section-title-minimal" id="home-faq-title">Shopping with LUMÈRA LUXE</h2>
            <a class="shopping-help-link" href="/contact/">Contact our concierge <span aria-hidden="true">↗</span></a>
          </div>
          <div class="home-faq-list">
            <details>
              <summary>How much is delivery in Qatar?</summary>
              <p>Express delivery is complimentary on orders above 300 QAR. Orders of 300 QAR or less have a 25 QAR delivery fee. <a href="/shipping-delivery/">Read the delivery policy.</a></p>
            </details>
            <details>
              <summary>How do I place and pay for an order?</summary>
              <p>Add your fragrances to the bag and send the order request to our WhatsApp concierge. We confirm availability and delivery with you. You can pay by cash or card on delivery, or arrange a bank transfer.</p>
            </details>
            <details>
              <summary>What if the fragrance is not for me?</summary>
              <p>Contact our concierge within six hours of delivery to request a return or exchange, even if you’ve opened and used the fragrance. <a href="/returns-refunds/">Read the returns policy.</a></p>
            </details>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .minimal-storefront {
    --home-section-gap: clamp(2.8rem, 5vw, 5rem);
    padding-top: 0;
    padding-bottom: 0;
  }

  .section-home {
    margin-bottom: var(--home-section-gap);
  }

  .hero-editorial-section {
    margin: clamp(.8rem, 2vw, 1.5rem) 0 clamp(2.75rem, 5vw, 5rem);
  }

  .hero-editorial-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    aspect-ratio: auto;
    min-height: 0;
    max-height: none;
    overflow: hidden;
    border: 1px solid #e4d9cc;
    border-radius: clamp(.7rem, 1.4vw, 1.15rem);
    background: #fbf7f1;
  }

  .hero-slides-track {
    grid-area: 1 / 1;
    display: grid;
    isolation: isolate;
    touch-action: pan-y pinch-zoom;
  }

  .hero-slide {
    grid-area: 1 / 1;
    min-width: 0;
    background: #fbf7f1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0s linear 550ms, visibility 0s linear 550ms;
  }

  .hero-slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 550ms cubic-bezier(.25, .46, .45, .94);
  }

  .hero-slide-picture {
    position: relative;
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #dec4a7;
  }

  .hero-slide-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transform: scale(1.055);
    transition: transform 1200ms cubic-bezier(.2, .65, .3, 1);
  }

  .hero-slide.is-active .hero-slide-image {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-slide-image {
      transition: none !important;
      transform: none;
    }
  }

  .home-kicker {
    margin: 0 0 .5rem;
    color: #855339;
    font-size: .69rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .btn-hero-shop-now {
    grid-area: 1 / 1;
    z-index: 1;
    place-self: end;
    margin: clamp(1rem, 2.4vw, 2.5rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 44px;
    min-width: 9rem;
    padding: .65rem 1.2rem;
    border-radius: 999px;
    border: 1px solid #e4d9cc;
    background: #fff9f2;
