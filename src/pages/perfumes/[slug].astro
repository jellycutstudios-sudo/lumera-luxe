</style>

<script>
  import { siteConfig } from '../../data/site';
  import { formatWhatsAppOrderMessage } from '../../lib/whatsapp';

  const STORAGE_CUSTOMER_KEY = 'lumera_customer_v1';

  // Mobile sticky bar observer
  const trigger = document.getElementById('pdp-buy-now-card');
  const stickyBar = document.getElementById('mobile-sticky-bar');

  if (trigger && stickyBar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          stickyBar.hidden = entry.isIntersecting;
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(trigger);
  }

  // Load saved customer details from localStorage
  const nameInput = document.getElementById('pdp-order-name') as HTMLInputElement;
  const phoneInput = document.getElementById('pdp-order-phone') as HTMLInputElement;
  const addressInput = document.getElementById('pdp-order-address') as HTMLInputElement;
  const citySelect = document.getElementById('pdp-order-city') as HTMLSelectElement;
  const notesInput = document.getElementById('pdp-order-notes') as HTMLInputElement;

  try {
    const savedCustomer = localStorage.getItem(STORAGE_CUSTOMER_KEY);
    if (savedCustomer) {
      const data = JSON.parse(savedCustomer);
      if (nameInput && data.fullName) nameInput.value = data.fullName;
      if (phoneInput && data.phone) phoneInput.value = data.phone;
      if (addressInput && data.address) addressInput.value = data.address;
      if (citySelect && data.city) citySelect.value = data.city;
      if (notesInput && data.notes) notesInput.value = data.notes;
    }
  } catch (e) {
    console.error('Failed to load saved customer details', e);
  }

  // Quantity handling
  let currentQty = 1;
  const qtyValEl = document.getElementById('pdp-qty-val');
  const qtyDecBtn = document.getElementById('pdp-qty-dec');
  const qtyIncBtn = document.getElementById('pdp-qty-inc');
  const totalPriceEl = document.getElementById('pdp-total-price');
  const btnAmountEl = document.getElementById('pdp-btn-amount');
  const buyNowBtn = document.getElementById('btn-pdp-buy-now');
  const pdpAddBtn = document.getElementById('pdp-main-add-btn');

  const unitPriceMinor = buyNowBtn ? Number(buyNowBtn.getAttribute('data-price') || 0) : 0;

  function updatePrices() {
    if (qtyValEl) qtyValEl.textContent = String(currentQty);
    const totalMinor = unitPriceMinor * currentQty;
    const formatted = `${(totalMinor / 100).toFixed(0)} QAR`;
    if (totalPriceEl) totalPriceEl.textContent = formatted;
    if (btnAmountEl) btnAmountEl.textContent = formatted;
  }

  qtyDecBtn?.addEventListener('click', () => {
    if (currentQty > 1) {
      currentQty--;
      updatePrices();
    }
  });

  qtyIncBtn?.addEventListener('click', () => {
    if (currentQty < 10) {
      currentQty++;
      updatePrices();
    }
  });

  // Sticky Buy Now smooth scroll
  const stickyBuyBtn = document.getElementById('btn-sticky-buy-now');
  stickyBuyBtn?.addEventListener('click', () => {
    const card = document.getElementById('pdp-buy-now-card');
    if (card) {
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => {
        nameInput?.focus();
      }, 500);
    }
  });

  // Buy Now via WhatsApp action
  buyNowBtn?.addEventListener('click', () => {
    const nameVal = nameInput ? nameInput.value.trim() : '';
    const phoneVal = phoneInput ? phoneInput.value.trim() : '';
    const addressVal = addressInput ? addressInput.value.trim() : '';
    const cityVal = citySelect ? citySelect.value : 'Doha';
    const notesVal = notesInput ? notesInput.value.trim() : '';

    let hasError = false;

    // Reset error states
    const nameErr = document.getElementById('pdp-name-error');
    const phoneErr = document.getElementById('pdp-phone-error');
    const addrErr = document.getElementById('pdp-address-error');

    nameInput?.classList.remove('input-error');
    phoneInput?.classList.remove('input-error');
    addressInput?.classList.remove('input-error');
    nameErr?.classList.remove('visible');
    phoneErr?.classList.remove('visible');
    addrErr?.classList.remove('visible');

    if (!nameVal) {
      nameInput?.classList.add('input-error');
      nameErr?.classList.add('visible');
      if (!hasError) nameInput?.focus();
      hasError = true;
    }

    if (!phoneVal || phoneVal.replace(/[^0-9]/g, '').length < 7) {
      phoneInput?.classList.add('input-error');
      phoneErr?.classList.add('visible');
      if (!hasError) phoneInput?.focus();
      hasError = true;
    }

    if (!addressVal) {
      addressInput?.classList.add('input-error');
      addrErr?.classList.add('visible');
      if (!hasError) addressInput?.focus();
      hasError = true;
    }

    if (hasError) return;

    // Save to localStorage for convenience
    try {
      localStorage.setItem(
        STORAGE_CUSTOMER_KEY,
        JSON.stringify({
          fullName: nameVal,
          phone: phoneVal,
          address: addressVal,
          city: cityVal,
          notes: notesVal
        })
      );
    } catch {}

    const id = buyNowBtn.getAttribute('data-id') || '';
    const name = buyNowBtn.getAttribute('data-name') || '';
    const brand = buyNowBtn.getAttribute('data-brand') || '';
    const sizeDisplay = buyNowBtn.getAttribute('data-size') || '';
    const concentration = buyNowBtn.getAttribute('data-concentration') || '';

    const items = [
      {
        id,
        name,
        brand,
        sizeDisplay,
        concentration,
        priceMinor: unitPriceMinor,
        quantity: currentQty
      }
    ];

    const customer = {
      fullName: nameVal,
      phone: phoneVal.startsWith('+') ? phoneVal : `+974 ${phoneVal}`,
      address: addressVal,
      city: cityVal,
      notes: notesVal
    };

    const msg = formatWhatsAppOrderMessage(items, customer);
    const phone = siteConfig.whatsappNumber.replace(/[^0-9]/g, '');
    const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

    const win = window.open(waUrl, '_blank');
    if (!win || win.closed || typeof win.closed === 'undefined') {
      window.location.href = waUrl;
    }
  });

  // Modify Add to Bag from PDP to honor quantity
  pdpAddBtn?.addEventListener('click', () => {
    const id = pdpAddBtn.getAttribute('data-id');
    if (!id) return;
    try {
      const data = localStorage.getItem('lumera_bag_v1');
      const items: { id: string; quantity: number }[] = data ? JSON.parse(data) : [];
      const existing = items.find((it) => it.id === id);
      if (existing) {
        existing.quantity += (currentQty - 1); // since global listener adds 1
      } else {
        setTimeout(() => {
          const updated = JSON.parse(localStorage.getItem('lumera_bag_v1') || '[]');
          const it = updated.find((x: any) => x.id === id);
          if (it) {
            it.quantity = currentQty;
            localStorage.setItem('lumera_bag_v1', JSON.stringify(updated));
            window.dispatchEvent(new Event('storage'));
          }
        }, 10);
      }
    } catch (e) {
      console.error(e);
    }
  });

  // Lightbox Zoom logic
  const mediaFrame = document.getElementById('pdp-media-frame');
  const lightbox = document.getElementById('image-lightbox');
  const lightboxClose = document.getElementById('lightbox-close');

  mediaFrame?.addEventListener('click', () => {
    if (lightbox) {
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }
  });

  lightboxClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightbox) {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
  });

  // WhatsApp Share Button
  const shareBtn = document.getElementById('btn-share-fragrance');
  shareBtn?.addEventListener('click', () => {
    const text = `Look at this luxury fragrance on LUMÈRA LUXE: ${document.title} - ${window.location.href}`;
    if (navigator.share) {
      navigator.share({ title: document.title, url: window.location.href, text }).catch(() => {});
    } else {
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    }
  });
</script>
