---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
import { siteConfig } from '../../data/site';
import { QATAR_DELIVERY_AREAS } from '../../lib/delivery';
import { findSimilarFragrances } from '../../lib/fragrance-matcher';
import { CURATED_LAYERING_PAIRS } from '../../data/fragrance-discovery';

export async function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

// Find 2-3 genuinely similar fragrances using note-affinity and olfactive family overlap
const similarResults = findSimilarFragrances(product, productsData, 3);
const similarProducts = similarResults.map((r) => r.product);

// Check if this fragrance is part of an approved layering ritual (either as base or top)
const activeLayeringPair = CURATED_LAYERING_PAIRS.find(
  (pair) => pair.baseSlug === product.slug || pair.topSlug === product.slug
);

const companionSlug = activeLayeringPair?.baseSlug === product.slug
  ? activeLayeringPair.topSlug
  : activeLayeringPair?.baseSlug;
const pairedProduct = productsData.find((item) => item.slug === companionSlug && !item.isDraft);
const duetPriceTotal = pairedProduct ? Math.round((product.priceMinor + pairedProduct.priceMinor) / 100) : 0;
const checkoutHref = `/checkout/?product=${encodeURIComponent(product.slug)}&qty=1`;

// Schema.org Product structured data (Enhanced for Google Merchant & AEO Rich Snippets)
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.fullName,
  url: `https://lumeraluxe.com.qa/perfumes/${product.slug}/`,
  image: `https://lumeraluxe.com.qa${product.image}`,
  description: product.description,
  sku: product.id,
  brand: {
    '@type': 'Brand',
    name: product.brand
  },
  offers: {
    '@type': 'Offer',
    url: `https://lumeraluxe.com.qa/perfumes/${product.slug}/`,
    priceCurrency: product.currency,
    price: (product.priceMinor / 100).toFixed(0),
    priceValidUntil: '2027-12-31',
    itemCondition: 'https://schema.org/NewCondition',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: siteConfig.brandName,
      url: 'https://lumeraluxe.com.qa',
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        merchantReturnLink: 'https://lumeraluxe.com.qa/returns-refunds/'
      }
    }
  }
};
---

<BaseLayout
  title={`${product.fullName} · ${product.sizeDisplay} | LUMÈRA LUXE`}
  description={product.description}
  image={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <article class="pdp-container container">
    <!-- Minimalist Haute Breadcrumb -->
    <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/shop/">Collection</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href={`/shop/?brand=${encodeURIComponent(product.brand)}`}>{product.brand}</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current" aria-current="page">{product.name}</span>
    </nav>

    <div class="pdp-grid">
      <!-- Media Stage with Magnifier -->
      <div class="pdp-media-wrap">
        <button class="pdp-media-frame" id="pdp-media-frame" type="button" aria-label={`Enlarge image of ${product.fullName}`} aria-haspopup="dialog">
          <img
            src={product.image}
            alt={`${product.fullName} luxury perfume bottle`}
            class="pdp-main-image"
            width="600"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            id="pdp-image"
          />

          <span class="pdp-zoom-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4M8 10.5h5m-2.5-2.5v5" />
            </svg>
          </span>
        </button>
      </div>

      <!-- Product Information Tier -->
      <div class="pdp-info">
        <!-- Identity Tier -->
        <div class="pdp-header-block">
          <span class="pdp-brand">{product.brand}</span>
          <h1 class="pdp-title">{product.name}</h1>
          <p class="pdp-variant-details">{product.concentration} · {product.sizeDisplay}</p>
        </div>

        <!-- Luxury Price & Privilege Bar -->
        <div class="pdp-price-row">
          <span class="pdp-price">{product.priceDisplay}</span>
          {product.stickerPriceMinor && product.stickerPriceMinor > product.priceMinor && (
            <s class="pdp-sticker-price"><span class="sr-only">Original price </span>{(product.stickerPriceMinor / 100).toFixed(0)} QAR</s>
          )}
        </div>

        {product.isDraft && (
          <div class="pdp-draft-notice">
            <span class="draft-tag">Review Candidate · Availability Verification</span>
            <p>This formulation is currently undergoing distributor batch verification. Please verify live availability with our WhatsApp concierge before dispatch.</p>
          </div>
        )}

        <!-- STREAMLINED LUXURY ACTION BLOCK -->
        <div class="pdp-action-block" id="pdp-cta-trigger">
          <div class="pdp-primary-action-row">
            <a href={checkoutHref} class="btn-pdp-buy-now">Buy now</a>
            <button
              type="button"
              class="btn-pdp-add-bag"
              id="pdp-main-add-btn"
              data-action="add-to-bag"
              data-id={product.id}
              data-name={product.name}
              data-brand={product.brand}
              data-size={product.sizeDisplay}
              data-concentration={product.concentration}
              data-price={product.priceMinor}
              data-image={product.image}
            >
              <span class="btn-text">Add to cart</span>
            </button>

            <!-- Wishlist Heart Button -->
            <button
              type="button"
              class="btn-pdp-fav"
              id="btn-pdp-fav"
              data-id={product.id}
              aria-label={`Save ${product.brand} ${product.name} to wishlist`}
              title="Save to Wishlist"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>

          <div class="pdp-micro-assurances">
            <details class="pdp-delivery-check">
              <summary>Check delivery</summary>
              <div class="pdp-delivery-fields">
                <label for="pdp-delivery-area">Delivery area</label>
                <select id="pdp-delivery-area">
                  <option value="">Select your area</option>
                  {QATAR_DELIVERY_AREAS.map(({ value, label }) => <option value={value}>{label}</option>)}
                  <option value="outside-qatar">Outside Qatar</option>
                </select>
                <output id="pdp-delivery-status" for="pdp-delivery-area">We’ll confirm the delivery fee and timing before finalizing your order.</output>
              </div>
            </details>
            <a href="/returns-refunds/">Returns & exchanges</a>
          </div>
          <a
            class="pdp-whatsapp-help"
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello LUMÈRA LUXE, I have a question about ${product.fullName}.`)}`}
            target="_blank"
            rel="noopener noreferrer"
          >Ask on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>

        <section class="pdp-composition-section" aria-labelledby="scent-profile-title">
          <h2 id="scent-profile-title">Scent profile</h2>
          <p class="pdp-description">{product.description}</p>
          <dl class="pdp-scent-details">
            {product.scentFamilies.length > 0 && (
              <div><dt>Scent families</dt><dd>{product.scentFamilies.join(' · ')}</dd></div>
            )}
            {product.keyNotes.length > 0 && (
              <div><dt>Key notes</dt><dd>{product.keyNotes.join(' · ')}</dd></div>
            )}
          </dl>
        </section>
      </div>
    </div>

    {activeLayeringPair && pairedProduct && (
      <section class="layering-card" aria-labelledby="layering-title">
        <div class="layering-intro">
          <h2 id="layering-title">Layer it with</h2>
          <p>{activeLayeringPair.description}</p>
          <a href={`/layering/#duet-${activeLayeringPair.id}`}>See how to layer this pair <span aria-hidden="true">↗</span></a>
        </div>
        <div class="layering-selection">
          <a class="layering-companion" href={`/perfumes/${pairedProduct.slug}/`}>
            <img src={pairedProduct.image} alt="" width="64" height="64" loading="lazy" decoding="async" />
            <span><small>{pairedProduct.brand}</small><strong>{pairedProduct.name}</strong></span>
            <span aria-hidden="true">↗</span>
          </a>
          <button
            type="button"
            class="btn-buy-duet"
            data-action="add-duet-to-bag"
            data-id-1={product.id}
            data-id-2={pairedProduct.id}
          >
            <span class="btn-duet-text">Add both to bag · {duetPriceTotal} QAR</span>
          </button>
        </div>
      </section>
    )}

    <!-- 7. SIMILAR FRAGRANCE RECOMMENDATIONS -->
    {similarProducts.length > 0 && (
      <section class="related-section" aria-label="Similar Fragrances">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">Similar fragrances</h2>
          <a href="/shop/" class="see-all-link">View all fragrances</a>
        </div>
        <div class="grid-products">
          {similarProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Quick purchase on smaller screens -->
  <aside class="pdp-sticky-bar" id="pdp-sticky-bar" aria-label="Quick Purchase Actions">
    <div class="pdp-sticky-inner">
      <div class="sticky-meta">
        <span class="sticky-title">{product.name}</span>
        <span class="sticky-price">{product.priceDisplay}</span>
      </div>
      <a href={checkoutHref} class="btn-pdp-buy-now">Buy now</a>
      <button
        type="button"
        class="btn-sticky-add-bag"
        id="btn-sticky-add-bag"
        data-action="add-to-bag"
        data-id={product.id}
        data-name={product.name}
        data-brand={product.brand}
        data-size={product.sizeDisplay}
        data-concentration={product.concentration}
        data-price={product.priceMinor}
        data-image={product.image}
      >
        <span class="btn-text">Add to cart</span>
      </button>
    </div>
  </aside>

  <dialog class="image-lightbox" id="image-lightbox" aria-labelledby="lightbox-caption">
    <form method="dialog">
      <button class="lightbox-close-btn" aria-label="Close image" autofocus>×</button>
    </form>
    <img src={product.image} alt={product.fullName} class="lightbox-img" width="600" height="600" loading="lazy" />
    <p class="lightbox-caption" id="lightbox-caption">{product.fullName} · {product.sizeDisplay}</p>
  </dialog>
</BaseLayout>

<style>
  .pdp-container {
    padding-top: clamp(.85rem, 2vw, 1.6rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .pdp-breadcrumb, .pdp-grid, .layering-card, .related-section {
    max-width: 76rem;
    margin-inline: auto;
  }

  .pdp-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem .6rem;
    margin-bottom: clamp(.9rem, 2vw, 1.6rem);
    color: var(--color-text-muted);
    font-size: .76rem;
    overflow-wrap: anywhere;
  }

  .pdp-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .pdp-breadcrumb a:hover {
    text-decoration: underline;
  }

  .pdp-breadcrumb .current {
    color: #38261f;
  }

  .pdp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.4rem, 4vw, 4.5rem);
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .pdp-media-frame {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: clamp(220px, 80vw, 440px);
    padding: clamp(.65rem, 2vw, 1.5rem);
    border: 1px solid #e7dbce;
    border-radius: .65rem;
    background: #fbf8f4;
    color: #38261f;
    cursor: zoom-in;
  }

  .pdp-main-image {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .pdp-zoom-icon {
    position: absolute;
    right: .7rem;
    bottom: .7rem;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #e7dbce;
    border-radius: 50%;
    background: #fff;
  }

  @media (min-width: 720px) {
    .pdp-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .pdp-media-frame {
      height: auto;
      aspect-ratio: 1;
    }
  }

  @media (min-width: 720px) and (min-height: 760px) {
    .pdp-media-wrap {
      position: sticky;
      top: 7.5rem;
    }
  }

  .pdp-info {
    min-width: 0;
    color: #38261f;
  }

  .pdp-brand {
    display: block;
    margin-bottom: .45rem;
    color: #784b34;
    font-size: .74rem;
    font-weight: 650;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .pdp-title {
    margin-bottom: .35rem;
    font: 400 clamp(2rem, 4vw, 3.5rem)/1.08 var(--font-display);
    letter-spacing: -.035em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .pdp-variant-details {
    color: var(--color-text-muted);
    font-size: .92rem;
  }

  .pdp-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .3rem .85rem;
    margin-block: .85rem 1rem;
  }

  .pdp-price {
    font-size: clamp(1.35rem, 2.3vw, 1.7rem);
    font-weight: 650;
  }

  .pdp-sticker-price {
    color: #6f6158;
    font-size: .9rem;
  }

  .pdp-draft-notice {
    padding: .8rem 1rem;
    margin-bottom: 1rem;
    border-left: 2px solid #784b34;
    background: #fbf8f4;
    color: #584a40;
    font-size: .85rem;
  }

  .pdp-draft-notice p {
    margin-bottom: 0;
  }

  .draft-tag {
    font-weight: 650;
  }

  .pdp-primary-action-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .72fr) 48px;
    gap: .45rem;
  }

  .btn-pdp-add-bag, .btn-pdp-buy-now, .btn-pdp-fav, .btn-buy-duet, .btn-sticky-add-bag {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: .45rem;
    min-height: 48px;
    padding: .55rem .45rem;
    border: 1px solid #cdbcae;
    border-radius: .4rem;
    background: transparent;
    color: #38261f;
    font: 650 .83rem/1.25 var(--font-body);
    text-decoration: none;
    text-align: center;
    cursor: pointer;
  }

  .btn-pdp-buy-now {
    background: #38261f;
    border-color: #38261f;
    color: #fff;
  }

  .btn-pdp-buy-now:hover {
    color: #fff;
    background: #593b2e;
    border-color: #593b2e;
  }

  .btn-pdp-add-bag:hover, .btn-sticky-add-bag:hover, .btn-pdp-fav:hover, .btn-buy-duet:hover {
    background: #f5eee7;
    border-color: #a6775b;
  }

  .btn-pdp-fav.is-active {
    color: #934e31;
    border-color: currentColor;
  }

  .btn-pdp-fav.is-active svg {
    fill: currentColor;
  }

  .pdp-micro-assurances {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .3rem 1rem;
    margin-top: .8rem;
    color: #665449;
    font-size: .79rem;
  }

  .pdp-micro-assurances a, .pdp-delivery-check summary, .layering-intro a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: .22em;
  }

  .pdp-delivery-check[open] {
    flex-basis: 100%;
  }

  .pdp-delivery-check summary {
    cursor: pointer;
  }

  .pdp-delivery-fields {
    display: grid;
    gap: .4rem;
    margin-top: .5rem;
    padding: .8rem;
    border: 1px solid #e7dbce;
    border-radius: .5rem;
    background: var(--color-surface);
    font-size: .875rem;
  }

  .pdp-delivery-fields select {
    width: 100%;
    min-height: 44px;
    padding: .4rem .65rem;
    border: 1px solid #cdbcae;
    border-radius: .3rem;
    background: #fff;
    color: var(--color-text-main);
  }

  .pdp-whatsapp-help {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 44px;
    color: #16604a;
    font-size: .83rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: .22em;
  }

  @media (min-width: 768px) {
    .pdp-whatsapp-help {
      display: none;
    }
  }

  .pdp-composition-section {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: 1.15rem;
    border-top: 1px solid #e7dbce;
  }

  .pdp-composition-section h2, .layering-card h2, .related-section .section-title-minimal {
    margin-bottom: .6rem;
    color: #38261f;
    font: 400 clamp(1.45rem, 2.4vw, 2rem)/1.16 var(--font-display);
    letter-spacing: -.025em;
    text-transform: none;
  }

  .pdp-description, .layering-intro p {
    max-width: 62ch;
    color: #584a40;
    font-size: .94rem;
    line-height: 1.65;
  }

  .pdp-scent-details {
    display: grid;
    gap: .65rem;
    margin: .95rem 0 0;
    font-size: .85rem;
  }

  .pdp-scent-details dt {
    font-weight: 650;
  }

  .pdp-scent-details dd {
    margin: .15rem 0 0;
    color: #665449;
  }

  .layering-card {
    display: grid;
    gap: 1rem clamp(1rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1rem, 3vw, 2rem);
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border: 1px solid #e7dbce;
    border-radius: .65rem;
    background: #fbf8f4;
  }

  .layering-intro a {
    color: #694b3a;
    font-size: .83rem;
  }

  .layering-selection {
    display: grid;
    gap: .6rem;
    min-width: 0;
  }

  .layering-companion {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: .65rem;
    align-items: center;
    color: #38261f;
    text-decoration: none;
  }

  .layering-companion:hover strong {
    text-decoration: underline;
  }

  .layering-companion img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    border-radius: .3rem;
    background: #fff;
  }

  .layering-companion small, .layering-companion strong {
    display: block;
    overflow-wrap: anywhere;
  }

  .layering-companion small {
    color: #665449;
  }

  .btn-buy-duet.added-success {
    background: #38261f;
    color: #fff;
  }

  .related-section .section-header-minimal {
    align-items: baseline;
    gap: .75rem;
    margin-bottom: 1rem;
  }

  .related-section .section-title-minimal {
    margin-bottom: 0;
  }

  .related-section .see-all-link {
    color: #694b3a;
    font-size: .75rem;
    letter-spacing: 0;
    text-align: right;
    text-transform: none;
  }

  @media (min-width: 680px) {
    .layering-card {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }

    .related-section .grid-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pdp-sticky-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 85;
    padding: .55rem 1rem calc(.55rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid #e7dbce;
    background: #fff;
    visibility: hidden;
    opacity: 0;
    transform: translateY(100%);
    transition: transform 220ms ease, opacity 180ms ease;
  }

  .pdp-sticky-bar.is-visible {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 720px) {
    .pdp-sticky-bar {
      display: none;
    }
  }

  .pdp-sticky-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(78px, .7fr) minmax(92px, .7fr);
    align-items: center;
    gap: .4rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  .sticky-title, .sticky-price {
    display: block;
    font-size: .8rem;
  }

  .sticky-title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .sticky-price {
    font-weight: 650;
  }

  .image-lightbox {
    position: fixed;
    inset: 0;
    width: min(calc(100% - 2rem), 42rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1rem;
    border: 1px solid #e7dbce;
    border-radius: .65rem;
    background: #fff;
    color: #38261f;
  }

  .image-lightbox::backdrop {
    background: rgb(35 23 18 / .76);
  }

  .lightbox-close-btn {
    position: absolute;
    top: .6rem;
    right: .6rem;
    width: 44px;
    height: 44px;
    border: 1px solid #e7dbce;
    border-radius: 50%;
    background: #fbf8f4;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .lightbox-img {
    display: block;
    width: 100%;
    height: min(65dvh, 36rem);
    object-fit: contain;
  }

  .lightbox-caption {
    margin: .5rem 0 0;
    text-align: center;
    font-size: .9rem;
  }
  @media (min-width: 768px) {
    .pdp-breadcrumb,
    .pdp-brand {
      font-size: .875rem;
    }

    .btn-pdp-add-bag,
    .btn-pdp-buy-now,
    .btn-buy-duet,
    .pdp-micro-assurances,
    .layering-intro a,
    .related-section .see-all-link {
      font-size: .9375rem;
    }

    .pdp-variant-details,
    .pdp-description,
    .pdp-scent-details,
    .pdp-delivery-fields,
    .layering-intro p {
      font-size: 1rem;
    }
  }
</style>

<script>
  import { isFavorite, toggleFavorite } from '../../lib/favorites';

  document.addEventListener('astro:page-load', () => {
    const mainButton = document.getElementById('pdp-main-add-btn');
    const favorite = document.getElementById('btn-pdp-fav');
    const stickyBar = document.getElementById('pdp-sticky-bar');
    const media = document.getElementById('pdp-media-frame');
    const lightbox = document.querySelector<HTMLDialogElement>('#image-lightbox');
    if (!mainButton || !favorite || !stickyBar || !media || !lightbox || mainButton.dataset.ready) return;
    mainButton.dataset.ready = 'true';

    const controller = new AbortController();
    const { signal } = controller;
    const deliveryArea = document.querySelector<HTMLSelectElement>('#pdp-delivery-area');
    const deliveryStatus = document.querySelector<HTMLOutputElement>('#pdp-delivery-status');
    if (deliveryArea && deliveryStatus) {
      const confirmationNote = deliveryStatus.defaultValue;
      const updateDeliveryStatus = () => {
        if (deliveryArea.value === 'outside-qatar') {
          deliveryStatus.value = 'We currently deliver within Qatar only.';
        } else if (deliveryArea.value) {
          deliveryStatus.value = `Delivery is available in your area. ${confirmationNote}`;
        } else {
          deliveryStatus.value = confirmationNote;
        }
      };
      deliveryArea.addEventListener('change', updateDeliveryStatus, { signal });
      updateDeliveryStatus();
    }

    const productId = favorite.dataset.id;
    const syncFavorite = () => {
      if (!productId) return;
      const saved = isFavorite(productId);
      favorite.classList.toggle('is-active', saved);
      favorite.setAttribute('aria-pressed', String(saved));
    };

    favorite.addEventListener('click', () => {
      if (productId) toggleFavorite(productId);
      syncFavorite();
    }, { signal });
    window.addEventListener('favorites-updated', syncFavorite, { signal });
    window.addEventListener('storage', syncFavorite, { signal });
    syncFavorite();

    const header = document.querySelector('header');
    const footer = document.querySelector('footer');
    const actionBlock = mainButton.closest('.pdp-action-block') ?? mainButton;
    const syncStickyBar = () => {
      const headerBottom = header?.getBoundingClientRect().bottom ?? 0;
      const pastActions = actionBlock.getBoundingClientRect().bottom <= headerBottom;
      const beforeFooter = (footer?.getBoundingClientRect().top ?? Infinity) > window.innerHeight + 20;
      stickyBar.classList.toggle('is-visible', pastActions && beforeFooter);
    };

    window.addEventListener('scroll', syncStickyBar, { passive: true, signal });
    window.addEventListener('resize', syncStickyBar, { passive: true, signal });
    syncStickyBar();

    media.addEventListener('click', () => lightbox.showModal(), { signal });
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    }, { signal });

    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
  });
</script>
