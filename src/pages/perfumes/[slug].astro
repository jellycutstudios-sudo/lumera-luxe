---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
import { siteConfig } from '../../data/site';

export async function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

// Find 3-4 related products sharing brand or scent families
const relatedProducts = productsData
  .filter(
    (p) =>
      p.id !== product.id &&
      (p.brand === product.brand ||
        p.scentFamilies.some((f) => product.scentFamilies.includes(f)))
  )
  .slice(0, 4);

// Schema.org Product structured data
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.fullName,
  image: `https://lumeraluxe.qa${product.image}`,
  description: product.description,
  brand: {
    '@type': 'Brand',
    name: product.brand
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: product.currency,
    price: (product.priceMinor / 100).toFixed(0),
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: siteConfig.brandName
    }
  }
};
---

<BaseLayout
  title={`${product.fullName} · ${product.sizeDisplay} — LUMÈRA LUXE`}
  description={product.description}
  image={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <article class="pdp-container container">
    <!-- Minimalist Haute Breadcrumb -->
    <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/shop/">Collection</a>
      <span class="sep">/</span>
      <a href={`/shop/?brand=${encodeURIComponent(product.brand)}`}>{product.brand}</a>
      <span class="sep">/</span>
      <span class="current" aria-current="page">{product.name}</span>
    </nav>

    <div class="pdp-grid">
      <!-- Media Stage with Magnifier -->
      <div class="pdp-media-wrap">
        <div class="pdp-media-frame" id="pdp-media-frame" title="Click to view full bottle photograph">
          <img
            src={product.image}
            alt={`${product.fullName} luxury perfume bottle`}
            class="pdp-main-image"
            width="600"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            id="pdp-image"
          />

          <!-- Authentic Batch Micro-Seal -->
          <div class="pdp-seal-pill">
            <span class="seal-dot"></span>
            <span>Sealed European Stock</span>
          </div>
        </div>
      </div>

      <!-- Product Information Tier -->
      <div class="pdp-info">
        <!-- Identity Tier -->
        <div class="pdp-header-block">
          <span class="pdp-brand">{product.brand}</span>
          <h1 class="pdp-title">{product.name}</h1>
          <p class="pdp-variant-details">{product.concentration} · {product.sizeDisplay}</p>
        </div>

        <!-- Luxury Price & Privilege Bar -->
        <div class="pdp-price-row">
          <div class="price-figures">
            <span class="pdp-price">{product.priceDisplay}</span>
            {product.stickerPriceMinor > product.priceMinor && (
              <span class="pdp-sticker-price">{(product.stickerPriceMinor / 100).toFixed(0)} QAR</span>
            )}
          </div>
          <div class="pdp-curation-badge">
            <span>Complimentary Qatar Delivery</span>
          </div>
        </div>

        <!-- Sensory Description -->
        <p class="pdp-description">{product.description}</p>

        {product.isDraft && (
          <div class="pdp-draft-notice">
            <span class="draft-tag">Review Candidate · Availability Verification</span>
            <p>This formulation is currently undergoing distributor batch verification. Please verify live availability with our WhatsApp concierge before dispatch.</p>
          </div>
        )}

        <!-- STREAMLINED LUXURY ACTION BLOCK -->
        <div class="pdp-action-block" id="pdp-cta-trigger">
          <!-- Primary CTA: High-Impact Full-Width Add to Bag -->
          <button
            type="button"
            class="btn-pdp-primary-add"
            id="pdp-main-add-btn"
            data-action="add-to-bag"
            data-id={product.id}
            data-name={product.name}
            data-brand={product.brand}
            data-size={product.sizeDisplay}
            data-concentration={product.concentration}
            data-price={product.priceMinor}
            data-image={product.image}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>Add to Bag · {product.priceDisplay}</span>
          </button>

          <!-- Secondary Row: WhatsApp Concierge + Wishlist -->
          <div class="pdp-secondary-action-row">
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello LUMÈRA LUXE, I would like to order or inquire about ${product.fullName} (${product.sizeDisplay}, ${product.priceDisplay}).`)}`}
              class="btn-pdp-whatsapp"
              id="pdp-whatsapp-btn"
              target="_blank"
              rel="noopener"
              aria-label="Order or inquire on WhatsApp"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
              </svg>
              <span>Order via WhatsApp</span>
            </a>

            <!-- Wishlist Heart Button -->
            <button
              type="button"
              class="btn-pdp-fav"
              id="btn-pdp-fav"
              data-id={product.id}
              aria-label={`Save ${product.brand} ${product.name} to wishlist`}
              title="Save to Wishlist"
            >
              <svg class="pdp-heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>

          <!-- Micro Assurance Strip -->
          <div class="pdp-micro-assurances">
            <span>✓ Sealed European Stock</span>
            <span class="micro-sep">·</span>
            <span>Complimentary Qatar Delivery</span>
            <span class="micro-sep">·</span>
            <span>Cash or Card on Delivery</span>
          </div>
        </div>

        <!-- Olfactory Composition (Clean Note Chips) -->
        <section class="pdp-composition-section">
          <div class="composition-header">
            <h2 class="composition-title">Olfactory Composition</h2>
            <span class="composition-kicker">Haute Parfumerie</span>
          </div>

          <div class="composition-families">
            <span class="family-label">Scent Families:</span>
            <div class="family-pills">
              {product.scentFamilies.map((fam) => (
                <span class="family-tag">{fam}</span>
              ))}
            </div>
          </div>

          <div class="composition-notes-block">
            <span class="notes-heading">Prominent Notes:</span>
            <ul class="notes-cloud">
              {product.keyNotes.map((note) => (
                <li class="note-chip">
                  <span class="note-pip"></span>
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>
    </div>

    <!-- Related Fragrances -->
    {relatedProducts.length > 0 && (
      <section class="related-section">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">You May Also Appreciate</h2>
          <a href="/shop/" class="see-all-link">View Collection</a>
        </div>
        <div class="grid-products">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Mobile Floating Sticky Dual-Action Bar -->
  <aside class="pdp-sticky-bar" id="pdp-sticky-bar" aria-label="Quick Purchase Actions">
    <div class="pdp-sticky-inner">
      <div class="sticky-thumb-info">
        <img src={product.image} alt={product.name} class="sticky-thumb-img" width="40" height="40" />
        <div class="sticky-meta">
          <span class="sticky-title">{product.name}</span>
          <span class="sticky-price" id="pdp-sticky-amount">{product.priceDisplay}</span>
        </div>
      </div>

      <div class="sticky-actions-wrap">
        <button
          type="button"
          class="btn-sticky-fav"
          id="btn-sticky-fav"
          data-id={product.id}
          aria-label="Save to Wishlist"
          title="Save to Wishlist"
        >
          <svg class="sticky-heart-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>

        <button
          type="button"
          class="btn-sticky-add-bag"
          id="btn-sticky-add-bag"
          data-action="add-to-bag"
          data-id={product.id}
          data-name={product.name}
          data-brand={product.brand}
          data-size={product.sizeDisplay}
          data-concentration={product.concentration}
          data-price={product.priceMinor}
          data-image={product.image}
          aria-label="Add to Bag"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span>Add to Bag</span>
        </button>
      </div>
    </div>
  </aside>

  <!-- Image Lightbox Modal -->
  <div class="image-lightbox-backdrop" id="image-lightbox" hidden>
    <div class="image-lightbox-content">
      <button class="lightbox-close-btn" id="lightbox-close" aria-label="Close zoom view">✕</button>
      <img src={product.image} alt={product.fullName} class="lightbox-img" />
      <span class="lightbox-caption">{product.fullName} · {product.sizeDisplay}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .pdp-container {
    padding-top: clamp(1rem, 2.5vw, 1.75rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
  }

  /* Breadcrumb */
  .pdp-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .pdp-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .pdp-breadcrumb a:hover {
    color: var(--color-text-main);
  }

  .pdp-breadcrumb .sep {
    color: var(--color-border);
  }

  .pdp-breadcrumb .current {
    color: var(--color-text-main);
    font-weight: 500;
  }

  /* PDP Grid */
  .pdp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  @media (min-width: 860px) {
    .pdp-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 4.5rem;
    }
  }

  /* Media Frame */
  .pdp-media-wrap {
    position: relative;
  }

  @media (min-width: 860px) {
    .pdp-media-wrap {
      position: sticky;
      top: 90px;
    }
  }

  .pdp-media-frame {
    position: relative;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 2rem);
    cursor: zoom-in;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }

  .pdp-zoom-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid #ECEAE5;
    padding: 0.4rem 0.75rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
    z-index: 2;
    transition: all var(--transition-fast);
  }

  .pdp-zoom-btn:hover {
    background-color: var(--color-text-main);
    color: #FFFFFF;
  }

  .pdp-seal-pill {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid #ECEAE5;
    padding: 0.35rem 0.65rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-muted);
  }

  .seal-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .pdp-main-image {
    width: 100%;
    height: 100%;
    max-width: 95%;
    max-height: 95%;
    object-fit: contain;
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pdp-media-frame:hover .pdp-main-image {
    transform: scale(1.035);
  }

  /* Product Info */
  .pdp-info {
    display: flex;
    flex-direction: column;
  }

  .pdp-header-block {
    margin-bottom: 1.25rem;
  }

  .pdp-brand {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.35rem;
  }

  .pdp-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.015em;
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
  }

  .pdp-variant-details {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Luxury Price Row */
  .pdp-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .price-figures {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .pdp-price {
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .pdp-sticker-price {
    font-size: 1rem;
    color: var(--color-text-light);
    text-decoration: line-through;
  }

  .pdp-curation-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    padding: 0.25rem 0.6rem;
    border-radius: var(--border-radius-sm);
  }

  /* Olfactory Specs Strip */
  .pdp-specs-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    background-color: #FAF9F6;
    margin-bottom: 1.5rem;
  }

  .spec-cell {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 0.85rem;
    gap: 0.15rem;
  }

  .spec-cell:not(:last-child) {
    border-right: 1px solid #ECEAE5;
  }

  .spec-title {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
  }

  .spec-value {
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Description */
  .pdp-description {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  /* Draft Candidate Availability Notice */
  .pdp-draft-notice {
    background-color: #FAF8F5;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand-cognac);
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }

  .draft-tag {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-brand-cognac);
    margin-bottom: 0.25rem;
  }

  .pdp-draft-notice p {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Action Block (Dual Luxury Action) */
  .pdp-action-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    margin-bottom: 2.25rem;
  }

  .pdp-primary-action-row {
    display: flex;
    gap: 0.65rem;
    align-items: stretch;
  }

  /* Primary Action Button: High-Impact Full-Width Add to Bag */
  .btn-pdp-primary-add {
    width: 100%;
    min-height: 52px;
    padding: 0.9rem 1.5rem;
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: none;
    border-radius: var(--border-radius-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    transition: all var(--transition-fast);
  }

  .btn-pdp-primary-add:hover {
    background-color: #000000;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }

  .btn-pdp-primary-add:active {
    transform: scale(0.985);
  }

  /* Secondary Row (Row 3 - WhatsApp + Wishlist + Share) */
  .pdp-secondary-action-row {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .btn-pdp-whatsapp {
    flex: 1;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-main);
    background-color: #FAF9F6;
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .btn-pdp-whatsapp svg {
    color: #25D366;
  }

  .btn-pdp-whatsapp:hover {
    border-color: #25D366;
    background-color: #FFFFFF;
    box-shadow: 0 2px 10px rgba(37, 211, 102, 0.12);
  }

  .btn-pdp-fav {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background-color: #FAF9F6;
    color: var(--color-text-main);
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .btn-pdp-fav:hover {
    border-color: var(--color-brand-cognac);
    color: var(--color-brand-cognac);
    transform: scale(1.05);
  }

  .btn-pdp-fav.is-active {
    color: var(--color-brand-cognac);
    border-color: rgba(200, 90, 36, 0.4);
    background-color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(200, 90, 36, 0.2);
  }

  .btn-pdp-fav.is-active .pdp-heart-icon {
    fill: var(--color-brand-cognac);
    stroke: var(--color-brand-cognac);
  }

  .pdp-micro-assurances {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    padding-top: 0.5rem;
