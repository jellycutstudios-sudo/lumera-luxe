---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
import { siteConfig } from '../../data/site';

export async function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

// Find 3-4 related products sharing brand or scent families
const relatedProducts = productsData
  .filter(
    (p) =>
      p.id !== product.id &&
      (p.brand === product.brand ||
        p.scentFamilies.some((f) => product.scentFamilies.includes(f)))
  )
  .slice(0, 4);

// Schema.org Product structured data
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.fullName,
  image: `https://lumeraluxe.qa${product.image}`,
  description: product.description,
  brand: {
    '@type': 'Brand',
    name: product.brand
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: product.currency,
    price: (product.priceMinor / 100).toFixed(0),
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: siteConfig.brandName
    }
  }
};
---

<BaseLayout
  title={`${product.fullName} · ${product.sizeDisplay} — LUMÈRA LUXE`}
  description={product.description}
  image={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <article class="pdp-container container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href="/shop/">Collection</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href={`/shop/?brand=${encodeURIComponent(product.brand)}`}>{product.brand}</a></li>
        <li class="breadcrumb-separator">/</li>
        <li aria-current="page">{product.name}</li>
      </ol>
    </nav>

    <div class="pdp-grid">
      <!-- Media Gallery with Zoom -->
      <div class="pdp-media-wrap">
        <div class="pdp-media-frame" id="pdp-media-frame" title="Click to view full bottle artwork">
          <button class="zoom-indicator-btn" id="btn-zoom-image" aria-label="Enlarge perfume photograph">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            <span>Enlarge View</span>
          </button>
          <img
            src={product.image}
            alt={`${product.fullName} bottle photograph`}
            class="pdp-main-image"
            width="500"
            height="625"
            loading="eager"
            id="pdp-image"
          />
        </div>
      </div>

      <!-- Product Information -->
      <div class="pdp-info">
        <span class="pdp-brand">{product.brand}</span>
        <h1 class="pdp-title">{product.name}</h1>
        <p class="pdp-variant-details">{product.sizeDisplay} · {product.concentration}</p>

        <div class="pdp-price-wrap">
          <span class="pdp-price">{product.priceDisplay}</span>
          <span class="pdp-availability-badge">
            <span class="status-dot"></span>
            Availability confirmed on WhatsApp
          </span>
        </div>

        <p class="pdp-description">{product.description}</p>

        <!-- Luxury Action Block (Airy, Uncongested Byredo Aesthetic) -->
        <div class="pdp-action-block" id="pdp-cta-trigger">
          <div class="pdp-action-primary-row">
            <!-- Quantity Selector -->
            <div class="pdp-qty-wrapper">
              <button type="button" class="pdp-qty-btn" id="pdp-qty-dec" aria-label="Decrease quantity">−</button>
              <span class="pdp-qty-display" id="pdp-qty-val">1</span>
              <button type="button" class="pdp-qty-btn" id="pdp-qty-inc" aria-label="Increase quantity">+</button>
            </div>

            <!-- BUY NOW (Primary CTA -> Goes directly to /checkout/) -->
            <a
              href={`/checkout/?product=${product.slug}&qty=1`}
              class="btn-buy-now-main"
              id="btn-pdp-buy-now"
              data-slug={product.slug}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>BUY NOW — <span id="pdp-btn-amount">{product.priceDisplay}</span></span>
            </a>
          </div>

          <!-- ADD TO BAG (Secondary CTA) -->
          <button
            type="button"
            class="btn-add-bag-secondary"
            id="pdp-main-add-btn"
            data-action="add-to-bag"
            data-id={product.id}
            data-name={product.name}
            data-brand={product.brand}
            data-size={product.sizeDisplay}
            data-concentration={product.concentration}
            data-price={product.priceMinor}
            data-image={product.image}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>Add to Bag</span>
          </button>

          <!-- Delivery Badge Note -->
          <div class="pdp-delivery-badge-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Complimentary Qatar Delivery · Pay via Cash or Card on Arrival</span>
          </div>

          <div class="pdp-secondary-actions">
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello LUMÈRA LUXE, I am interested in inquiring about ${product.fullName} (${product.sizeDisplay}, ${product.concentration}).`)}`}
              class="btn-inquire-link"
              target="_blank"
              rel="noopener"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
              </svg>
              <span>Inquire with Boutique Concierge</span>
            </a>

            <button type="button" class="btn-share-wa" id="btn-share-fragrance" title="Share with friends">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span>Share</span>
            </button>
          </div>
        </div>

        <!-- Scent Profile Details (Below Action Block) -->
        <div class="pdp-notes-box">
          <h2 class="pdp-notes-title">Fragrance Profile</h2>
          
          <div class="pdp-family-tags">
            {product.scentFamilies.map((fam) => (
              <span class="badge badge-accent">{fam}</span>
            ))}
          </div>

          <div class="pdp-key-notes">
            <span class="key-notes-label">Prominent Notes:</span>
            <ul class="key-notes-list">
              {product.keyNotes.map((note) => (
                <li class="note-pill">{note}</li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Client Guarantees -->
        <div class="pdp-assurances">
          <div class="assurance-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>100% Guaranteed Genuine & Verified Quality</span>
          </div>
          <div class="assurance-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Doha & Qatar Doorstep Delivery</span>
          </div>
          <div class="assurance-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Personal advice & payment confirmation via WhatsApp</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Fragrances -->
    {relatedProducts.length > 0 && (
      <section class="related-section">
        <div class="section-header">
          <div>
            <span class="section-eyebrow">Olfactory Harmonies</span>
            <h2 class="section-heading">You May Also Appreciate</h2>
          </div>
        </div>
        <div class="grid-products">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Mobile Sticky Buy Now Bar -->
  <div class="mobile-sticky-bar" id="mobile-sticky-bar" hidden>
    <div class="mobile-sticky-inner">
      <div class="mobile-sticky-info">
        <span class="mobile-sticky-name">{product.name}</span>
        <span class="mobile-sticky-price">{product.priceDisplay}</span>
      </div>
      <a
        href={`/checkout/?product=${product.slug}&qty=1`}
        class="btn-sticky-buy-now"
        id="btn-sticky-buy-now"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
        </svg>
        <span>BUY NOW</span>
      </a>
    </div>
  </div>
  <!-- Image Lightbox Modal -->
  <div class="image-lightbox-backdrop" id="image-lightbox" hidden>
    <div class="image-lightbox-content">
      <button class="lightbox-close-btn" id="lightbox-close" aria-label="Close zoom view">✕</button>
      <img src={product.image} alt={product.fullName} class="lightbox-img" />
      <span class="lightbox-caption">{product.fullName} · {product.sizeDisplay}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .pdp-container {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb-separator {
    color: var(--color-border);
  }

  .breadcrumb-list a:hover {
    color: var(--color-accent);
  }

  .pdp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 5rem;
  }

  @media (min-width: 860px) {
    .pdp-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 4rem;
    }
  }

  /* Media Frame */
  .pdp-media-wrap {
    position: relative;
  }

  @media (min-width: 860px) {
    .pdp-media-wrap {
      position: sticky;
      top: 96px;
    }
  }

  .pdp-media-frame {
    position: relative;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    cursor: zoom-in;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }

  .zoom-indicator-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.65rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
    z-index: 2;
    transition: all var(--transition-fast);
  }

  .zoom-indicator-btn:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }

  .pdp-main-image {
    width: 100%;
    height: 100%;
    max-width: 92%;
    max-height: 92%;
    object-fit: contain;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pdp-main-image:hover {
    transform: scale(1.035);
  }

  /* Product Info */
  .pdp-info {
    display: flex;
    flex-direction: column;
  }

  .pdp-brand {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .pdp-title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .pdp-variant-details {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .pdp-price-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.75rem;
  }

  .pdp-price {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .pdp-availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    padding: 0.35rem 0.65rem;
    border-radius: var(--border-radius-sm);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #25D366;
  }

  .pdp-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  /* Notes Box */
  .pdp-notes-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .pdp-notes-title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    margin-bottom: 1rem;
  }

  .pdp-family-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .key-notes-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .key-notes-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .note-pill {
    font-size: 0.8125rem;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
  }

  /* Luxury Action Block */
  .pdp-action-block {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 2.25rem;
  }

  .pdp-action-primary-row {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
  }

  .pdp-qty-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background-color: #FFFFFF;
    padding: 0 0.25rem;
  }

  .pdp-qty-btn {
    width: 38px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--color-text-main);
    cursor: pointer;
  }

  .pdp-qty-btn:hover {
    color: var(--color-accent);
  }

  .pdp-qty-display {
    min-width: 34px;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
  }

  /* Primary Buy Now Button */
  .btn-buy-now-main {
    flex: 1;
    min-height: 52px;
    padding: 0.875rem 1.5rem;
    background-color: var(--color-text-main);
    color: #FFFFFF;
    text-decoration: none;
    border: 1px solid var(--color-text-main);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    transition: all var(--transition-fast);
  }

  .btn-buy-now-main:hover {
    background-color: #000000;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }

  /* Secondary Add to Bag Button */
  .btn-add-bag-secondary {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1.5rem;
    background-color: #FFFFFF;
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-add-bag-secondary:hover {
    border-color: var(--color-text-main);
    background-color: var(--color-surface);
  }

  .pdp-delivery-badge-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding: 0.5rem 0.25rem 0;
  }

  .pdp-delivery-badge-note svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .pdp-secondary-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-inquire-link {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: 0.78125rem;
    font-weight: 500;
    color: var(--color-text-main);
    background-color: #FFFFFF;
    transition: all var(--transition-fast);
  }

  .btn-inquire-link svg {
    color: #25D366;
  }

  .btn-inquire-link:hover {
    border-color: #25D366;
    color: #25D366;
  }

  .btn-share-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: 0.78125rem;
    font-weight: 500;
    background-color: #FFFFFF;
    color: var(--color-text-main);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .btn-share-wa:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Assurances */
  .pdp-assurances {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .assurance-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .assurance-item svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Related Section */
  .related-section {
    padding-top: 4rem;
    border-top: 1px solid var(--color-border);
  }

  /* Mobile Sticky Bar */
  .mobile-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
  }

  @media (min-width: 860px) {
    .mobile-sticky-bar {
      display: none !important;
    }
  }

  .mobile-sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mobile-sticky-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .mobile-sticky-name {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mobile-sticky-price {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .btn-sticky-buy-now {
    min-height: 42px;
    padding: 0.5rem 1.25rem;
    background-color: #25D366;
    color: #FFFFFF;
    text-decoration: none;
    border: none;
    border-radius: var(--border-radius-sm);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(37, 211, 102, 0.3);
  }

  /* Lightbox */
  .image-lightbox-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(37, 33, 30, 0.85);
    backdrop-filter: blur(8px);
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: fadeIn 200ms ease;
  }

  .image-lightbox-content {
    position: relative;
    max-width: 600px;
    width: 100%;
    background-color: #FFFFFF;
    border-radius: var(--border-radius-md);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
  }

  .lightbox-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-surface);
    color: var(--color-text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    margin-bottom: 1.5rem;
  }

  .lightbox-caption {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text-main);
  }
</style>

<script>
  // Mobile sticky bar observer
  const trigger = document.getElementById('pdp-cta-trigger');
  const stickyBar = document.getElementById('mobile-sticky-bar');

  if (trigger && stickyBar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          stickyBar.hidden = entry.isIntersecting;
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(trigger);
  }

  // Quantity handling
  let currentQty = 1;
  const qtyValEl = document.getElementById('pdp-qty-val');
  const qtyDecBtn = document.getElementById('pdp-qty-dec');
  const qtyIncBtn = document.getElementById('pdp-qty-inc');
  const btnAmountEl = document.getElementById('pdp-btn-amount');
  const buyNowBtn = document.getElementById('btn-pdp-buy-now');
  const stickyBuyBtn = document.getElementById('btn-sticky-buy-now');
  const pdpAddBtn = document.getElementById('pdp-main-add-btn');

  const productSlug = buyNowBtn?.getAttribute('data-slug') || '';
  const unitPriceMinor = pdpAddBtn ? Number(pdpAddBtn.getAttribute('data-price') || 0) : 0;

  function updatePrices() {
    if (qtyValEl) qtyValEl.textContent = String(currentQty);
    const totalMinor = unitPriceMinor * currentQty;
    const formatted = `${(totalMinor / 100).toFixed(0)} QAR`;
    if (btnAmountEl) btnAmountEl.textContent = formatted;
    const checkoutUrl = `/checkout/?product=${encodeURIComponent(productSlug)}&qty=${currentQty}`;
    if (buyNowBtn) buyNowBtn.setAttribute('href', checkoutUrl);
    if (stickyBuyBtn) stickyBuyBtn.setAttribute('href', checkoutUrl);
  }

  qtyDecBtn?.addEventListener('click', () => {
    if (currentQty > 1) {
      currentQty--;
      updatePrices();
    }
  });

  qtyIncBtn?.addEventListener('click', () => {
    if (currentQty < 10) {
      currentQty++;
      updatePrices();
    }
  });

  // Direct Buy Now -> Navigate straight to /checkout/
  function goToCheckout() {
    if (!productSlug) return;
    window.location.href = `/checkout/?product=${encodeURIComponent(productSlug)}&qty=${currentQty}`;
  }

  buyNowBtn?.addEventListener('click', goToCheckout);
  stickyBuyBtn?.addEventListener('click', goToCheckout);

  // Add to Bag from PDP
  pdpAddBtn?.addEventListener('click', () => {
    const id = pdpAddBtn.getAttribute('data-id');
    if (!id) return;
    try {
      const data = localStorage.getItem('lumera_bag_v1');
      const items: { id: string; quantity: number }[] = data ? JSON.parse(data) : [];
      const existing = items.find((it) => it.id === id);
      if (existing) {
        existing.quantity += (currentQty - 1);
      } else {
        setTimeout(() => {
          const updated = JSON.parse(localStorage.getItem('lumera_bag_v1') || '[]');
          const it = updated.find((x: any) => x.id === id);
          if (it) {
            it.quantity = currentQty;
            localStorage.setItem('lumera_bag_v1', JSON.stringify(updated));
            window.dispatchEvent(new Event('storage'));
          }
        }, 10);
      }
    } catch (e) {
      console.error(e);
    }
  });

  // Lightbox Zoom logic
  const mediaFrame = document.getElementById('pdp-media-frame');
  const lightbox = document.getElementById('image-lightbox');
  const lightboxClose = document.getElementById('lightbox-close');

  mediaFrame?.addEventListener('click', () => {
    if (lightbox) {
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }
  });

  lightboxClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightbox) {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
  });

  // WhatsApp Share Button
  const shareBtn = document.getElementById('btn-share-fragrance');
  shareBtn?.addEventListener('click', () => {
    const text = `Look at this luxury fragrance on LUMÈRA LUXE: ${document.title} - ${window.location.href}`;
    if (navigator.share) {
      navigator.share({ title: document.title, url: window.location.href, text }).catch(() => {});
    } else {
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    }
  });
</script>

