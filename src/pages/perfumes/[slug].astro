---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
import { siteConfig } from '../../data/site';

export async function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

// Find 3-4 related products sharing brand or scent families
const relatedProducts = productsData
  .filter(
    (p) =>
      p.id !== product.id &&
      (p.brand === product.brand ||
        p.scentFamilies.some((f) => product.scentFamilies.includes(f)))
  )
  .slice(0, 4);

// Schema.org Product structured data
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.fullName,
  image: `https://lumeraluxe.qa${product.image}`,
  description: product.description,
  brand: {
    '@type': 'Brand',
    name: product.brand
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: product.currency,
    price: (product.priceMinor / 100).toFixed(0),
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: siteConfig.brandName
    }
  }
};
---

<BaseLayout
  title={`${product.fullName} · ${product.sizeDisplay} — LUMÈRA LUXE`}
  description={product.description}
  image={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <article class="pdp-container container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href="/shop/">Collection</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href={`/shop/?brand=${encodeURIComponent(product.brand)}`}>{product.brand}</a></li>
        <li class="breadcrumb-separator">/</li>
        <li aria-current="page">{product.name}</li>
      </ol>
    </nav>

    <div class="pdp-grid">
      <!-- Media Gallery with Zoom -->
      <div class="pdp-media-wrap">
        <div class="pdp-media-frame" id="pdp-media-frame" title="Click to view full bottle artwork">
          <button class="zoom-indicator-btn" id="btn-zoom-image" aria-label="Enlarge perfume photograph">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            <span>Enlarge View</span>
          </button>
          <img
            src={product.image}
            alt={`${product.fullName} bottle photograph`}
            class="pdp-main-image"
            width="500"
            height="625"
            loading="eager"
            id="pdp-image"
          />
        </div>
      </div>

      <!-- Product Information -->
      <div class="pdp-info">
        <span class="pdp-brand">{product.brand}</span>
        <h1 class="pdp-title">{product.name}</h1>
        <p class="pdp-variant-details">{product.sizeDisplay} · {product.concentration}</p>

        <div class="pdp-price-wrap">
          <span class="pdp-price">{product.priceDisplay}</span>
          <span class="pdp-availability-badge">
            <span class="status-dot"></span>
            Availability confirmed on WhatsApp
          </span>
        </div>

        <p class="pdp-description">{product.description}</p>

        <!-- Scent Profile Details -->
        <div class="pdp-notes-box">
          <h2 class="pdp-notes-title">Fragrance Profile</h2>
          
          <div class="pdp-family-tags">
            {product.scentFamilies.map((fam) => (
              <span class="badge badge-accent">{fam}</span>
            ))}
          </div>

          <div class="pdp-key-notes">
            <span class="key-notes-label">Prominent Notes:</span>
            <ul class="key-notes-list">
              {product.keyNotes.map((note) => (
                <li class="note-pill">{note}</li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Express Direct Order & Delivery Address Section -->
        <div class="pdp-buy-now-card" id="pdp-buy-now-card">
          <div class="buy-now-card-header">
            <div class="header-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div class="header-text-group">
              <span class="delivery-badge">QATAR DOORSTEP DELIVERY</span>
              <h2 class="buy-now-card-title">Direct Order & Delivery Details</h2>
              <p class="buy-now-card-sub">Fill your delivery details below to confirm your order directly on WhatsApp.</p>
            </div>
          </div>

          <form id="pdp-direct-order-form" class="buy-now-form" onsubmit="return false;" novalidate>
            <div class="form-grid">
              <div class="form-field">
                <label for="pdp-order-name" class="field-label">Full Name <span class="required-star">*</span></label>
                <input
                  type="text"
                  id="pdp-order-name"
                  class="form-input"
                  placeholder="e.g. Fatima Al-Kuwari"
                  autocomplete="name"
                  required
                />
                <span class="field-error-msg" id="pdp-name-error">Please enter your full name</span>
              </div>

              <div class="form-field">
                <label for="pdp-order-phone" class="field-label">WhatsApp Mobile <span class="required-star">*</span></label>
                <div class="phone-input-wrap">
                  <span class="phone-prefix">🇶🇦 +974</span>
                  <input
                    type="tel"
                    id="pdp-order-phone"
                    class="form-input phone-input"
                    placeholder="e.g. 5512 3456"
                    autocomplete="tel"
                    required
                  />
                </div>
                <span class="field-error-msg" id="pdp-phone-error">Please enter your 8-digit mobile number</span>
              </div>

              <div class="form-field full-width">
                <label for="pdp-order-address" class="field-label">Delivery Address in Qatar <span class="required-star">*</span></label>
                <input
                  type="text"
                  id="pdp-order-address"
                  class="form-input"
                  placeholder="Street name, Villa/Building number, Zone"
                  autocomplete="street-address"
                  required
                />
                <span class="field-error-msg" id="pdp-address-error">Please enter your delivery street or villa</span>
              </div>

              <div class="form-field">
                <label for="pdp-order-city" class="field-label">Municipality / Area</label>
                <div class="select-wrap">
                  <select id="pdp-order-city" class="form-input form-select">
                    <option value="Doha" selected>Doha (الدوحة)</option>
                    <option value="Lusail">Lusail (لوسيل)</option>
                    <option value="The Pearl">The Pearl (اللؤلؤة)</option>
                    <option value="West Bay">West Bay (الخليج الغربي)</option>
                    <option value="Al Rayyan">Al Rayyan (الريان)</option>
                    <option value="Al Wakrah">Al Wakrah (الوكرة)</option>
                    <option value="Al Daayen">Al Daayen (الظعاين)</option>
                    <option value="Umm Salal">Umm Salal (أم صلال)</option>
                    <option value="Al Khor">Al Khor (الخور)</option>
                    <option value="Al Shahaniya">Al Shahaniya (الشحانية)</option>
                    <option value="Other Area in Qatar">Other Area in Qatar</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="pdp-order-notes" class="field-label">Delivery Notes (Optional)</label>
                <input
                  type="text"
                  id="pdp-order-notes"
                  class="form-input"
                  placeholder="e.g. Call before arrival, leave with security"
                />
              </div>
            </div>

            <!-- Order Summary & Quantity -->
            <div class="order-summary-box">
              <div class="summary-product-row">
                <div class="summary-thumb-wrap">
                  <img src={product.image} alt={product.fullName} class="summary-thumb" width="48" height="48" />
                </div>
                <div class="summary-details">
                  <span class="summary-brand">{product.brand}</span>
                  <strong class="summary-name">{product.name}</strong>
                  <span class="summary-specs">{product.sizeDisplay} · {product.concentration}</span>
                </div>
                <div class="summary-qty-selector">
                  <span class="qty-label">Qty:</span>
                  <div class="pdp-qty-wrapper">
                    <button type="button" class="pdp-qty-btn" id="pdp-qty-dec" aria-label="Decrease quantity">−</button>
                    <span class="pdp-qty-display" id="pdp-qty-val">1</span>
                    <button type="button" class="pdp-qty-btn" id="pdp-qty-inc" aria-label="Increase quantity">+</button>
                  </div>
                </div>
              </div>

              <div class="summary-pricing-row">
                <div class="payment-method-pill">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                  </svg>
                  <span>Cash or Card upon Delivery</span>
                </div>
                <div class="summary-total-group">
                  <span class="total-caption">Total to Pay:</span>
                  <span class="total-amount" id="pdp-total-price">{product.priceDisplay}</span>
                </div>
              </div>
            </div>

            <!-- Primary Buy Now via WhatsApp CTA -->
            <button
              type="button"
              class="btn-buy-now-whatsapp"
              id="btn-pdp-buy-now"
              data-id={product.id}
              data-name={product.name}
              data-brand={product.brand}
              data-size={product.sizeDisplay}
              data-concentration={product.concentration}
              data-price={product.priceMinor}
              data-image={product.image}
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
              </svg>
              <span>BUY NOW VIA WHATSAPP — <span id="pdp-btn-amount">{product.priceDisplay}</span></span>
            </button>
          </form>

          <div class="or-divider">
            <span class="or-text">OR SHOP MULTIPLE ITEMS</span>
          </div>

          <button
            type="button"
            class="btn-add-to-bag-alt"
            id="pdp-main-add-btn"
            data-action="add-to-bag"
            data-id={product.id}
            data-name={product.name}
            data-brand={product.brand}
            data-size={product.sizeDisplay}
            data-concentration={product.concentration}
            data-price={product.priceMinor}
            data-image={product.image}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>Add to Bag (Combine Fragrances)</span>
          </button>
        </div>

        <!-- Client Guarantees -->
        <div class="pdp-assurances">
          <div class="assurance-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>100% Guaranteed Genuine & Verified Quality</span>
          </div>
          <div class="assurance-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Doha & Qatar Doorstep Delivery</span>
          </div>
          <div class="assurance-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Personal advice & payment confirmation via WhatsApp</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Fragrances -->
    {relatedProducts.length > 0 && (
      <section class="related-section">
        <div class="section-header">
          <div>
            <span class="section-eyebrow">Olfactory Harmonies</span>
            <h2 class="section-heading">You May Also Appreciate</h2>
          </div>
        </div>
        <div class="grid-products">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Mobile Sticky Buy Now Bar -->
  <div class="mobile-sticky-bar" id="mobile-sticky-bar" hidden>
    <div class="mobile-sticky-inner">
      <div class="mobile-sticky-info">
        <span class="mobile-sticky-name">{product.name}</span>
        <span class="mobile-sticky-price">{product.priceDisplay}</span>
      </div>
      <button
        class="btn-sticky-buy-now"
        id="btn-sticky-buy-now"
        type="button"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
        </svg>
        <span>BUY NOW</span>
      </button>
    </div>
  </div>
  <!-- Image Lightbox Modal -->
  <div class="image-lightbox-backdrop" id="image-lightbox" hidden>
    <div class="image-lightbox-content">
      <button class="lightbox-close-btn" id="lightbox-close" aria-label="Close zoom view">✕</button>
      <img src={product.image} alt={product.fullName} class="lightbox-img" />
      <span class="lightbox-caption">{product.fullName} · {product.sizeDisplay}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .pdp-container {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb-separator {
    color: var(--color-border);
  }

  .breadcrumb-list a:hover {
    color: var(--color-accent);
  }

  .pdp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 5rem;
  }

  @media (min-width: 860px) {
    .pdp-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 4rem;
    }
  }

  /* Media Frame */
  .pdp-media-wrap {
    position: sticky;
    top: 96px;
  }

  .pdp-media-frame {
    position: relative;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
    cursor: zoom-in;
    box-shadow: 0 8px 30px rgba(37, 33, 30, 0.04);
  }

  .zoom-indicator-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.65rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
    z-index: 2;
    transition: all var(--transition-fast);
  }

  .zoom-indicator-btn:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }

  .pdp-main-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 16px 30px rgba(0, 0, 0, 0.08));
    transition: transform 300ms ease;
  }

  .pdp-main-image:hover {
    transform: scale(1.035);
  }

  /* Product Info */
  .pdp-info {
    display: flex;
    flex-direction: column;
  }

  .pdp-brand {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .pdp-title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .pdp-variant-details {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .pdp-price-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.75rem;
  }

  .pdp-price {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .pdp-availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    padding: 0.35rem 0.65rem;
    border-radius: var(--border-radius-sm);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #25D366;
  }

  .pdp-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  /* Notes Box */
  .pdp-notes-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .pdp-notes-title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    margin-bottom: 1rem;
  }

  .pdp-family-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .key-notes-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .key-notes-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .note-pill {
    font-size: 0.8125rem;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
  }

  /* Buy Now Direct Checkout Card */
  .pdp-buy-now-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-bottom: 2.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .buy-now-card-header {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    flex-shrink: 0;
  }

  .delivery-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  .buy-now-card-title {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 0.2rem;
