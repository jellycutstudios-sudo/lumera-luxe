---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import productsData from '../../data/products.json';
import { siteConfig } from '../../data/site';
import { findSimilarFragrances } from '../../lib/fragrance-matcher';
import { CURATED_LAYERING_PAIRS } from '../../data/fragrance-discovery';

export async function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

// Find 2-3 genuinely similar fragrances using note-affinity and olfactive family overlap
const similarResults = findSimilarFragrances(product, productsData, 3);
const similarProducts = similarResults.map((r) => r.product);

// Check if this fragrance is part of an approved layering ritual (either as base or top)
const activeLayeringPair = CURATED_LAYERING_PAIRS.find(
  (pair) => pair.baseSlug === product.slug || pair.topSlug === product.slug
);

let pairedProduct = null;
let isCurrentBase = false;
if (activeLayeringPair) {
  isCurrentBase = activeLayeringPair.baseSlug === product.slug;
  const companionSlug = isCurrentBase ? activeLayeringPair.topSlug : activeLayeringPair.baseSlug;
  pairedProduct = productsData.find((p) => p.slug === companionSlug) || null;
}
const duetPriceTotal = pairedProduct ? Math.round((product.priceMinor + pairedProduct.priceMinor) / 100) : 0;

// Schema.org Product structured data (Enhanced for Google Merchant & AEO Rich Snippets)
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.fullName,
  url: `https://lumeraluxe.com.qa/perfumes/${product.slug}/`,
  image: `https://lumeraluxe.com.qa${product.image}`,
  description: product.description,
  sku: product.id,
  brand: {
    '@type': 'Brand',
    name: product.brand
  },
  offers: {
    '@type': 'Offer',
    url: `https://lumeraluxe.com.qa/perfumes/${product.slug}/`,
    priceCurrency: product.currency,
    price: (product.priceMinor / 100).toFixed(0),
    priceValidUntil: '2027-12-31',
    itemCondition: 'https://schema.org/NewCondition',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: siteConfig.brandName,
      url: 'https://lumeraluxe.com.qa'
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '0',
        currency: 'QAR'
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'QA'
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 1,
          unitCode: 'DAY'
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 1,
          maxValue: 2,
          unitCode: 'DAY'
        }
      }
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'QA',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 14,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn'
    }
  }
};
---

<BaseLayout
  title={`${product.fullName} · ${product.sizeDisplay} | LUMÈRA LUXE`}
  description={product.description}
  image={product.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <article class="pdp-container container">
    <!-- Minimalist Haute Breadcrumb -->
    <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/shop/">Collection</a>
      <span class="sep">/</span>
      <a href={`/shop/?brand=${encodeURIComponent(product.brand)}`}>{product.brand}</a>
      <span class="sep">/</span>
      <span class="current" aria-current="page">{product.name}</span>
    </nav>

    <div class="pdp-grid">
      <!-- Media Stage with Magnifier -->
      <div class="pdp-media-wrap">
        <div class="pdp-media-frame" id="pdp-media-frame" title="Click to view full bottle photograph">
          <img
            src={product.image}
            alt={`${product.fullName} luxury perfume bottle`}
            class="pdp-main-image"
            width="600"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            id="pdp-image"
          />

          <!-- Authentic Batch Micro-Seal -->
          <div class="pdp-seal-pill">
            <span class="seal-dot"></span>
            <span>Sealed European Stock</span>
          </div>
        </div>
      </div>

      <!-- Product Information Tier -->
      <div class="pdp-info">
        <!-- Identity Tier -->
        <div class="pdp-header-block">
          <span class="pdp-brand">{product.brand}</span>
          <h1 class="pdp-title">{product.name}</h1>
          <p class="pdp-variant-details">{product.concentration} · {product.sizeDisplay}</p>
        </div>

        <!-- Luxury Price & Privilege Bar -->
        <div class="pdp-price-row">
          <div class="price-figures">
            {product.stickerPriceMinor && product.stickerPriceMinor > product.priceMinor && (
              <span class="pdp-sticker-price">{(product.stickerPriceMinor / 100).toFixed(0)} QAR</span>
            )}
            <span class="pdp-price">{product.priceDisplay}</span>
          </div>
          <div class="pdp-curation-badge">
            <span>Complimentary Qatar Delivery</span>
          </div>
        </div>

        <!-- Sensory Description -->
        <p class="pdp-description">{product.description}</p>

        {product.isDraft && (
          <div class="pdp-draft-notice">
            <span class="draft-tag">Review Candidate · Availability Verification</span>
            <p>This formulation is currently undergoing distributor batch verification. Please verify live availability with our WhatsApp concierge before dispatch.</p>
          </div>
        )}

        <!-- STREAMLINED LUXURY ACTION BLOCK -->
        <div class="pdp-action-block" id="pdp-cta-trigger">
          <!-- Row 1: Add to Bag + Wishlist Heart -->
          <div class="pdp-primary-action-row">
            <button
              type="button"
              class="btn-pdp-add-bag"
              id="pdp-main-add-btn"
              data-action="add-to-bag"
              data-id={product.id}
              data-name={product.name}
              data-brand={product.brand}
              data-size={product.sizeDisplay}
              data-concentration={product.concentration}
              data-price={product.priceMinor}
              data-image={product.image}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span>Add to Bag</span>
            </button>

            <!-- Wishlist Heart Button -->
            <button
              type="button"
              class="btn-pdp-fav"
              id="btn-pdp-fav"
              data-id={product.id}
              aria-label={`Save ${product.brand} ${product.name} to wishlist`}
              title="Save to Wishlist"
            >
              <svg class="pdp-heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>

            <!-- Share Button -->
            <button
              type="button"
              class="btn-pdp-fav"
              id="btn-share-fragrance"
              aria-label={`Share ${product.brand} ${product.name}`}
              title="Share Fragrance"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
            </button>
          </div>

          <!-- Row 2: Instant Buy Now (Direct to Delivery Details Checkout) -->
          <a
            href={`/checkout/?product=${encodeURIComponent(product.slug)}&qty=1`}
            class="btn-pdp-buy-now"
            id="pdp-direct-buy-btn"
            data-slug={product.slug}
          >
            <span>BUY NOW · {product.priceDisplay}</span>
          </a>

          <!-- Micro Assurance Strip -->
          <div class="pdp-micro-assurances">
            <span>✓ Sealed European Stock</span>
            <span class="micro-sep">·</span>
            <span>Free Qatar Courier Delivery</span>
            <span class="micro-sep">·</span>
            <span>Cash or Card on Delivery</span>
          </div>

          <!-- Concierge Question Link (Clearly for questions/advice, not ordering) -->
          <div class="pdp-concierge-assist">
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello LUMÈRA LUXE concierge, I have a question regarding ${product.fullName} (${product.sizeDisplay}).`)}`}
              target="_blank"
              rel="noopener"
              class="concierge-link"
              id="pdp-whatsapp-btn"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
                <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
              </svg>
              <span>Have questions about this fragrance? Chat with Concierge</span>
            </a>
          </div>
        </div>

        <!-- Olfactory Composition (Clean Note Chips) -->
        <section class="pdp-composition-section">
          <div class="composition-header">
            <h2 class="composition-title">Olfactory Composition</h2>
            <span class="composition-kicker">Haute Parfumerie</span>
          </div>

          <div class="composition-families">
            <span class="family-label">Scent Families:</span>
            <div class="family-pills">
              {product.scentFamilies.map((fam) => (
                <a href={`/shop/?family=${product.category || 'floral'}`} class="family-tag" title={`Explore ${fam} fragrances`}>
                  {fam}
                </a>
              ))}
            </div>
          </div>

          <div class="composition-notes-block">
            <span class="notes-heading">Prominent Notes:</span>
            <ul class="notes-cloud">
              {product.keyNotes.map((note) => (
                <li class="note-chip">
                  <span class="note-pip"></span>
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>
    </div>

    <!-- 8. THE ART OF LAYERING (Curated Flacon Combination) -->
    {activeLayeringPair && pairedProduct && (
      <section class="layering-section" aria-label="Fragrance Layering Ritual">
        <div class="layering-card">
          <!-- Compact Editorial Header -->
          <div class="layering-header">
            <div class="layering-kicker-row">
              <span class="layering-kicker">Maison Scent Duet · The Art of Layering</span>
              <a href={`/layering/#duet-${activeLayeringPair.id}`} class="layering-browse-all" data-astro-prefetch>
                <span>View All 10 Duets</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
            <h2 class="layering-title">{activeLayeringPair.title}</h2>
            <p class="layering-lead">{activeLayeringPair.description}</p>
          </div>

          <!-- Symmetrical Side-by-Side Duet Stage (Desktop & Mobile) -->
          <div class="layering-duet-stage">
            <!-- Current Flacon -->
            <div class="duet-podium current-podium">
              <span class="podium-role-badge">{isCurrentBase ? 'Foundation Base' : 'Harmonizing Top Veil'}</span>
              <div class="podium-image-frame">
                <img src={product.image} alt={product.fullName} width="160" height="160" class="podium-img" loading="lazy" decoding="async" />
              </div>
              <div class="podium-meta">
                <span class="podium-brand">{product.brand}</span>
                <span class="podium-name">{product.name}</span>
                <span class="podium-notes">{(product.keyNotes || []).slice(0, 3).join(' · ')}</span>
                <div class="podium-price-row">
                  <span class="podium-price">{product.priceDisplay}</span>
                  <span class="podium-pill-tag">Current Flacon</span>
                </div>
              </div>
            </div>

            <!-- Visual Scent Connector -->
            <div class="duet-connector" aria-hidden="true">
              <span class="connector-plus">+</span>
              <span class="connector-label">Layer With</span>
            </div>

            <!-- Companion Flacon -->
            <div class="duet-podium companion-podium">
              <span class="podium-role-badge">{isCurrentBase ? 'Harmonizing Top Veil' : 'Foundation Base'}</span>
              <a href={`/perfumes/${pairedProduct.slug}/`} class="podium-image-link" aria-label={`View ${pairedProduct.fullName}`}>
                <div class="podium-image-frame">
                  <img src={pairedProduct.image} alt={pairedProduct.fullName} width="160" height="160" class="podium-img" loading="lazy" decoding="async" />
                </div>
              </a>
              <div class="podium-meta">
                <span class="podium-brand">{pairedProduct.brand}</span>
                <a href={`/perfumes/${pairedProduct.slug}/`} class="podium-name-link">{pairedProduct.name}</a>
                <span class="podium-notes">{(pairedProduct.keyNotes || []).slice(0, 3).join(' · ')}</span>
                <div class="podium-price-row">
                  <span class="podium-price">{pairedProduct.priceDisplay}</span>
                  <a href={`/perfumes/${pairedProduct.slug}/`} class="podium-explore-link">Details →</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Integrated Ritual Tip Strip -->
          <div class="layering-ritual-strip">
            <span class="ritual-sparkle" aria-hidden="true">✦</span>
            <p class="ritual-text"><strong>Layering Ritual:</strong> {activeLayeringPair.ritualNote}</p>
          </div>

          <!-- Seamless 1-Click Purchase Bar -->
          <div class="layering-footer-bar">
            <div class="duet-offer-summary">
              <span class="duet-offer-title">Acquire Complete Scent Duet</span>
              <div class="duet-offer-figures">
                <span class="duet-offer-total">{duetPriceTotal} QAR</span>
                <span class="duet-offer-subtitle">(Both Full Flacons · Free Delivery)</span>
              </div>
            </div>

            <button
              type="button"
              class="btn-buy-duet"
              data-action="add-duet-to-bag"
              data-id-1={product.id}
              data-id-2={pairedProduct.id}
              aria-label={`Add Scent Duet: ${product.name} and ${pairedProduct.name} to bag`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span class="btn-duet-text">Add Both to Bag · {duetPriceTotal} QAR</span>
            </button>
          </div>
        </div>
      </section>
    )}

    <!-- 7. SIMILAR FRAGRANCE RECOMMENDATIONS -->
    {similarProducts.length > 0 && (
      <section class="related-section" aria-label="Similar Fragrances">
        <div class="section-header-minimal">
          <h2 class="section-title-minimal">If You Love This, Try These</h2>
          <span class="similar-note-kicker">Matched by shared note accords & fragrance families</span>
        </div>
        <div class="grid-products">
          {similarProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Mobile Floating Sticky Dual-Action Bar -->
  <aside class="pdp-sticky-bar" id="pdp-sticky-bar" aria-label="Quick Purchase Actions">
    <div class="pdp-sticky-inner">
      <div class="sticky-thumb-info">
        <img src={product.image} alt={product.name} class="sticky-thumb-img" width="40" height="40" loading="lazy" decoding="async" />
        <div class="sticky-meta">
          <span class="sticky-title">{product.name}</span>
          <span class="sticky-price" id="pdp-sticky-amount">{product.priceDisplay}</span>
        </div>
      </div>

      <div class="sticky-actions-wrap">
        <button
          type="button"
          class="btn-sticky-fav"
          id="btn-sticky-fav"
          data-id={product.id}
          aria-label="Save to Wishlist"
          title="Save to Wishlist"
        >
          <svg class="sticky-heart-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>

        <button
          type="button"
          class="btn-sticky-add-bag"
          id="btn-sticky-add-bag"
          data-action="add-to-bag"
          data-id={product.id}
          data-name={product.name}
          data-brand={product.brand}
          data-size={product.sizeDisplay}
          data-concentration={product.concentration}
          data-price={product.priceMinor}
          data-image={product.image}
          aria-label="Add to Bag"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span>Add to Bag</span>
        </button>

        <a
          href={`/checkout/?product=${encodeURIComponent(product.slug)}&qty=1`}
          class="btn-sticky-direct-buy"
          id="btn-sticky-direct-buy"
          data-slug={product.slug}
          aria-label="Buy Now"
        >
          <span>BUY NOW</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Image Lightbox Modal -->
  <div class="image-lightbox-backdrop" id="image-lightbox" hidden>
    <div class="image-lightbox-content">
      <button class="lightbox-close-btn" id="lightbox-close" aria-label="Close zoom view">✕</button>
      <img src={product.image} alt={product.fullName} class="lightbox-img" />
      <span class="lightbox-caption">{product.fullName} · {product.sizeDisplay}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .pdp-container {
    padding-top: clamp(1rem, 2.5vw, 1.75rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
  }

  /* Breadcrumb */
  .pdp-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .pdp-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .pdp-breadcrumb a:hover {
    color: var(--color-text-main);
  }

  .pdp-breadcrumb .sep {
    color: var(--color-border);
  }

  .pdp-breadcrumb .current {
    color: var(--color-text-main);
    font-weight: 500;
  }

  /* PDP Grid */
  .pdp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  @media (min-width: 860px) {
    .pdp-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 4.5rem;
    }
  }

  /* Media Frame */
  .pdp-media-wrap {
    position: relative;
  }

  @media (min-width: 860px) {
    .pdp-media-wrap {
      position: sticky;
      top: 90px;
    }
  }

  .pdp-media-frame {
    position: relative;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 2rem);
    cursor: zoom-in;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }

  .pdp-zoom-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid #ECEAE5;
    padding: 0.4rem 0.75rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
    z-index: 2;
    transition: all var(--transition-fast);
  }

  .pdp-zoom-btn:hover {
    background-color: var(--color-text-main);
    color: #FFFFFF;
  }

  .pdp-seal-pill {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid #ECEAE5;
    padding: 0.35rem 0.65rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-muted);
  }

  .seal-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .pdp-main-image {
    width: 100%;
    height: 100%;
    max-width: 95%;
    max-height: 95%;
    object-fit: contain;
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pdp-media-frame:hover .pdp-main-image {
    transform: scale(1.035);
  }

  /* Product Info */
  .pdp-info {
    display: flex;
    flex-direction: column;
  }

  .pdp-header-block {
    margin-bottom: 1.25rem;
  }

  .pdp-brand {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.35rem;
  }

  .pdp-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.015em;
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
  }

  .pdp-variant-details {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Luxury Price Row */
  .pdp-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .price-figures {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .pdp-price {
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .pdp-sticker-price {
    font-size: 1rem;
    color: var(--color-text-light);
    text-decoration: line-through;
  }

  .pdp-curation-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    padding: 0.25rem 0.6rem;
    border-radius: var(--border-radius-sm);
  }

  /* Olfactory Specs Strip */
  .pdp-specs-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    background-color: #FAF9F6;
    margin-bottom: 1.5rem;
  }

  .spec-cell {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 0.85rem;
    gap: 0.15rem;
  }

  .spec-cell:not(:last-child) {
    border-right: 1px solid #ECEAE5;
  }

  .spec-title {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
  }

  .spec-value {
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Description */
  .pdp-description {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  /* Draft Candidate Availability Notice */
  .pdp-draft-notice {
    background-color: #FAF8F5;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand-cognac);
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }

  .draft-tag {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-brand-cognac);
    margin-bottom: 0.25rem;
  }

  .pdp-draft-notice p {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Action Block (Dual Luxury Action) */
  .pdp-action-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    margin-bottom: 2.25rem;
  }

  .pdp-primary-action-row {
    display: flex;
    gap: 0.65rem;
    align-items: stretch;
  }

  /* Row 1: Add to Bag + Wishlist */
  .pdp-primary-action-row {
    display: flex;
    gap: 0.65rem;
    align-items: stretch;
  }

  .btn-pdp-add-bag {
    flex: 1;
    min-height: 50px;
    padding: 0.85rem 1.25rem;
    background-color: #FFFFFF;
    color: #1A1A1A;
    border: 1.5px solid #1A1A1A;
    border-radius: var(--border-radius-sm);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .btn-pdp-add-bag:hover {
    background-color: #1A1A1A;
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .btn-pdp-add-bag:active {
    transform: scale(0.985);
  }

  .btn-pdp-fav {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background-color: #FAF9F6;
    color: var(--color-text-main);
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .btn-pdp-fav:hover {
    border-color: var(--color-brand-cognac);
    color: var(--color-brand-cognac);
    transform: scale(1.05);
  }

  .btn-pdp-fav.is-active {
    color: var(--color-brand-cognac);
    border-color: rgba(200, 90, 36, 0.4);
    background-color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(200, 90, 36, 0.2);
  }

  .btn-pdp-fav.is-active .pdp-heart-icon {
    fill: var(--color-brand-cognac);
    stroke: var(--color-brand-cognac);
  }

  /* Row 2: Instant Buy Now (Direct to Delivery Details Checkout) */
  .btn-pdp-buy-now {
    width: 100%;
    min-height: 52px;
    padding: 0.9rem 1.5rem;
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: none;
    border-radius: var(--border-radius-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.14);
    transition: all var(--transition-fast);
  }

  .btn-pdp-buy-now:hover {
    background-color: #000000;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
  }

  .btn-pdp-buy-now:active {
    transform: scale(0.985);
  }

  /* Concierge Assistance Link */
  .pdp-concierge-assist {
    text-align: center;
    padding-top: 0.35rem;
    border-top: 1px dashed var(--color-border);
    margin-top: 0.2rem;
  }

  .concierge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .concierge-link svg {
    color: #25D366;
  }

  .concierge-link:hover {
    color: var(--color-text-main);
    text-decoration: underline;
  }

  .pdp-micro-assurances {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    padding-top: 0.5rem;
    border-top: 1px solid #ECEAE5;
    text-align: center;
  }

  .micro-sep {
    color: var(--color-border);
  }

  /* Composition Section */
  .pdp-composition-section {
    background-color: #FAF9F6;
    border: 1px solid #ECEAE5;
    border-radius: var(--border-radius-sm);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .composition-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #ECEAE5;
  }

  .composition-title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-main);
    margin: 0;
  }

  .composition-kicker {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .composition-families {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .family-label {
    font-size: 0.71875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
  }

  .family-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .family-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    background-color: var(--color-accent-light);
    color: var(--color-accent);
    padding: 0.2rem 0.55rem;
    border-radius: var(--border-radius-sm);
  }

  .composition-notes-block {
    margin-bottom: 1rem;
  }

  .notes-heading {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }

  .notes-cloud {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .note-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    background-color: #FFFFFF;
    border: 1px solid #ECEAE5;
    padding: 0.3rem 0.7rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
    transition: all var(--transition-fast);
  }

  .note-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .note-pip {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .composition-accord-wrap {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px dashed #ECEAE5;
  }

  .accord-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
    margin-bottom: 0.35rem;
  }

  .accord-text {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Guarantees */
  .pdp-guarantee-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .guarantee-row-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .guarantee-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #FAF9F6;
    border: 1px solid #ECEAE5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .guarantee-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .guarantee-headline {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: 0.02em;
  }

  .guarantee-subtext {
    font-size: 0.71875rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  /* Related Section */
  .related-section {
    padding-top: clamp(3rem, 5vw, 4.5rem);
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }

  .similar-note-kicker {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-family: var(--font-display);
    display: block;
    margin-top: 0.25rem;
  }

  /* The Art of Layering Section - Premium Compact Architecture */
  .layering-section {
    padding-top: clamp(2rem, 3.5vw, 3rem);
    margin-top: 2.5rem;
    margin-bottom: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .layering-card {
    max-width: 800px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E6DFD5;
    border-radius: 6px;
    box-shadow: 0 4px 24px rgba(26, 23, 21, 0.04);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .layering-header {
    text-align: center;
    padding: clamp(1.25rem, 2.5vw, 1.85rem) clamp(1rem, 2.5vw, 2rem) 1rem;
    background: linear-gradient(180deg, #FAF7F2 0%, #FFFFFF 100%);
    border-bottom: 1px solid #F0ECE4;
  }

  .layering-kicker-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .layering-kicker {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-brand-cognac, #9E532B);
  }

  .layering-browse-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .layering-browse-all:hover {
    color: var(--color-brand-cognac, #9E532B);
  }

  .layering-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 500;
    color: var(--color-text-main);
    line-height: 1.25;
    margin: 0 0 0.45rem;
  }

  .layering-lead {
    font-size: 0.84375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Dual Flacon Stage - Symmetrical Side-by-Side (Desktop & Mobile) */
  .layering-duet-stage {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    padding: clamp(0.85rem, 2vw, 1.5rem);
    gap: clamp(0.4rem, 1.5vw, 1.25rem);
    background-color: #FFFFFF;
  }

  .duet-podium {
    background: #FAF8F5;
    border: 1px solid #EBE5DC;
    border-radius: 4px;
    padding: clamp(0.75rem, 1.8vw, 1.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .duet-podium:hover {
    border-color: #D6C9B8;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
  }

  .podium-role-badge {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brand-cognac, #9E532B);
    background: #FFFFFF;
    border: 1px solid #E6DED4;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    margin-bottom: 0.4rem;
    white-space: nowrap;
  }

  .podium-image-frame {
    width: clamp(75px, 13vw, 120px);
    height: clamp(75px, 13vw, 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.25rem auto 0.5rem;
  }

  .podium-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 200ms ease;
  }

  .podium-image-link:hover .podium-img {
    transform: scale(1.05);
  }

  .podium-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: auto;
  }

  .podium-brand {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }

  .podium-name,
  .podium-name-link {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 1.4vw, 0.95rem);
    font-weight: 600;
    color: var(--color-text-main);
    text-decoration: none;
    line-height: 1.25;
    margin-bottom: 0.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .podium-name-link:hover {
    color: var(--color-brand-cognac);
  }

  .podium-notes {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .podium-price-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding-top: 0.45rem;
    border-top: 1px solid #ECE5DC;
    flex-wrap: wrap;
  }

  .podium-price {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .podium-pill-tag {
    font-size: 0.5625rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: #EFEAE2;
    padding: 0.12rem 0.35rem;
    border-radius: 2px;
  }

  .podium-explore-link {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-brand-cognac);
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .podium-explore-link:hover {
    transform: translateX(2px);
  }

  /* Duet Connector */
  .duet-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
  }

  .connector-plus {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #FAF7F2;
    border: 1px solid #E6DED4;
    color: var(--color-brand-cognac, #9E532B);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1;
  }

  .connector-label {
    font-size: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Integrated Ritual Note */
  .layering-ritual-strip {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem clamp(0.85rem, 2vw, 1.5rem);
    background: #FAF7F2;
    border-top: 1px solid #F0ECE4;
    border-bottom: 1px solid #F0ECE4;
  }

  .ritual-sparkle {
    color: #D4AF37;
    font-size: 0.875rem;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .ritual-text {
    font-size: 0.78125rem;
    line-height: 1.45;
    color: #4A423A;
    margin: 0;
  }

  /* Integrated Purchase Footer Bar */
  .layering-footer-bar {
    padding: clamp(0.85rem, 2vw, 1.25rem) clamp(0.85rem, 2vw, 1.5rem);
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  @media (min-width: 580px) {
    .layering-footer-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .duet-offer-summary {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-align: center;
  }

  @media (min-width: 580px) {
    .duet-offer-summary {
      text-align: left;
    }
  }

  .duet-offer-title {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-cognac, #9E532B);
  }

  .duet-offer-figures {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.45rem;
  }

  @media (min-width: 580px) {
    .duet-offer-figures {
      justify-content: flex-start;
    }
  }

  .duet-offer-total {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.2;
  }

  .duet-offer-subtitle {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .btn-buy-duet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background: #1A1715;
    color: #FAF8F5;
    border: 1px solid #1A1715;
    border-radius: 3px;
    padding: 0.8rem 1.4rem;
    font-family: var(--font-sans);
    font-size: 0.78125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    min-height: 46px;
    white-space: nowrap;
    width: 100%;
    transition: all 180ms ease;
