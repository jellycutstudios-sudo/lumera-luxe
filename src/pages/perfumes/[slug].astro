</style>

<script>
  import { siteConfig } from '../../data/site';
  import { isFavorite, toggleFavorite } from '../../lib/favorites';

  // Quantity handling
  let currentQty = 1;
  const qtyValEl = document.getElementById('pdp-qty-val');
  const qtyDecBtn = document.getElementById('pdp-qty-dec');
  const qtyIncBtn = document.getElementById('pdp-qty-inc');
  const pdpBuyAmountEl = document.getElementById('pdp-buy-amount');
  const pdpStickyAmountEl = document.getElementById('pdp-sticky-amount');
  const pdpAddBtn = document.getElementById('pdp-main-add-btn');
  const stickyAddBtn = document.getElementById('btn-sticky-add-bag');
  const directBuyBtn = document.getElementById('pdp-direct-buy-btn');
  const stickyDirectBuyBtn = document.getElementById('btn-sticky-direct-buy');
  const pdpWhatsAppBtn = document.getElementById('pdp-whatsapp-btn') as HTMLAnchorElement;
  const stickyBar = document.getElementById('pdp-sticky-bar');
  const pdpFavBtn = document.getElementById('btn-pdp-fav');
  const stickyFavBtn = document.getElementById('btn-sticky-fav');
  const prodId = pdpFavBtn?.getAttribute('data-id') || stickyFavBtn?.getAttribute('data-id');

  // Sync Favorite Buttons state
  function syncPdpFav() {
    if (!prodId) return;
    const active = isFavorite(prodId);
    [pdpFavBtn, stickyFavBtn].forEach((btn) => {
      if (btn) {
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
    });
  }

  function handleFavToggle(e: Event) {
    e.preventDefault();
    if (!prodId) return;
    toggleFavorite(prodId);
    syncPdpFav();
  }

  pdpFavBtn?.addEventListener('click', handleFavToggle);
  stickyFavBtn?.addEventListener('click', handleFavToggle);
  window.addEventListener('favorites-updated', syncPdpFav);
  window.addEventListener('storage', syncPdpFav);
  syncPdpFav();

  const unitPriceMinor = pdpAddBtn ? Number(pdpAddBtn.getAttribute('data-price') || 0) : 0;
  const productName = pdpAddBtn?.getAttribute('data-name') || '';
  const productBrand = pdpAddBtn?.getAttribute('data-brand') || '';
  const productSize = pdpAddBtn?.getAttribute('data-size') || '';

  function updatePrices() {
    if (qtyValEl) qtyValEl.textContent = String(currentQty);
    const totalMinor = unitPriceMinor * currentQty;
    const formatted = `${(totalMinor / 100).toFixed(0)} QAR`;

    if (pdpBuyAmountEl) pdpBuyAmountEl.textContent = formatted;
    if (pdpStickyAmountEl) pdpStickyAmountEl.textContent = formatted;

    // Update data-qty attribute on add to bag buttons
    pdpAddBtn?.setAttribute('data-qty', String(currentQty));
    stickyAddBtn?.setAttribute('data-qty', String(currentQty));

    // Update WhatsApp link with new quantity & total
    if (pdpWhatsAppBtn) {
      const waMsg = `Hello LUMÈRA LUXE, I would like to order or inquire about ${currentQty > 1 ? `${currentQty}x ` : ''}${productBrand} ${productName} (${productSize}, ${formatted}).`;
      const waPhone = siteConfig.whatsappNumber.replace(/[^0-9]/g, '');
      pdpWhatsAppBtn.href = `https://wa.me/${waPhone}?text=${encodeURIComponent(waMsg)}`;
    }
  }

  qtyDecBtn?.addEventListener('click', () => {
    if (currentQty > 1) {
      currentQty--;
      updatePrices();
    }
  });

  qtyIncBtn?.addEventListener('click', () => {
    if (currentQty < 10) {
      currentQty++;
      updatePrices();
    }
  });

  // Direct Buy: Instant 1-click checkout
  function handleDirectBuy() {
    const slug = directBuyBtn?.getAttribute('data-slug') || stickyDirectBuyBtn?.getAttribute('data-slug');
    if (slug) {
      window.location.href = `/checkout/?product=${encodeURIComponent(slug)}&qty=${currentQty}`;
    }
  }

  directBuyBtn?.addEventListener('click', handleDirectBuy);
  stickyDirectBuyBtn?.addEventListener('click', handleDirectBuy);

  // Mobile Sticky Bar Visibility
  function handleStickyScroll() {
    if (!stickyBar || !pdpAddBtn) return;
    const btnRect = pdpAddBtn.getBoundingClientRect();
    const footer = document.querySelector('footer');
    const footerRect = footer ? footer.getBoundingClientRect() : null;

    const isPastCta = btnRect.bottom < 0;
    const isAtBottom = footerRect ? footerRect.top <= (window.innerHeight + 20) : false;

    if (isPastCta && !isAtBottom) {
      stickyBar.classList.add('is-visible');
    } else {
      stickyBar.classList.remove('is-visible');
    }
  }

  window.addEventListener('scroll', handleStickyScroll, { passive: true });
  window.addEventListener('resize', handleStickyScroll, { passive: true });
  handleStickyScroll();

  // Lightbox Zoom logic
  const mediaFrame = document.getElementById('pdp-media-frame');
  const lightbox = document.getElementById('image-lightbox');
  const lightboxClose = document.getElementById('lightbox-close');

  mediaFrame?.addEventListener('click', () => {
    if (lightbox) {
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }
  });

  lightboxClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightbox) {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
  });

  // Native Web Share API
  const shareBtn = document.getElementById('btn-share-fragrance');
  shareBtn?.addEventListener('click', () => {
    const text = `Explore ${document.title} on LUMÈRA LUXE Haute Parfumerie`;
    if (navigator.share) {
      navigator.share({ title: document.title, url: window.location.href, text }).catch(() => {});
    } else {
      window.open(`https://wa.me/?text=${encodeURIComponent(text + ' ' + window.location.href)}`, '_blank');
    }
  });
</script>
