---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Our Story | ${siteConfig.brandName} Doha`}
  description="The philosophy, craftsmanship, and quiet dedication behind LUMÈRA LUXE. Curating verified, rare haute fragrances for connoisseurs across Qatar."
>
  <article class="story-page">
    <!-- Editorial Masthead -->
    <header class="story-masthead">
      <div class="container-narrow text-center">
        <span class="story-kicker">Maison LUMÈRA LUXE · Doha, Qatar</span>
        <h1 class="story-headline">
          The Art of Rare Scent,<br />
          <span class="headline-italic">Curated for Qatar.</span>
        </h1>
        <p class="story-lead">
          Born in Doha from a quiet conviction: that authentic haute perfumery should never be obscured by mass retail markups or impersonal service.
        </p>
      </div>
    </header>

    <!-- Chapter I: European Provenance & Authenticity -->
    <section class="story-chapter">
      <div class="container">
        <div class="chapter-grid">
          <div class="chapter-text">
            <span class="chapter-num">Chapter I</span>
            <h2 class="chapter-title">Direct European Provenance</h2>
            <div class="chapter-body">
              <p>
                Fragrance is deeply personal: an intimate signature and a quiet presence. Fine fragrance should never feel complicated by artificial markups or impersonal department store counters.
              </p>
              <p>
                LUMÈRA LUXE was founded in Doha to offer a thoughtful alternative. We personally curate authentic flacons from established European perfume houses, ensuring every bottle, from luminous Eau de Parfum to concentrated Extrait, arrives in pristine condition.
              </p>
            </div>
            <div class="chapter-meta">
              <div class="meta-item">
                <span class="meta-label">Origin</span>
                <span class="meta-val">Direct European Channels</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Integrity</span>
                <span class="meta-val">100% Sealed & Batch-Coded</span>
              </div>
            </div>
          </div>
          <div class="chapter-visual">
            <div class="visual-frame">
              <img
                src="/assets/brand/story-flacon-elegance.webp"
                alt="Chanel N°5 Eau de Parfum flacon in warm ambient light"
                class="chapter-img"
                width="800"
                height="600"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Standards Section (Clean 3-Column Minimal Grid) -->
    <section class="standards-section">
      <div class="container">
        <div class="standards-header text-center">
          <span class="standards-kicker">House Standards</span>
          <h2 class="standards-title">Three Unwavering Tenets</h2>
        </div>
        <div class="standards-grid">
          <div class="standard-item">
            <span class="standard-index">01</span>
            <h3 class="standard-name">Authentic Provenance</h3>
            <p class="standard-desc">
              Every bottle carries verified manufacturer batch codes. We partner exclusively with verified European channels, guaranteeing untampered concentrations and genuine formulations.
            </p>
          </div>
          <div class="standard-item">
            <span class="standard-index">02</span>
            <h3 class="standard-name">Climate-Preserved Storage</h3>
            <p class="standard-desc">
              Qatar’s climate requires vigilance. Our flacons are preserved in dedicated temperature-monitored facilities to ensure fragile top notes and natural essences remain uncompromised.
            </p>
          </div>
          <div class="standard-item">
            <span class="standard-index">03</span>
            <h3 class="standard-name">Personal Doha Concierge</h3>
            <p class="standard-desc">
              No chatbots or automated queues. Connect directly on WhatsApp with genuine fragrance connoisseurs for tailored scent recommendations, bottle reservations, and delivery updates.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter II: The Presentation Ritual -->
    <section class="story-chapter chapter-reverse">
      <div class="container">
        <div class="chapter-grid">
          <div class="chapter-visual">
            <div class="visual-frame">
              <img
                src="/assets/brand/story-packaging-ritual.webp"
                alt="Signature LUMÈRA LUXE boutique gift box with ribbon"
                class="chapter-img"
                width="800"
                height="600"
                loading="lazy"
              />
            </div>
          </div>
          <div class="chapter-text">
            <span class="chapter-num">Chapter II</span>
            <h2 class="chapter-title">The Ritual of Presentation</h2>
            <div class="chapter-body">
              <p>
                We believe the experience of fine perfumery begins before the first spray. Every flacon is hand-wrapped in our minimalist embossed boutique box, secured with a hand-tied ribbed ribbon, and prepared as an exquisite gift.
              </p>
              <p>
                Dispatched directly across Doha, Lusail, The Pearl, and all municipalities of Qatar, our local couriers handle every parcel with utmost care and discretion.
              </p>
            </div>
            <div class="delivery-badges">
              <span class="badge-item">Doha Priority Courier</span>
              <span class="badge-item">Signature Gift Ribbon</span>
              <span class="badge-item">2 Discovery Samples</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter III: The Signature Collection (Coming Soon) -->
    <section class="story-chapter story-chapter-signature">
      <div class="container">
        <div class="chapter-grid">
          <div class="chapter-text">
            <span class="chapter-num">Chapter III · Upcoming Creation</span>
            <h2 class="chapter-title">The Signature Collection</h2>
            <div class="chapter-body">
              <p>
                An intimate evolution of our maison. Conceived in Doha as our defining private reserve: <em>The Light She Carries</em>.
              </p>
            </div>
            <div class="chapter-meta">
              <div class="meta-item">
                <span class="meta-label">Status</span>
                <span class="meta-val">Coming Soon</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">First Flacon</span>
                <span class="meta-val">The Light She Carries</span>
              </div>
            </div>
          </div>
          <div class="chapter-visual">
            <div class="visual-frame visual-frame-signature">
              <img
                src="/assets/brand/story-signature-collection.webp"
                alt="LUMÈRA LUXE The Signature Collection - Coming Soon - The Light She Carries"
                class="signature-collection-img"
                width="1024"
                height="576"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial Pull Quote -->
    <section class="story-quote-section">
      <div class="container-narrow text-center">
        <blockquote class="manifesto-quote">
          “Perfume is an invisible signature: a quiet presence that lingers long after you leave the room.”
        </blockquote>
        <span class="quote-signoff">The LUMÈRA LUXE Philosophy</span>
      </div>
    </section>

    <!-- Clean Invitation CTA -->
    <section class="story-invitation">
      <div class="container-narrow text-center">
        <span class="invitation-kicker">Haute Parfumerie</span>
        <h2 class="invitation-headline">Find Your Next Signature</h2>
        <p class="invitation-lead">
          Explore our curated catalog of authentic European flacons or converse directly with our Doha boutique concierge on WhatsApp.
        </p>
        <div class="invitation-actions">
          <a href="/shop/" class="btn-invitation-primary">
            Explore Collection
          </a>
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello LUMÈRA LUXE, I would like personal assistance choosing a fragrance from your curated collection.')}`}
            class="btn-invitation-secondary"
            target="_blank"
            rel="noopener"
          >
            Speak with Concierge
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .story-page {
    background-color: #FFFFFF;
    color: #181513;
    overflow-x: hidden;
  }

  .container-narrow {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .text-center {
    text-align: center;
  }

  /* 1. Masthead */
  .story-masthead {
    background: linear-gradient(180deg, #FAF8F5 0%, #FFFFFF 100%);
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid #F0ECE6;
  }

  .story-kicker {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold-dark);
    margin-bottom: 0.85rem;
  }

  .story-headline {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.3rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #181513;
    margin-bottom: 1.25rem;
  }

  .headline-italic {
    font-style: italic;
    color: var(--color-brand-cognac-dark);
  }

  .story-lead {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    font-weight: 400;
    line-height: 1.7;
    color: #6D6760;
    max-width: 580px;
    margin: 0 auto;
  }

  /* 2. Chapters */
  .story-chapter {
    padding: clamp(4rem, 6vw, 6rem) 0;
  }

  .chapter-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .chapter-grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .chapter-reverse .chapter-grid {
      grid-template-columns: 1fr 1.1fr;
    }

    .chapter-reverse .chapter-text {
      order: 2;
    }

    .chapter-reverse .chapter-visual {
      order: 1;
    }
  }

  .chapter-num {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin-bottom: 0.65rem;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #181513;
    margin-bottom: 1.25rem;
  }

  .chapter-body p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: #6D6760;
    margin-bottom: 1.25rem;
  }

  .chapter-body p:last-child {
    margin-bottom: 0;
  }

  .chapter-meta {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #F0ECE6;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #8F8880;
  }

  .meta-val {
    font-size: 0.85rem;
    font-weight: 500;
    color: #181513;
  }

  .visual-frame {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    background-color: #FAF8F5;
    border: 1px solid #E8E3DC;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
  }

  .chapter-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .visual-frame:hover .chapter-img {
    transform: scale(1.02);
  }

  .delivery-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #F0ECE6;
  }

  .badge-item {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    color: #3A3530;
    background-color: #FAF8F5;
    border: 1px solid #E8E3DC;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  /* 3. Standards Section */
  .standards-section {
    background-color: #FAF8F5;
    padding: clamp(4rem, 7vw, 6rem) 0;
    border-top: 1px solid #F0ECE6;
    border-bottom: 1px solid #F0ECE6;
  }

  .standards-header {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .standards-kicker {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin-bottom: 0.5rem;
  }

  .standards-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.4rem);
    font-weight: 400;
    color: #181513;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 768px) {
    .standards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .standard-item {
    background-color: #FFFFFF;
    border: 1px solid #E8E3DC;
    border-radius: 4px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .standard-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
  }

  .standard-index {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    color: #C5A059;
    display: block;
    margin-bottom: 0.85rem;
  }

  .standard-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: #181513;
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .standard-desc {
    font-size: 0.85rem;
    line-height: 1.65;
    color: #6D6760;
    margin: 0;
  }

  /* 4. Manifesto Quote */
  .story-quote-section {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background-color: #FFFFFF;
  }

  .manifesto-quote {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #181513;
    margin: 0 auto 1.5rem;
    max-width: 640px;
  }

  .quote-signoff {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8F8880;
    display: block;
  }

  /* 5. Minimal Invitation */
  .story-invitation {
    background-color: #FAF8F5;
    border-top: 1px solid #F0ECE6;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
  }

  .invitation-kicker {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin-bottom: 0.65rem;
  }

  .invitation-headline {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    font-weight: 400;
    color: #181513;
    margin-bottom: 0.85rem;
  }

  .invitation-lead {
    font-size: 0.92rem;
    color: #6D6760;
    max-width: 520px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .invitation-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .btn-invitation-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #181513;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.95rem 2.25rem;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(24, 21, 19, 0.12);
  }

  .btn-invitation-primary:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(24, 21, 19, 0.22);
  }

  .btn-invitation-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
    color: #181513;
    border: 1px solid #E8E3DC;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.95rem 2.25rem;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .btn-invitation-secondary:hover {
    border-color: #181513;
    background-color: #FFFFFF;
    transform: translateY(-1px);
  }

  /* 2.1 Chapter III: Signature Collection */
  .story-chapter-signature {
    background-color: #FAF8F5;
    border-top: 1px solid #F0ECE6;
    border-bottom: 1px solid #F0ECE6;
  }

  .visual-frame-signature {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    background-color: #12100E;
    border: 1px solid rgba(197, 160, 89, 0.28);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
  }

  .signature-collection-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .visual-frame-signature:hover .signature-collection-img {
    transform: scale(1.025);
  @media (min-width: 860px) {
    .story-chapter-signature .chapter-grid {
      grid-template-columns: 0.9fr 1.6fr;
      gap: 3.5rem;
    }
  }
</style>
