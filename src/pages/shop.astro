---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../data/products.json';

// Unique brands
const brands = Array.from(new Set(productsData.map((p) => p.brand))).sort();
---

<BaseLayout
  title="Collection — LUMÈRA LUXE | Fragrances in Qatar"
  description="Explore our curated collection of verified designer and niche fragrances. Authentic concentrates, fair pricing, and personal concierge service in Qatar."
>
  <div class="shop-page">
    <!-- Compact Luxury Header -->
    <header class="shop-header">
      <div class="container">
        <span class="shop-eyebrow">Curated Catalogue</span>
        <h1 class="shop-title">The Fragrance Collection</h1>
        <p class="shop-description">
          100% genuine verified fragrances · Free doorstep delivery in Qatar
        </p>
      </div>
    </header>

    <div class="container shop-layout">
      <!-- Streamlined Search & Filter Bar -->
      <div class="catalog-toolbar">
        <!-- Search Input -->
        <div class="search-input-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="catalogue-search"
            class="search-input"
            placeholder="Search perfume, brand, or note..."
            aria-label="Search fragrances"
            autocomplete="off"
          />
          <button type="button" id="search-clear-btn" class="search-clear-btn" aria-label="Clear search" style="display: none;">
            ✕
          </button>
        </div>

        <!-- Controls: Brand, Price, Sort -->
        <div class="toolbar-controls">
          <!-- Brand Filter -->
          <div class="select-wrap">
            <label for="filter-brand" class="sr-only">Filter by Brand</label>
            <select id="filter-brand" class="toolbar-select">
              <option value="">All Brands ({brands.length})</option>
              {brands.map((b) => <option value={b}>{b}</option>)}
            </select>
          </div>

          <!-- Price Filter -->
          <div class="select-wrap">
            <label for="filter-price" class="sr-only">Filter by Price</label>
            <select id="filter-price" class="toolbar-select">
              <option value="all">All Prices</option>
              <option value="under-250">Under 250 QAR</option>
              <option value="250-350">250 – 350 QAR</option>
              <option value="over-350">350+ QAR</option>
            </select>
          </div>

          <!-- Sort -->
          <div class="select-wrap">
            <label for="sort-select" class="sr-only">Sort By</label>
            <select id="sort-select" class="toolbar-select">
              <option value="featured">Featured</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="name-asc">A to Z</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Compact Status Bar: Result Count & Active Reset -->
      <div class="catalog-status-bar">
        <span id="results-count" class="results-count">
          Showing <strong>{productsData.length}</strong> fragrances
        </span>
        <div class="status-actions">
          <div class="active-filter-tags" id="active-tags-container"></div>
          <button id="clear-all-btn" class="clear-all-btn" type="button" style="display: none;">
            Reset filters
          </button>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="grid-products" id="catalogue-grid">
        {productsData.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <!-- Zero Results State -->
      <div class="zero-results" id="zero-results" hidden>
        <div class="zero-icon-wrap">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3 class="zero-title">No fragrances match your selection</h3>
        <p class="zero-subtitle">Try adjusting your keywords or clearing active filters.</p>
        <button id="reset-zero-btn" class="btn btn-primary btn-sm">Clear All Filters</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .shop-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: clamp(1.25rem, 3vw, 2rem) 0 1rem;
    text-align: center;
  }

  .shop-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
    display: block;
  }

  .shop-title {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
    line-height: 1.15;
  }

  .shop-description {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto;
  }

  .shop-layout {
    padding-top: 1.25rem;
    padding-bottom: 4rem;
  }

  /* Catalog Toolbar */
  .catalog-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 880px) {
    .catalog-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  /* Search Input */
  .search-input-wrap {
    position: relative;
    flex: 1;
    max-width: 100%;
  }

  @media (min-width: 880px) {
    .search-input-wrap {
      max-width: 440px;
    }
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-light);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 42px;
    font-family: var(--font-body);
    font-size: 0.84rem;
    padding: 0 2.2rem 0 2.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background-color: #FFFFFF;
    color: var(--color-text-main);
    transition: all var(--transition-fast);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-brand-cognac);
    box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.12);
  }

  .search-clear-btn {
    position: absolute;
    right: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--color-text-light);
    font-size: 0.75rem;
    cursor: pointer;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .search-clear-btn:hover {
    background-color: var(--color-surface);
    color: var(--color-text-main);
  }

  /* Controls: Brand, Price, Sort */
  .toolbar-controls {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  @media (min-width: 880px) {
    .toolbar-controls {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
  }

  .select-wrap {
    position: relative;
    min-width: 0;
  }

  .toolbar-select {
    width: 100%;
    height: 42px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0 1.6rem 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    background-color: #FFFFFF;
    color: var(--color-text-main);
    cursor: pointer;
    appearance: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238A4A28' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.55rem center;
    background-size: 13px;
    transition: all var(--transition-fast);
  }

  @media (min-width: 880px) {
    .toolbar-select {
      width: auto;
      min-width: 130px;
    }
  }

  .toolbar-select:focus {
    outline: none;
    border-color: var(--color-brand-cognac);
    box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.12);
  }

  .toolbar-select.is-active {
    border-color: var(--color-brand-cognac);
    background-color: rgba(184, 134, 11, 0.05);
    color: var(--color-brand-cognac);
    font-weight: 600;
  }

  /* Compact Status Row */
  .catalog-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.65rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .status-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .clear-all-btn {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brand-cognac);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.2rem 0.35rem;
    border-radius: var(--border-radius-sm);
    transition: color var(--transition-fast);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .clear-all-btn:hover {
    color: var(--color-brand-cognac-hover);
  }

  .active-filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  :global(.filter-tag) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 500;
    background-color: rgba(184, 134, 11, 0.08);
    border: 1px solid rgba(184, 134, 11, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 12px;
    color: var(--color-brand-cognac);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  :global(.filter-tag:hover) {
    background-color: rgba(184, 134, 11, 0.16);
  }

  :global(.filter-tag-remove) {
    font-weight: 700;
    font-size: 0.68rem;
  }

  /* Zero Results */
  .zero-results {
    text-align: center;
    padding: 4rem 1rem;
  }

  .zero-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--color-surface);
    color: var(--color-text-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem auto;
  }

  .zero-title {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .zero-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  import productsData from '../data/products.json';

  const searchInput = document.getElementById('catalogue-search') as HTMLInputElement;
  const searchClearBtn = document.getElementById('search-clear-btn') as HTMLButtonElement;
  const brandSelect = document.getElementById('filter-brand') as HTMLSelectElement;
  const priceSelect = document.getElementById('filter-price') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const clearAllBtn = document.getElementById('clear-all-btn') as HTMLButtonElement;
  const resetZeroBtn = document.getElementById('reset-zero-btn');
  const countEl = document.getElementById('results-count');
  const gridEl = document.getElementById('catalogue-grid');
  const zeroEl = document.getElementById('zero-results');
  const tagsContainer = document.getElementById('active-tags-container');

  // Read URL parameters
  const urlParams = new URLSearchParams(window.location.search);
  const initialSearch = urlParams.get('search') || '';
  const initialBrand = urlParams.get('brand') || '';
  const initialFamily = urlParams.get('family') || '';
  const initialPrice = urlParams.get('price') || '';

  let activeFamily = initialFamily;

  if (searchInput && initialSearch) searchInput.value = initialSearch;
  if (brandSelect && initialBrand) brandSelect.value = initialBrand;
  if (priceSelect && initialPrice) priceSelect.value = initialPrice;

  function updateActiveStates() {
    if (brandSelect) {
      brandSelect.classList.toggle('is-active', Boolean(brandSelect.value));
    }
    if (priceSelect) {
      priceSelect.classList.toggle('is-active', priceSelect.value !== 'all');
    }
    if (searchClearBtn && searchInput) {
      searchClearBtn.style.display = searchInput.value.trim() ? 'flex' : 'none';
    }
  }

  function renderActiveTags(q: string, brand: string, price: string, family: string) {
    if (!tagsContainer) return;
    const tags: { label: string; clear: () => void }[] = [];

    if (family) {
      const familyName = family.charAt(0).toUpperCase() + family.slice(1);
      tags.push({
        label: `Family: ${familyName}`,
        clear: () => {
          activeFamily = '';
          filterAndSortProducts();
        }
      });
    }

    tagsContainer.innerHTML = tags
      .map(
        (t, idx) =>
          `<span class="filter-tag" data-tag-idx="${idx}">${t.label} <span class="filter-tag-remove">✕</span></span>`
      )
      .join('');

    tags.forEach((t, idx) => {
      tagsContainer.querySelector(`[data-tag-idx="${idx}"]`)?.addEventListener('click', t.clear);
    });

    const hasAnyFilter = Boolean(q || brand || (price && price !== 'all') || family);
    if (clearAllBtn) {
      clearAllBtn.style.display = hasAnyFilter ? 'inline-block' : 'none';
    }
  }

  function filterAndSortProducts() {
    const q = searchInput?.value.trim().toLowerCase() || '';
    const selectedBrand = brandSelect?.value || '';
    const selectedPrice = priceSelect?.value || 'all';
    const sort = sortSelect?.value || 'featured';

    updateActiveStates();

    const cards = Array.from(gridEl?.querySelectorAll('.product-card') || []) as HTMLElement[];
    let visibleCount = 0;

    cards.forEach((card) => {
      const id = card.getAttribute('data-product-id');
      const prod = productsData.find((p) => p.id === id);
      if (!prod) return;

      const matchesSearch =
        !q ||
        prod.name.toLowerCase().includes(q) ||
        prod.brand.toLowerCase().includes(q) ||
        prod.rawNotes.toLowerCase().includes(q) ||
        prod.scentFamilies.some((f) => f.toLowerCase().includes(q));

      const matchesBrand = !selectedBrand || prod.brand === selectedBrand;

      const matchesFamily =
        !activeFamily ||
        prod.scentFamilies.some((f) => f.toLowerCase().includes(activeFamily.toLowerCase()));

      const priceQar = prod.priceMinor / 100;
      let matchesPrice = true;
      if (selectedPrice === 'under-250') matchesPrice = priceQar < 250;
      if (selectedPrice === '250-350') matchesPrice = priceQar >= 250 && priceQar <= 350;
      if (selectedPrice === 'over-350') matchesPrice = priceQar > 350;

      if (matchesSearch && matchesBrand && matchesFamily && matchesPrice) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Sort visible cards
    if (gridEl) {
      const sortedCards = cards.slice().sort((a, b) => {
        const prodA = productsData.find((p) => p.id === a.getAttribute('data-product-id'))!;
        const prodB = productsData.find((p) => p.id === b.getAttribute('data-product-id'))!;

        if (sort === 'price-asc') return prodA.priceMinor - prodB.priceMinor;
        if (sort === 'price-desc') return prodB.priceMinor - prodA.priceMinor;
        if (sort === 'name-asc') return prodA.name.localeCompare(prodB.name);
        return (prodB.featured ? 1 : 0) - (prodA.featured ? 1 : 0);
      });

      sortedCards.forEach((c) => gridEl.appendChild(c));
    }

    renderActiveTags(q, selectedBrand, selectedPrice, activeFamily);

    // Update results count
    if (countEl) {
      countEl.innerHTML = `Showing <strong>${visibleCount}</strong> fragrance${visibleCount === 1 ? '' : 's'}`;
    }

    if (zeroEl && gridEl) {
      if (visibleCount === 0) {
        zeroEl.hidden = false;
        gridEl.hidden = true;
      } else {
        zeroEl.hidden = true;
        gridEl.hidden = false;
      }
    }
  }

  function resetAllFilters() {
    if (searchInput) searchInput.value = '';
    if (brandSelect) brandSelect.value = '';
    if (priceSelect) priceSelect.value = 'all';
    if (sortSelect) sortSelect.value = 'featured';
    activeFamily = '';
    filterAndSortProducts();
  }

  searchInput?.addEventListener('input', filterAndSortProducts);
  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    filterAndSortProducts();
  });

  brandSelect?.addEventListener('change', filterAndSortProducts);
  priceSelect?.addEventListener('change', filterAndSortProducts);
  sortSelect?.addEventListener('change', filterAndSortProducts);
  clearAllBtn?.addEventListener('click', resetAllFilters);
  resetZeroBtn?.addEventListener('click', resetAllFilters);

  // Initial trigger if params exist
  if (initialSearch || initialBrand || initialFamily || initialPrice) {
    filterAndSortProducts();
  } else {
    updateActiveStates();
  }
</script>
