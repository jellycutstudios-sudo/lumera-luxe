---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Contact & Concierge — ${siteConfig.brandName}`}
  description="Connect with LUMÈRA LUXE in Doha, Qatar. Direct WhatsApp assistance for fragrance inquiries, recommendations, and delivery arrangements."
>
  <div class="contact-page">
    <header class="contact-header">
      <div class="container text-center">
        <span class="eyebrow">Client Care</span>
        <h1 class="contact-title">Connect with Our Concierge</h1>
        <p class="contact-lead">
          We provide personalized consultation for perfume selections, special requests, and Qatar deliveries.
        </p>
      </div>
    </header>

    <div class="container contact-container">
      <div class="contact-grid">
        <!-- Direct Channels -->
        <div class="contact-cards">
          <div class="contact-channel-card highlight-card">
            <div class="channel-icon-wrap whatsapp-theme">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
              </svg>
            </div>
            <div class="channel-body">
              <h2 class="channel-title">WhatsApp Concierge</h2>
              <p class="channel-desc">
                Fastest response for perfume advice, immediate stock confirmation, and delivery updates.
              </p>
              <a
                href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent("Hello LUMÈRA LUXE, I have a question about your fragrance boutique.")}`}
                class="btn btn-primary btn-sm"
                target="_blank"
                rel="noopener"
              >
                Start WhatsApp Conversation
              </a>
            </div>
          </div>

          <div class="contact-channel-card">
            <div class="channel-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="channel-body">
              <h2 class="channel-title">Email Inquiries</h2>
              <p class="channel-desc">For formal inquiries, gift consultations, or partnership requests.</p>
              <a href={`mailto:${siteConfig.email}`} class="channel-link">{siteConfig.email}</a>
            </div>
          </div>

          <div class="contact-channel-card">
            <div class="channel-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="channel-body">
              <h2 class="channel-title">Location & Service Area</h2>
              <p class="channel-desc">
                Based in Doha, Qatar. Doorstep courier dispatch to Doha, Lusail, The Pearl, Al Wakrah, and across Qatar.
              </p>
              <span class="channel-location-badge">Doha, State of Qatar</span>
            </div>
          </div>
        </div>

        <!-- FAQ Note Box -->
        <div class="contact-faq-wrap">
          <div class="faq-box">
            <h3 class="faq-box-title">How Our Boutique Operates</h3>
            
            <div class="faq-item">
              <h4 class="faq-item-q">How do I place an order?</h4>
              <p class="faq-item-a">
                Browse our curated collection, add your preferred fragrances to your bag, and tap <em>Request via WhatsApp</em>. Our team confirms exact availability, delivery fees, and sends payment instructions.
              </p>
            </div>

            <div class="faq-item">
              <h4 class="faq-item-q">Are the perfumes 100% genuine?</h4>
              <p class="faq-item-a">
                Yes, completely. Every fragrance we stock is sourced through verified channels and examined for authentic batch codes, concentrations, and pristine packaging.
              </p>
            </div>

            <div class="faq-item">
              <h4 class="faq-item-q">What are the delivery times in Qatar?</h4>
              <p class="faq-item-a">
                Orders within Doha and surrounding municipalities are typically delivered within 24 to 48 hours of order confirmation.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(3rem, 6vw, 4.5rem) 0;
  }

  .text-center {
    text-align: center;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    display: block;
  }

  .contact-title {
    font-size: var(--text-4xl);
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .contact-lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-container {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-channel-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 1.75rem 1.5rem;
    display: flex;
    gap: 1.25rem;
  }

  .contact-channel-card.highlight-card {
    background-color: var(--color-surface);
    border-color: rgba(166, 83, 45, 0.3);
  }

  .channel-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--border-radius-sm);
    background-color: var(--color-surface-subtle);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-icon-wrap.whatsapp-theme {
    background-color: rgba(37, 211, 102, 0.12);
    color: #25D366;
  }

  .channel-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
  }

  .channel-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .channel-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
  }

  .channel-location-badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-main);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: var(--border-radius-sm);
  }

  /* FAQ Box */
  .faq-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 2rem 1.75rem;
  }

  .faq-box-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item {
    margin-bottom: 1.5rem;
  }

  .faq-item:last-child {
    margin-bottom: 0;
  }

  .faq-item-q {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
  }

  .faq-item-a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
