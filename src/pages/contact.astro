---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Contact & Concierge — ${siteConfig.brandName} Doha`}
  description="Connect with LUMÈRA LUXE in Doha, Qatar. Direct WhatsApp assistance for fragrance inquiries, recommendations, and delivery arrangements."
>
  <div class="contact-page">
    <!-- Hero Header -->
    <header class="contact-hero">
      <div class="container-narrow text-center">
        <span class="eyebrow">Client Care · Doha, Qatar</span>
        <h1 class="hero-title">
          How May We Assist You?
        </h1>
        <p class="hero-lead">
          From personalized olfactory recommendations to express Qatar delivery coordination, our Doha boutique team is at your service.
        </p>
      </div>
    </header>

    <!-- Main Content Container -->
    <div class="container contact-container">
      <!-- 3 Primary Symmetrical Channels -->
      <div class="channels-grid">
        <!-- WhatsApp Concierge (Primary) -->
        <div class="channel-card highlight-card">
          <div class="channel-top">
            <div class="channel-icon-wrap whatsapp-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div class="status-indicator">
              <span class="status-dot"></span>
              <span>Online Now</span>
            </div>
          </div>
          <div class="channel-content">
            <span class="channel-kicker">Immediate Assistance</span>
            <h2 class="channel-title">WhatsApp Concierge</h2>
            <p class="channel-desc">
              Direct consultation with our perfume specialist. Inquire about bottle availability, scent notes, or arrange immediate delivery.
            </p>
          </div>
          <div class="channel-footer">
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent("Hello LUMÈRA LUXE, I would like to inquire about your fragrances.")}`}
              class="btn-channel-primary"
              target="_blank"
              rel="noopener"
            >
              <span>Chat on WhatsApp</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <span class="channel-subtext">{siteConfig.whatsappDisplay}</span>
          </div>
        </div>

        <!-- Email Channel -->
        <div class="channel-card">
          <div class="channel-top">
            <div class="channel-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
          </div>
          <div class="channel-content">
            <span class="channel-kicker">Formal & Gifting</span>
            <h2 class="channel-title">Email Correspondence</h2>
            <p class="channel-desc">
              For corporate gifting, bespoke curation, flacon reservations, and general boutique correspondence.
            </p>
          </div>
          <div class="channel-footer">
            <a href={`mailto:${siteConfig.email}`} class="btn-channel-secondary">
              <span>{siteConfig.email}</span>
            </a>
            <span class="channel-subtext">Replies within 24 hours</span>
          </div>
        </div>

        <!-- Location & Nationwide Dispatch -->
        <div class="channel-card">
          <div class="channel-top">
            <div class="channel-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
          </div>
          <div class="channel-content">
            <span class="channel-kicker">Nationwide Delivery</span>
            <h2 class="channel-title">Doha & Across Qatar</h2>
            <p class="channel-desc">
              Hand-packaged priority dispatch across Doha, Lusail, The Pearl, Al Rayyan, Al Wakrah, and all municipalities.
            </p>
          </div>
          <div class="channel-footer">
            <div class="delivery-badge">24–48h Priority Courier</div>
            <span class="channel-subtext">Same-day delivery on request</span>
          </div>
        </div>
      </div>

      <!-- Clean Concierge Info Ribbon -->
      <div class="info-ribbon">
        <div class="info-item">
          <span class="info-label">Concierge Hours</span>
          <span class="info-value">Daily: 10:00 AM – 10:00 PM (AST)</span>
        </div>
        <div class="info-sep" aria-hidden="true"></div>
        <div class="info-item">
          <span class="info-label">Boutique Territory</span>
          <span class="info-value">Doha, State of Qatar</span>
        </div>
        <div class="info-sep" aria-hidden="true"></div>
        <div class="info-item">
          <span class="info-label">Official Social</span>
          <div class="info-social-links">
            <a href={siteConfig.instagramUrl} target="_blank" rel="noopener" class="social-link">Instagram</a>
            <span class="social-dot">·</span>
            <a href={siteConfig.tiktokUrl} target="_blank" rel="noopener" class="social-link">TikTok</a>
          </div>
        </div>
      </div>

      <!-- Business & Regulatory Information (Bank Review & Licensing Compliance) -->
      <div class="business-entity-panel">
        <div class="entity-card">
          <div class="entity-header">
            <span class="entity-kicker">Corporate & Regulatory Identification · Ministry of Commerce & Industry (MOCI)</span>
            <h2 class="entity-title">{siteConfig.legalEntityName}</h2>
            {siteConfig.legalEntityNameAr && (
              <p class="entity-title-ar" dir="rtl">{siteConfig.legalEntityNameAr}</p>
            )}
          </div>
          <div class="entity-details-grid">
            <div class="entity-detail-col">
              <span class="detail-label">Commercial Registration (CR)</span>
              <span class="detail-value highlight">{siteConfig.commercialRegistrationNumber}</span>
            </div>
            <div class="entity-detail-col">
              <span class="detail-label">Legal Form</span>
              <span class="detail-value">{siteConfig.legalForm}</span>
            </div>
            <div class="entity-detail-col">
              <span class="detail-label">SME Classification</span>
              <span class="detail-value">{siteConfig.smeClassification}</span>
            </div>
            <div class="entity-detail-col">
              <span class="detail-label">Corporate Bank</span>
              <span class="detail-value">{siteConfig.corporateBank}</span>
            </div>
            <div class="entity-detail-col">
              <span class="detail-label">Registered Jurisdiction</span>
              <span class="detail-value">{siteConfig.registeredOffice}</span>
            </div>
            <div class="entity-detail-col">
              <span class="detail-label">Formal Correspondence</span>
              <a href={`mailto:${siteConfig.customerSupportEmail}`} class="detail-value link">{siteConfig.customerSupportEmail}</a>
            </div>
            <div class="entity-detail-col">
              <span class="detail-label">Boutique Concierge</span>
              <a href={`https://wa.me/${siteConfig.whatsappNumber}`} class="detail-value link">{siteConfig.whatsappDisplay}</a>
            </div>
            <div class="entity-detail-col">
              <span class="detail-label">Fulfillment Hub</span>
              <span class="detail-value">{siteConfig.dispatchHub}</span>
            </div>
          </div>
          <div class="entity-footer-note">
            <span>Official boutique registered with the Ministry of Commerce and Industry (State of Qatar). Direct concierge ordering with delivery verification across Qatar.</span>
          </div>
        </div>
      </div>

      <!-- Frequently Asked Questions -->
      <section class="faq-section">
        <div class="faq-header text-center">
          <span class="eyebrow">Client Care</span>
          <h2 class="faq-title">Frequently Asked Questions</h2>
          <p class="faq-subtitle">Clear answers on authenticity, concierge ordering, and Qatar delivery.</p>
        </div>

        <div class="faq-grid">
          <div class="faq-card">
            <span class="faq-num">01</span>
            <h3 class="faq-q">How do I place an order?</h3>
            <p class="faq-a">
              Browse our boutique, add your preferred flacons to your bag, enter your Qatar delivery details, and confirm your order. Our Doha concierge verifies batch availability and coordinates hand-packaged doorstep delivery.
            </p>
          </div>

          <div class="faq-card">
            <span class="faq-num">02</span>
            <h3 class="faq-q">Are all fragrances authentic?</h3>
            <p class="faq-a">
              Without exception. Every flacon is sourced directly through verified European channels, carrying factory batch codes, original packaging, and sealed cellophane wrap.
            </p>
          </div>

          <div class="faq-card">
            <span class="faq-num">03</span>
            <h3 class="faq-q">What are delivery times in Qatar?</h3>
            <p class="faq-a">
              Deliveries within Doha, Lusail, and surrounding municipalities are typically fulfilled within 24 to 48 hours. Urgent same-day delivery can be arranged upon request via WhatsApp.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    background-color: #FFFFFF;
    color: #181513;
  }

  .container-narrow {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .text-center {
    text-align: center;
  }

  /* Hero */
  .contact-hero {
    background: linear-gradient(180deg, #FAF8F5 0%, #FFFFFF 100%);
    border-bottom: 1px solid #F0ECE6;
    padding: clamp(3.5rem, 6vw, 5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
  }

  .eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold-dark);
    margin-bottom: 0.85rem;
    display: inline-block;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #181513;
    margin-bottom: 1rem;
  }

  .hero-lead {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    font-weight: 400;
    line-height: 1.65;
    color: #6D6760;
    max-width: 580px;
    margin: 0 auto;
  }

  /* Main Container */
  .contact-container {
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: 6rem;
  }

  /* 3 Symmetrical Channel Cards */
  .channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 860px) {
    .channels-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .channel-card {
    background-color: #FFFFFF;
    border: 1px solid #E8E3DC;
    border-radius: 4px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  .channel-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
    border-color: #D5C9B8;
  }

  .channel-card.highlight-card {
    border-color: rgba(197, 160, 89, 0.45);
    background: linear-gradient(180deg, #FCFAF7 0%, #FFFFFF 100%);
    box-shadow: 0 4px 20px rgba(197, 160, 89, 0.08);
  }

  .channel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .channel-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #FAF8F5;
    border: 1px solid #E8E3DC;
    color: #181513;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .whatsapp-icon {
    color: #25D366;
    background-color: rgba(37, 211, 102, 0.08);
    border-color: rgba(37, 211, 102, 0.25);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: #1FAF59;
    background-color: rgba(37, 211, 102, 0.08);
    border: 1px solid rgba(37, 211, 102, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: #1FAF59;
    border-radius: 50%;
  }

  .channel-content {
    flex: 1;
    margin-bottom: 1.75rem;
  }

  .channel-kicker {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    margin-bottom: 0.4rem;
  }

  .channel-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    color: #181513;
    margin-bottom: 0.65rem;
    letter-spacing: 0.01em;
  }

  .channel-desc {
    font-size: 0.85rem;
    color: #6D6760;
    line-height: 1.6;
    margin: 0;
  }

  .channel-footer {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: auto;
  }

  .btn-channel-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: #181513;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.85rem 1.25rem;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-channel-primary:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .btn-channel-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FAF8F5;
    color: #181513;
    border: 1px solid #E8E3DC;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.85rem 1.25rem;
    border-radius: 2px;
    transition: all 0.2s ease;
    word-break: break-all;
  }

  .btn-channel-secondary:hover {
    background-color: #FFFFFF;
    border-color: #181513;
    color: #181513;
  }

  .delivery-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FAF8F5;
    border: 1px solid #E8E3DC;
    color: #181513;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.85rem 1.25rem;
    border-radius: 2px;
  }

  .channel-subtext {
    font-size: 0.72rem;
    color: #8F8880;
    text-align: center;
  }

  /* Info Ribbon */
  .info-ribbon {
    background-color: #FAF8F5;
    border: 1px solid #F0ECE6;
    border-radius: 4px;
    padding: 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-around;
    margin-bottom: 4.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .info-ribbon {
      flex-direction: row;
      text-align: left;
    }
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #8F8880;
  }

  .info-value {
    font-size: 0.85rem;
    font-weight: 500;
    color: #181513;
  }

  .info-sep {
    width: 1px;
    height: 32px;
    background-color: #E8E3DC;
    display: none;
  }

  @media (min-width: 768px) {
    .info-sep {
      display: block;
    }
  }

  .info-social-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: #181513;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .social-link:hover {
    color: var(--color-brand-cognac);
  }

  /* Business Entity & Bank Compliance Panel */
  .business-entity-panel {
    margin-bottom: 4rem;
  }

  .entity-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .entity-header {
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .entity-kicker {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-brand-cognac);
    margin-bottom: 0.35rem;
  }

  .entity-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 500;
    color: var(--color-text-main);
    margin: 0;
  }

  .entity-title-ar {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0.35rem 0 0;
    letter-spacing: 0.02em;
  }

  .entity-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .entity-detail-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .detail-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
  }

  .detail-value {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-main);
  }

  .detail-value.highlight {
    color: var(--color-brand-cognac);
    font-weight: 700;
    font-family: monospace;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .detail-value.link {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--color-text-main);
  }

  .detail-value.link:hover {
    color: var(--color-brand-cognac);
  }

  .entity-footer-note {
    background-color: #FAF8F5;
    padding: 0.85rem 1.15rem;
    border-radius: 2px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  /* FAQ Section */
  .faq-section {
    padding-top: 1rem;
  }

  .faq-header {
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .faq-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.3rem);
    font-weight: 400;
    color: #181513;
    margin-bottom: 0.65rem;
    letter-spacing: -0.01em;
  }

  .faq-subtitle {
    font-size: 0.88rem;
    color: #6D6760;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .faq-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .faq-card {
    background-color: #FFFFFF;
    border: 1px solid #F0ECE6;
    border-radius: 4px;
    padding: 2rem 1.75rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-card:hover {
    border-color: #E0D9CF;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
  }

  .faq-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: #C5A059;
    margin-bottom: 0.85rem;
  }

  .faq-q {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: #181513;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .faq-a {
    font-size: 0.84rem;
    color: #6D6760;
    line-height: 1.65;
    margin: 0;
  }

  .faq-a em {
    font-style: normal;
    font-weight: 600;
    color: #181513;
  }
</style>
