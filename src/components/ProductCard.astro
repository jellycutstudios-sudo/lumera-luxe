---
export interface Props {
  product: {
    id: string;
    slug: string;
    brand: string;
    name: string;
    sizeDisplay: string;
    concentration: string;
    priceMinor: number;
    priceDisplay: string;
    stickerPriceMinor?: number | null;
    image: string;
    scentFamilies: string[];
    keyNotes: string[];
    isDraft?: boolean;
  };
  priority?: boolean;
  isLarge?: boolean;
}

const { product, priority = false, isLarge = false } = Astro.props;
---

<article class:list={['luxury-product-card', 'minimal-product-card', 'product-card', { 'card-large': isLarge }]} data-product-id={product.id}>
  <div class="card-media-wrapper">
    <a
      href={`/perfumes/${product.slug}/`}
      class="card-image-link"
      aria-label={`View ${product.brand} ${product.name}`}
      data-astro-prefetch="viewport"
    >
      <div class="card-image-surface">
        <img
          src={product.image}
          alt={`${product.brand} ${product.name}`}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class="bottle-img"
          width="400"
          height="400"
        />
      </div>
    </a>

    <!-- Wishlist Favorite Heart Button in Top Right -->
    <button
      type="button"
      class="card-fav-btn"
      data-action="toggle-fav"
      data-id={product.id}
      aria-label={`Save ${product.brand} ${product.name} to wishlist`}
      title="Save to Wishlist"
    >
      <svg
        class="card-heart-icon"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <span class="sr-only">Save to Wishlist</span>
    </button>
  </div>

  <div class="card-caption">
    <span class="card-brand">{product.brand}</span>
    <h3 class="card-title">
      <a href={`/perfumes/${product.slug}/`} data-astro-prefetch="viewport">{product.name}</a>
    </h3>

    <p class="card-specs">{[product.concentration, product.sizeDisplay].filter(Boolean).join(' · ')}</p>

    <div class="card-price-row">
      <div class="card-price-group">
        <span class="card-price">{product.priceDisplay}</span>
        {product.stickerPriceMinor && product.stickerPriceMinor > product.priceMinor && (
          <span class="card-sticker-price">{Math.round(product.stickerPriceMinor / 100)} QAR</span>
        )}
      </div>
    </div>

    <div class="card-actions-row">
      <a
        href={`/checkout/?product=${encodeURIComponent(product.slug)}&qty=1`}
        class="card-buy-btn"
        aria-label={`Buy now: ${product.brand} ${product.name}`}
      >Buy now</a>
      <button
        type="button"
        class="card-bag-btn quick-add-btn"
        data-action="add-to-bag"
        data-id={product.id}
        data-name={product.name}
        data-brand={product.brand}
        data-size={product.sizeDisplay}
        data-concentration={product.concentration}
        data-price={product.priceMinor}
        data-image={product.image}
        aria-label={`Add ${product.brand} ${product.name} to cart`}
      >
        <span class="plus-icon" aria-hidden="true">+</span>
        <span class="btn-text">Add to cart</span>
      </button>
    </div>
  </div>
</article>

<style is:global>
  /* ==========================================================================
     LUMÈRA LUXE - OPULENT COMMERCIAL PRODUCT CARD
     ========================================================================== */
  .luxury-product-card {
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border: 1px solid #e7dbce;
    border-radius: 8px;
    padding: clamp(0.75rem, 1.5vw, 1rem);
    position: relative;
    width: 100%;
    min-width: 0;
    transition: border-color 180ms ease;
  }

  .luxury-product-card:hover {
    border-color: #c8aa90;
  }

  .card-media-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
    margin-bottom: 0.85rem;
  }

  .card-image-link {
    display: block;
    width: 100%;
    min-width: 0;
  }

  .card-image-surface {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle at 50% 50%, #FFFFFF 0%, #FAF8F5 100%);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    transition: all 300ms ease;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(236, 232, 225, 0.7);
  }

  .card-image-link:hover .card-image-surface {
    background: radial-gradient(circle at 50% 50%, #FFFFFF 0%, #F6F2EA 100%);
  }

  .card-large .card-image-surface {
    aspect-ratio: 1 / 1;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .bottle-img {
    max-width: 90%;
    max-height: 90%;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .card-image-link:hover .bottle-img {
      transform: scale(1.06);
    }
  }

  /* Wishlist Favorite Heart Button in Top Right */
  .card-fav-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6E6862;
    cursor: pointer;
    border: 1px solid rgba(197, 160, 89, 0.35);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all var(--transition-fast);
    z-index: 3;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .card-fav-btn:hover {
    color: var(--color-brand-cognac, #A84112);
    background-color: #FFFFFF;
    border-color: var(--color-brand-cognac, #A84112);
    transform: scale(1.1);
  }

  .card-fav-btn:active {
    transform: scale(0.92);
  }

  .card-fav-btn.is-active {
    color: var(--color-brand-cognac, #A84112);
    background-color: #FFFFFF;
    border-color: rgba(168, 65, 18, 0.4);
    box-shadow: 0 2px 10px rgba(168, 65, 18, 0.25);
  }

  .card-fav-btn.is-active .card-heart-icon {
    fill: var(--color-brand-cognac, #A84112);
    stroke: var(--color-brand-cognac, #A84112);
  }

  /* Captions directly underneath */
  .card-caption {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0.15rem 0;
    min-width: 0;
    width: 100%;
    flex: 1;
  }

  .card-brand {
    font-family: var(--font-body);
    font-size: 0.78125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand-cognac, #A84112);
    margin-bottom: 0.3rem;
    line-height: 1.25;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-title {
    font-family: var(--font-body);
    font-size: clamp(0.96875rem, 1.2vw, 1.0625rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #110F0D;
    margin-bottom: 0.35rem;
    line-height: 1.35;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal;
    min-height: 2.7em;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--color-brand-cognac, #A84112);
  }

  .card-specs {
    font-size: clamp(.7rem, 1vw, .8rem);
    color: #605248;
    line-height: 1.4;
    margin: 0 0 .65rem;
  }

  .card-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    padding-top: 0.45rem;
    border-top: 1px solid rgba(236, 232, 225, 0.75);
    flex-wrap: wrap;
  }

  .card-price-group {
    display: flex;
    align-items: baseline;
    gap: .2rem .45rem;
    flex-wrap: wrap;
  }

  .card-price {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.4vw, 1.25rem);
    font-weight: 700;
    color: #110F0D;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .card-sticker-price {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #8C847B;
    text-decoration: line-through;
    white-space: nowrap;
  }

  .card-actions-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 86px), 1fr));
    gap: .35rem;
    margin-top: auto;
    width: 100%;
  }

  .card-buy-btn,
  .card-bag-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .25rem;
    min-height: 44px;
    min-width: 0;
    padding: .3rem .25rem;
    border: 1px solid #cdbcae;
    border-radius: 5px;
    background: #fff;
    color: #38261f;
    font-family: var(--font-body);
    font-size: clamp(.75rem, 1.1vw, .82rem);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .card-buy-btn {
    border-color: #38261f;
    background: #38261f;
    color: #fff9f2;
  }

  .card-buy-btn:hover {
    border-color: #593b2b;
    background: #593b2b;
    color: #fff9f2;
  }

  .card-bag-btn:hover {
    background: #f5eee7;
  }

  .card-bag-btn .plus-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .card-bag-btn:active {
    transform: scale(0.95);
  }

  .card-bag-btn.added-success {
    background: #25D366 !important;
    border-color: #25D366 !important;
    color: #FFFFFF !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 540px) {
    .luxury-product-card {
      padding: .58rem;
    }

    .card-brand {
      font-size: .68rem;
      letter-spacing: .07em;
    }

    .card-price {
      font-size: 1rem;
    }

    .card-sticker-price {
      font-size: .72rem;
    }

    .card-fav-btn {
      width: 44px;
      height: 44px;
    }
  }

</style>

<script>
  import { getFavorites, toggleFavorite } from '../lib/favorites';

  function syncCardFavStates() {
    const favs = new Set(getFavorites());
    document.querySelectorAll<HTMLElement>('.card-fav-btn').forEach((btn) => {
      const id = btn.getAttribute('data-id');
      if (id && favs.has(id)) {
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
      } else {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-pressed', 'false');
      }
    });
  }

  // Initial sync
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncCardFavStates);
  } else {
    syncCardFavStates();
  }

  // React to changes
  window.addEventListener('favorites-updated', syncCardFavStates);
  window.addEventListener('storage', syncCardFavStates);
  document.addEventListener('astro:page-load', syncCardFavStates);

  // Click delegation
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.card-fav-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    const id = btn.getAttribute('data-id');
    if (id) {
      const isNowFav = toggleFavorite(id);
      btn.classList.toggle('is-active', isNowFav);
      btn.setAttribute('aria-pressed', isNowFav ? 'true' : 'false');
    }
  });
</script>
