---
export interface Props {
  product: {
    id: string;
    slug: string;
    brand: string;
    name: string;
    sizeDisplay: string;
    concentration: string;
    priceMinor: number;
    priceDisplay: string;
    image: string;
    scentFamilies: string[];
    keyNotes: string[];
    isDraft?: boolean;
  };
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const primaryFamily = product.scentFamilies[0] || 'Eau de Parfum';
---

<article class="product-card" data-product-id={product.id}>
  <a
    href={`/perfumes/${product.slug}/`}
    class="product-card-media-link"
    aria-label={`View ${product.brand} ${product.name}`}
  >
    <div class="product-card-media">
      <span class="product-card-tag">{primaryFamily}</span>
      <img
        src={product.image}
        alt={`${product.brand} ${product.name} luxury perfume bottle`}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        class="product-card-img"
        width="360"
        height="450"
      />
    </div>
  </a>

  <div class="product-card-content">
    <div class="product-card-meta">
      <span class="product-card-brand">{product.brand}</span>
      <span class="product-card-volume">{product.sizeDisplay}</span>
    </div>

    <h3 class="product-card-title">
      <a href={`/perfumes/${product.slug}/`}>{product.name}</a>
    </h3>

    <p class="product-card-concentration">{product.concentration}</p>

    <!-- Notes Preview -->
    {
      product.keyNotes && product.keyNotes.length > 0 && (
        <div class="product-card-notes">
          {product.keyNotes.slice(0, 3).map((note) => (
            <span class="card-note-chip">{note}</span>
          ))}
        </div>
      )
    }

    <div class="product-card-footer">
      <span class="product-card-price">{product.priceDisplay}</span>

      <button
        type="button"
        class="btn-add-bag"
        data-action="add-to-bag"
        data-id={product.id}
        data-name={product.name}
        data-brand={product.brand}
        data-size={product.sizeDisplay}
        data-concentration={product.concentration}
        data-price={product.priceMinor}
        data-image={product.image}
        aria-label={`Add ${product.brand} ${product.name} to bag`}
      >
        <span class="btn-text">Add to Bag</span>
        <svg
          class="icon-add"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base),
      border-color var(--transition-base);
    height: 100%;
    position: relative;
  }

  .product-card:hover {
    border-color: rgba(166, 83, 45, 0.4);
    box-shadow: 0 10px 28px rgba(37, 33, 30, 0.06);
    transform: translateY(-2px);
  }

  .product-card-media-link {
    display: block;
    background-color: var(--color-surface-subtle);
    padding: 1.25rem;
    overflow: hidden;
    position: relative;
  }

  .product-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card-tag {
    position: absolute;
    top: -0.25rem;
    left: -0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    padding: 0.2rem 0.5rem;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--color-border-subtle);
    z-index: 2;
  }

  .product-card-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card-img {
      transform: scale(1.035);
    }
  }

  .product-card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.25rem 1rem 1rem 1rem;
    background-color: #FFFFFF;
  }

  .product-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .product-card-brand {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
  }

  .product-card-volume {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-light);
  }

  .product-card-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.25rem;
    color: var(--color-text-main);
  }

  .product-card-title a {
    color: inherit;
  }

  .product-card-title a:hover {
    color: var(--color-accent);
  }

  .product-card-concentration {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.65rem;
  }

  .product-card-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .card-note-chip {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    padding: 0.15rem 0.45rem;
    border-radius: var(--border-radius-sm);
  }

  .product-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .product-card-price {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .btn-add-bag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-main);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    min-height: 38px;
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
  }

  .btn-add-bag:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }

  .btn-add-bag:active {
    transform: scale(0.96);
  }

  .btn-add-bag.added-success {
    background-color: #25D366;
    border-color: #25D366;
    color: #FFFFFF;
  }

  @media (max-width: 480px) {
    .btn-add-bag .btn-text {
      display: none;
    }
    .btn-add-bag {
      padding: 0.5rem;
      min-height: 36px;
      width: 36px;
      justify-content: center;
    }
  }
</style>
