---
export interface Props {
  product: {
    id: string;
    slug: string;
    brand: string;
    name: string;
    sizeDisplay: string;
    concentration: string;
    priceMinor: number;
    priceDisplay: string;
    image: string;
    scentFamilies: string[];
    keyNotes: string[];
    isDraft?: boolean;
  };
  priority?: boolean;
  isLarge?: boolean;
}

const { product, priority = false, isLarge = false } = Astro.props;
---

<article class:list={['minimal-product-card', { 'card-large': isLarge }]} data-product-id={product.id}>
  <div class="card-media-wrapper">
    <a
      href={`/perfumes/${product.slug}/`}
      class="card-image-link"
      aria-label={`View ${product.brand} ${product.name}`}
    >
      <div class="card-image-surface">
        <img
          src={product.image}
          alt={`${product.brand} ${product.name}`}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class="bottle-img"
          width="400"
          height="400"
        />
      </div>
    </a>

    <!-- Minimalist '+' Quick Add Button -->
    <button
      type="button"
      class="quick-add-btn"
      data-action="add-to-bag"
      data-id={product.id}
      data-name={product.name}
      data-brand={product.brand}
      data-size={product.sizeDisplay}
      data-concentration={product.concentration}
      data-price={product.priceMinor}
      data-image={product.image}
      aria-label={`Quick add ${product.brand} ${product.name} to bag`}
      title="Add to Bag"
    >
      <span class="plus-icon">+</span>
      <span class="btn-text sr-only">Add to Bag</span>
    </button>
  </div>

  <div class="card-caption">
    <span class="card-brand">{product.brand}</span>
    <h3 class="card-title">
      <a href={`/perfumes/${product.slug}/`}>{product.name}</a>
    </h3>
    <div class="card-price-row">
      <span class="card-price">{product.priceDisplay}</span>
      <span class="card-dot-sep">·</span>
      <span class="card-size-label">{product.sizeDisplay}</span>
    </div>
    <span class="card-concentration-line">{product.concentration}</span>
  </div>
</article>

<style>
  .minimal-product-card {
    display: flex;
    flex-direction: column;
    background-color: transparent;
    border: none;
    position: relative;
    width: 100%;
    min-width: 0;
    transition: opacity var(--transition-fast);
  }

  .card-media-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
    margin-bottom: 0.75rem;
  }

  .card-image-link {
    display: block;
    width: 100%;
    min-width: 0;
  }

  .card-image-surface {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    transition: all var(--transition-base);
    overflow: hidden;
    position: relative;
  }

  .card-image-link:hover .card-image-surface {
    border-color: var(--color-gold);
    box-shadow: 0 8px 24px var(--color-gold-glow);
  }

  .card-large .card-image-surface {
    aspect-ratio: 1 / 1;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .bottle-img {
    max-width: 90%;
    max-height: 90%;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .card-image-link:hover .bottle-img {
      transform: scale(1.04);
    }
  }

  /* Minimalist '+' Quick Add Button in Top Right */
  .quick-add-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    border: 1px solid var(--color-gold-border);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: all var(--transition-fast);
    z-index: 2;
  }

  .quick-add-btn:hover {
    background: var(--color-brand-gradient);
    border-color: transparent;
    color: #FFFFFF;
    transform: scale(1.1);
    box-shadow: 0 3px 10px var(--color-brand-cognac-glow);
  }

  .quick-add-btn.added-success {
    background-color: #25D366;
    color: #FFFFFF;
  }

  .plus-icon {
    font-weight: 300;
    margin-top: -1px;
  }

  /* Captions directly underneath */
  .card-caption {
    display: flex;
    flex-direction: column;
    padding: 0.35rem 0.1rem 0;
    min-width: 0;
    width: 100%;
  }

  .card-brand {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
    margin-bottom: 0.2rem;
    line-height: 1.2;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #1A1816;
    margin-bottom: 0.35rem;
    line-height: 1.25;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-title a {
    color: inherit;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 0.15rem;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-price {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1A1816;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .card-dot-sep {
    font-size: 0.65rem;
    color: var(--color-text-light);
  }

  .card-size-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .card-concentration-line {
    font-size: 0.6875rem;
    color: var(--color-text-light);
    line-height: 1.3;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
