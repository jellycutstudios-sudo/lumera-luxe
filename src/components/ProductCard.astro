---
export interface Props {
  product: {
    id: string;
    slug: string;
    brand: string;
    name: string;
    sizeDisplay: string;
    concentration: string;
    priceMinor: number;
    priceDisplay: string;
    stickerPriceMinor?: number | null;
    image: string;
    scentFamilies: string[];
    keyNotes: string[];
    isDraft?: boolean;
  };
  priority?: boolean;
  isLarge?: boolean;
}

const { product, priority = false, isLarge = false } = Astro.props;
---

<article class:list={['minimal-product-card', 'product-card', { 'card-large': isLarge }]} data-product-id={product.id}>
  <div class="card-media-wrapper">
    <a
      href={`/perfumes/${product.slug}/`}
      class="card-image-link"
      aria-label={`View ${product.brand} ${product.name}`}
      data-astro-prefetch="viewport"
    >
      <div class="card-image-surface">
        <img
          src={product.image}
          alt={`${product.brand} ${product.name}`}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class="bottle-img"
          width="400"
          height="400"
        />
      </div>
    </a>

    <!-- Wishlist Favorite Heart Button in Top Left -->
    <button
      type="button"
      class="card-fav-btn"
      data-action="toggle-fav"
      data-id={product.id}
      aria-label={`Save ${product.brand} ${product.name} to wishlist`}
      title="Save to Wishlist"
    >
      <svg
        class="card-heart-icon"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <span class="sr-only">Save to Wishlist</span>
    </button>

    <!-- Minimalist '+' Quick Add Button in Top Right -->
    <button
      type="button"
      class="quick-add-btn"
      data-action="add-to-bag"
      data-id={product.id}
      data-name={product.name}
      data-brand={product.brand}
      data-size={product.sizeDisplay}
      data-concentration={product.concentration}
      data-price={product.priceMinor}
      data-image={product.image}
      aria-label={`Quick add ${product.brand} ${product.name} to bag`}
      title="Add to Bag"
    >
      <span class="plus-icon">+</span>
      <span class="btn-text sr-only">Add to Bag</span>
    </button>
  </div>

  <div class="card-caption">
    <span class="card-brand">{product.brand}</span>
    <h3 class="card-title">
      <a href={`/perfumes/${product.slug}/`} data-astro-prefetch="viewport">{product.name}</a>
    </h3>
    <div class="card-specs">
      {product.concentration && <span class="card-concentration">{product.concentration}</span>}
      {product.concentration && product.sizeDisplay && <span class="card-dot-sep">·</span>}
      {product.sizeDisplay && <span class="card-size-label">{product.sizeDisplay}</span>}
    </div>
    <div class="card-price-row">
      {product.stickerPriceMinor && product.stickerPriceMinor > product.priceMinor && (
        <span class="card-sticker-price">{Math.round(product.stickerPriceMinor / 100)} QAR</span>
      )}
      <span class="card-price">{product.priceDisplay}</span>
    </div>
  </div>
</article>

<style is:global>
  .minimal-product-card {
    display: flex;
    flex-direction: column;
    background-color: transparent;
    border: none;
    position: relative;
    width: 100%;
    min-width: 0;
    transition: opacity var(--transition-fast);
  }

  .card-media-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
    margin-bottom: 0.75rem;
  }

  .card-image-link {
    display: block;
    width: 100%;
    min-width: 0;
  }

  .card-image-surface {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    transition: all var(--transition-base);
    overflow: hidden;
    position: relative;
  }

  .card-image-link:hover .card-image-surface {
    border-color: var(--color-gold);
    box-shadow: 0 10px 28px rgba(197, 160, 89, 0.22);
  }

  .card-large .card-image-surface {
    aspect-ratio: 1 / 1;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .bottle-img {
    max-width: 90%;
    max-height: 90%;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .card-image-link:hover .bottle-img {
      transform: scale(1.04);
    }
  }

  /* Wishlist Favorite Heart Button in Top Left */
  .card-fav-btn {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8C867F;
    cursor: pointer;
    border: 1px solid var(--color-gold-border);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: all var(--transition-fast);
    z-index: 2;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Expand touch target to 48x48px for comfortable finger tapping */
  .card-fav-btn::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .card-fav-btn:hover {
    color: var(--color-brand-cognac);
    background-color: #FFFFFF;
    border-color: var(--color-brand-cognac);
    transform: scale(1.08);
  }

  .card-fav-btn:active {
    transform: scale(0.90);
  }

  .card-fav-btn.is-active {
    color: var(--color-brand-cognac);
    background-color: #FFFFFF;
    border-color: rgba(200, 90, 36, 0.4);
    box-shadow: 0 2px 8px rgba(200, 90, 36, 0.2);
  }

  .card-fav-btn.is-active .card-heart-icon {
    fill: var(--color-brand-cognac);
    stroke: var(--color-brand-cognac);
  }

  /* Minimalist '+' Quick Add Button in Top Right */
  .quick-add-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    border: 1px solid var(--color-gold-border);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: all var(--transition-fast);
    z-index: 2;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Expand touch target to 48x48px */
  .quick-add-btn::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .quick-add-btn:hover {
    background: var(--color-brand-gradient);
    border-color: transparent;
    color: #FFFFFF;
    transform: scale(1.08);
    box-shadow: 0 3px 10px var(--color-brand-cognac-glow);
  }

  .quick-add-btn:active {
    transform: scale(0.90);
  }

  .quick-add-btn.added-success {
    background-color: #25D366;
    color: #FFFFFF;
  }

  .plus-icon {
    font-weight: 300;
    margin-top: -1px;
  }

  /* Captions directly underneath */
  .card-caption {
    display: flex;
    flex-direction: column;
    padding: 0 0.15rem;
    min-width: 0;
    width: 100%;
    gap: 0;
  }

  .card-brand {
    font-family: var(--font-body);
    font-size: clamp(0.72rem, 1.1vw, 0.78125rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin-bottom: 0.25rem;
    line-height: 1.25;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-title {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.4vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #181513;
    margin-bottom: 0.35rem;
    line-height: 1.35;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal;
    min-height: 2.7em;
  }

  .card-title a {
    color: inherit;
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--color-brand-cognac);
  }

  .card-specs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 1.1vw, 0.8125rem);
    color: var(--color-text-muted);
    line-height: 1.35;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0 0 0.45rem 0;
  }

  .card-concentration {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-dot-sep {
    font-size: 0.65rem;
    color: var(--color-text-light);
    opacity: 0.75;
  }

  .card-size-label {
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .card-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    border: none;
    min-width: 0;
    flex-wrap: wrap;
  }

  .card-sticker-price {
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 1.1vw, 0.875rem);
    font-weight: 400;
    color: #8A8580;
    text-decoration: line-through;
    text-decoration-color: rgba(138, 133, 128, 0.75);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .card-price {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.8vw, 1.18rem);
    font-weight: 700;
    color: #181513;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  import { getFavorites, toggleFavorite } from '../lib/favorites';

  function syncCardFavStates() {
    const favs = new Set(getFavorites());
    document.querySelectorAll<HTMLElement>('.card-fav-btn').forEach((btn) => {
      const id = btn.getAttribute('data-id');
      if (id && favs.has(id)) {
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
      } else {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-pressed', 'false');
      }
    });
  }

  // Initial sync
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncCardFavStates);
  } else {
    syncCardFavStates();
  }

  // React to changes
  window.addEventListener('favorites-updated', syncCardFavStates);
  window.addEventListener('storage', syncCardFavStates);
  document.addEventListener('astro:page-load', syncCardFavStates);

  // Click delegation
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.card-fav-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    const id = btn.getAttribute('data-id');
    if (id) {
      const isNowFav = toggleFavorite(id);
      btn.classList.toggle('is-active', isNowFav);
      btn.setAttribute('aria-pressed', isNowFav ? 'true' : 'false');
    }
  });
</script>
