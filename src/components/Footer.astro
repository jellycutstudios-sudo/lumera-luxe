---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <!-- Perfume House Guarantees Ribbon -->
    <div class="footer-guarantees-bar">
      <div class="guarantee-cell">
        <div class="guarantee-icon-wrap">
          <!-- Perfume Flacon Line Icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="2" width="6" height="4" rx="0.5"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <rect x="5" y="8" width="14" height="13" rx="2"></rect>
            <line x1="9" y1="13" x2="15" y2="13"></line>
          </svg>
        </div>
        <div class="guarantee-text">
          <span class="guarantee-title">100% Genuine Perfumes</span>
          <span class="guarantee-sub">Verified authentic European batches</span>
        </div>
      </div>

      <div class="guarantee-cell">
        <div class="guarantee-icon-wrap">
          <!-- Luxury Doorstep Courier Icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="guarantee-text">
          <span class="guarantee-title">Doorstep Qatar Courier</span>
          <span class="guarantee-sub">Complimentary delivery across Qatar</span>
        </div>
      </div>

      <div class="guarantee-cell">
        <div class="guarantee-icon-wrap">
          <!-- WhatsApp Concierge Line Icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
            <path d="M15.5 13.5v1.2a1.3 1.3 0 0 1-1.4 1.3 7.8 7.8 0 0 1-5.6-5.6 1.3 1.3 0 0 1 1.3-1.4h1.2a.9.9 0 0 1 .9.7l.3 1.2a.9.9 0 0 1-.3.9l-.6.6a5.5 5.5 0 0 0 2.6 2.6l.6-.6a.9.9 0 0 1 .9-.3l1.2.3a.9.9 0 0 1 .7.9z"></path>
          </svg>
        </div>
        <div class="guarantee-text">
          <span class="guarantee-title">Direct WhatsApp Advice</span>
          <span class="guarantee-sub">Personal scent guidance & ordering</span>
        </div>
      </div>
    </div>

    <!-- Main Footer Columns -->
    <div class="footer-layout">
      <!-- Left: Iconic Brand Wordmark & Copyright -->
      <div class="footer-brand-side">
        <a href="/" class="footer-wordmark-link" aria-label="LUMÈRA LUXE">
          <img
            src="/assets/lumera-logo.svg"
            alt="LUMÈRA LUXE"
            class="footer-logo-minimal"
            width="180"
            height="32"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="footer-tagline">
          Haute Parfumerie · Authentic Fragrances in Qatar.
        </p>
        <p class="footer-legal-copy">
          &copy; {new Date().getFullYear()} {siteConfig.legalEntityName} · C.R. #{siteConfig.commercialRegistrationNumber} · Doha, State of Qatar.
        </p>
        <p class="footer-registration-note">
          Licensed under the Ministry of Commerce & Industry (State of Qatar). Assisted concierge order confirmation via WhatsApp.
        </p>
      </div>

      <!-- Right: Minimalist 3-Column Navigation -->
      <div class="footer-links-columns">
        <div class="footer-col">
          <h4 class="col-title">Collection</h4>
          <ul class="col-list">
            <li><a href="/shop/">All Fragrances</a></li>
            <li><a href="/shop/?family=fresh">Fresh & Citrus</a></li>
            <li><a href="/shop/?family=floral">Floral & Rose</a></li>
            <li><a href="/shop/?family=oriental">Amber & Oriental</a></li>
            <li><a href="/shop/?family=woody">Woody & Earthy</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Discovery & Care</h4>
          <ul class="col-list">
            <li><a href="/fragrance-finder/">Fragrance Finder Quiz</a></li>
            <li><a href="/layering/">The Art of Layering</a></li>
            <li><a href="/scent-styling/">Scent & Style Alignment</a></li>
            <li><a href="/contact/">Concierge Contact</a></li>
            <li><a href="/our-story/">The House</a></li>
            <li>
              <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener" class="social-link-item">
                <span>WhatsApp Concierge</span>
              </a>
            </li>
            <li>
              <a href={siteConfig.instagramUrl} target="_blank" rel="noopener" class="social-link-item">
                <span>Instagram</span>
              </a>
            </li>
            <li>
              <a href={siteConfig.tiktokUrl} target="_blank" rel="noopener" class="social-link-item">
                <span>TikTok</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Legal & Policies</h4>
          <ul class="col-list">
            <li><a href="/terms-and-conditions/">Terms & Conditions</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/shipping-delivery/">Shipping & Delivery</a></li>
            <li><a href="/returns-refunds/">Returns & Refunds</a></li>
            <li><a href="/cancellation-policy/">Cancellation Policy</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #FFFFFF;
    border-top: 1px solid var(--color-border);
    padding-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.75rem);
    margin-top: auto;
  }

  @media (max-width: 767px) {
    .site-footer {
      padding-bottom: calc(clamp(2.5rem, 4vw, 3.75rem) + 64px);
    }
  }

  /* Guarantees bar */
  .footer-guarantees-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .footer-guarantees-bar {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .guarantee-cell {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .guarantee-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #FAF9F6;
    border: 1px solid #ECEAE5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .guarantee-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .guarantee-title {
    font-size: clamp(0.8125rem, 1.2vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .guarantee-sub {
    font-size: clamp(0.75rem, 1.1vw, 0.8125rem);
    color: var(--color-text-muted);
    line-height: 1.35;
  }

  .footer-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 860px) {
    .footer-layout {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 4rem;
    }
  }

  .footer-brand-side {
    display: flex;
    flex-direction: column;
  }

  .footer-logo-minimal {
    height: 30px;
    width: auto;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-size: clamp(0.84rem, 1.2vw, 0.9rem);
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .footer-legal-copy {
    font-size: clamp(0.72rem, 1vw, 0.76rem);
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    line-height: 1.45;
  }

  .footer-registration-note {
    font-size: clamp(0.75rem, 1vw, 0.8125rem);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 340px;
    margin: 0;
  }

  .footer-links-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-links-columns {
      grid-template-columns: repeat(3, 1fr);
      gap: 3.5rem;
    }
  }

  .col-title {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 1.1vw, 0.8125rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col-list a {
    font-size: clamp(0.78125rem, 1.1vw, 0.84375rem);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .col-list a:hover {
    color: var(--color-text-main);
  }

  .social-link-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-link-item svg {
    color: var(--color-text-light);
    transition: color var(--transition-fast);
  }

  .social-link-item:hover svg {
    color: var(--color-accent);
  }
</style>
