---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-layout">
      <!-- Left: Iconic Brand Wordmark & Copyright -->
      <div class="footer-brand-side">
        <a href="/" class="footer-wordmark-link" aria-label="LUMÈRA LUXE">
          <img
            src="/assets/lumera-logo.svg"
            alt="LUMÈRA LUXE"
            class="footer-logo-minimal"
            width="180"
            height="32"
          />
        </a>
        <p class="footer-legal-copy">
          &copy; {new Date().getFullYear()} {siteConfig.brandName}. Doha, Qatar.
        </p>
      </div>

      <!-- Right: Minimalist 3-Column Navigation -->
      <div class="footer-links-columns">
        <div class="footer-col">
          <h4 class="col-title">Shop</h4>
          <ul class="col-list">
            <li><a href="/shop/">All Fragrances</a></li>
            <li><a href="/shop/?family=floral">Floral</a></li>
            <li><a href="/shop/?family=oriental">Amber & Oriental</a></li>
            <li><a href="/shop/?family=woody">Woody & Musk</a></li>
            <li><a href="/shop/?family=fresh">Fresh & Citrus</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Follow Us</h4>
          <ul class="col-list">
            <li>
              <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener">
                WhatsApp Concierge
              </a>
            </li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="https://pinterest.com" target="_blank" rel="noopener">Pinterest</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Customer Care</h4>
          <ul class="col-list">
            <li><a href="/contact/">Concierge Contact</a></li>
            <li><a href="/delivery-returns/">Delivery & Returns</a></li>
            <li><a href="/privacy/">Privacy Policy</a></li>
            <li><a href="/our-story/">Our Story</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #FFFFFF;
    border-top: 1px solid var(--color-border);
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    margin-top: auto;
  }

  .footer-layout {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  @media (min-width: 860px) {
    .footer-layout {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 4rem;
    }
  }

  .footer-brand-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .footer-logo-minimal {
    height: 30px;
    width: auto;
    margin-bottom: 2rem;
  }

  .footer-legal-copy {
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    text-transform: uppercase;
  }

  .footer-links-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-links-columns {
      grid-template-columns: repeat(3, 1fr);
      gap: 3.5rem;
    }
  }

  .col-title {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col-list a {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .col-list a:hover {
    color: var(--color-text-main);
  }
</style>
