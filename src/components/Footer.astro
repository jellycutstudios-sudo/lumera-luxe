---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <!-- Perfume House Guarantees Ribbon -->
    <div class="footer-guarantees-bar">
      <div class="guarantee-cell">
        <div class="guarantee-icon-wrap">
          <!-- Perfume Bottle Line Icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="2" width="6" height="4" rx="0.5"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <rect x="5" y="8" width="14" height="13" rx="2"></rect>
            <line x1="9" y1="13" x2="15" y2="13"></line>
          </svg>
        </div>
        <div class="guarantee-text">
          <span class="guarantee-title">100% Genuine Perfumes</span>
          <span class="guarantee-sub">Verified authentic European batches</span>
        </div>
      </div>

      <div class="guarantee-cell">
        <div class="guarantee-icon-wrap">
          <!-- Luxury Doorstep Courier Icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="guarantee-text">
          <span class="guarantee-title">Express 6-Hour Delivery</span>
          <span class="guarantee-sub">Free on purchases above 300 QAR</span>
        </div>
      </div>

      <div class="guarantee-cell">
        <div class="guarantee-icon-wrap">
          <!-- Shield Guarantee Icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="guarantee-text">
          <span class="guarantee-title">6-Hour Return Guarantee</span>
          <span class="guarantee-sub">Returns accepted even if opened & used</span>
        </div>
      </div>

      <div class="guarantee-cell">
        <div class="guarantee-icon-wrap">
          <!-- WhatsApp Concierge Line Icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
            <path d="M15.5 13.5v1.2a1.3 1.3 0 0 1-1.4 1.3 7.8 7.8 0 0 1-5.6-5.6 1.3 1.3 0 0 1 1.3-1.4h1.2a.9.9 0 0 1 .9.7l.3 1.2a.9.9 0 0 1-.3.9l-.6.6a5.5 5.5 0 0 0 2.6 2.6l.6-.6a.9.9 0 0 1 .9-.3l1.2.3a.9.9 0 0 1 .7.9z"></path>
          </svg>
        </div>
        <div class="guarantee-text">
          <span class="guarantee-title">Direct WhatsApp Concierge</span>
          <span class="guarantee-sub">Instant ordering: +974 6667 5166</span>
        </div>
      </div>
    </div>

    <!-- Main Footer Columns -->
    <div class="footer-layout">
      <!-- Left: Brand wordmark -->
      <div class="footer-brand-side">
        <a href="/" class="footer-wordmark-link" aria-label="LUMÈRA LUXE">
          <img
            src="/assets/lumera-logo.svg"
            alt="LUMÈRA LUXE"
            class="footer-logo-minimal"
            width="344"
            height="52"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="footer-tagline">
          Haute Parfumerie · Authentic Fragrances in Qatar.
        </p>
      </div>

      <!-- Right: Minimalist 3-Column Navigation -->
      <div class="footer-links-columns">
        <div class="footer-col">
          <h4 class="col-title">Collection</h4>
          <ul class="col-list">
            <li><a href="/shop/">All Perfumes</a></li>
            <li><a href="/shop/?family=fresh">Fresh & Citrus</a></li>
            <li><a href="/shop/?family=floral">Floral & Rose</a></li>
            <li><a href="/shop/?family=oriental">Amber & Oriental</a></li>
            <li><a href="/shop/?family=woody">Woody & Earthy</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Discovery & Care</h4>
          <ul class="col-list">
            <li><a href="/fragrance-finder/">Perfume Quiz</a></li>
            <li><a href="/layering/">The Art of Layering</a></li>
            <li><a href="/scent-styling/">Scent & Style Alignment</a></li>
            <li><a href="/contact/">Concierge Contact</a></li>
            <li><a href="/our-story/">The House</a></li>
            <li>
              <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener" class="social-link-item">
                <span>WhatsApp Concierge</span>
              </a>
            </li>
            <li>
              <a href={siteConfig.instagramUrl} target="_blank" rel="noopener" class="social-link-item">
                <span>Instagram</span>
              </a>
            </li>
            <li>
              <a href={siteConfig.tiktokUrl} target="_blank" rel="noopener" class="social-link-item">
                <span>TikTok</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">Legal & Policies</h4>
          <ul class="col-list">
            <li><a href="/terms-and-conditions/">Terms & Conditions</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/shipping-delivery/">Shipping & Delivery</a></li>
            <li><a href="/returns-refunds/">Returns & Refunds</a></li>
            <li><a href="/cancellation-policy/">Cancellation Policy</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-meta">
      <p class="footer-legal-copy">
        &copy; {new Date().getFullYear()} {siteConfig.legalEntityName} · C.R. #{siteConfig.commercialRegistrationNumber} · Doha, State of Qatar.
      </p>
      <p class="footer-registration-note">
        Licensed under the Ministry of Commerce & Industry (State of Qatar). Assisted concierge order confirmation via WhatsApp.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-ink: #fff8ef;
    --footer-muted: #f1ded1;
    --footer-line: rgb(255 237 221 / 24%);
    background-color: #602719;
    background-image: linear-gradient(112deg, #853620, #602719 46%, #361a14);
    color: var(--footer-ink);
    border-top: 1px solid #b57153;
    padding-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.75rem);
    margin-top: auto;
  }

  .site-footer a:focus-visible {
    outline-color: var(--footer-ink);
  }

  /* Guarantees bar */
  .footer-guarantees-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem clamp(1rem, 2vw, 2rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--footer-line);
  }

  @media (min-width: 560px) {
    .footer-guarantees-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .footer-guarantees-bar {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .guarantee-cell {
    display: flex;
    align-items: flex-start;
    gap: clamp(.65rem, 1.2vw, .95rem);
  }

  .guarantee-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgb(255 237 221 / 8%);
    border: 1px solid var(--footer-line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffdfbd;
    flex-shrink: 0;
  }

  .guarantee-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .guarantee-title {
    font-size: .9375rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--footer-ink);
  }

  .guarantee-sub {
    font-size: .9375rem;
    color: var(--footer-muted);
    line-height: 1.35;
  }

  .footer-layout {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
  }

  @media (min-width: 860px) {
    .footer-layout {
      grid-template-columns: minmax(0, .85fr) minmax(0, 1.75fr);
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  .footer-brand-side {
    display: flex;
    flex-direction: column;
  }

  .footer-wordmark-link {
    align-self: flex-start;
    margin-bottom: .9rem;
  }

  .footer-logo-minimal {
    width: clamp(11.5rem, 16vw, 15rem);
    height: auto;
    filter: brightness(0) invert(1);
    opacity: .96;
  }

  .footer-tagline {
    font-size: 1rem;
    color: var(--footer-muted);
    max-width: 38ch;
  }

  .footer-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .6rem 2rem;
    margin-top: clamp(1.75rem, 3.5vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--footer-line);
  }

  .footer-legal-copy,
  .footer-registration-note {
    font-size: .875rem;
    color: var(--footer-muted);
    line-height: 1.5;
  }

  .footer-registration-note {
    max-width: 54ch;
  }

  .footer-links-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem clamp(1rem, 3vw, 3rem);
  }

  @media (min-width: 640px) {
    .footer-links-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .col-title {
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--footer-ink);
    margin-bottom: .9rem;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col-list a {
    font-size: .9375rem;
    color: var(--footer-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .col-list a:hover,
  .col-list a:focus-visible {
    color: var(--footer-ink);
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  @media (width < 768px) {
    .site-footer {
      /* Keep the fixed mobile controls clear of footer text and links. */
      padding-bottom: calc(clamp(2.5rem, 4vw, 3.75rem) + 76px + env(safe-area-inset-bottom, 0px));
    }

    .guarantee-title,
    .guarantee-sub,
    .footer-registration-note,
    .col-list a {
      font-size: .875rem;
    }

    .col-title {
      font-size: .8125rem;
    }
  }

  .social-link-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
