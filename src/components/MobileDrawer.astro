---
import { siteConfig } from '../data/site';
import productsData from '../data/products.json';
---

<!-- Mobile Navigation Drawer Overlay (Root Level, outside header) -->
<div class="mobile-nav-backdrop" id="mobile-nav-backdrop" hidden></div>

<aside
  class="mobile-nav-drawer"
  id="mobile-nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation Menu"
  hidden
>
  <!-- Top Bar: Brand & Minimal Close Button -->
  <div class="mobile-drawer-top">
    <a href="/" class="mobile-drawer-brand" aria-label="LUMÈRA LUXE Home">
      <img
        src="/assets/lumera-logo.svg"
        alt="LUMÈRA LUXE"
        class="mobile-drawer-logo"
        width="130"
        height="22"
      />
    </a>
    <button
      class="mobile-drawer-close"
      id="mobile-nav-close-btn"
      aria-label="Close navigation menu"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Scrollable Minimal Content -->
  <div class="mobile-drawer-content">
    <nav class="drawer-nav-menu" aria-label="Mobile Navigation">
      <!-- Group 1: Fragrance Collection -->
      <div class="nav-group">
        <span class="nav-group-eyebrow">Collection</span>
        <ul class="nav-items-list">
          <li>
            <a href="/shop/" class="drawer-primary-link">
              <span>All Fragrances</span>
              <span class="drawer-count">({productsData.length})</span>
            </a>
          </li>
          <li>
            <button type="button" class="drawer-primary-link drawer-action-trigger" id="drawer-families-btn">
              <span>Scent Families</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </li>
          <li>
            <button type="button" class="drawer-primary-link drawer-action-trigger" id="drawer-open-wishlist-btn">
              <span style="display: inline-flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
                <span>Wishlist</span>
              </span>
              <span class="drawer-count" id="drawer-wishlist-count">(0)</span>
            </button>
          </li>
        </ul>
      </div>

      <!-- Group 2: The Maison -->
      <div class="nav-group">
        <span class="nav-group-eyebrow">The Maison</span>
        <ul class="nav-items-list">
          <li>
            <a href="/our-story/" class="drawer-sub-link">Our Story & Craft</a>
          </li>
          <li>
            <a href="/delivery-returns/" class="drawer-sub-link">Qatar Priority Delivery</a>
          </li>
          <li>
            <a href="/contact/" class="drawer-sub-link">Contact & Concierge</a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Refined Concierge / Support Card -->
    <div class="drawer-support-box">
      <button type="button" class="drawer-support-btn" id="drawer-support-modal-btn">
        <div class="drawer-support-icon">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
            <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
          </svg>
        </div>
        <div class="drawer-support-text">
          <span class="support-title">Personal Scent Support</span>
          <span class="support-subtitle">Consultation & order assistance</span>
        </div>
        <span class="drawer-support-arrow">→</span>
      </button>
    </div>
  </div>

  <!-- Minimalist Bottom Bar -->
  <div class="mobile-drawer-bottom">
    <div class="drawer-socials">
      <a href={siteConfig.instagramUrl} target="_blank" rel="noopener">Instagram</a>
      <span class="social-dot">·</span>
      <a href={siteConfig.tiktokUrl} target="_blank" rel="noopener">TikTok</a>
    </div>
    <span class="drawer-guarantee-note">Doha, Qatar · 100% Genuine Guaranteed</span>
  </div>
</aside>

<style>
  [hidden] {
    display: none !important;
  }

  .mobile-nav-backdrop[hidden],
  .mobile-nav-drawer[hidden] {
    display: none !important;
  }

  /* Full Screen Backdrop */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(26, 24, 22, 0.45);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 998;
    animation: drawerFadeIn 220ms ease;
  }

  /* Sliding Panel (Pure White, Quiet Luxury) */
  .mobile-nav-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    max-width: 340px;
    background-color: #FFFFFF !important;
    z-index: 999;
    display: flex;
    flex-direction: column;
    box-shadow: 10px 0 40px rgba(0, 0, 0, 0.12);
    animation: drawerSlideLeft 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerSlideLeft {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes drawerFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Top Bar */
  .mobile-drawer-top {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: #FFFFFF;
    flex-shrink: 0;
  }

  .mobile-drawer-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
  }

  .mobile-drawer-close {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    background: transparent;
    border: none;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .mobile-drawer-close:hover {
    background-color: var(--color-surface);
  }

  /* Scrollable Navigation Body */
  .mobile-drawer-content {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1.5rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .drawer-nav-menu {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .nav-group-eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.65rem;
    padding-left: 0.2rem;
  }

  .nav-items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Primary Editorial Links */
  .drawer-primary-link {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-text-main);
    text-decoration: none;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    transition: color var(--transition-fast), background-color var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
  }

  .drawer-primary-link:hover,
  .drawer-primary-link:active {
    color: var(--color-brand-cognac);
    background-color: var(--color-surface);
  }

  .drawer-count {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-light);
    letter-spacing: 0.02em;
  }

  .drawer-action-trigger svg {
    color: var(--color-text-light);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .drawer-action-trigger:hover svg {
    transform: translateX(2px);
    color: var(--color-brand-cognac);
  }

  /* Secondary Sub-Links */
  .drawer-sub-link {
    display: block;
    padding: 0.6rem 0.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 6px;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .drawer-sub-link:hover,
  .drawer-sub-link:active {
    color: var(--color-text-main);
    background-color: var(--color-surface);
  }

  /* Refined Concierge / Support Card */
  .drawer-support-box {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .drawer-support-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background-color: #FAF9F6;
    border: 1px solid #ECEAE5;
    border-radius: 10px;
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
  }

  .drawer-support-btn:hover,
  .drawer-support-btn:active {
    background-color: #FFFFFF;
    border-color: var(--color-brand-cognac);
    box-shadow: 0 4px 14px rgba(138, 74, 40, 0.08);
  }

  .drawer-support-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    color: var(--color-brand-cognac);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .drawer-support-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .support-title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .support-subtitle {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .drawer-support-arrow {
    color: var(--color-text-light);
    font-size: 0.95rem;
    transition: transform var(--transition-fast);
  }

  .drawer-support-btn:hover .drawer-support-arrow {
    transform: translateX(2px);
    color: var(--color-brand-cognac);
  }

  /* Minimalist Bottom Bar */
  .mobile-drawer-bottom {
    padding: 1rem 1.25rem max(env(safe-area-inset-bottom, 1rem), 1rem);
    border-top: 1px solid var(--color-border-subtle);
    background-color: #FAF9F6;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .drawer-socials {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .drawer-socials a {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .drawer-socials a:hover {
    color: var(--color-brand-cognac);
  }

  .social-dot {
    font-size: 0.75rem;
    color: var(--color-border);
  }

  .drawer-guarantee-note {
    font-size: 0.6875rem;
    color: var(--color-text-light);
    letter-spacing: 0.03em;
  }
</style>

<script is:inline>
  // DOM Elements
  var backdrop = document.getElementById('mobile-nav-backdrop');
  var drawer = document.getElementById('mobile-nav-drawer');
  var openBtn = document.getElementById('menu-toggle-btn');
  var closeBtn = document.getElementById('mobile-nav-close-btn');
  var familiesBtn = document.getElementById('drawer-families-btn');
  var supportBtn = document.getElementById('drawer-support-modal-btn');

  function openDrawer() {
    if (backdrop) backdrop.hidden = false;
    if (drawer) drawer.hidden = false;
    if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (backdrop) backdrop.hidden = true;
    if (drawer) drawer.hidden = true;
    if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);

  // Scent Families button opens the Scent Families modal
  if (familiesBtn) {
    familiesBtn.addEventListener('click', function () {
      closeDrawer();
      if (typeof window.openFamiliesModal === 'function') {
        window.openFamiliesModal();
      }
    });
  }

  // Personal Scent Support button opens the Support modal
  if (supportBtn) {
    supportBtn.addEventListener('click', function () {
      closeDrawer();
      if (typeof window.openSupportModal === 'function') {
        window.openSupportModal();
      }
    });
  }

  // Wishlist button opens Wishlist drawer
  var drawerWishlistBtn = document.getElementById('drawer-open-wishlist-btn');
  if (drawerWishlistBtn) {
    drawerWishlistBtn.addEventListener('click', function () {
      closeDrawer();
    });
  }

  function syncDrawerWishlist() {
    var countEl = document.getElementById('drawer-wishlist-count');
    try {
      var favs = JSON.parse(localStorage.getItem('lumera_favorites_v1') || '[]');
      if (countEl) countEl.textContent = '(' + favs.length + ')';
    } catch (e) {}
  }
  window.addEventListener('favorites-updated', syncDrawerWishlist);
  window.addEventListener('focus', syncDrawerWishlist);
  syncDrawerWishlist();

  // Close on Escape
  window.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer && !drawer.hidden) {
      closeDrawer();
    }
  });

  // Close on internal link click
  if (drawer) {
    drawer.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        closeDrawer();
      });
    });
  }
</script>
