---
import { siteConfig } from '../data/site';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello LUMÈRA LUXE, I would like help choosing a fragrance.')}`;
const scentFamilies = [
  { label: 'Fresh & Citrus', slug: 'fresh' },
  { label: 'Floral & Rose', slug: 'floral' },
  { label: 'Amber & Oriental', slug: 'oriental' },
  { label: 'Woody & Earthy', slug: 'woody' }
];
---

<div class="mobile-menu-backdrop" id="mobile-nav-backdrop" hidden></div>

<aside class="mobile-menu-drawer" id="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu" hidden>
  <div class="mobile-menu-top">
    <a href="/" aria-label="LUMÈRA LUXE home">
      <img src="/assets/lumera-logo.svg" alt="" width="132" height="22" class="mobile-menu-logo" />
    </a>
    <button type="button" class="mobile-menu-close" id="mobile-nav-close-btn" aria-label="Close navigation menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </div>

  <nav class="mobile-menu-content" aria-label="Mobile navigation">
    <div class="mobile-menu-group">
      <h2>Browse</h2>
      <a href="/shop/" class="mobile-menu-primary" data-astro-prefetch>
        Shop fragrances <span aria-hidden="true">↗</span>
      </a>
      <a href="/#shop-by-occasion" class="mobile-menu-row">
        Shop by occasion <span class="mobile-menu-chevron" aria-hidden="true"></span>
      </a>
      <details>
        <summary class="mobile-menu-row">Scent families <span class="mobile-menu-chevron" aria-hidden="true"></span></summary>
        <ul class="mobile-menu-sublinks">
          {scentFamilies.map(({ label, slug }) => (
            <li><a href={`/shop/?family=${slug}`}>{label}</a></li>
          ))}
        </ul>
      </details>
    </div>

    <div class="mobile-menu-group">
      <h2>Discover</h2>
      <a href="/fragrance-finder/" class="mobile-menu-row">
        Fragrance quiz <span class="mobile-menu-chevron" aria-hidden="true"></span>
      </a>
      <details>
        <summary class="mobile-menu-row">More to explore <span class="mobile-menu-chevron" aria-hidden="true"></span></summary>
        <ul class="mobile-menu-sublinks">
          <li><a href="/scent-styling/">Scent & style</a></li>
          <li><a href="/layering/">Fragrance layering</a></li>
          <li><a href="/our-story/">Our story</a></li>
        </ul>
      </details>
    </div>

    <details class="mobile-menu-help">
      <summary class="mobile-menu-row">Delivery & help <span class="mobile-menu-chevron" aria-hidden="true"></span></summary>
      <ul class="mobile-menu-sublinks">
        <li><a href="/delivery-returns/">Delivery & returns</a></li>
        <li><a href="/contact/">Contact us</a></li>
      </ul>
    </details>
  </nav>

  <div class="mobile-menu-bottom">
    <a href={whatsappUrl} class="mobile-menu-chat" target="_blank" rel="noopener noreferrer">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
        <path d="M15.5 13.5v1.2a1.3 1.3 0 0 1-1.4 1.3 7.8 7.8 0 0 1-5.6-5.6 1.3 1.3 0 0 1 1.3-1.4h1.2a.9.9 0 0 1 .9.7l.3 1.2a.9.9 0 0 1-.3.9l-.6.6a5.5 5.5 0 0 0 2.6 2.6l.6-.6a.9.9 0 0 1 .9-.3l1.2.3a.9.9 0 0 1 .7.9z" />
      </svg>
      Chat on WhatsApp
    </a>
  </div>
</aside>

<!-- Keep the drawer styles with its markup during Astro page transitions. -->
<style is:inline>
  .mobile-menu-drawer[hidden],
  .mobile-menu-backdrop[hidden] {
    display: none;
  }

  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 998;
    background: rgb(35 24 18 / .48);
  }

  .mobile-menu-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 999;
    display: flex;
    flex-direction: column;
    width: min(calc(100% - 1.25rem), 24rem);
    background: #fffcf8;
    color: #38261f;
    box-shadow: 8px 0 30px rgb(35 24 18 / .16);
    animation: drawer-slide-in 220ms cubic-bezier(.16, 1, .3, 1);
  }

  @keyframes drawer-slide-in {
    from { transform: translateX(-100%); }
    to { transform: translateX(0); }
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: calc(.65rem + env(safe-area-inset-top, 0px)) 1.25rem .65rem;
    border-bottom: 1px solid #e7dbce;
  }

  .mobile-menu-top > a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .mobile-menu-logo {
    width: 132px;
    height: auto;
  }

  .mobile-menu-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid #e7dbce;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .mobile-menu-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem 1.25rem .75rem;
  }

  .mobile-menu-group + .mobile-menu-group,
  .mobile-menu-help {
    margin-top: .85rem;
    padding-top: .85rem;
    border-top: 1px solid #e7dbce;
  }

  .mobile-menu-group h2 {
    margin: 0 0 .4rem;
    color: #784b34;
    font: 650 .7rem/1.4 var(--font-body);
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .mobile-menu-primary,
  .mobile-menu-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    min-height: 48px;
    padding-block: .45rem;
    color: inherit;
    text-decoration: none;
    font-weight: 550;
    cursor: pointer;
  }

  .mobile-menu-primary {
    min-height: 58px;
    margin-bottom: .3rem;
    padding-inline: .9rem;
    border-radius: .55rem;
    background: #efe3d7;
    font: 400 1.2rem/1.2 var(--font-display);
  }

  .mobile-menu-row {
    padding-inline: .15rem .45rem;
    list-style: none;
  }

  summary.mobile-menu-row::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-chevron {
    width: .45rem;
    height: .45rem;
    flex-shrink: 0;
    border: solid currentColor;
    border-width: 0 1px 1px 0;
    transform: rotate(-45deg);
  }

  summary .mobile-menu-chevron {
    transform: rotate(45deg);
  }

  details[open] > summary .mobile-menu-chevron {
    transform: rotate(225deg);
  }

  .mobile-menu-sublinks {
    margin: .15rem 0 .4rem;
    padding: .15rem .75rem;
    list-style: none;
    border-left: 1px solid #d9c5b4;
    background: #f7f0e9;
  }

  .mobile-menu-sublinks a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: .35rem;
    color: #58463b;
    font-size: .89rem;
    text-decoration: none;
  }

  .mobile-menu-row:hover,
  .mobile-menu-sublinks a:hover {
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .mobile-menu-bottom {
    flex-shrink: 0;
    padding: .8rem 1.25rem calc(.8rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid #e7dbce;
  }

  .mobile-menu-chat {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    min-height: 48px;
    padding-inline: .6rem;
    border-radius: .55rem;
    background: #e9f3ed;
    color: #16604a;
    font-size: .88rem;
    font-weight: 650;
    text-align: center;
    text-decoration: none;
  }

  .mobile-menu-chat:hover {
    background: #dcebe2;
  }
</style>

<script is:inline>
  (() => {
    if (window.openMobileDrawer) return;

    function openDrawer() {
      if (typeof window.closeSearchModal === 'function') {
        window.closeSearchModal();
      }
      if (typeof window.closeAllNavModals === 'function') {
        window.closeAllNavModals();
      }
      var backdrop = document.getElementById('mobile-nav-backdrop');
      var drawer = document.getElementById('mobile-nav-drawer');
      var openBtn = document.getElementById('menu-toggle-btn');
      if (backdrop) {
        backdrop.removeAttribute('hidden');
        backdrop.hidden = false;
      }
      if (drawer) {
        drawer.removeAttribute('hidden');
        drawer.hidden = false;
      }
      if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      document.getElementById('mobile-nav-close-btn')?.focus({ preventScroll: true });
    }

    function closeDrawer() {
      var backdrop = document.getElementById('mobile-nav-backdrop');
      var drawer = document.getElementById('mobile-nav-drawer');
      var openBtn = document.getElementById('menu-toggle-btn');
      if (backdrop) {
        backdrop.setAttribute('hidden', '');
        backdrop.hidden = true;
      }
      if (drawer) {
        drawer.setAttribute('hidden', '');
        drawer.hidden = true;
      }
      if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
      var isOtherModalOpen =
        (document.getElementById('bag-drawer') && !document.getElementById('bag-drawer').hidden) ||
        (document.getElementById('search-modal') && !document.getElementById('search-modal').hidden) ||
        (document.getElementById('wishlist-drawer') && document.getElementById('wishlist-drawer').classList.contains('is-open')) ||
        (document.getElementById('discovery-modal') && document.getElementById('discovery-modal').classList.contains('is-open')) ||
        (document.getElementById('families-modal') && document.getElementById('families-modal').classList.contains('is-open')) ||
        (document.getElementById('support-modal') && document.getElementById('support-modal').classList.contains('is-open'));
      if (!isOtherModalOpen) {
        document.body.style.overflow = '';
      }
    }

    window.openMobileDrawer = openDrawer;
    window.closeMobileDrawer = closeDrawer;

    // Global Click Delegator (Never breaks on SPA route changes)
    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target) return;

      if (target.closest('#menu-toggle-btn, .mobile-toggle-btn, [data-action="open-menu"]')) {
        e.preventDefault();
        openDrawer();
        return;
      }

      if (target.closest('#mobile-nav-close-btn')) {
        e.preventDefault();
        closeDrawer();
        document.getElementById('menu-toggle-btn')?.focus();
        return;
      }

      // Auto-close when clicking any navigation link inside drawer
      if (target.closest('#mobile-nav-drawer a')) {
        closeDrawer();
        return;
      }

      var backdropEl = document.getElementById('mobile-nav-backdrop');
      if (backdropEl && target === backdropEl) {
        closeDrawer();
        document.getElementById('menu-toggle-btn')?.focus();
        return;
      }
    });

    window.addEventListener('keydown', function (event) {
      var drawer = document.getElementById('mobile-nav-drawer');
      if (!drawer || drawer.hidden) return;
      if (event.key === 'Escape') {
        closeDrawer();
        document.getElementById('menu-toggle-btn')?.focus();
      }
      if (event.key !== 'Tab') return;

      var focusable = Array.from(drawer.querySelectorAll('a[href], button, summary'))
        .filter(function (element) { return element.getClientRects().length > 0; });
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('astro:page-load', function () {
      closeDrawer();
    });

    document.addEventListener('astro:before-preparation', function () {
      closeDrawer();
    });
  })();
</script>
