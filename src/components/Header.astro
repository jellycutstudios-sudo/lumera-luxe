---
import { siteConfig } from '../data/site';
import productsData from '../data/products.json';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="main-header">
  <div class="container header-container">
    <!-- Left: Mobile Menu Toggle / Desktop Nav Links -->
    <div class="header-left">
      <button
        class="mobile-toggle-btn"
        id="menu-toggle-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="line-icon-bar top-bar"></span>
        <span class="line-icon-bar bottom-bar"></span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
        <ul class="nav-list">
          {
            siteConfig.navigation.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <li class="nav-item">
                  <a
                    href={item.href}
                    class:list={['nav-link', { active: isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <!-- Center: Iconic Wordmark -->
    <div class="header-center">
      <a href="/" class="brand-link" aria-label="LUMÈRA LUXE Home">
        <img
          src="/assets/lumera-logo.svg"
          alt="LUMÈRA LUXE"
          class="brand-logo"
          width="150"
          height="26"
        />
      </a>
    </div>

    <!-- Right: Premium Line Action Icons (Search & Bag) -->
    <div class="header-right">
      <!-- Search Line Icon Button -->
      <button
        class="header-action-btn search-trigger"
        id="open-search-modal-btn"
        aria-label="Search fragrances"
        title="Search fragrances"
      >
        <svg
          class="header-line-icon"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <span class="action-label desktop-only">Search</span>
      </button>

      <!-- Shopping Bag Line Icon Button -->
      <button
        class="header-action-btn bag-trigger"
        id="open-bag-btn"
        aria-label="Shopping bag"
        aria-haspopup="dialog"
        title="Shopping Bag"
      >
        <div class="bag-icon-frame">
          <svg
            class="header-line-icon"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="bag-counter-pill" id="header-bag-count">0</span>
        </div>
        <span class="action-label desktop-only">Bag</span>
      </button>
    </div>
  </div>

  <!-- Luxury Slide-in Mobile Drawer Backdrop & Panel -->
  <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" hidden></div>

  <aside
    class="mobile-drawer-panel"
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation Menu"
    hidden
  >
    <!-- Drawer Header -->
    <div class="drawer-header">
      <a href="/" class="drawer-brand" aria-label="LUMÈRA LUXE">
        <img
          src="/assets/lumera-logo.svg"
          alt="LUMÈRA LUXE"
          class="drawer-logo"
          width="135"
          height="23"
        />
      </a>
      <button
        class="drawer-close-btn"
        id="mobile-menu-close-btn"
        aria-label="Close navigation menu"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Drawer Quick Search Trigger -->
    <div class="drawer-search-wrap">
      <button class="drawer-search-trigger" id="drawer-search-trigger-btn">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <span>Search 25 luxury perfumes...</span>
      </button>
    </div>

    <!-- Drawer Scrollable Body -->
    <div class="drawer-body">
      <!-- Group 1: The Perfume Collection -->
      <div class="drawer-nav-group">
        <span class="drawer-group-title">Fragrance Collection</span>
        <ul class="drawer-list">
          <li>
            <a href="/shop/" class="drawer-item-link">
              <span class="item-icon-box">
                <!-- Perfume Bottle Line Icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="8" width="14" height="13" rx="2"></rect>
                  <path d="M10 2h4v3h-4z"></path>
                  <line x1="12" y1="5" x2="12" y2="8"></line>
                </svg>
              </span>
              <span class="item-label">All Perfumes ({productsData.length})</span>
              <span class="item-arrow">→</span>
            </a>
          </li>
          <li>
            <a href="/shop/?family=oriental" class="drawer-item-link">
              <span class="item-icon-box">
                <!-- Warm Radiant Flame Line Icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2c1 4 5 7 5 12a7 7 0 1 1-14 0c0-4 3-7 4-10 1 3 3 5 5 5-2-4 0-7 0-7z"></path>
                </svg>
              </span>
              <span class="item-label">Amber & Oriental</span>
            </a>
          </li>
          <li>
            <a href="/shop/?family=floral" class="drawer-item-link">
              <span class="item-icon-box">
                <!-- Flower Petals Line Icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M12 2a4 4 0 0 1 4 4c0 3-4 6-4 6s-4-3-4-6a4 4 0 0 1 4-4z"></path>
                  <path d="M12 22a4 4 0 0 1-4-4c0-3 4-6 4-6s4 3 4 6a4 4 0 0 1-4 4z"></path>
                  <path d="M2 12a4 4 0 0 1 4-4c3 0 6 4 6 4s-3 4-6 4a4 4 0 0 1-4-4z"></path>
                  <path d="M22 12a4 4 0 0 1-4 4c-3 0-6-4-6-4s3-4 6-4a4 4 0 0 1 4 4z"></path>
                </svg>
              </span>
              <span class="item-label">Floral & Rose</span>
            </a>
          </li>
          <li>
            <a href="/shop/?family=woody" class="drawer-item-link">
              <span class="item-icon-box">
                <!-- Botanical Leaf Line Icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                </svg>
              </span>
              <span class="item-label">Woody & Fresh</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Group 2: The House -->
      <div class="drawer-nav-group">
        <span class="drawer-group-title">The House</span>
        <ul class="drawer-list">
          <li>
            <a href="/our-story/" class="drawer-item-link">
              <span class="item-icon-box">
                <!-- Open Journal Line Icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
              </span>
              <span class="item-label">Our Story & Craft</span>
            </a>
          </li>
          <li>
            <a href="/delivery-returns/" class="drawer-item-link">
              <span class="item-icon-box">
                <!-- Priority Courier Van Line Icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              </span>
              <span class="item-label">Qatar Priority Delivery</span>
            </a>
          </li>
          <li>
            <a href="/contact/" class="drawer-item-link">
              <span class="item-icon-box">
                <!-- Location Compass Line Icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
              </span>
              <span class="item-label">Contact & Inquiries</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Drawer Footer: WhatsApp Concierge -->
    <div class="drawer-footer">
      <div class="concierge-status-box">
        <div class="status-indicator-row">
          <span class="status-live-dot"></span>
          <span class="status-live-text">Qatar Concierge Available</span>
        </div>
        <p class="concierge-desc">Inquire about notes, authenticity, or personal recommendations.</p>
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent("Hello LUMÈRA LUXE, I would like personal assistance selecting a fragrance.")}`}
          class="btn-whatsapp-drawer"
          target="_blank"
          rel="noopener"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.77.462 3.498 1.341 5.022L2 22l5.093-1.336A10.007 10.007 0 0 0 12.031 22C17.567 22 22 17.505 22 12.031 22 6.495 17.567 2 12.031 2zm5.879 14.195c-.244.686-1.42 1.314-1.956 1.385-.514.068-1.163.097-3.708-.958-3.04-1.258-4.996-4.34-5.148-4.542-.152-.202-1.233-1.64-1.233-3.128 0-1.488.777-2.22 1.052-2.525.275-.305.6-.381.8-.381.2 0 .4 0 .576.01.187.01.438-.071.686.525.257.619.876 2.143.952 2.296.076.153.127.33.025.534-.102.204-.153.33-.305.508-.152.178-.32.396-.457.533-.153.153-.312.32-.134.626.178.305.792 1.306 1.698 2.112 1.166 1.037 2.148 1.358 2.453 1.51.305.153.483.128.66-.076.178-.204.762-.89 965-1.195.204-.305.407-.254.686-.153.28.102 1.777.838 2.082.99.305.153.508.229.584.356.076.127.076.737-.168 1.423z"/>
          </svg>
          <span>Chat via WhatsApp</span>
        </a>
      </div>
      <p class="drawer-origin-note">Doha, Qatar · Genuine Luxury Guaranteed</p>
    </div>
  </aside>

  <!-- Minimalist Quick Search Modal Overlay -->
  <div class="search-modal-backdrop" id="search-modal" hidden>
    <div class="search-modal-card" role="dialog" aria-modal="true" aria-label="Search Fragrances">
      <div class="search-modal-header">
        <svg
          class="search-header-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          type="search"
          id="quick-search-input"
          class="quick-search-field"
          placeholder="SEARCH FRAGRANCES, BRANDS, OR NOTES..."
          autocomplete="off"
        />
        <button class="search-close-btn" id="close-search-modal-btn" aria-label="Close search">
          ✕
        </button>
      </div>

      <div class="search-modal-results" id="quick-search-results">
        <p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>
      </div>
    </div>
  </div>
</header>

<style>
  [hidden] {
    display: none !important;
  }

  .search-modal-backdrop[hidden],
  .mobile-drawer-backdrop[hidden],
  .mobile-drawer-panel[hidden] {
    display: none !important;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    transition: all var(--transition-fast);
  }

  @media (min-width: 860px) {
    .site-header {
      height: 68px;
    }
  }

  /* 3-column header layout */
  .header-container {
    height: 100%;
    display: grid;
    grid-template-columns: 44px 1fr 88px;
    align-items: center;
  }

  @media (min-width: 860px) {
    .header-container {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .header-center {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .header-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .brand-logo {
    height: 20px;
    max-width: 135px;
    width: auto;
    object-fit: contain;
  }

  @media (min-width: 860px) {
    .brand-logo {
      height: 25px;
      max-width: 165px;
    }
  }

  /* Desktop Primary Navigation */
  .primary-nav {
    display: none;
  }

  @media (min-width: 860px) {
    .primary-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    text-transform: uppercase;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover,
  .nav-link.active {
    opacity: 0.6;
  }

  /* Minimalist 2-line Hamburger Button */
  .mobile-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 860px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  .line-icon-bar {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text-main);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  /* Header Line Action Buttons */
  .header-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    border: none;
    padding: 0.4rem;
    color: var(--color-text-main);
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .header-action-btn:hover {
    opacity: 0.6;
  }

  .header-line-icon {
    display: block;
    color: var(--color-text-main);
  }

  .action-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 860px) {
    .desktop-only {
      display: inline-block;
    }
  }

  /* Bag Icon & Badge */
  .bag-icon-frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bag-counter-pill {
    position: absolute;
    top: -5px;
    right: -7px;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    border-radius: 8px;
    background-color: var(--color-text-main);
    color: #FFFFFF;
    font-size: 0.5625rem;
    font-weight: 600;
    line-height: 15px;
    text-align: center;
  }

  /* ===================================================
     LUXURY MOBILE DRAWER (Slide-in)
     =================================================== */
  .mobile-drawer-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(26, 24, 22, 0.45);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 120;
    animation: fadeIn 200ms ease;
  }

  .mobile-drawer-panel {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 86%;
    max-width: 360px;
    background-color: #FFFFFF;
    z-index: 121;
    display: flex;
    flex-direction: column;
    box-shadow: 10px 0 35px rgba(0, 0, 0, 0.12);
    animation: slideInLeft 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideInLeft {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
  }

  .drawer-close-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    background: transparent;
    border: none;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .drawer-close-btn:hover {
    background-color: var(--color-surface);
  }

  /* Quick Search in Drawer */
  .drawer-search-wrap {
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .drawer-search-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.65rem 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-family: var(--font-body);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--transition-fast);
  }

  .drawer-search-trigger:hover {
    border-color: var(--color-text-main);
  }

  /* Drawer Scrollable Content */
  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
  }

  .drawer-nav-group {
    margin-bottom: 1.75rem;
  }

  .drawer-group-title {
    display: block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-bottom: 0.65rem;
    padding-left: 0.25rem;
  }

  .drawer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .drawer-item-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.65rem 0.65rem;
    border-radius: var(--border-radius-sm);
    color: var(--color-text-main);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .drawer-item-link:hover {
    background-color: var(--color-surface);
  }

  .item-icon-box {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    flex-shrink: 0;
  }

  .drawer-item-link:hover .item-icon-box {
    background-color: #FFFFFF;
    color: var(--color-accent);
  }

  .item-label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-main);
    flex: 1;
  }

  .item-arrow {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  /* Drawer Footer */
  .drawer-footer {
    border-top: 1px solid var(--color-border);
    padding: 1rem 1.25rem 1.25rem;
    background-color: var(--color-surface);
  }

  .concierge-status-box {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .status-indicator-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.35rem;
  }

  .status-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #25D366;
    box-shadow: 0 0 0 2px rgba(37, 211, 102, 0.2);
  }

  .status-live-text {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-main);
  }

  .concierge-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .btn-whatsapp-drawer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    background-color: #25D366;
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.65rem 1rem;
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .btn-whatsapp-drawer:hover {
    background-color: #1EBE5D;
  }

  .drawer-origin-note {
    font-size: 0.65rem;
    text-align: center;
    color: var(--color-text-light);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ===================================================
     SEARCH MODAL OVERLAY
     =================================================== */
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 130;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(2rem, 10vh, 5rem);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .search-modal-card {
    width: 100%;
    max-width: 620px;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }

  .search-modal-header {
    display: flex;
    align-items: center;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    gap: 0.75rem;
  }

  .search-header-icon {
    color: var(--color-text-light);
    flex-shrink: 0;
  }

  .quick-search-field {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    border: none;
    outline: none;
    color: var(--color-text-main);
    background: transparent;
  }

  .quick-search-field::placeholder {
    color: var(--color-text-light);
  }

  .search-close-btn {
    font-size: 1.1rem;
    color: var(--color-text-light);
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    background: transparent;
    border: none;
    line-height: 1;
    transition: color var(--transition-fast);
  }

  .search-close-btn:hover {
    color: var(--color-text-main);
  }

  .search-modal-results {
    max-height: 380px;
    overflow-y: auto;
    padding: 0.75rem 1.25rem;
  }

  .search-modal-hint {
    font-size: 0.75rem;
    color: var(--color-text-light);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    padding: 1.5rem 0;
  }

  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-fast);
  }

  :global(.search-result-item:hover) {
    background-color: var(--color-surface);
  }

  :global(.search-result-thumb) {
    width: 48px;
    height: 58px;
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    flex-shrink: 0;
  }

  :global(.search-result-thumb img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  :global(.search-result-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  :global(.search-result-brand) {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-light);
  }

  :global(.search-result-name) {
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-main);
  }

  :global(.search-result-price) {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-main);
  }
</style>

<script>
  import productsData from '../data/products.json';

  // Mobile Drawer Toggle
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
  const closeDrawerBtn = document.getElementById('mobile-menu-close-btn');
  const drawerSearchBtn = document.getElementById('drawer-search-trigger-btn');

  function openMobileMenu() {
    if (drawerBackdrop) drawerBackdrop.hidden = false;
    if (mobileMenu) mobileMenu.hidden = false;
    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    if (drawerBackdrop) drawerBackdrop.hidden = true;
    if (mobileMenu) mobileMenu.hidden = true;
    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', openMobileMenu);
  closeDrawerBtn?.addEventListener('click', closeMobileMenu);
  drawerBackdrop?.addEventListener('click', closeMobileMenu);

  // Quick Search Modal Logic
  const openSearchBtn = document.getElementById('open-search-modal-btn');
  const searchModal = document.getElementById('search-modal');
  const closeSearchBtn = document.getElementById('close-search-modal-btn');
  const searchInput = document.getElementById('quick-search-input') as HTMLInputElement;
  const searchResults = document.getElementById('quick-search-results');

  function openSearch() {
    closeMobileMenu();
    if (searchModal) {
      searchModal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput?.focus(), 50);
    }
  }

  function closeSearch() {
    if (searchModal) {
      searchModal.hidden = true;
      document.body.style.overflow = '';
      if (searchInput) searchInput.value = '';
      if (searchResults) {
        searchResults.innerHTML = '<p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>';
      }
    }
  }

  openSearchBtn?.addEventListener('click', openSearch);
  drawerSearchBtn?.addEventListener('click', openSearch);
  closeSearchBtn?.addEventListener('click', closeSearch);

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (searchModal && !searchModal.hidden) closeSearch();
      if (mobileMenu && !mobileMenu.hidden) closeMobileMenu();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q) {
      if (searchResults) {
        searchResults.innerHTML = '<p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>';
      }
      return;
    }

    const matches = productsData.filter(
      (p) =>
        p.name.toLowerCase().includes(q) ||
        p.brand.toLowerCase().includes(q) ||
        p.rawNotes.toLowerCase().includes(q) ||
        p.scentFamilies.some((f) => f.toLowerCase().includes(q))
    ).slice(0, 6);

    if (!searchResults) return;

    if (!matches.length) {
      searchResults.innerHTML = `
        <div style="text-align: center; padding: 2rem 0; color: var(--color-text-muted);">
          <p style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em;">No perfumes match "${q}"</p>
        </div>
      `;
      return;
    }

    searchResults.innerHTML = matches
      .map(
        (p) => `
        <a href="/perfumes/${p.slug}/" class="search-result-item">
          <div class="search-result-thumb">
            <img src="${p.image}" alt="${p.brand} ${p.name}" />
          </div>
          <div class="search-result-info">
            <span class="search-result-brand">${p.brand}</span>
            <span class="search-result-name">${p.name}</span>
            <span style="font-size: 0.6875rem; color: var(--color-text-light); text-transform: uppercase;">${p.sizeDisplay} · ${p.concentration}</span>
          </div>
          <span class="search-result-price">${p.priceDisplay}</span>
        </a>
      `
      )
      .join('');
  });
</script>
