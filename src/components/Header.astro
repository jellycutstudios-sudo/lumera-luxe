---
import { siteConfig } from '../data/site';
import productsData from '../data/products.json';

const currentPath = Astro.url.pathname;
const searchHighlights = productsData.filter((p) => p.featured).slice(0, 3);
---

<header class="site-header" id="main-header">
  <div class="container header-container">
    <!-- Left: Mobile Menu & Search (Mobile) / Desktop Editorial Navigation -->
    <div class="header-left">
      <button
        class="mobile-toggle-btn"
        id="menu-toggle-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg
          class="hamburger-svg"
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <line x1="3" y1="8" x2="21" y2="8"></line>
          <line x1="3" y1="16" x2="21" y2="16"></line>
        </svg>
      </button>

      <!-- Mobile Search Button (Left Utility on Mobile for 2:2 Symmetry) -->
      <button
        class="header-action-btn search-trigger mobile-search-btn"
        aria-label="Search fragrances"
        title="Search fragrances"
      >
        <svg
          class="header-line-icon"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </button>

      <!-- Desktop Primary Nav -->
      <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
        <ul class="nav-list">
          {
            siteConfig.navigation.map((item) => {
              const isDiscovery = item.label === 'Discovery';
              const isShop = item.label === 'Shop';
              const isActive =
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href)) ||
                (isDiscovery && (currentPath.startsWith('/scent-styling') || currentPath.startsWith('/fragrance-finder') || currentPath.startsWith('/layering'))) ||
                (isShop && currentPath.startsWith('/perfumes/'));

              if (isDiscovery) {
                return (
                  <li class="nav-item nav-item-dropdown">
                    <a
                      href={item.href}
                      class:list={['nav-link', 'dropdown-trigger-link', { active: isActive }]}
                      aria-current={isActive ? 'page' : undefined}
                      aria-expanded="false"
                      aria-haspopup="true"
                    >
                      <span>{item.label}</span>
                      <svg class="dropdown-caret" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </a>

                    <!-- Luxury Dropdown Panel -->
                    <div class="nav-dropdown-panel" role="menu">
                      <div class="nav-dropdown-inner">
                        <!-- Column 1: Scent & Style -->
                        <div class="dropdown-col">
                          <span class="dropdown-header">Scent & Style Alignment</span>
                          <a href="/scent-styling/#gold" class="dropdown-item-link" role="menuitem">
                            <div class="dropdown-item-main">
                              <span class="dropdown-bullet">✦</span>
                              <span class="item-title">Wear with Warm Gold</span>
                            </div>
                            <span class="dropdown-arrow" aria-hidden="true">→</span>
                          </a>
                          <a href="/scent-styling/#silver" class="dropdown-item-link" role="menuitem">
                            <div class="dropdown-item-main">
                              <span class="dropdown-bullet">✦</span>
                              <span class="item-title">Wear with Cool Silver</span>
                            </div>
                            <span class="dropdown-arrow" aria-hidden="true">→</span>
                          </a>
                          <a href="/scent-styling/#rose-gold" class="dropdown-item-link" role="menuitem">
                            <div class="dropdown-item-main">
                              <span class="dropdown-bullet">✦</span>
                              <span class="item-title">Wear with Rose Gold</span>
                            </div>
                            <span class="dropdown-arrow" aria-hidden="true">→</span>
                          </a>
                        </div>

                        <!-- Column 2: Rituals & Consultation -->
                        <div class="dropdown-col">
                          <span class="dropdown-header">Consultation & Rituals</span>
                          <a href="/fragrance-finder/" class="dropdown-item-link" role="menuitem">
                            <div class="dropdown-item-main">
                              <span class="dropdown-bullet">✦</span>
                              <span class="item-title">Fragrance Finder Quiz</span>
                            </div>
                            <span class="dropdown-arrow" aria-hidden="true">→</span>
                          </a>
                          <a href="/layering/" class="dropdown-item-link" role="menuitem" data-astro-prefetch>
                            <div class="dropdown-item-main">
                              <span class="dropdown-bullet">✦</span>
                              <span class="item-title">The Art of Layering</span>
                            </div>
                            <span class="dropdown-arrow" aria-hidden="true">→</span>
                          </a>
                          <a href="/scent-styling/#elements" class="dropdown-item-link" role="menuitem">
                            <div class="dropdown-item-main">
                              <span class="dropdown-bullet">✦</span>
                              <span class="item-title">The Elemental Wardrobe</span>
                            </div>
                            <span class="dropdown-arrow" aria-hidden="true">→</span>
                          </a>
                        </div>
                      </div>

                      <div class="dropdown-footer-bar">
                        <a href="/scent-styling/" class="dropdown-all-link">
                          <span>Explore Complete Scent & Style Hub</span>
                          <span aria-hidden="true">→</span>
                        </a>
                      </div>
                    </div>
                  </li>
                );
              }

              return (
                <li class="nav-item">
                  <a
                    href={item.href}
                    class:list={['nav-link', { active: isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                    data-astro-prefetch
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <!-- Center: Iconic Wordmark (Optically Baseline-Centered) -->
    <div class="header-center">
      <a href="/" class="brand-link" aria-label="LUMÈRA LUXE Home">
        <img
          src="/assets/lumera-logo.svg"
          alt="LUMÈRA LUXE"
          class="brand-logo"
          width="135"
          height="24"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <!-- Right: Utility Actions (Search on Desktop, Wishlist, Bag) -->
    <div class="header-right">
      <!-- Desktop Search Line Icon Button -->
      <button
        class="header-action-btn search-trigger desktop-search-btn"
        id="open-search-modal-btn"
        aria-label="Search fragrances"
        title="Search fragrances"
      >
        <svg
          class="header-line-icon"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </button>

      <!-- Wishlist / Saved Fragrances Line Icon Button -->
      <button
        class="header-action-btn wishlist-trigger"
        id="open-wishlist-btn"
        aria-label="Wishlist / Saved Fragrances"
        title="Saved Fragrances"
      >
        <div class="wishlist-icon-frame">
          <svg
            class="header-line-icon wishlist-heart-icon"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="bag-counter-pill wishlist-counter-pill" id="header-wishlist-count" hidden>0</span>
        </div>
      </button>

      <!-- Direct WhatsApp Concierge Shortcut Button (Consistent Luxury Line Icon) -->
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello LUMÈRA LUXE, I would like personal assistance choosing a fragrance from your collection.')}`}
        class="header-action-btn whatsapp-header-btn"
        id="header-whatsapp-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Direct WhatsApp Concierge"
        title="Direct WhatsApp Concierge"
      >
        <div class="whatsapp-icon-frame">
          <svg
            class="header-line-icon whatsapp-icon"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
            <path d="M15.5 13.5v1.2a1.3 1.3 0 0 1-1.4 1.3 7.8 7.8 0 0 1-5.6-5.6 1.3 1.3 0 0 1 1.3-1.4h1.2a.9.9 0 0 1 .9.7l.3 1.2a.9.9 0 0 1-.3.9l-.6.6a5.5 5.5 0 0 0 2.6 2.6l.6-.6a.9.9 0 0 1 .9-.3l1.2.3a.9.9 0 0 1 .7.9z"></path>
          </svg>
        </div>
      </a>

      <!-- Shopping Bag Line Icon Button -->
      <button
        class="header-action-btn bag-trigger"
        id="open-bag-btn"
        aria-label="Shopping bag"
        aria-haspopup="dialog"
        title="Shopping Bag"
      >
        <div class="bag-icon-frame">
          <svg
            class="header-line-icon"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="bag-counter-pill" id="header-bag-count" hidden>0</span>
        </div>
      </button>
    </div>
  </div>
</header>

  <!-- Luxury Quick Search Modal Overlay -->
  <div class="search-modal-backdrop" id="search-modal" hidden>
    <div class="search-modal-card" role="dialog" aria-modal="true" aria-label="Search Fragrances">
      <div class="search-modal-header">
        <svg
          class="search-header-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          type="search"
          id="quick-search-input"
          class="quick-search-field"
          placeholder="Search perfumes, brands, or notes..."
          autocomplete="off"
          aria-label="Search perfumes, brands, or notes"
        />
        <button type="button" class="search-clear-input-btn" id="search-clear-input-btn" aria-label="Clear search input" style="display: none;">
          ✕
        </button>
        <button type="button" class="search-close-btn" id="close-search-modal-btn" aria-label="Close search">
          <span class="search-close-key" aria-hidden="true">ESC</span>
          <svg class="search-close-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="search-modal-results" id="quick-search-results">
        <!-- Pre-rendered Initial View (Instant Luxury Content with Zero Flash) -->
        <div class="search-initial-view" id="search-initial-view">
          <!-- Popular Searches -->
          <div class="search-section">
            <div class="search-section-title">Trending Searches</div>
            <div class="search-chips-row">
              <button type="button" class="search-suggestion-chip" data-search-term="Chanel">Chanel</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Libre">YSL Libre</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Good Girl">Good Girl</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Black Orchid">Black Orchid</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Vanilla">Vanilla</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Under 300">Under 300 QAR</button>
            </div>
          </div>

          <!-- Curated Highlights -->
          <div class="search-section">
            <div class="search-section-header">
              <span class="search-section-title">Curated Bestsellers</span>
              <a href="/shop/" class="search-section-link">View All ({productsData.length}) →</a>
            </div>
            <div class="search-highlight-list">
              {
                searchHighlights.map((p) => (
                  <a href={`/perfumes/${p.slug}/`} class="search-highlight-item">
                    <div class="search-item-thumb">
                      <img src={p.image} alt={`${p.brand} ${p.name}`} loading="lazy" width="48" height="48" />
                    </div>
                    <div class="search-item-info">
                      <span class="search-item-brand">{p.brand}</span>
                      <span class="search-item-name">{p.name}</span>
                      <span class="search-item-meta">{p.sizeDisplay} · {p.concentration}</span>
                    </div>
                    <div class="search-item-price-wrap">
                      <span class="search-item-price">{p.priceDisplay}</span>
                      <svg class="search-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Scent Families Quick Filter -->
          <div class="search-section">
            <div class="search-section-title">Explore by Scent Family</div>
            <div class="search-families-grid">
              <a href="/shop/?family=floral" class="search-family-badge">🌸 Floral & Rose</a>
              <a href="/shop/?family=oriental" class="search-family-badge">🔥 Amber & Oriental</a>
              <a href="/shop/?family=woody" class="search-family-badge">🌲 Woody & Earthy</a>
              <a href="/shop/?family=fresh" class="search-family-badge">🍋 Fresh & Citrus</a>
            </div>
          </div>
        </div>

        <!-- Dynamic Results Container (Filled on Typing) -->
        <div class="search-dynamic-view" id="search-dynamic-view" style="display: none;"></div>
      </div>
    </div>
  </div>

<style>
  [hidden] {
    display: none !important;
  }

  .search-modal-backdrop[hidden] {
    display: none !important;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-gold-border-subtle);
    transition: all var(--transition-fast);
  }

  @media (min-width: 768px) {
    .site-header {
      height: 68px;
    }
  }

  /* Header Layout */
  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    padding-left: clamp(0.5rem, 2.5vw, 1.25rem);
    padding-right: clamp(0.5rem, 2.5vw, 1.25rem);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 2px;
    z-index: 2;
    flex-shrink: 0;
  }

  /* Mobile vs Desktop Search Switcher (Ensures exact 2:2 icon symmetry on mobile) */
  .mobile-search-btn {
    display: inline-flex;
  }

  .desktop-search-btn {
    display: none !important;
  }

  /* Centered Brand Logo: Auto-balanced between Left (2 icons) and Right (3 icons) */
  .header-center {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex: 1;
    min-width: 0;
    padding: 0 0.35rem;
    z-index: 1;
    pointer-events: auto;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    line-height: 1;
    max-width: 100%;
  }

  .brand-logo {
    height: 18px;
    max-width: clamp(96px, 25vw, 122px);
    width: auto;
    object-fit: contain;
    display: block;
  }

  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    z-index: 2;
    flex-shrink: 0;
  }

  /* OPTION B: All 5 Icons with Generous 44px Touch Targets */
  @media (max-width: 767px) {
    .header-action-btn,
    .mobile-toggle-btn {
      width: 38px;
      height: 44px;
      min-width: 38px;
      min-height: 44px;
    }

    .header-action-btn .header-line-icon,
    .mobile-toggle-btn .hamburger-svg {
      width: 18.5px;
      height: 18.5px;
    }

    .header-left {
      gap: 2px;
      flex-shrink: 0;
    }

    .header-right {
      gap: 2px;
      flex-shrink: 0;
    }

    .wishlist-trigger {
      display: inline-flex !important;
    }
  }

  @media (max-width: 375px) {
    .header-container {
      padding-left: 0.35rem;
      padding-right: 0.35rem;
    }

    .header-action-btn,
    .mobile-toggle-btn {
      width: 35px;
      height: 44px;
      min-width: 35px;
      min-height: 44px;
    }

    .header-action-btn .header-line-icon,
    .mobile-toggle-btn .hamburger-svg {
      width: 17.5px;
      height: 17.5px;
    }

    .brand-logo {
      height: 16.5px;
      max-width: 98px;
    }
  }

  @media (max-width: 330px) {
    .header-action-btn,
    .mobile-toggle-btn {
      width: 32px;
      height: 44px;
      min-width: 32px;
      min-height: 44px;
    }

    .brand-logo {
      height: 15px;
      max-width: 88px;
    }
  }

  @media (min-width: 768px) {
    .header-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      position: static;
      padding-left: clamp(1.25rem, 3vw, 2.5rem);
      padding-right: clamp(1.25rem, 3vw, 2.5rem);
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .header-center {
      position: static;
      transform: translateY(-2px);
      flex: none;
      padding: 0;
    }

    .brand-logo {
      height: 24px;
      max-width: 160px;
    }

    .header-right {
      gap: 0.75rem;
    }

    .header-action-btn {
      width: 44px;
      height: 44px;
    }

    .header-action-btn .header-line-icon {
      width: 22px;
      height: 22px;
      stroke-width: 1.75;
    }

    .bag-icon-frame,
    .wishlist-icon-frame,
    .whatsapp-icon-frame {
      width: 24px;
      height: 24px;
    }

    .bag-counter-pill,
    .wishlist-counter-pill {
      top: -4px;
      right: -6px;
      min-width: 16px;
      height: 16px;
      font-size: 0.625rem;
    }

    .mobile-search-btn {
      display: none !important;
    }

    .desktop-search-btn {
      display: inline-flex !important;
    }

    .wishlist-trigger {
      display: inline-flex !important;
    }
  }

  /* Desktop Primary Navigation */
  .primary-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .primary-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: clamp(1.75rem, 2.2vw, 2.5rem);
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 0.95vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.11em;
    color: var(--color-text-main);
    text-transform: uppercase;
    text-decoration: none;
    position: relative;
    padding: 0.45rem 0;
    transition: opacity var(--transition-fast), color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-brand-cognac, #9e532b);
    opacity: 0.85;
  }

  .nav-link.active {
    color: var(--color-brand-cognac, #9e532b);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-brand-cognac, #9e532b);
  }

  /* Dropdown Trigger & Luxury Panel */
  .nav-item-dropdown {
    position: relative;
  }

  .dropdown-trigger-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dropdown-caret {
    width: 10px;
    height: 10px;
    stroke-width: 2.2;
    transition: transform 200ms ease;
  }

  .nav-item-dropdown:hover .dropdown-caret,
  .nav-item-dropdown:focus-within .dropdown-caret {
    transform: rotate(180deg);
    color: var(--color-brand-cognac, #9E532B);
  }

  .nav-dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: -20px;
    width: 580px;
    background: #FFFFFF;
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: var(--border-radius-sm, 4px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.1), 0 4px 14px rgba(197, 160, 89, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 200ms ease, transform 200ms ease, visibility 200ms ease;
    z-index: 120;
    pointer-events: none;
  }

  /* Keep hover alive with invisible top bridge */
  .nav-dropdown-panel::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }

  .nav-item-dropdown:hover .nav-dropdown-panel,
  .nav-item-dropdown:focus-within .nav-dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-dropdown-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    padding: 1.65rem 1.65rem 1.35rem;
  }

  .dropdown-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

