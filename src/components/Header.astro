---
import { siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="main-header">
  <div class="container header-container">
    <!-- Left: Mobile Menu Toggle / Desktop Nav Links -->
    <div class="header-left">
      <button
        class="mobile-toggle"
        id="menu-toggle-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
        <ul class="nav-list">
          {
            siteConfig.navigation.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <li class="nav-item">
                  <a
                    href={item.href}
                    class:list={['nav-link', { active: isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <!-- Center: Iconic Wordmark -->
    <div class="header-center">
      <a href="/" class="brand-link" aria-label="LUMÈRA LUXE Home">
        <img
          src="/assets/lumera-logo.svg"
          alt="LUMÈRA LUXE"
          class="brand-logo"
          width="160"
          height="28"
        />
      </a>
    </div>

    <!-- Right: Minimalist Search & Bag -->
    <div class="header-right">
      <button
        class="nav-action-text"
        id="open-search-modal-btn"
        aria-label="Search catalogue"
      >
        <span>Search</span>
      </button>

      <button
        class="nav-action-text bag-trigger-btn"
        id="open-bag-btn"
        aria-label="Shopping bag"
        aria-haspopup="dialog"
      >
        <span>Bag</span>
        <span class="bag-pill" id="header-bag-count">0</span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="container mobile-menu-inner">
      <ul class="mobile-nav-list">
        {
          siteConfig.navigation.map((item) => (
            <li>
              <a href={item.href} class="mobile-nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu-footer">
        <p class="mobile-concierge-note">Doha Concierge Assistance</p>
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}`}
          class="btn btn-primary btn-block"
          target="_blank"
          rel="noopener"
        >
          WhatsApp Concierge
        </a>
      </div>
    </div>
  </div>

  <!-- Minimalist Quick Search Modal Overlay -->
  <div class="search-modal-backdrop" id="search-modal" hidden>
    <div class="search-modal-card" role="dialog" aria-modal="true" aria-label="Search Fragrances">
      <div class="search-modal-header">
        <input
          type="search"
          id="quick-search-input"
          class="quick-search-field"
          placeholder="SEARCH FRAGRANCES, BRANDS, OR NOTES..."
          autocomplete="off"
        />
        <button class="search-close-btn" id="close-search-modal-btn" aria-label="Close search">
          ✕
        </button>
      </div>

      <div class="search-modal-results" id="quick-search-results">
        <p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 68px;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    transition: all var(--transition-fast);
  }

  .header-container {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .header-center {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .header-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.5rem;
  }

  .brand-logo {
    height: 24px;
    width: auto;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .brand-logo {
      height: 26px;
    }
  }

  .primary-nav {
    display: none;
  }

  @media (min-width: 860px) {
    .primary-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    text-transform: uppercase;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover,
  .nav-link.active {
    opacity: 0.6;
  }

  .nav-action-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-main);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0;
    cursor: pointer;
  }

  .nav-action-text:hover {
    opacity: 0.6;
  }

  .bag-pill {
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    padding: 6px;
  }

  @media (min-width: 860px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text-main);
  }

  /* Mobile Dropdown */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .mobile-menu-inner {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .mobile-nav-link {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .mobile-menu-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  .mobile-concierge-note {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .btn-block {
    width: 100%;
  }

  /* Search Overlay */
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(2rem, 10vh, 5rem);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .search-modal-card {
    width: 100%;
    max-width: 620px;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .search-modal-header {
    display: flex;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    gap: 1rem;
  }

  .quick-search-field {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    border: none;
    outline: none;
    color: var(--color-text-main);
    background: transparent;
  }

  .search-close-btn {
    font-size: 1rem;
    color: var(--color-text-light);
  }

  .search-close-btn:hover {
    color: var(--color-text-main);
  }

  .search-modal-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 1rem 1.5rem;
  }

  .search-modal-hint {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    text-align: center;
    padding: 2rem 0;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  :global(.search-result-thumb) {
    width: 44px;
    height: 52px;
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    flex-shrink: 0;
  }

  :global(.search-result-thumb img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  :global(.search-result-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  :global(.search-result-brand) {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-light);
  }

  :global(.search-result-name) {
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-main);
  }

  :global(.search-result-price) {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-main);
  }
</style>

<script>
  import productsData from '../data/products.json';

  // Mobile menu toggle
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.hidden = isExpanded;
    });
  }

  // Quick Search Modal Logic
  const openSearchBtn = document.getElementById('open-search-modal-btn');
  const searchModal = document.getElementById('search-modal');
  const closeSearchBtn = document.getElementById('close-search-modal-btn');
  const searchInput = document.getElementById('quick-search-input') as HTMLInputElement;
  const searchResults = document.getElementById('quick-search-results');

  function openSearch() {
    if (searchModal) {
      searchModal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput?.focus(), 50);
    }
  }

  function closeSearch() {
    if (searchModal) {
      searchModal.hidden = true;
      document.body.style.overflow = '';
      if (searchInput) searchInput.value = '';
      if (searchResults) {
        searchResults.innerHTML = '<p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>';
      }
    }
  }

  openSearchBtn?.addEventListener('click', openSearch);
  closeSearchBtn?.addEventListener('click', closeSearch);

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && searchModal && !searchModal.hidden) {
      closeSearch();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q) {
      if (searchResults) {
        searchResults.innerHTML = '<p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>';
      }
      return;
    }

    const matches = productsData.filter(
      (p) =>
        p.name.toLowerCase().includes(q) ||
        p.brand.toLowerCase().includes(q) ||
        p.rawNotes.toLowerCase().includes(q) ||
        p.scentFamilies.some((f) => f.toLowerCase().includes(q))
    ).slice(0, 6);

    if (!searchResults) return;

    if (!matches.length) {
      searchResults.innerHTML = `
        <div style="text-align: center; padding: 2rem 0; color: var(--color-text-muted);">
          <p style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em;">No perfumes match "${q}"</p>
        </div>
      `;
      return;
    }

    searchResults.innerHTML = matches
      .map(
        (p) => `
        <a href="/perfumes/${p.slug}/" class="search-result-item">
          <div class="search-result-thumb">
            <img src="${p.image}" alt="${p.brand} ${p.name}" />
          </div>
          <div class="search-result-info">
            <span class="search-result-brand">${p.brand}</span>
            <span class="search-result-name">${p.name}</span>
            <span style="font-size: 0.6875rem; color: var(--color-text-light); text-transform: uppercase;">${p.sizeDisplay} · ${p.concentration}</span>
          </div>
          <span class="search-result-price">${p.priceDisplay}</span>
        </a>
      `
      )
      .join('');
  });
</script>
