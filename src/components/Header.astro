---
import { siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="main-header">
  <div class="container header-container">
    <!-- Left: Mobile Menu Toggle / Desktop Nav Links -->
    <div class="header-left">
      <button
        class="mobile-toggle-btn"
        id="menu-toggle-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="line-icon-bar top-bar"></span>
        <span class="line-icon-bar bottom-bar"></span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
        <ul class="nav-list">
          {
            siteConfig.navigation.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <li class="nav-item">
                  <a
                    href={item.href}
                    class:list={['nav-link', { active: isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <!-- Center: Iconic Wordmark -->
    <div class="header-center">
      <a href="/" class="brand-link" aria-label="LUMÈRA LUXE Home">
        <img
          src="/assets/lumera-logo.svg"
          alt="LUMÈRA LUXE"
          class="brand-logo"
          width="150"
          height="26"
        />
      </a>
    </div>

    <!-- Right: Premium Line Action Icons (Search & Bag) -->
    <div class="header-right">
      <!-- Search Line Icon Button -->
      <button
        class="header-action-btn search-trigger"
        id="open-search-modal-btn"
        aria-label="Search fragrances"
        title="Search fragrances"
      >
        <svg
          class="header-line-icon"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <span class="action-label desktop-only">Search</span>
      </button>

      <!-- Shopping Bag Line Icon Button -->
      <button
        class="header-action-btn bag-trigger"
        id="open-bag-btn"
        aria-label="Shopping bag"
        aria-haspopup="dialog"
        title="Shopping Bag"
      >
        <div class="bag-icon-frame">
          <svg
            class="header-line-icon"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="bag-counter-pill" id="header-bag-count">0</span>
        </div>
        <span class="action-label desktop-only">Bag</span>
      </button>
    </div>
  </div>

  <!-- Minimalist Quick Search Modal Overlay -->
  <div class="search-modal-backdrop" id="search-modal" hidden>
    <div class="search-modal-card" role="dialog" aria-modal="true" aria-label="Search Fragrances">
      <div class="search-modal-header">
        <svg
          class="search-header-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          type="search"
          id="quick-search-input"
          class="quick-search-field"
          placeholder="SEARCH FRAGRANCES, BRANDS, OR NOTES..."
          autocomplete="off"
        />
        <button class="search-close-btn" id="close-search-modal-btn" aria-label="Close search">
          ✕
        </button>
      </div>

      <div class="search-modal-results" id="quick-search-results">
        <p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>
      </div>
    </div>
  </div>
</header>

<style>
  [hidden] {
    display: none !important;
  }

  .search-modal-backdrop[hidden] {
    display: none !important;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-gold-border-subtle);
    transition: all var(--transition-fast);
  }

  @media (min-width: 860px) {
    .site-header {
      height: 68px;
    }
  }

  /* 3-column header layout */
  .header-container {
    height: 100%;
    display: grid;
    grid-template-columns: 44px 1fr 88px;
    align-items: center;
  }

  @media (min-width: 860px) {
    .header-container {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .header-center {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .header-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .brand-logo {
    height: 20px;
    max-width: 135px;
    width: auto;
    object-fit: contain;
  }

  @media (min-width: 860px) {
    .brand-logo {
      height: 25px;
      max-width: 165px;
    }
  }

  /* Desktop Primary Navigation */
  .primary-nav {
    display: none;
  }

  @media (min-width: 860px) {
    .primary-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    text-transform: uppercase;
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover,
  .nav-link.active {
    opacity: 0.6;
  }

  /* Minimalist 2-line Hamburger Button */
  .mobile-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 860px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  .line-icon-bar {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text-main);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  /* Header Line Action Buttons */
  .header-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    border: none;
    padding: 0.4rem;
    color: var(--color-text-main);
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .header-action-btn:hover {
    opacity: 0.6;
  }

  .header-line-icon {
    display: block;
    color: var(--color-text-main);
  }

  .action-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 860px) {
    .desktop-only {
      display: inline-block;
    }
  }

  /* Bag Icon & Badge */
  .bag-icon-frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bag-counter-pill {
    position: absolute;
    top: -5px;
    right: -7px;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    border-radius: 8px;
    background: var(--color-brand-gradient);
    color: #FFFFFF;
    font-size: 0.5625rem;
    font-weight: 700;
    line-height: 15px;
    text-align: center;
    box-shadow: 0 2px 6px var(--color-brand-cognac-glow);
  }

  /* ===================================================
     SEARCH MODAL OVERLAY
     =================================================== */
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 130;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(2rem, 10vh, 5rem);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .search-modal-card {
    width: 100%;
    max-width: 620px;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }

  .search-modal-header {
    display: flex;
    align-items: center;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    gap: 0.75rem;
  }

  .search-header-icon {
    color: var(--color-text-light);
    flex-shrink: 0;
  }

  .quick-search-field {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    border: none;
    outline: none;
    color: var(--color-text-main);
    background: transparent;
  }

  .quick-search-field::placeholder {
    color: var(--color-text-light);
  }

  .search-close-btn {
    font-size: 1.1rem;
    color: var(--color-text-light);
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    background: transparent;
    border: none;
    line-height: 1;
    transition: color var(--transition-fast);
  }

  .search-close-btn:hover {
    color: var(--color-text-main);
  }

  .search-modal-results {
    max-height: 380px;
    overflow-y: auto;
    padding: 0.75rem 1.25rem;
  }

  .search-modal-hint {
    font-size: 0.75rem;
    color: var(--color-text-light);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    padding: 1.5rem 0;
  }

  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-fast);
  }

  :global(.search-result-item:hover) {
    background-color: var(--color-surface);
  }

  :global(.search-result-thumb) {
    width: 48px;
    height: 58px;
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    flex-shrink: 0;
  }

  :global(.search-result-thumb img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  :global(.search-result-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  :global(.search-result-brand) {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-light);
  }

  :global(.search-result-name) {
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-main);
  }

  :global(.search-result-price) {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-main);
  }
</style>

<script>
  import productsData from '../data/products.json';

  // Quick Search Modal Logic
  const openSearchBtn = document.getElementById('open-search-modal-btn');
  const searchModal = document.getElementById('search-modal');
  const closeSearchBtn = document.getElementById('close-search-modal-btn');
  const searchInput = document.getElementById('quick-search-input') as HTMLInputElement;
  const searchResults = document.getElementById('quick-search-results');

  function openSearch() {
    if (searchModal) {
      searchModal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput?.focus(), 50);
    }
  }

  function closeSearch() {
    if (searchModal) {
      searchModal.hidden = true;
      document.body.style.overflow = '';
      if (searchInput) searchInput.value = '';
      if (searchResults) {
        searchResults.innerHTML = '<p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>';
      }
    }
  }

  openSearchBtn?.addEventListener('click', openSearch);
  closeSearchBtn?.addEventListener('click', closeSearch);

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (searchModal && !searchModal.hidden) closeSearch();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q) {
      if (searchResults) {
        searchResults.innerHTML = '<p class="search-modal-hint">Search across our 25 verified luxury perfumes...</p>';
      }
      return;
    }

    const matches = productsData.filter(
      (p) =>
        p.name.toLowerCase().includes(q) ||
        p.brand.toLowerCase().includes(q) ||
        p.rawNotes.toLowerCase().includes(q) ||
        p.scentFamilies.some((f) => f.toLowerCase().includes(q))
    ).slice(0, 6);

    if (!searchResults) return;

    if (!matches.length) {
      searchResults.innerHTML = `
        <div style="text-align: center; padding: 2rem 0; color: var(--color-text-muted);">
          <p style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em;">No perfumes match "${q}"</p>
        </div>
      `;
      return;
    }

    searchResults.innerHTML = matches
      .map(
        (p) => `
        <a href="/perfumes/${p.slug}/" class="search-result-item">
          <div class="search-result-thumb">
            <img src="${p.image}" alt="${p.brand} ${p.name}" />
          </div>
          <div class="search-result-info">
            <span class="search-result-brand">${p.brand}</span>
            <span class="search-result-name">${p.name}</span>
            <span style="font-size: 0.6875rem; color: var(--color-text-light); text-transform: uppercase;">${p.sizeDisplay} · ${p.concentration}</span>
          </div>
          <span class="search-result-price">${p.priceDisplay}</span>
        </a>
      `
      )
      .join('');
  });
</script>
