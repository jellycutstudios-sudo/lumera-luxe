---
import { siteConfig } from '../data/site';
import productsData from '../data/products.json';
import { isEligibleForShowcase } from '../data/storefront-edits';

const currentPath = Astro.url.pathname;
const searchHighlights = productsData.filter((p) => p.featured && isEligibleForShowcase(p)).slice(0, 3);
---

<header class="site-header" id="main-header">
  <aside class="header-top-ribbon" aria-label="Qatar delivery and authenticity">
    <a href="/shipping-delivery/">Free Qatar delivery above 300 QAR</a>
    <span class="header-ribbon-payment">Authenticity &amp; Luxury</span>
    {siteConfig.maintenanceMode?.enabled && (
      <button type="button" class="header-preview-lock" id="maintenance-relock-btn">Lock preview</button>
    )}
  </aside>

  <div class="container header-container">
    <!-- Left: Mobile Hamburger Toggle + Brand Logo (SouqScent Placement) -->
    <div class="header-left">
      <button
        class="mobile-toggle-btn"
        id="menu-toggle-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg
          class="hamburger-svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <line x1="3" y1="8" x2="21" y2="8"></line>
          <line x1="3" y1="16" x2="21" y2="16"></line>
        </svg>
      </button>

      <!-- Brand Logo on the Left -->
      <a href="/" class="brand-link" aria-label="LUMÈRA LUXE Home">
        <img
          src="/assets/lumera-logo.svg"
          alt="LUMÈRA LUXE"
          class="brand-logo"
          width="152"
          height="26"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <!-- Center: Horizontal Navigation Menu (SouqScent Direct Layout) -->
    <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
      <ul class="nav-list">
        <!-- WOMEN -->
        <li class="nav-item">
          <a
            href="/shop/"
            class={`nav-link ${currentPath === '/shop/' && !Astro.url.search ? 'active' : ''}`}
            data-astro-prefetch
          >
            WOMEN
          </a>
        </li>

        <!-- CATEGORIES DROPDOWN -->
        <li class="nav-item nav-item-dropdown">
          <button
            type="button"
            class="nav-link dropdown-trigger"
            aria-expanded="false"
            aria-controls="nav-categories-panel"
          >
            <span>CATEGORIES</span>
            <svg class="dropdown-caret" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="nav-dropdown-panel" id="nav-categories-panel" hidden>
            <div class="nav-dropdown-inner single-col">
              <a href="/shop/" class="dropdown-item-link">
                <span class="item-title">All Perfumes ({productsData.length})</span>
                <span class="dropdown-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/shop/?family=floral" class="dropdown-item-link">
                <span class="item-title">Floral & Rose</span>
                <span class="dropdown-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/shop/?family=oriental" class="dropdown-item-link">
                <span class="item-title">Amber & Oriental</span>
                <span class="dropdown-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/shop/?family=woody" class="dropdown-item-link">
                <span class="item-title">Woody & Earthy</span>
                <span class="dropdown-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/shop/?family=fresh" class="dropdown-item-link">
                <span class="item-title">Fresh & Citrus</span>
                <span class="dropdown-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/shop/?price=over-350" class="dropdown-item-link">
                <span class="item-title">Prestige & Luxury (350+ QAR)</span>
                <span class="dropdown-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </li>

        <!-- BRANDS DROPDOWN -->
        <li class="nav-item nav-item-dropdown">
          <button
            type="button"
            class={`nav-link dropdown-trigger ${currentPath === '/shop/' && Astro.url.search.includes('brand') ? 'active' : ''}`}
            aria-expanded="false"
            aria-controls="nav-brands-panel"
          >
            <span>BRANDS</span>
            <svg class="dropdown-caret" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="nav-dropdown-panel brands-mega-panel" id="nav-brands-panel" hidden>
            <div class="brands-dropdown-grid">
              <div class="brands-col">
                <span class="brands-col-title">Designer Maisons</span>
                <a href="/shop/?brand=Chanel" class="dropdown-brand-link">Chanel</a>
                <a href="/shop/?brand=Dior" class="dropdown-brand-link">Dior</a>
                <a href="/shop/?brand=Tom+Ford" class="dropdown-brand-link">Tom Ford</a>
                <a href="/shop/?brand=Yves+Saint+Laurent" class="dropdown-brand-link">Yves Saint Laurent</a>
                <a href="/shop/?brand=Carolina+Herrera" class="dropdown-brand-link">Carolina Herrera</a>
                <a href="/shop/?brand=Dolce+%26+Gabbana" class="dropdown-brand-link">Dolce & Gabbana</a>
              </div>
              <div class="brands-col">
                <span class="brands-col-title">High Prestige</span>
                <a href="/shop/?brand=Creed" class="dropdown-brand-link">Creed</a>
                <a href="/shop/?brand=Boucheron" class="dropdown-brand-link">Boucheron</a>
                <a href="/shop/?brand=Chopard" class="dropdown-brand-link">Chopard</a>
                <a href="/shop/?brand=Guerlain" class="dropdown-brand-link">Guerlain</a>
                <a href="/shop/?brand=Hermès" class="dropdown-brand-link">Hermès</a>
                <a href="/shop/?brand=Cartier" class="dropdown-brand-link">Cartier</a>
              </div>
              <div class="brands-col">
                <span class="brands-col-title">Modern Icons</span>
                <a href="/shop/?brand=Givenchy" class="dropdown-brand-link">Givenchy</a>
                <a href="/shop/?brand=Jean+Paul+Gaultier" class="dropdown-brand-link">Jean Paul Gaultier</a>
                <a href="/shop/?brand=Narciso+Rodriguez" class="dropdown-brand-link">Narciso Rodriguez</a>
                <a href="/shop/?brand=Paco+Rabanne" class="dropdown-brand-link">Paco Rabanne</a>
                <a href="/shop/?brand=Prada" class="dropdown-brand-link">Prada</a>
                <a href="/shop/?brand=Mugler" class="dropdown-brand-link">Mugler</a>
              </div>
            </div>
            <div class="brands-dropdown-footer">
              <a href="/shop/" class="brands-all-link">
                <span>View All 40+ European Fragrance Brands</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </li>

        <!-- SCENT DROPDOWN -->
        <li class="nav-item nav-item-dropdown">
          <button
            type="button"
            class={`nav-link dropdown-trigger ${currentPath.startsWith('/scent-styling') || currentPath.startsWith('/layering') ? 'active' : ''}`}
            aria-expanded="false"
            aria-controls="nav-scent-panel"
          >
            <span>SCENT</span>
            <svg class="dropdown-caret" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="nav-dropdown-panel" id="nav-scent-panel" hidden>
            <div class="nav-dropdown-inner">
              <div class="dropdown-col">
                <span class="dropdown-header">Scent Types</span>
                <a href="/shop/?family=floral" class="dropdown-item-link">
                  <span class="item-title">Floral & Rose</span>
                  <span class="dropdown-arrow" aria-hidden="true">→</span>
                </a>
                <a href="/shop/?family=oriental" class="dropdown-item-link">
                  <span class="item-title">Amber & Oriental</span>
                  <span class="dropdown-arrow" aria-hidden="true">→</span>
                </a>
                <a href="/shop/?family=woody" class="dropdown-item-link">
                  <span class="item-title">Woody & Earthy</span>
                  <span class="dropdown-arrow" aria-hidden="true">→</span>
                </a>
                <a href="/shop/?family=fresh" class="dropdown-item-link">
                  <span class="item-title">Fresh & Citrus</span>
                  <span class="dropdown-arrow" aria-hidden="true">→</span>
                </a>
              </div>
              <div class="dropdown-col">
                <span class="dropdown-header">Guides & Rituals</span>
                <a href="/fragrance-finder/" class="dropdown-item-link">
                  <span class="item-title">Perfume Quiz</span>
                  <span class="dropdown-arrow" aria-hidden="true">→</span>
                </a>
                <a href="/layering/" class="dropdown-item-link">
                  <span class="item-title">The Art of Layering</span>
                  <span class="dropdown-arrow" aria-hidden="true">→</span>
                </a>
                <a href="/scent-styling/" class="dropdown-item-link">
                  <span class="item-title">Scent & Style Alignment</span>
                  <span class="dropdown-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </li>

        <li class="nav-item">
          <a href="/#shop-by-occasion" class="nav-link">Occasions</a>
        </li>

        <!-- DISCOVERY QUIZ -->
        <li class="nav-item">
          <a
            href="/fragrance-finder/"
            class={`nav-link nav-quiz-badge ${currentPath.startsWith('/fragrance-finder') ? 'active' : ''}`}
            data-astro-prefetch
          >
            <span>DISCOVERY QUIZ</span>
            <span class="quiz-sparkle" aria-hidden="true">✦</span>
          </a>
        </li>

        <!-- OUR STORY -->
        <li class="nav-item">
          <a
            href="/our-story/"
            class={`nav-link ${currentPath.startsWith('/our-story') ? 'active' : ''}`}
            data-astro-prefetch
          >
            OUR STORY
          </a>
        </li>
      </ul>
    </nav>

    <!-- Right: Utility Actions (Search, Wishlist, WhatsApp, SouqScent Black Bag Pill, Region Flag) -->
    <div class="header-right">
      <!-- Search Line Icon Button (Click opens instant luxury search modal) -->
      <button
        type="button"
        class="header-action-btn search-trigger"
        id="open-search-modal-btn"
        aria-label="Search fragrances"
        title="Search fragrances"
      >
        <svg
          class="header-line-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </button>

      <!-- Wishlist / Saved Fragrances -->
      <button
        type="button"
        class="header-action-btn wishlist-trigger"
        id="open-wishlist-btn"
        aria-label="Wishlist / Saved Fragrances"
        title="Saved Fragrances"
      >
        <div class="wishlist-icon-frame">
          <svg
            class="header-line-icon wishlist-heart-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="bag-counter-pill wishlist-counter-pill" id="header-wishlist-count" hidden>0</span>
        </div>
      </button>

      <!-- Direct WhatsApp Concierge Shortcut -->
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello LUMÈRA LUXE, I would like personal assistance choosing a fragrance from your collection.')}`}
        class="header-action-btn whatsapp-header-btn"
        id="header-whatsapp-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Direct WhatsApp Concierge"
        title="Direct WhatsApp Concierge"
      >
        <div class="whatsapp-icon-frame">
          <svg
            class="header-line-icon whatsapp-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
            <path d="M15.5 13.5v1.2a1.3 1.3 0 0 1-1.4 1.3 7.8 7.8 0 0 1-5.6-5.6 1.3 1.3 0 0 1 1.3-1.4h1.2a.9.9 0 0 1 .9.7l.3 1.2a.9.9 0 0 1-.3.9l-.6.6a5.5 5.5 0 0 0 2.6 2.6l.6-.6a.9.9 0 0 1 .9-.3l1.2.3a.9.9 0 0 1 .7.9z"></path>
          </svg>
        </div>
      </a>

      <!-- Shopping bag -->
      <button
        type="button"
        class="header-action-btn bag-trigger"
        id="open-bag-btn"
        aria-label="Shopping bag"
        aria-haspopup="dialog"
        title="Shopping Bag"
      >
        <span class="bag-icon-frame">
          <svg
            class="header-line-icon"
            width="20"
            height="20"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="header-bag-badge" id="header-bag-count" hidden>0</span>
        </span>
      </button>

      <!-- Qatar Region Indicator (Direct SouqScent Flag & Currency) -->
      <div class="header-region-item" title="Delivering across Qatar">
        <span class="region-flag" aria-hidden="true">🇶🇦</span>
        <span class="region-label">QAR</span>
      </div>
    </div>
  </div>
</header>

  <!-- Luxury Quick Search Modal Overlay -->
  <div class="search-modal-backdrop" id="search-modal" hidden>
    <div class="search-modal-card" role="dialog" aria-modal="true" aria-label="Search Fragrances">
      <div class="search-modal-header">
        <svg
          class="search-header-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          type="search"
          id="quick-search-input"
          class="quick-search-field"
          placeholder="Search perfumes, brands, or notes..."
          autocomplete="off"
          aria-label="Search perfumes, brands, or notes"
        />
        <button type="button" class="search-clear-input-btn" id="search-clear-input-btn" aria-label="Clear search input" style="display: none;">
          ✕
        </button>
        <button type="button" class="search-close-btn" id="close-search-modal-btn" aria-label="Close search">
          <span class="search-close-key" aria-hidden="true">ESC</span>
          <svg class="search-close-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="search-modal-results" id="quick-search-results">
        <!-- Pre-rendered Initial View (Instant Luxury Content with Zero Flash) -->
        <div class="search-initial-view" id="search-initial-view">
          <!-- Popular Searches -->
          <div class="search-section">
            <div class="search-section-title">Trending Searches</div>
            <div class="search-chips-row">
              <button type="button" class="search-suggestion-chip" data-search-term="Chanel">Chanel</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Libre">YSL Libre</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Good Girl">Good Girl</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Black Orchid">Black Orchid</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Vanilla">Vanilla</button>
              <button type="button" class="search-suggestion-chip" data-search-term="Under 300">Under 300 QAR</button>
            </div>
          </div>

          <!-- Curated Highlights -->
          <div class="search-section">
            <div class="search-section-header">
              <span class="search-section-title">Curated Bestsellers</span>
              <a href="/shop/" class="search-section-link">View All ({productsData.length}) →</a>
            </div>
            <div class="search-highlight-list">
              {
                searchHighlights.map((p) => (
                  <a href={`/perfumes/${p.slug}/`} class="search-highlight-item">
                    <div class="search-item-thumb">
                      <img src={p.image} alt={`${p.brand} ${p.name}`} loading="lazy" width="48" height="48" />
                    </div>
                    <div class="search-item-info">
                      <span class="search-item-brand">{p.brand}</span>
                      <span class="search-item-name">{p.name}</span>
                      <span class="search-item-meta">{p.sizeDisplay} · {p.concentration}</span>
                    </div>
                    <div class="search-item-price-wrap">
                      <span class="search-item-price">{p.priceDisplay}</span>
                      <svg class="search-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Scent Families Quick Filter -->
          <div class="search-section">
            <div class="search-section-title">Explore by Scent Family</div>
            <div class="search-families-grid">
              <a href="/shop/?family=floral" class="search-family-badge">🌸 Floral & Rose</a>
              <a href="/shop/?family=oriental" class="search-family-badge">🔥 Amber & Oriental</a>
              <a href="/shop/?family=woody" class="search-family-badge">🌲 Woody & Earthy</a>
              <a href="/shop/?family=fresh" class="search-family-badge">🍋 Fresh & Citrus</a>
            </div>
          </div>
        </div>

        <!-- Dynamic Results Container (Filled on Typing) -->
        <div class="search-dynamic-view" id="search-dynamic-view" style="display: none;"></div>
      </div>
    </div>
  </div>

<style>
  [hidden] {
    display: none !important;
  }

  .search-modal-backdrop[hidden] {
    display: none !important;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-gold-border-subtle);
    transition: all var(--transition-fast);
  }

  .header-top-ribbon {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 30px;
    gap: 1rem;
    padding: .25rem var(--page-gutter);
    background: #30211c;
    color: #fff7ee;
    font-size: .72rem;
    letter-spacing: .02em;
    text-align: center;
  }

  .header-top-ribbon a {
    color: inherit;
    text-underline-offset: .2em;
  }

  .header-top-ribbon a:hover {
    text-decoration: underline;
  }

  .header-ribbon-payment {
    border-inline-start: 1px solid #9b7663;
    padding-inline-start: 1rem;
  }

  .header-preview-lock {
    display: none;
    align-items: center;
    min-height: 28px;
    padding: .1rem .45rem;
    border: 1px solid #9b7663;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  :global(html.maintenance-unlocked) .header-preview-lock {
    display: inline-flex;
  }

  .header-preview-lock:hover {
    background: #593b2b;
  }

  .header-preview-lock:focus-visible {
    outline-color: #fff7ee;
  }

  @media (max-width: 540px) {
    .header-top-ribbon {
      gap: .55rem;
    }

    .header-ribbon-payment {
      display: none;
    }
  }

  /* 2. Main Header Row (SouqScent Single Unified Row) */
  .header-container {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2vw, 2.5rem);
    position: relative;
    max-width: var(--content-max-width, 1600px);
    margin: 0 auto;
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
  }

  @media (min-width: 1200px) {
    .header-container {
      height: 72px;
    }
  }

  /* Left: Hamburger (mobile) + Brand Logo */
  .header-left {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.2vw, 1rem);
    z-index: 2;
    flex-shrink: 0;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .brand-logo {
    height: 20px;
    width: auto;
    max-width: clamp(120px, 18vw, 158px);
    object-fit: contain;
    display: block;
  }

  @media (min-width: 1200px) {
    .brand-logo {
      height: 24px;
    }
  }

  /* Center: Horizontal Navigation Menu */
  .primary-nav {
    display: none;
    flex: 1;
    align-self: stretch;
    justify-content: center;
  }

  @media (min-width: 1200px) {
    .primary-nav {
      display: flex;
    }
  }

  .nav-list {
    display: flex;
    gap: clamp(.8rem, 1.35vw, 1.55rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 600;
    letter-spacing: .06em;
    color: #110F0D;
    text-transform: uppercase;
    text-decoration: none;
    position: relative;
    padding: 0.5rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: #A84112;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #A84112;
    border-radius: 2px;
  }

  .nav-quiz-badge {
    color: #9E532B;
  }

  .quiz-sparkle {
    color: #C5A059;
    font-size: 0.85rem;
    line-height: 1;
  }

  /* Dropdowns */
  .nav-item {
    display: flex;
    align-items: center;
  }

  .nav-item-dropdown {
    position: relative;
  }

  .dropdown-trigger {
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dropdown-caret {
    width: 9px;
    height: 9px;
    stroke-width: 2.2;
    color: #8C847B;
    transition: transform 200ms ease, color 200ms ease;
  }

  .dropdown-trigger[aria-expanded="true"] .dropdown-caret {
    transform: rotate(180deg);
    color: #A84112;
  }

  .nav-dropdown-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 31rem;
    max-height: min(70vh, calc(100dvh - 7rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #FFFFFF;
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: 8px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12), 0 4px 14px rgba(197, 160, 89, 0.08);
    z-index: 120;
  }

  #nav-categories-panel {
    width: 18rem;
  }

  .nav-dropdown-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 1rem;
  }

  .nav-dropdown-inner.single-col {
    grid-template-columns: minmax(0, 1fr);
    gap: .15rem;
    padding: .65rem;
  }

  .dropdown-col {
    display: flex;
    flex-direction: column;
  }

  .dropdown-col + .dropdown-col {
    border-inline-start: 1px solid #eee3d8;
    padding-inline-start: 1rem;
  }

  .dropdown-header {
    padding: .25rem .55rem .45rem;
    color: #855339;
    font-size: .875rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .dropdown-item-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .65rem;
    min-height: 40px;
    padding: .45rem .55rem;
    border-radius: 4px;
    color: #2D2722;
    font-size: .9375rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .dropdown-item-link:hover,
  .dropdown-item-link:focus-visible {
    background-color: #FAF5EF;
    color: #7C4023;
  }

  .dropdown-arrow {
    flex-shrink: 0;
    color: #855339;
  }

  /* Brands Mega Dropdown Panel */
  .brands-mega-panel {
    width: 36.25rem;
  }

  .brands-dropdown-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 1.65rem;
  }

  .brands-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .brands-col-title {
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #9E532B;
    margin-bottom: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(197, 160, 89, 0.22);
  }

  .dropdown-brand-link {
    font-family: var(--font-body);
    font-size: .9375rem;
    color: #2D2722;
    text-decoration: none;
    padding: 0.25rem 0;
    transition: all 160ms ease;
    display: block;
  }

  .dropdown-brand-link:hover {
    color: #A84112;
    transform: translateX(3px);
  }

  .brands-dropdown-footer {
    padding: 0.8rem 1.65rem;
    background: #FAF8F4;
    border-top: 1px solid rgba(197, 160, 89, 0.22);
    border-radius: 0 0 8px 8px;
    text-align: center;
  }

  .brands-all-link {
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #110F0D;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color 150ms ease;
  }

  .brands-all-link:hover {
    color: #A84112;
  }

  /* Right Utility Actions */
  .header-right {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 0.8vw, 0.75rem);
    z-index: 2;
    flex-shrink: 0;
  }

  .header-bag-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    border: 1px solid #fff;
    background: #ead0b3;
    color: #30211c;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    min-width: 17px;
    height: 17px;
    padding: 0 4.5px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .header-bag-badge[hidden] {
    display: none !important;
  }

  /* Qatar Region / Currency Indicator */
  .header-region-item {
    display: none;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #2D2722;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    background: #F8F6F1;
    border: 1px solid rgba(0, 0, 0, 0.06);
    cursor: default;
    user-select: none;
  }

  @media (min-width: 1320px) {
    .header-region-item {
      display: inline-flex;
    }
  }

  .region-flag {
    font-size: 1.05rem;
    line-height: 1;
  }

  .region-label {
    letter-spacing: 0.06em;
  }

  @media (min-width: 1200px) {
    .mobile-toggle-btn {
      display: none !important;
    }
  }

  /* Hamburger SVG */
  .hamburger-svg {
    display: block;
    color: var(--color-text-main);
  }

  /* Minimalist 2-line Hamburger Button */
  .mobile-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-main);
    border-radius: 50%;
    transition: opacity var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    flex-shrink: 0;
  }

  .mobile-toggle-btn:hover {
    background-color: rgba(24, 21, 19, 0.05);
  }

  .mobile-toggle-btn:active {
    transform: scale(0.92);
  }

  /* Header Line Action Buttons - Clean Minimal Luxury Iconography */
  .header-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    width: 42px;
    height: 42px;
    padding: 0;
    color: var(--color-text-main);
    cursor: pointer;
    border-radius: 50%;
    transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    position: relative;
    flex-shrink: 0;
  }

  .header-action-btn:hover {
    background-color: rgba(24, 21, 19, 0.05);
    color: var(--color-brand-cognac, #9e532b);
    transform: translateY(-1px);
  }

  .header-action-btn:active {
    transform: scale(0.92) !important;
  }

  .header-line-icon {
    display: block;
    color: inherit;
    transition: stroke var(--transition-fast);
  }

  .header-action-btn:hover .header-line-icon {
    stroke: currentColor;
  }

  /* Bag, Wishlist & WhatsApp Icon & Badge */
  .bag-icon-frame,
  .wishlist-icon-frame,
  .whatsapp-icon-frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }

  .whatsapp-header-btn:hover {
    color: #25D366 !important;
    background-color: rgba(37, 211, 102, 0.08) !important;
  }

  @media (width < 768px) {
    .site-header {
      background-color: #fffcf8;
      border-bottom-color: #e8dacb;
    }

    .header-container {
      height: 68px;
      gap: .5rem;
      padding-inline: clamp(.625rem, 3vw, 1.25rem);
    }

    .header-left {
      gap: .25rem;
      min-width: 0;
      flex-shrink: 1;
    }

    .brand-link {
      min-width: 0;
      min-height: 44px;
    }

    .brand-logo {
      width: min(38vw, 152px);
      max-width: 100%;
      height: auto;
    }

    .header-right {
      gap: 0;
    }

    .whatsapp-header-btn {
      display: none;
    }

    .mobile-toggle-btn,
    .header-action-btn {
      width: 44px;
      height: 44px;
      color: #38261f;
    }

    .hamburger-svg,
    .header-line-icon {
      width: 20px;
      height: 20px;
      stroke-width: 1.5;
      color: inherit;
    }

    .bag-icon-frame {
      width: 36px;
      height: 36px;
      border: 1px solid #e8dacb;
      border-radius: 50%;
      background-color: #f5ede4;
    }

    .header-bag-badge {
      top: -2px;
      right: -2px;
    }
  }

  .whatsapp-icon {
    display: block;
    color: inherit;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .whatsapp-header-btn:hover .whatsapp-icon {
    transform: scale(1.08);
  }

  .bag-counter-pill,
  .wishlist-counter-pill {
    position: absolute;
    top: -5px;
    right: -7px;
    min-width: 15px;
    height: 15px;
    padding: 0 3.5px;
    border-radius: 999px;
    background-color: var(--color-brand-cognac);
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #FFFFFF;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
    pointer-events: none;
  }

  .wishlist-heart-icon {
    transition: all var(--transition-fast);
  }

  .wishlist-heart-icon.is-active {
    color: var(--color-brand-cognac);
    stroke: var(--color-brand-cognac);
    fill: rgba(200, 90, 36, 0.14);
  }

  /* ===================================================
     LUXURY SEARCH MODAL OVERLAY
     =================================================== */
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(18, 15, 13, 0.48);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 0;
    transition: opacity var(--transition-fast);
  }

  @media (min-width: 768px) {
    .search-modal-backdrop {
      padding-top: clamp(2rem, 8vh, 4.5rem);
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  .search-modal-card {
    width: 100%;
    max-width: 100%;
    background-color: #FFFFFF;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 440px;
    max-height: 92vh;
    animation: searchModalSlideDown 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 768px) {
    .search-modal-card {
      max-width: 660px;
      border-radius: 16px;
      border: 1px solid var(--color-border);
      box-shadow: 0 25px 65px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(197, 160, 89, 0.18);
      min-height: 480px;
      max-height: 82vh;
    }
  }

  @keyframes searchModalSlideDown {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .search-modal-header {
    display: flex;
    align-items: center;
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid var(--color-border-subtle);
    gap: 0.75rem;
    background: #FFFFFF;
    position: relative;
  }

  @media (min-width: 768px) {
    .search-modal-header {
      padding: 1.15rem 1.4rem;
      gap: 0.85rem;
    }
  }

  .search-header-icon {
    color: var(--color-brand-cognac);
    flex-shrink: 0;
  }

  .quick-search-field {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    border: none;
    outline: none;
    color: var(--color-text-main);
    background: transparent;
    padding: 0;
  }

  .quick-search-field::-webkit-search-cancel-button,
  .quick-search-field::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .quick-search-field::placeholder {
    color: var(--color-text-light);
    font-weight: 400;
  }

  .search-clear-input-btn {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-light);
    font-size: 0.7rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .search-clear-input-btn:hover {
    color: var(--color-text-main);
    background: #ECE8E1;
  }

  .search-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.55rem;
    cursor: pointer;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-muted);
    font-size: 0.71875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .search-close-btn:hover {
    color: var(--color-text-main);
    border-color: var(--color-text-main);
  }

  .search-close-key {
    display: none;
  }

  @media (min-width: 768px) {
    .search-close-key {
      display: inline-block;
      font-size: 0.625rem;
      font-family: monospace;
      padding: 0.1rem 0.35rem;
      background: #FFFFFF;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      color: var(--color-text-light);
    }
  }

  .search-modal-results {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1rem 1.15rem 1.25rem;
  }

  @media (min-width: 768px) {
    .search-modal-results {
      padding: 1.25rem 1.4rem 1.5rem;
    }
  }

  /* Initial Rich View */
  :global(.search-initial-view) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.search-section) {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  :global(.search-section-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  :global(.search-section-title) {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-light);
  }

  :global(.search-section-link) {
    font-size: 0.71875rem;
    font-weight: 600;
    color: var(--color-brand-cognac);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color var(--transition-fast);
  }

  :global(.search-section-link:hover) {
    color: var(--color-brand-cognac-dark);
  }

  :global(.search-chips-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.search-suggestion-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-main);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.search-suggestion-chip:hover) {
    border-color: var(--color-brand-cognac);
    color: var(--color-brand-cognac);
    background: #FFFFFF;
    box-shadow: 0 2px 8px rgba(200, 90, 36, 0.1);
  }

  :global(.search-suggestion-chip.search-chip-primary) {
    background: var(--color-brand-gradient);
    color: #FFFFFF;
    border: none;
    font-weight: 600;
  }

  /* Curated Highlights */
  :global(.search-highlight-list) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.search-highlight-item),
  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.65rem;
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
  }

  :global(.search-highlight-item:hover),
  :global(.search-result-item:hover) {
    background-color: var(--color-surface);
    border-color: var(--color-border-subtle);
  }

  :global(.search-item-thumb) {
    width: 44px;
    height: 52px;
    background-color: #FAF8F5;
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
    flex-shrink: 0;
  }

  :global(.search-item-thumb img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  :global(.search-item-info) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  :global(.search-item-brand) {
    font-size: 0.625rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-brand-cognac);
  }

  :global(.search-item-name) {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: 0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-item-meta) {
    font-size: 0.6875rem;
    color: var(--color-text-light);
  }

  :global(.search-item-price-wrap) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  :global(.search-item-price) {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: 0.02em;
  }

  :global(.search-item-arrow) {
    color: var(--color-text-light);
    transition: transform var(--transition-fast);
  }

  :global(.search-highlight-item:hover .search-item-arrow),
  :global(.search-result-item:hover .search-item-arrow) {
    color: var(--color-brand-cognac);
    transform: translateX(3px);
  }

  /* Scent Families Badges */
  :global(.search-families-grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.45rem;
  }

  @media (min-width: 500px) {
    :global(.search-families-grid) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  :global(.search-family-badge) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.65rem;
    background: #FAF8F5;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: 0.71875rem;
    font-weight: 600;
    color: var(--color-text-main);
    text-decoration: none;
    transition: all var(--transition-fast);
    text-align: center;
  }

  :global(.search-family-badge:hover) {
    background: #FFFFFF;
    border-color: var(--color-brand-cognac);
    color: var(--color-brand-cognac);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  /* Active Search Results */
  :global(.search-results-wrapper) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.search-results-meta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.71875rem;
    color: var(--color-text-muted);
  }

  :global(.search-view-all-link) {
    color: var(--color-brand-cognac);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color var(--transition-fast);
  }

  :global(.search-view-all-link:hover) {
    text-decoration: underline;
  }

  :global(.search-results-list) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  /* Zero State */
  :global(.search-zero-state) {
    text-align: center;
    padding: 2.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  :global(.search-zero-icon) {
    font-size: 1.75rem;
    opacity: 0.6;
    margin-bottom: 0.2rem;
  }

  :global(.search-zero-title) {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0;
  }

  :global(.search-zero-desc) {
    font-size: 0.78125rem;
    color: var(--color-text-muted);
    max-width: 320px;
    margin: 0 0 1rem 0;
    line-height: 1.45;
  }

  :global(.search-zero-chips) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  @media (min-width: 768px) {
    .header-top-ribbon,
    .search-close-btn,
    :global(.search-section-title),
    :global(.search-section-link),
    :global(.search-suggestion-chip),
    :global(.search-item-brand),
    :global(.search-item-meta),
    :global(.search-family-badge),
    :global(.search-results-meta) {
      font-size: .875rem;
    }

    .quick-search-field,
    :global(.search-item-name),
    :global(.search-item-price),
    :global(.search-zero-desc) {
      font-size: 1rem;
    }
  }
</style>

<script>
  import { getProductCatalog } from '../lib/catalog';
  import { getFavorites } from '../lib/favorites';

  let openDropdown: HTMLElement | null = null;
  let dropdownPinned = false;

  function setNavDropdown(item: HTMLElement | null, pinned = false) {
    openDropdown?.querySelector('button')?.setAttribute('aria-expanded', 'false');
    const previousPanel = openDropdown?.querySelector<HTMLElement>('.nav-dropdown-panel');
    if (previousPanel) previousPanel.hidden = true;

    openDropdown = item;
    dropdownPinned = pinned;
    item?.querySelector('button')?.setAttribute('aria-expanded', 'true');
    const nextPanel = item?.querySelector<HTMLElement>('.nav-dropdown-panel');
    if (nextPanel) nextPanel.hidden = false;
  }

  function initNavDropdowns() {
    const nav = document.getElementById('primary-nav');
    if (!nav || nav.dataset.dropdownsReady) return;
    nav.dataset.dropdownsReady = 'true';

    nav.querySelectorAll<HTMLElement>('.nav-item-dropdown').forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.dropdown-trigger');
      const panel = item.querySelector<HTMLElement>('.nav-dropdown-panel');
      if (!trigger || !panel) return;

      trigger.addEventListener('click', () => {
        if (openDropdown === item && dropdownPinned) {
          setNavDropdown(null);
        } else {
          setNavDropdown(item, true);
        }
      });

      trigger.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse' && openDropdown !== item &&
            !openDropdown?.querySelector('.nav-dropdown-panel')?.contains(document.activeElement)) {
          setNavDropdown(item);
        }
      });

      item.addEventListener('pointerleave', () => {
        if (openDropdown === item && !dropdownPinned && !panel.contains(document.activeElement)) {
          setNavDropdown(null);
        }
      });

      item.addEventListener('focusout', (event) => {
        if (openDropdown === item && event.relatedTarget instanceof Node && !item.contains(event.relatedTarget)) {
          setNavDropdown(null);
        }
      });

      panel.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) setNavDropdown(null);
      });
    });
  }

  initNavDropdowns();
  document.addEventListener('astro:page-load', initNavDropdowns);
  document.addEventListener('astro:before-swap', () => setNavDropdown(null));

  document.addEventListener('pointerdown', (event) => {
    if (openDropdown && event.target instanceof Node && !openDropdown.contains(event.target)) {
      setNavDropdown(null);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !openDropdown) return;
    if (openDropdown.contains(document.activeElement)) openDropdown.querySelector('button')?.focus();
    setNavDropdown(null);
  });

  // Wishlist Badge Logic
  function updateWishlistBadge() {
    const badge = document.getElementById('header-wishlist-count');
    const heartIcon = document.querySelector('.wishlist-heart-icon');
    const favs = getFavorites();
    const count = favs.length;
    if (badge) {
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }
    if (heartIcon) {
      heartIcon.classList.toggle('is-active', count > 0);
    }
  }

  window.addEventListener('favorites-updated', updateWishlistBadge);
  // Also check on page load & tab focus
  window.addEventListener('focus', updateWishlistBadge);
  updateWishlistBadge();

  // Bag Badge Logic
  function updateBagBadge() {
    const bagBadge = document.getElementById('header-bag-count');
    try {
      const data = localStorage.getItem('lumera_bag_v1');
      const items = data ? JSON.parse(data) : [];
      const count = items.reduce((sum: number, it: any) => sum + (it.quantity || 1), 0);
      if (bagBadge) {
        bagBadge.textContent = String(count);
        bagBadge.hidden = count === 0;
      }
    } catch (e) {}
  }

  window.addEventListener('bag-updated', updateBagBadge);
  window.addEventListener('storage', updateBagBadge);
  window.addEventListener('focus', updateBagBadge);
  updateBagBadge();

  // Search Input Handler (Live Real-Time Filtering)
  async function handleSearchInput(input: HTMLInputElement) {
    const q = input.value.trim().toLowerCase();
    const clearBtn = document.getElementById('search-clear-input-btn') as HTMLButtonElement;
    const initialView = document.getElementById('search-initial-view');
    const dynamicView = document.getElementById('search-dynamic-view');

    if (clearBtn) {
      clearBtn.style.display = q ? 'flex' : 'none';
    }

    if (!q) {
      if (initialView) initialView.style.display = 'flex';
      if (dynamicView) {
        dynamicView.style.display = 'none';
        dynamicView.innerHTML = '';
      }
      return;
    }

    if (initialView) initialView.style.display = 'none';
    if (!dynamicView) return;
    dynamicView.style.display = 'block';

    const catalog = await getProductCatalog();
    const matches = catalog.filter((p) => {
      const isPriceQuery = q.includes('250') || q.includes('300') || q.includes('under') || q.includes('price');
      let matchesPrice = false;
      if (isPriceQuery && (q.includes('under') || q.includes('<') || q.includes('300'))) {
        matchesPrice = p.priceMinor < 30000;
      }

      return (
        p.name.toLowerCase().includes(q) ||
        p.brand.toLowerCase().includes(q) ||
        p.rawNotes.toLowerCase().includes(q) ||
        p.scentFamilies.some((f) => f.toLowerCase().includes(q)) ||
        matchesPrice
      );
    }).slice(0, 8);

    if (!matches.length) {
      dynamicView.innerHTML = `
        <div class="search-zero-state">
          <div class="search-zero-icon" aria-hidden="true">🔍</div>
          <h4 class="search-zero-title">No fragrances found for "${input.value.trim()}"</h4>
          <p class="search-zero-desc">Check your spelling, or explore these popular luxury selections.</p>
          <div class="search-zero-chips">
            <button type="button" class="search-suggestion-chip" data-search-term="Chanel">Chanel</button>
            <button type="button" class="search-suggestion-chip" data-search-term="Libre">YSL Libre</button>
            <button type="button" class="search-suggestion-chip" data-search-term="Good Girl">Good Girl</button>
            <a href="/shop/" class="search-suggestion-chip search-chip-primary">Browse All Perfumes</a>
          </div>
        </div>
      `;
      return;
    }

    dynamicView.innerHTML = `
      <div class="search-results-wrapper">
        <div class="search-results-meta">
          <span>Found <strong>${matches.length}</strong> ${matches.length === 1 ? 'fragrance' : 'fragrances'}</span>
          <a href="/shop/?search=${encodeURIComponent(input.value.trim())}" class="search-view-all-link">
            View all in Shop Collection →
          </a>
        </div>
        <div class="search-results-list">
          ${matches
            .map(
              (p) => `
            <a href="/perfumes/${p.slug}/" class="search-result-item">
              <div class="search-item-thumb">
                <img src="${p.image}" alt="${p.brand} ${p.name}" width="48" height="48" loading="lazy" decoding="async" />
              </div>
              <div class="search-item-info">
                <span class="search-item-brand">${p.brand}</span>
                <span class="search-item-name">${p.name}</span>
                <span class="search-item-meta">${p.sizeDisplay} · ${p.concentration}</span>
              </div>
              <div class="search-item-price-wrap">
                <span class="search-item-price">${p.priceDisplay}</span>
                <svg class="search-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </a>
          `
            )
            .join('')}
        </div>
      </div>
    `;
  }

  function openSearch() {
    if (typeof (window as any).closeMobileDrawer === 'function') {
      (window as any).closeMobileDrawer();
    }
    if (typeof (window as any).closeAllNavModals === 'function') {
      (window as any).closeAllNavModals();
    }
    getProductCatalog(); // Preload search catalog asynchronously in background
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('quick-search-input') as HTMLInputElement;
    const initialView = document.getElementById('search-initial-view');
    const dynamicView = document.getElementById('search-dynamic-view');

    if (modal) {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      if (input && !input.value.trim()) {
        if (initialView) initialView.style.display = 'flex';
        if (dynamicView) {
          dynamicView.style.display = 'none';
          dynamicView.innerHTML = '';
        }
      }
      setTimeout(() => input?.focus(), 50);
    }
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('quick-search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear-input-btn') as HTMLButtonElement;
    const initialView = document.getElementById('search-initial-view');
    const dynamicView = document.getElementById('search-dynamic-view');

    if (modal) {
      modal.hidden = true;
      const isOtherModalOpen =
        !document.getElementById('bag-drawer')?.hidden ||
        !document.getElementById('mobile-nav-drawer')?.hidden ||
        document.getElementById('wishlist-drawer')?.classList.contains('is-open') ||
        document.getElementById('discovery-modal')?.classList.contains('is-open') ||
        document.getElementById('families-modal')?.classList.contains('is-open') ||
        document.getElementById('support-modal')?.classList.contains('is-open');
      if (!isOtherModalOpen) {
        document.body.style.overflow = '';
      }
      if (input) input.value = '';
      if (clearBtn) clearBtn.style.display = 'none';
      if (initialView) initialView.style.display = 'flex';
      if (dynamicView) {
        dynamicView.style.display = 'none';
        dynamicView.innerHTML = '';
      }
    }
  }

  // Expose globally
  (window as any).openSearchModal = openSearch;
  (window as any).closeSearchModal = closeSearch;

  // Global Delegated Input Listener (Resilient to ViewTransitions & Dynamic Rendering)
  document.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.id === 'quick-search-input') {
      handleSearchInput(target as HTMLInputElement);
    }
  });

  // Global Delegated Keydown Listener (Enter submits to /shop/, Esc closes)
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.id === 'quick-search-input' && e.key === 'Enter') {
      const q = (target as HTMLInputElement).value.trim();
      if (q) {
        window.location.href = `/shop/?search=${encodeURIComponent(q)}`;
      }
      return;
    }

    if (e.key === 'Escape') {
      const modal = document.getElementById('search-modal');
      if (modal && !modal.hidden) closeSearch();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // Global Click Delegator (Never breaks on SPA navigation)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target) return;

    if (target.closest('.search-trigger, #open-search-modal-btn, .mobile-search-btn')) {
      e.preventDefault();
      openSearch();
      return;
    }

    if (target.closest('#close-search-modal-btn')) {
      e.preventDefault();
      closeSearch();
      return;
    }

    if (target.closest('#search-clear-input-btn')) {
      e.preventDefault();
      const input = document.getElementById('quick-search-input') as HTMLInputElement;
      if (input) {
        input.value = '';
        input.focus();
        handleSearchInput(input);
      }
      return;
    }

    // Suggestion chips
    const chip = target.closest<HTMLButtonElement>('[data-search-term]');
    if (chip) {
      e.preventDefault();
      const term = chip.getAttribute('data-search-term') || '';
      const input = document.getElementById('quick-search-input') as HTMLInputElement;
      if (input) {
        input.value = term;
        input.focus();
        handleSearchInput(input);
      }
      return;
    }

    // Auto-close search when clicking any result link
    if (target.closest('#search-modal a')) {
      closeSearch();
      return;
    }

    const modal = document.getElementById('search-modal');
    if (modal && target === modal) {
      closeSearch();
      return;
    }
  });

  // Re-sync badges and reset state on every Astro SPA route change
  document.addEventListener('astro:page-load', () => {
    updateWishlistBadge();
    updateBagBadge();
    closeSearch();
  });

  document.addEventListener('astro:before-preparation', () => {
    closeSearch();
  });
</script>
