<script>
  import { getProductCatalog } from '../lib/catalog';
  import { getFavorites } from '../lib/favorites';

  // Wishlist Badge Logic
  function updateWishlistBadge() {
    const badge = document.getElementById('header-wishlist-count');
    const heartIcon = document.querySelector('.wishlist-heart-icon');
    const favs = getFavorites();
    const count = favs.length;
    if (badge) {
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }
    if (heartIcon) {
      heartIcon.classList.toggle('is-active', count > 0);
    }
  }

  window.addEventListener('favorites-updated', updateWishlistBadge);
  // Also check on page load & tab focus
  window.addEventListener('focus', updateWishlistBadge);
  updateWishlistBadge();

  // Bag Badge Logic
  function updateBagBadge() {
    const bagBadge = document.getElementById('header-bag-count');
    try {
      const data = localStorage.getItem('lumera_bag_v1');
      const items = data ? JSON.parse(data) : [];
      const count = items.reduce((sum: number, it: any) => sum + (it.quantity || 1), 0);
      if (bagBadge) {
        bagBadge.textContent = String(count);
        bagBadge.hidden = count === 0;
      }
    } catch (e) {}
  }

  window.addEventListener('bag-updated', updateBagBadge);
  window.addEventListener('storage', updateBagBadge);
  window.addEventListener('focus', updateBagBadge);
  updateBagBadge();

  // Search Input Handler (Live Real-Time Filtering)
  async function handleSearchInput(input: HTMLInputElement) {
    const q = input.value.trim().toLowerCase();
    const clearBtn = document.getElementById('search-clear-input-btn') as HTMLButtonElement;
    const initialView = document.getElementById('search-initial-view');
    const dynamicView = document.getElementById('search-dynamic-view');

    if (clearBtn) {
      clearBtn.style.display = q ? 'flex' : 'none';
    }

    if (!q) {
      if (initialView) initialView.style.display = 'flex';
      if (dynamicView) {
        dynamicView.style.display = 'none';
        dynamicView.innerHTML = '';
      }
      return;
    }

    if (initialView) initialView.style.display = 'none';
    if (!dynamicView) return;
    dynamicView.style.display = 'block';

    const catalog = await getProductCatalog();
    const matches = catalog.filter((p) => {
      const isPriceQuery = q.includes('250') || q.includes('300') || q.includes('under') || q.includes('price');
      let matchesPrice = false;
      if (isPriceQuery && (q.includes('under') || q.includes('<') || q.includes('300'))) {
        matchesPrice = p.priceMinor < 30000;
      }

      return (
        p.name.toLowerCase().includes(q) ||
        p.brand.toLowerCase().includes(q) ||
        p.rawNotes.toLowerCase().includes(q) ||
        p.scentFamilies.some((f) => f.toLowerCase().includes(q)) ||
        matchesPrice
      );
    }).slice(0, 8);

    if (!matches.length) {
      dynamicView.innerHTML = `
        <div class="search-zero-state">
          <div class="search-zero-icon" aria-hidden="true">🔍</div>
          <h4 class="search-zero-title">No fragrances found for "${input.value.trim()}"</h4>
          <p class="search-zero-desc">Check your spelling, or explore these popular luxury selections.</p>
          <div class="search-zero-chips">
            <button type="button" class="search-suggestion-chip" data-search-term="Chanel">Chanel</button>
            <button type="button" class="search-suggestion-chip" data-search-term="Libre">YSL Libre</button>
            <button type="button" class="search-suggestion-chip" data-search-term="Good Girl">Good Girl</button>
            <a href="/shop/" class="search-suggestion-chip search-chip-primary">Browse All Fragrances</a>
          </div>
        </div>
      `;
      return;
    }

    dynamicView.innerHTML = `
      <div class="search-results-wrapper">
        <div class="search-results-meta">
          <span>Found <strong>${matches.length}</strong> ${matches.length === 1 ? 'fragrance' : 'fragrances'}</span>
          <a href="/shop/?search=${encodeURIComponent(input.value.trim())}" class="search-view-all-link">
            View all in Shop Collection →
          </a>
        </div>
        <div class="search-results-list">
          ${matches
            .map(
              (p) => `
            <a href="/perfumes/${p.slug}/" class="search-result-item">
              <div class="search-item-thumb">
                <img src="${p.image}" alt="${p.brand} ${p.name}" width="48" height="48" loading="lazy" decoding="async" />
              </div>
              <div class="search-item-info">
                <span class="search-item-brand">${p.brand}</span>
                <span class="search-item-name">${p.name}</span>
                <span class="search-item-meta">${p.sizeDisplay} · ${p.concentration}</span>
              </div>
              <div class="search-item-price-wrap">
                <span class="search-item-price">${p.priceDisplay}</span>
                <svg class="search-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </a>
          `
            )
            .join('')}
        </div>
      </div>
    `;
  }

  function openSearch() {
    if (typeof (window as any).closeMobileDrawer === 'function') {
      (window as any).closeMobileDrawer();
    }
    if (typeof (window as any).closeAllNavModals === 'function') {
      (window as any).closeAllNavModals();
    }
    getProductCatalog(); // Preload search catalog asynchronously in background
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('quick-search-input') as HTMLInputElement;
    const initialView = document.getElementById('search-initial-view');
    const dynamicView = document.getElementById('search-dynamic-view');

    if (modal) {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      if (input && !input.value.trim()) {
        if (initialView) initialView.style.display = 'flex';
        if (dynamicView) {
          dynamicView.style.display = 'none';
          dynamicView.innerHTML = '';
        }
      }
      setTimeout(() => input?.focus(), 50);
    }
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('quick-search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear-input-btn') as HTMLButtonElement;
    const initialView = document.getElementById('search-initial-view');
    const dynamicView = document.getElementById('search-dynamic-view');

    if (modal) {
      modal.hidden = true;
      const isOtherModalOpen =
        !document.getElementById('bag-drawer')?.hidden ||
        !document.getElementById('mobile-nav-drawer')?.hidden ||
        document.getElementById('wishlist-drawer')?.classList.contains('is-open') ||
        document.getElementById('discovery-modal')?.classList.contains('is-open') ||
        document.getElementById('families-modal')?.classList.contains('is-open') ||
        document.getElementById('support-modal')?.classList.contains('is-open');
      if (!isOtherModalOpen) {
        document.body.style.overflow = '';
      }
      if (input) input.value = '';
      if (clearBtn) clearBtn.style.display = 'none';
      if (initialView) initialView.style.display = 'flex';
      if (dynamicView) {
        dynamicView.style.display = 'none';
        dynamicView.innerHTML = '';
      }
    }
  }

  // Expose globally
  (window as any).openSearchModal = openSearch;
  (window as any).closeSearchModal = closeSearch;

  // Global Delegated Input Listener (Resilient to ViewTransitions & Dynamic Rendering)
  document.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.id === 'quick-search-input') {
      handleSearchInput(target as HTMLInputElement);
    }
  });

  // Global Delegated Keydown Listener (Enter submits to /shop/, Esc closes)
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.id === 'quick-search-input' && e.key === 'Enter') {
      const q = (target as HTMLInputElement).value.trim();
      if (q) {
        window.location.href = `/shop/?search=${encodeURIComponent(q)}`;
      }
      return;
    }

    if (e.key === 'Escape') {
      const modal = document.getElementById('search-modal');
      if (modal && !modal.hidden) closeSearch();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // Global Click Delegator (Never breaks on SPA navigation)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target) return;

    if (target.closest('.search-trigger, #open-search-modal-btn, .mobile-search-btn')) {
      e.preventDefault();
      openSearch();
      return;
    }

    if (target.closest('#close-search-modal-btn')) {
      e.preventDefault();
      closeSearch();
      return;
    }

    if (target.closest('#search-clear-input-btn')) {
      e.preventDefault();
      const input = document.getElementById('quick-search-input') as HTMLInputElement;
      if (input) {
        input.value = '';
        input.focus();
        handleSearchInput(input);
      }
      return;
    }

    // Suggestion chips
    const chip = target.closest<HTMLButtonElement>('[data-search-term]');
    if (chip) {
      e.preventDefault();
      const term = chip.getAttribute('data-search-term') || '';
      const input = document.getElementById('quick-search-input') as HTMLInputElement;
      if (input) {
        input.value = term;
        input.focus();
        handleSearchInput(input);
      }
      return;
    }

    // Auto-close search when clicking any result link
    if (target.closest('#search-modal a')) {
      closeSearch();
      return;
    }

    const modal = document.getElementById('search-modal');
    if (modal && target === modal) {
      closeSearch();
      return;
    }
  });

  // Re-sync badges and reset state on every Astro SPA route change
  document.addEventListener('astro:page-load', () => {
    updateWishlistBadge();
    updateBagBadge();
    closeSearch();
  });

  document.addEventListener('astro:before-preparation', () => {
    closeSearch();
  });
</script>
