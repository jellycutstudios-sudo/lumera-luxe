---
import { siteConfig } from '../data/site';
---

<div class="bag-drawer-backdrop" id="bag-backdrop" hidden></div>

<aside
  class="bag-drawer"
  id="bag-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bag-drawer-title"
  hidden
>
  <!-- Drawer Header -->
  <div class="bag-drawer-header">
    <div class="bag-drawer-title-group">
      <h2 id="bag-drawer-title" class="bag-drawer-title">Shopping Bag</h2>
      <span class="bag-drawer-badge" id="bag-items-badge">0 items</span>
    </div>
    <button class="bag-close-btn" id="bag-close-btn" aria-label="Close shopping bag">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Bag Items Container -->
  <div class="bag-drawer-body">
    <!-- Clean, Spacious Empty State -->
    <div id="bag-empty-state" class="bag-empty-state">
      <div class="empty-bag-stage">
        <div class="empty-bag-halo" aria-hidden="true"></div>
        <img
          src="/assets/brand/lumera-shopping-bag.webp"
          alt="Lumèra Luxe shopping bag"
          class="empty-bag-img"
          width="210"
          height="210"
          loading="eager"
        />
        <div class="empty-bag-shadow" aria-hidden="true"></div>
      </div>

      <div class="empty-text-wrap">
        <h3 class="empty-title">Your fragrance bag is empty</h3>
        <p class="empty-subtitle">Explore our collection of authentic luxury perfumes.</p>
        <a href="/shop/" class="btn-empty-browse" id="empty-shop-link">
          <span>BROWSE COLLECTION</span>
        </a>
      </div>
    </div>

    <!-- Active Bag Perks & Free Shipping Banner -->
    <div id="bag-delivery-perk" class="bag-perk-banner" hidden>
      <div class="perk-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <span class="perk-text" id="perk-text">Add 1 more fragrance for complimentary Qatar priority courier!</span>
    </div>

    <!-- Active Items List -->
    <ul id="bag-items-list" class="bag-items-list"></ul>
  </div>

  <!-- Bag Drawer Footer -->
  <div class="bag-drawer-footer" id="bag-footer" hidden>
    <!-- Pricing Summary -->
    <div class="bag-summary">
      <div class="summary-row">
        <span class="summary-label">Estimated Total</span>
        <span class="summary-val" id="bag-subtotal-val">0 QAR</span>
      </div>
      <div class="bag-payment-notice">
        <span class="status-dot"></span>
        <span>Complimentary Qatar Doorstep Delivery</span>
      </div>
    </div>

    <!-- Checkout Actions -->
    <div class="bag-actions">
      <a href="/checkout/" class="btn btn-primary btn-block btn-drawer-checkout" id="btn-drawer-checkout">
        <span>PROCEED TO CHECKOUT</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</aside>

<!-- Toast Notification -->
<div class="toast-notification" id="toast-notify" role="status" aria-live="polite" hidden>
  <span class="toast-message" id="toast-text">Added to bag</span>
  <button class="toast-action" id="toast-view-btn">View Bag</button>
</div>

<style>
  [hidden] {
    display: none !important;
  }

  .bag-drawer-backdrop[hidden],
  .bag-drawer[hidden],
  .toast-notification[hidden],
  .bag-perk-banner[hidden],
  .bag-empty-state[hidden],
  .bag-drawer-footer[hidden] {
    display: none !important;
  }

  .bag-drawer-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(24, 21, 19, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 100;
    transition: opacity 0.3s ease;
  }

  .bag-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background-color: #FFFFFF;
    z-index: 101;
    display: flex;
    flex-direction: column;
    box-shadow: -15px 0 45px rgba(0, 0, 0, 0.08);
    border-left: 1px solid rgba(0, 0, 0, 0.05);
    animation: drawerSlideIn 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerSlideIn {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Header */
  .bag-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.75rem;
    border-bottom: 1px solid #F0ECE6;
    background-color: #FFFFFF;
  }

  .bag-drawer-title-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .bag-drawer-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #181513;
    margin: 0;
    white-space: nowrap;
  }

  .bag-drawer-badge {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #76706B;
    background-color: #FAF8F5;
    border: 1px solid #E8E3DC;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .bag-close-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #181513;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .bag-close-btn:hover {
    background-color: #FAF8F5;
    border-color: #E8E3DC;
    transform: rotate(90deg);
  }

  .bag-close-btn:active {
    transform: scale(0.92);
  }

  @media (max-width: 480px) {
    .bag-drawer-header {
      padding: 1rem 1.25rem;
    }

    .bag-drawer-title {
      font-size: 1.05rem;
      letter-spacing: 0.06em;
    }

    .bag-close-btn {
      width: 38px;
      height: 38px;
    }
  }

  /* Body */
  .bag-drawer-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    padding: 1.5rem 1.25rem;
    background-color: #FFFFFF;
    display: flex;
    flex-direction: column;
    -webkit-overflow-scrolling: touch;
  }

  /* Spacious, Optimized Minimal Empty Bag State */
  .bag-empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
    margin: auto 0;
  }

  .empty-bag-stage {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
  }

  .empty-bag-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(197, 160, 89, 0.12) 0%, rgba(250, 248, 245, 0.45) 45%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .empty-bag-img {
    position: relative;
    z-index: 1;
    width: 200px;
    height: 200px;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(30, 25, 20, 0.08));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .empty-bag-stage:hover .empty-bag-img {
    transform: translateY(-4px) scale(1.02);
  }

  .empty-bag-shadow {
    width: 130px;
    height: 14px;
    background: radial-gradient(ellipse at center, rgba(30, 20, 10, 0.2) 0%, rgba(30, 20, 10, 0.05) 55%, transparent 75%);
    border-radius: 50%;
    filter: blur(3px);
    margin-top: -6px;
    z-index: 0;
  }

  .empty-text-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .empty-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: #181513;
    line-height: 1.3;
    margin-bottom: 0.65rem;
    letter-spacing: 0.01em;
  }

  .empty-subtitle {
    font-size: 0.85rem;
    color: #6D6760;
    line-height: 1.55;
    max-width: 290px;
    margin: 0 auto 1.85rem;
  }

  .btn-empty-browse {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #181513;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.95rem 2.5rem;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(24, 21, 19, 0.12);
    border: 1px solid #181513;
  }

  .btn-empty-browse:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(24, 21, 19, 0.22);
  }

  /* Active Bag Perks */
  .bag-perk-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: #FDF5F0;
    border: 1px solid rgba(200, 90, 36, 0.2);
    border-radius: 2px;
    margin-bottom: 1.25rem;
    animation: fadeIn 250ms ease;
  }

  .perk-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    display: flex;
  }

  .perk-text {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-main);
    line-height: 1.4;
  }

  .bag-perk-banner.unlocked {
    background-color: rgba(37, 211, 102, 0.08);
    border-color: rgba(37, 211, 102, 0.3);
  }

  .bag-perk-banner.unlocked .perk-icon {
    color: #1FAF59;
  }

  /* Item List */
  .bag-items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  :global(.bag-item-card) {
    display: flex;
    gap: 1.15rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #F0ECE6;
  }

  :global(.bag-item-img-wrap) {
    width: 78px;
    height: 96px;
    background-color: #FFFFFF;
    border-radius: 2px;
    border: 1px solid #E8E3DC;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  :global(.bag-item-img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  :global(.bag-item-details) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  :global(.bag-item-header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.15rem;
  }

  :global(.bag-item-info) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  :global(.bag-item-remove-btn) {
    background: transparent;
    border: none;
    color: #8F8880;
    cursor: pointer;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }

  :global(.bag-item-remove-btn:hover) {
    color: var(--color-brand-cognac);
    background-color: #FAF8F5;
  }

  :global(.bag-item-remove-btn:active) {
    transform: scale(0.9);
  }

  :global(.bag-item-brand) {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #8F8880;
  }

  :global(.bag-item-name) {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: #181513;
    margin-bottom: 0.2rem;
    line-height: 1.25;
  }

  :global(.bag-item-meta) {
    font-size: 0.72rem;
    color: #76706B;
    margin-bottom: 0.75rem;
  }

  :global(.bag-item-bottom) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    gap: 0.5rem;
  }

  :global(.bag-qty-group) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  :global(.bag-item-remove-link) {
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    color: #8F8880;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
    padding: 0.2rem 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.bag-item-remove-link:hover) {
    color: var(--color-brand-cognac);
  }

  :global(.bag-qty-controls) {
    display: flex;
    align-items: center;
    border: 1px solid #E8E3DC;
    border-radius: 2px;
    background-color: #FFFFFF;
  }

  :global(.bag-qty-btn) {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    color: #181513;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.bag-qty-btn:hover) {
    background-color: #FAF8F5;
  }

  :global(.bag-qty-btn:active) {
    background-color: #ECEAE5;
    transform: scale(0.92);
  }

  :global(.bag-qty-val) {
    min-width: 26px;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  :global(.bag-item-price) {
    font-size: 0.95rem;
    font-weight: 600;
    color: #181513;
  }

  /* Drawer Footer */
  .bag-drawer-footer {
    border-top: 1px solid #F0ECE6;
    padding: 1.25rem 1.75rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    background-color: #FFFFFF;
    flex-shrink: 0;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.03);
  }

  .bag-summary {
    margin-bottom: 1.15rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1rem;
    font-weight: 600;
    color: #181513;
    margin-bottom: 0.4rem;
  }

  .summary-label {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .summary-val {
    font-weight: 700;
    font-size: 1.1rem;
    color: #181513;
  }

  .bag-payment-notice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #76706B;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: #1FAF59;
    border-radius: 50%;
    display: inline-block;
  }

  .bag-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .btn-drawer-checkout {
    background-color: #181513;
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 600;
    min-height: 48px;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border-radius: 2px;
    box-shadow: 0 4px 16px rgba(24, 21, 19, 0.15);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-drawer-checkout:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(24, 21, 19, 0.22);
  }

  .btn-drawer-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid #E8E3DC;
    background-color: #FAF8F5;
    color: #181513;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .btn-drawer-whatsapp:hover {
    background-color: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }

  .btn-drawer-whatsapp svg {
    color: #25D366;
    transition: color 0.2s ease;
  }

  .btn-drawer-whatsapp:hover svg {
    color: #FFFFFF;
  }

  /* Toast Notification */
  .toast-notification {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    background-color: #181513;
    color: #FFFFFF;
    padding: 0.85rem 1.25rem;
    border-radius: 2px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    z-index: 110;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    animation: toastPop 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes toastPop {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .toast-message {
    font-size: 0.875rem;
  }

  .toast-action {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #C5A059;
    border-bottom: 1px solid #C5A059;
    padding-bottom: 1px;
    background: transparent;
    border-top: none;
    border-left: none;
    border-right: none;
    cursor: pointer;
  }
</style>

<script>
  import productsData from '../data/products.json';

  interface CartStorageItem {
    id: string;
    quantity: number;
  }

  const STORAGE_KEY = 'lumera_bag_v1';

  function getCartItems(): CartStorageItem[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveCartItems(items: CartStorageItem[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    } catch (e) {
      console.error('Failed to save cart to localStorage', e);
    }
    updateBagUI();
    window.dispatchEvent(new CustomEvent('bag-updated'));
    window.dispatchEvent(new Event('storage'));
  }

  function getHydratedCart() {
    const stored = getCartItems();
    return stored
      .map(item => {
        const prod = productsData.find(p => p.id === item.id || p.slug === item.id);
        if (!prod) return null;
        return {
          id: prod.id,
          name: prod.name,
          brand: prod.brand,
          sizeDisplay: prod.sizeDisplay,
          concentration: prod.concentration,
          priceMinor: prod.priceMinor,
          priceDisplay: prod.priceDisplay,
          image: prod.image,
          quantity: item.quantity
        };
      })
      .filter(Boolean);
  }

  function updateBagUI() {
    const items = getHydratedCart();
    const totalCount = items.reduce((sum, it) => sum + it.quantity, 0);

    // Update header badges
    const headerCount = document.getElementById('header-bag-count');
    if (headerCount) {
      headerCount.textContent = String(totalCount);
      headerCount.hidden = totalCount === 0;
    }

    const drawerBadge = document.getElementById('bag-items-badge');
    if (drawerBadge) drawerBadge.textContent = `${totalCount} item${totalCount === 1 ? '' : 's'}`;

    const emptyState = document.getElementById('bag-empty-state');
    const footer = document.getElementById('bag-footer');
    const list = document.getElementById('bag-items-list');
    const perkBanner = document.getElementById('bag-delivery-perk');
    const perkText = document.getElementById('perk-text');

    if (perkBanner && perkText) {
      if (totalCount === 0) {
        perkBanner.hidden = true;
      } else if (totalCount === 1) {
        perkBanner.hidden = false;
        perkBanner.classList.remove('unlocked');
        perkText.textContent = 'Add 1 more fragrance for complimentary Qatar priority delivery!';
      } else {
        perkBanner.hidden = false;
        perkBanner.classList.add('unlocked');
        perkText.textContent = '✓ Unlocked: Complimentary Qatar Priority Courier Delivery';
      }
    }

    if (!items.length) {
      if (emptyState) emptyState.hidden = false;
      if (footer) footer.hidden = true;
      if (list) list.innerHTML = '';
      return;
    }

    if (emptyState) emptyState.hidden = true;
    if (footer) footer.hidden = false;

    // Render list
    if (list) {
      list.innerHTML = items
        .map(
          item => `
        <li class="bag-item-card">
          <div class="bag-item-img-wrap">
            <img
              src="${item.image}"
              alt="${item.brand} ${item.name}"
              class="bag-item-img"
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
              onerror="this.onerror=null;this.src='/assets/lumera-logo.svg';"
            />
          </div>
          <div class="bag-item-details">
            <div class="bag-item-header">
              <div class="bag-item-info">
                <span class="bag-item-brand">${item.brand}</span>
                <h4 class="bag-item-name">${item.name}</h4>
              </div>
              <button
                type="button"
                class="bag-item-remove-btn"
                data-action="remove"
                data-id="${item.id}"
                aria-label="Remove ${item.name} from bag"
                title="Remove item"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
            <span class="bag-item-meta">${item.sizeDisplay} · ${item.concentration}</span>
            <div class="bag-item-bottom">
              <div class="bag-qty-group">
                <div class="bag-qty-controls">
                  <button class="bag-qty-btn" data-action="decrement" data-id="${item.id}" aria-label="Decrease quantity">−</button>
                  <span class="bag-qty-val">${item.quantity}</span>
                  <button class="bag-qty-btn" data-action="increment" data-id="${item.id}" aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="bag-item-remove-link" data-action="remove" data-id="${item.id}" aria-label="Remove ${item.name}">
                  Remove
                </button>
              </div>
              <span class="bag-item-price">${((item.priceMinor * item.quantity) / 100).toFixed(0)} QAR</span>
            </div>
          </div>
        </li>
      `
        )
        .join('');
    }

    // Update Subtotal
    const subtotalMinor = items.reduce((sum, it) => sum + it.priceMinor * it.quantity, 0);
    const subtotalEl = document.getElementById('bag-subtotal-val');
    if (subtotalEl) subtotalEl.textContent = `${(subtotalMinor / 100).toFixed(0)} QAR`;
  }

  // Bag Drawer Open/Close handling
  function openBag() {
    const backdrop = document.getElementById('bag-backdrop');
    const drawer = document.getElementById('bag-drawer');
    if (backdrop) backdrop.hidden = false;
    if (drawer) drawer.hidden = false;
    document.body.style.overflow = 'hidden';
    updateBagUI();
  }

  function closeBag() {
    const backdrop = document.getElementById('bag-backdrop');
    const drawer = document.getElementById('bag-drawer');
    if (backdrop) backdrop.hidden = true;
    if (drawer) drawer.hidden = true;
    document.body.style.overflow = '';
  }

  (window as any).openBagDrawer = openBag;
  (window as any).closeBagDrawer = closeBag;

  // Global Click Delegator (Never breaks on SPA route changes)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target) return;

    if (target.closest('#open-bag-btn, .bag-trigger, [data-action="open-bag"]')) {
      e.preventDefault();
      openBag();
      return;
    }

    if (target.closest('#bag-close-btn, #empty-shop-link, #btn-drawer-checkout')) {
      closeBag();
      return;
    }

    const backdropEl = document.getElementById('bag-backdrop');
    if (backdropEl && target === backdropEl) {
      closeBag();
      return;
    }
  });

  window.addEventListener('keydown', (e) => {
    const drawer = document.getElementById('bag-drawer');
    if (e.key === 'Escape' && drawer && !drawer.hidden) {
      closeBag();
    }
  });

  document.addEventListener('astro:page-load', () => {
    updateBagUI();
    closeBag();
  });

  document.addEventListener('astro:before-preparation', () => {
    closeBag();
  });

  // Global Add to Bag click delegator
  document.addEventListener('click', e => {
    const target = (e.target as HTMLElement).closest('[data-action]');
    if (!target) return;

    const action = target.getAttribute('data-action');
    const id = target.getAttribute('data-id');

    if (action === 'add-to-bag' && id) {
      const qtyToAdd = Math.max(1, parseInt(target.getAttribute('data-qty') || '1', 10));
      const items = getCartItems();
      const existing = items.find(it => it.id === id);
      if (existing) {
        existing.quantity += qtyToAdd;
      } else {
        items.push({ id, quantity: qtyToAdd });
      }
      saveCartItems(items);
      showToast('Added to bag');

      // Tactile button response
      const btnText = target.querySelector('.btn-text');
      if (btnText) {
        const orig = btnText.textContent;
        target.classList.add('added-success');
        btnText.textContent = '✓ Added';
        setTimeout(() => {
          target.classList.remove('added-success');
          btnText.textContent = orig;
        }, 1200);
      }

      // Bump header badge
      const headerCount = document.getElementById('header-bag-count');
      if (headerCount) {
        headerCount.classList.remove('bump');
        void headerCount.offsetWidth;
        headerCount.classList.add('bump');
        setTimeout(() => headerCount.classList.remove('bump'), 300);
      }
    }

    if (action === 'increment' && id) {
      const items = getCartItems();
      const existing = items.find(it => it.id === id);
      if (existing) {
        existing.quantity += 1;
        saveCartItems(items);
      }
    }

    if (action === 'decrement' && id) {
      let items = getCartItems();
      const existing = items.find(it => it.id === id);
      if (existing) {
        existing.quantity -= 1;
        if (existing.quantity <= 0) {
          items = items.filter(it => it.id !== id);
        }
        saveCartItems(items);
      }
    }

    if (action === 'remove' && id) {
      let items = getCartItems();
      items = items.filter(it => it.id !== id);
      saveCartItems(items);
      showToast('Removed from bag');
    }
  });

  // Toast
  let toastTimer: number;
  function showToast(msg: string) {
    const toast = document.getElementById('toast-notify');
    const text = document.getElementById('toast-text');
    if (!toast || !text) return;

    text.textContent = msg;
    toast.hidden = false;

    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.hidden = true;
    }, 3500);
  }

  const toastViewBtn = document.getElementById('toast-view-btn');
  if (toastViewBtn) {
    toastViewBtn.addEventListener('click', () => {
      const toast = document.getElementById('toast-notify');
      if (toast) toast.hidden = true;
      openBag();
    });
  }

  // Initial load sync
  updateBagUI();
</script>
