---
---

<div class="bag-drawer-backdrop" id="bag-backdrop" hidden></div>

<aside
  class="bag-drawer"
  id="bag-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bag-drawer-title"
  hidden
>
  <!-- Drawer Header -->
  <div class="bag-drawer-header">
    <div class="bag-drawer-title-group">
      <h2 id="bag-drawer-title" class="bag-drawer-title">Shopping Bag</h2>
      <span class="bag-drawer-badge" id="bag-items-badge">0 items</span>
    </div>
    <button class="bag-close-btn" id="bag-close-btn" aria-label="Close shopping bag">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Bag Items Container -->
  <div class="bag-drawer-body">
    <!-- Clean, Spacious Empty State -->
    <div id="bag-empty-state" class="bag-empty-state">
      <div class="empty-bag-stage">
        <div class="empty-bag-halo" aria-hidden="true"></div>
        <img
          src="/assets/brand/lumera-shopping-bag.webp"
          alt="Lumèra Luxe shopping bag"
          class="empty-bag-img"
          width="210"
          height="210"
          loading="eager"
        />
        <div class="empty-bag-shadow" aria-hidden="true"></div>
      </div>

      <div class="empty-text-wrap">
        <h3 class="empty-title">Your fragrance bag is empty</h3>
        <p class="empty-subtitle">Explore our collection of authentic luxury perfumes.</p>
        <a href="/shop/" class="btn-empty-browse" id="empty-shop-link">
          <span>BROWSE COLLECTION</span>
        </a>
      </div>
    </div>

    <!-- Active Bag Perks & Free Shipping Banner -->
    <div id="bag-delivery-perk" class="bag-perk-banner" hidden>
      <div class="perk-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <span class="perk-text" id="perk-text">Free express delivery on orders above 300 QAR</span>
    </div>

    <!-- Active Items List -->
    <ul id="bag-items-list" class="bag-items-list"></ul>
  </div>

  <!-- Bag Drawer Footer -->
  <div class="bag-drawer-footer" id="bag-footer" hidden>
    <!-- Pricing Summary -->
    <div class="bag-summary">
      <div class="summary-row">
        <span class="summary-label">Estimated Total</span>
        <span class="summary-val" id="bag-subtotal-val">0 QAR</span>
      </div>
      <div class="bag-payment-notice">
        <span class="status-dot"></span>
        <span id="bag-delivery-notice-text">Express 6-Hour Delivery (Free Above 300 QAR)</span>
      </div>
    </div>

    <!-- Checkout Actions -->
    <div class="bag-actions">
      <a href="/checkout/" class="btn btn-primary btn-block btn-drawer-checkout" id="btn-drawer-checkout">
        <span>PROCEED TO CHECKOUT</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</aside>

<div class="sr-only" id="toast-announcement" role="status"></div>
<div class="toast-notification" id="toast-notify" role="region" aria-label="Shopping bag update" hidden>
  <div class="toast-header-bar">
    <div class="toast-status">
      <span class="toast-check-icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>
      <span class="toast-status-text" id="toast-kicker">Added to your bag</span>
    </div>
    <button type="button" class="toast-close-btn" id="toast-close-btn" aria-label="Dismiss notification" data-action="dismiss-toast">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="toast-body" id="toast-product-body">
    <div class="toast-thumb-wrap" id="toast-thumb-wrap" hidden>
      <img alt="" class="toast-thumb-img" id="toast-img" width="58" height="58" decoding="async" />
    </div>
    <div class="toast-meta">
      <span class="toast-brand" id="toast-brand"></span>
      <span class="toast-name" id="toast-name"></span>
      <div class="toast-details-row">
        <span class="toast-size" id="toast-size"></span>
        <span class="toast-dot" id="toast-dot" aria-hidden="true">·</span>
        <span class="toast-price" id="toast-price"></span>
      </div>
    </div>
  </div>

  <div class="toast-actions" id="toast-actions">
    <button type="button" class="toast-btn-view" id="toast-view-btn" data-action="open-bag">
      <span>View bag</span>
      <span class="toast-count-pill" id="toast-bag-count" aria-hidden="true"></span>
    </button>
    <a href="/checkout/" class="toast-btn-checkout" id="toast-checkout-btn">
      Checkout
    </a>
  </div>

  <div class="toast-progress-track" aria-hidden="true">
    <div class="toast-progress-bar" id="toast-progress-bar"></div>
  </div>
</div>

<style>
  [hidden] {
    display: none !important;
  }

  .bag-drawer-backdrop[hidden],
  .bag-drawer[hidden],
  .toast-notification[hidden],
  .bag-perk-banner[hidden],
  .bag-empty-state[hidden],
  .bag-drawer-footer[hidden] {
    display: none !important;
  }

  .bag-drawer-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(24, 21, 19, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 1100;
    transition: opacity 0.3s ease;
  }

  .bag-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background-color: #FFFFFF;
    z-index: 1101;
    display: flex;
    flex-direction: column;
    box-shadow: -15px 0 45px rgba(0, 0, 0, 0.08);
    border-left: 1px solid rgba(0, 0, 0, 0.05);
    animation: drawerSlideIn 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerSlideIn {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Header */
  .bag-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.75rem;
    border-bottom: 1px solid #F0ECE6;
    background-color: #FFFFFF;
  }

  .bag-drawer-title-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem .85rem;
    min-width: 0;
  }

  .bag-drawer-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #181513;
    margin: 0;
  }

  .bag-drawer-badge {
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #76706B;
    background-color: #FAF8F5;
    border: 1px solid #E8E3DC;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .bag-close-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #181513;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .bag-close-btn:hover {
    background-color: #FAF8F5;
    border-color: #E8E3DC;
    transform: rotate(90deg);
  }

  .bag-close-btn:active {
    transform: scale(0.92);
  }

  @media (max-width: 480px) {
    .bag-drawer-header {
      padding: 1rem 1.25rem;
    }

    .bag-drawer-title {
      font-size: 1.05rem;
      letter-spacing: 0.06em;
    }

    .bag-close-btn {
      width: 38px;
      height: 38px;
    }
  }

  /* Body */
  .bag-drawer-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    padding: 1.5rem 1.25rem;
    background-color: #FFFFFF;
    display: flex;
    flex-direction: column;
    -webkit-overflow-scrolling: touch;
  }

  /* Spacious, Optimized Minimal Empty Bag State */
  .bag-empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
    margin: auto 0;
  }

  .empty-bag-stage {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
  }

  .empty-bag-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(197, 160, 89, 0.12) 0%, rgba(250, 248, 245, 0.45) 45%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .empty-bag-img {
    position: relative;
    z-index: 1;
    width: 200px;
    height: 200px;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(30, 25, 20, 0.08));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .empty-bag-stage:hover .empty-bag-img {
    transform: translateY(-4px) scale(1.02);
  }

  .empty-bag-shadow {
    width: 130px;
    height: 14px;
    background: radial-gradient(ellipse at center, rgba(30, 20, 10, 0.2) 0%, rgba(30, 20, 10, 0.05) 55%, transparent 75%);
    border-radius: 50%;
    filter: blur(3px);
    margin-top: -6px;
    z-index: 0;
  }

  .empty-text-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .empty-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: #181513;
    line-height: 1.3;
    margin-bottom: 0.65rem;
    letter-spacing: 0.01em;
  }

  .empty-subtitle {
    font-size: 1rem;
    color: #6D6760;
    line-height: 1.55;
    max-width: 290px;
    margin: 0 auto 1.85rem;
  }

  .btn-empty-browse {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #181513;
    color: #FFFFFF;
    text-decoration: none;
    font-size: .875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.95rem 2.5rem;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(24, 21, 19, 0.12);
    border: 1px solid #181513;
  }

  .btn-empty-browse:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(24, 21, 19, 0.22);
  }

  /* Active Bag Perks */
  .bag-perk-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: #FDF5F0;
    border: 1px solid rgba(200, 90, 36, 0.2);
    border-radius: 2px;
    margin-bottom: 1.25rem;
    animation: fadeIn 250ms ease;
  }

  .perk-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    display: flex;
  }

  .perk-text {
    font-size: .875rem;
    font-weight: 500;
    color: var(--color-text-main);
    line-height: 1.4;
  }

  .bag-perk-banner.unlocked {
    background-color: rgba(37, 211, 102, 0.08);
    border-color: rgba(37, 211, 102, 0.3);
  }

  .bag-perk-banner.unlocked .perk-icon {
    color: #1FAF59;
  }

  /* Item List */
  .bag-items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  :global(.bag-item-card) {
    display: flex;
    gap: 1.15rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #F0ECE6;
  }

  :global(.bag-item-img-wrap) {
    width: 78px;
    height: 96px;
    background-color: #FFFFFF;
    border-radius: 2px;
    border: 1px solid #E8E3DC;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  :global(.bag-item-img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  :global(.bag-item-details) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  :global(.bag-item-header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.15rem;
  }

  :global(.bag-item-info) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  :global(.bag-item-remove-btn) {
    background: transparent;
    border: none;
    color: #8F8880;
    cursor: pointer;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all var(--transition-fast);
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }

  :global(.bag-item-remove-btn:hover) {
    color: var(--color-brand-cognac);
    background-color: #FAF8F5;
  }

  :global(.bag-item-remove-btn:active) {
    transform: scale(0.9);
  }

  :global(.bag-item-brand) {
    font-size: .875rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
  }

  :global(.bag-item-name) {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.4vw, 1.2rem);
    font-weight: 500;
    color: #181513;
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  :global(.bag-item-meta) {
    font-size: .875rem;
    color: #76706B;
    margin-bottom: 0.75rem;
  }

  :global(.bag-item-bottom) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    gap: 0.5rem;
  }

  :global(.bag-qty-group) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  :global(.bag-item-remove-link) {
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 500;
    color: var(--color-text-light);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
    padding: 0.2rem 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.bag-item-remove-link:hover) {
    color: var(--color-brand-cognac);
  }

  :global(.bag-qty-controls) {
    display: flex;
    align-items: center;
    border: 1px solid #E8E3DC;
    border-radius: 2px;
    background-color: #FFFFFF;
  }

  :global(.bag-qty-btn) {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    color: #181513;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.bag-qty-btn:hover) {
    background-color: #FAF8F5;
  }

  :global(.bag-qty-btn:active) {
    background-color: #ECEAE5;
    transform: scale(0.92);
  }

  :global(.bag-qty-val) {
    min-width: 26px;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  :global(.bag-item-price) {
    font-size: clamp(1.05rem, 1.4vw, 1.15rem);
    font-weight: 700;
    color: #181513;
  }

  /* Drawer Footer */
  .bag-drawer-footer {
    border-top: 1px solid #F0ECE6;
    padding: 1.25rem 1.75rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    background-color: #FFFFFF;
    flex-shrink: 0;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.03);
  }

  .bag-summary {
    margin-bottom: 1.15rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1rem;
    font-weight: 600;
    color: #181513;
    margin-bottom: 0.4rem;
  }

  .summary-label {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.4vw, 1.15rem);
    letter-spacing: 0.02em;
  }

  .summary-val {
    font-weight: 700;
    font-size: clamp(1.15rem, 1.6vw, 1.3rem);
    color: #181513;
  }

  .bag-payment-notice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: .875rem;
    color: #76706B;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: #1FAF59;
    border-radius: 50%;
    display: inline-block;
  }

  .bag-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .btn-drawer-checkout {
    background-color: #181513;
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 600;
    min-height: 52px;
    font-size: 1rem;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border-radius: 2px;
    box-shadow: 0 4px 16px rgba(24, 21, 19, 0.15);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-drawer-checkout:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(24, 21, 19, 0.22);
  }

  .btn-drawer-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid #E8E3DC;
    background-color: #FAF8F5;
    color: #181513;
    text-decoration: none;
    font-size: .875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .btn-drawer-whatsapp:hover {
    background-color: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }

  .btn-drawer-whatsapp svg {
    color: #25D366;
    transition: color 0.2s ease;
  }

  .btn-drawer-whatsapp:hover svg {
    color: #FFFFFF;
  }

  /* Shopping bag notification */
  .toast-notification {
    --toast-gold: #e9ca93;
    --toast-text: #fff8ee;
    --toast-muted: #d9c7b9;

    position: fixed;
    z-index: 1200;
    inset: auto max(1.5rem, env(safe-area-inset-right, 0px))
      max(1.5rem, env(safe-area-inset-bottom, 0px)) auto;
    width: min(23rem, calc(100% - 3rem));
    padding: 0.75rem 1rem 1rem;
    display: grid;
    gap: 0.75rem;
    overflow: hidden;
    background: #211914;
    color: var(--toast-text);
    border: 1px solid #5b4737;
    border-radius: 1rem;
    box-shadow: 0 12px 32px rgb(33 25 20 / 28%);
    animation: toastSlideUp 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 767px) {
    .toast-notification {
      inset-inline: max(0.75rem, env(safe-area-inset-left, 0px))
        max(0.75rem, env(safe-area-inset-right, 0px));
      bottom: calc(5.25rem + env(safe-area-inset-bottom, 0px));
      width: auto;
      max-width: 23rem;
      margin-inline: auto;
    }
  }

  @keyframes toastSlideUp {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  .toast-header-bar,
  .toast-status {
    display: flex;
    align-items: center;
  }

  .toast-header-bar {
    justify-content: space-between;
    gap: 0.5rem;
  }

  .toast-status {
    gap: 0.625rem;
  }

  .toast-status-text {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .toast-check-icon,
  .toast-close-btn {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
  }

  .toast-check-icon {
    width: 1.75rem;
    height: 1.75rem;
    background: #49382b;
    color: var(--toast-gold);
  }

  .toast-close-btn {
    width: 44px;
    height: 44px;
    margin-block: -0.25rem;
    margin-inline-end: -0.375rem;
    padding: 0;
    background: transparent;
    color: var(--toast-muted);
    border: 0;
    cursor: pointer;
  }

  .toast-close-btn:hover {
    color: var(--toast-text);
    background: #392b23;
  }

  .toast-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem;
    border: 1px solid #49372b;
    border-radius: 0.75rem;
    background: #2d221b;
  }

  .toast-thumb-wrap {
    width: 3.625rem;
    height: 3.625rem;
    flex: none;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #fff;
  }

  .toast-thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .toast-meta {
    display: grid;
    min-width: 0;
    gap: 0.1875rem;
    line-height: 1.3;
  }

  .toast-brand {
    color: var(--toast-gold);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toast-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 650;
  }

  .toast-details-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.375rem;
    color: var(--toast-muted);
    font-size: 0.8125rem;
  }

  .toast-price {
    font-weight: 700;
    color: var(--toast-text);
    white-space: nowrap;
  }

  .toast-actions {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 0.5rem;
  }

  .toast-btn-view,
  .toast-btn-checkout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0.375rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    font: 700 0.875rem/1.2 var(--font-body);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 160ms ease;
  }

  .toast-btn-view {
    background: var(--toast-gold);
    color: #211914;
  }

  .toast-btn-view:hover {
    background: #f7dcb0;
  }

  .toast-count-pill {
    flex: none;
    min-width: 1.375rem;
    padding: 0.1875rem 0.25rem;
    border-radius: 1rem;
    background: rgb(33 25 20 / 12%);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .toast-btn-checkout {
    border-color: #705b49;
    background: #31251d;
    color: var(--toast-text);
  }

  .toast-btn-checkout:hover {
    background: #47362a;
    color: var(--toast-text);
  }

  .toast-notification :focus-visible {
    outline: 2px solid var(--toast-gold);
    outline-offset: 2px;
  }

  .toast-progress-track {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: #392b23;
  }

  .toast-progress-bar {
    height: 100%;
    background: #bb975f;
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .toast-notification {
      animation: none;
    }

    .toast-progress-track {
      visibility: hidden;
    }
  }

  /* Global feedback styles for Add-to-Bag buttons across the site */
  :global(.btn-pdp-add-bag.added-success),
  :global(.btn-sticky-add-bag.added-success) {
    background-color: #181513 !important;
    border-color: #C5A059 !important;
    color: #E6C875 !important;
    box-shadow: 0 0 16px rgba(197, 160, 89, 0.35) !important;
  }

  :global(.quick-add-btn.added-success) {
    background: #181513 !important;
    border-color: #C5A059 !important;
    color: #E6C875 !important;
    box-shadow: 0 0 12px rgba(197, 160, 89, 0.4) !important;
    transform: scale(1.08) !important;
  }
</style>

<script>
  import { getProductCatalog, getCachedProductCatalog } from '../lib/catalog';
  import { FREE_DELIVERY_THRESHOLD_QAR, getDeliveryFeeQar } from '../lib/delivery';

  // Pre-warm catalog in background for fast synchronous lookups
  getProductCatalog().catch(() => {});

  interface CartStorageItem {
    id: string;
    quantity: number;
  }

  const STORAGE_KEY = 'lumera_bag_v1';

  function getCartItems(): CartStorageItem[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveCartItems(items: CartStorageItem[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    } catch (e) {
      console.error('Failed to save cart to localStorage', e);
    }
    updateBagUI();
    window.dispatchEvent(new CustomEvent('bag-updated'));
    window.dispatchEvent(new Event('storage'));
  }

  async function getHydratedCart() {
    const stored = getCartItems();
    if (stored.length === 0) return [];
    const productsData = await getProductCatalog();
    return stored
      .map(item => {
        const prod = productsData.find(p => p.id === item.id || p.slug === item.id);
        if (!prod) return null;
        return {
          id: prod.id,
          name: prod.name,
          brand: prod.brand,
          sizeDisplay: prod.sizeDisplay,
          concentration: prod.concentration,
          priceMinor: prod.priceMinor,
          priceDisplay: prod.priceDisplay,
          image: prod.image,
          quantity: item.quantity
        };
      })
      .filter((it): it is NonNullable<typeof it> => it !== null);
  }

  async function updateBagUI() {
    const stored = getCartItems();
    const totalCount = stored.reduce((sum, it) => sum + it.quantity, 0);

    // Update header badges immediately (synchronous, 0ms overhead)
    const headerCount = document.getElementById('header-bag-count');
    if (headerCount) {
      headerCount.textContent = String(totalCount);
      headerCount.hidden = totalCount === 0;
    }

    const drawerBadge = document.getElementById('bag-items-badge');
    if (drawerBadge) drawerBadge.textContent = `${totalCount} item${totalCount === 1 ? '' : 's'}`;

    const emptyState = document.getElementById('bag-empty-state');
    const footer = document.getElementById('bag-footer');
    const list = document.getElementById('bag-items-list');
    const perkBanner = document.getElementById('bag-delivery-perk');
    const perkText = document.getElementById('perk-text');

    const items = totalCount ? await getHydratedCart() : [];

    if (!items.length) {
      if (perkBanner) perkBanner.hidden = true;
      if (emptyState) emptyState.hidden = false;
      if (footer) footer.hidden = true;
      if (list) list.innerHTML = '';
      return;
    }

    if (emptyState) emptyState.hidden = true;
    if (footer) footer.hidden = false;

    const subtotalMinor = items.reduce((sum, item) => sum + item.priceMinor * item.quantity, 0);
    if (perkBanner && perkText) {
      const qualifies = getDeliveryFeeQar(subtotalMinor) === 0;
      perkBanner.hidden = false;
      perkBanner.classList.toggle('unlocked', qualifies);
      if (qualifies) {
        perkText.textContent = 'Free express delivery unlocked';
      } else {
        const remainingQar = FREE_DELIVERY_THRESHOLD_QAR - subtotalMinor / 100;
        perkText.textContent = remainingQar > 0
          ? `Add more than ${remainingQar.toFixed(2).replace(/\.00$/, '')} QAR for free express delivery.`
          : `Spend above ${FREE_DELIVERY_THRESHOLD_QAR} QAR for free express delivery.`;
      }
    }

    // Render list
    if (list) {
      list.innerHTML = items
        .map(
          item => `
        <li class="bag-item-card">
          <div class="bag-item-img-wrap">
            <img
              src="${item.image}"
              alt="${item.brand} ${item.name}"
              class="bag-item-img"
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
              onerror="this.onerror=null;this.src='/assets/lumera-logo.svg';"
            />
          </div>
          <div class="bag-item-details">
            <div class="bag-item-header">
              <div class="bag-item-info">
                <span class="bag-item-brand">${item.brand}</span>
                <h4 class="bag-item-name">${item.name}</h4>
              </div>
              <button
                type="button"
                class="bag-item-remove-btn"
                data-action="remove"
                data-id="${item.id}"
                aria-label="Remove ${item.name} from bag"
                title="Remove item"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
            <span class="bag-item-meta">${item.sizeDisplay} · ${item.concentration}</span>
            <div class="bag-item-bottom">
              <div class="bag-qty-group">
                <div class="bag-qty-controls">
                  <button class="bag-qty-btn" data-action="decrement" data-id="${item.id}" aria-label="Decrease quantity">−</button>
                  <span class="bag-qty-val">${item.quantity}</span>
                  <button class="bag-qty-btn" data-action="increment" data-id="${item.id}" aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="bag-item-remove-link" data-action="remove" data-id="${item.id}" aria-label="Remove ${item.name}">
                  Remove
                </button>
              </div>
              <span class="bag-item-price">${((item.priceMinor * item.quantity) / 100).toFixed(0)} QAR</span>
            </div>
          </div>
        </li>
      `
        )
        .join('');
    }

    // Update Subtotal
    const subtotalEl = document.getElementById('bag-subtotal-val');
    if (subtotalEl) subtotalEl.textContent = `${(subtotalMinor / 100).toFixed(0)} QAR`;
  }

  // Bag Drawer Open/Close handling
  function openBag() {
    hideToast();

    (window as Window & { closeAllNavModals?: () => void }).closeAllNavModals?.();

    const backdrop = document.getElementById('bag-backdrop');
    const drawer = document.getElementById('bag-drawer');
    if (backdrop) backdrop.hidden = false;
    if (drawer) drawer.hidden = false;
    document.body.style.overflow = 'hidden';
    updateBagUI();
  }

  function closeBag() {
    const backdrop = document.getElementById('bag-backdrop');
    const drawer = document.getElementById('bag-drawer');
    if (backdrop) backdrop.hidden = true;
    if (drawer) drawer.hidden = true;
    const isOtherModalOpen =
      Boolean(!document.getElementById('mobile-nav-drawer')?.hidden) ||
      Boolean(!document.getElementById('search-modal')?.hidden) ||
      Boolean(document.getElementById('wishlist-drawer')?.classList.contains('is-open')) ||
      Boolean(document.getElementById('discovery-modal')?.classList.contains('is-open')) ||
      Boolean(document.getElementById('families-modal')?.classList.contains('is-open')) ||
      Boolean(document.getElementById('support-modal')?.classList.contains('is-open'));
    if (!isOtherModalOpen) {
      document.body.style.overflow = '';
    }
  }

  (window as any).openBagDrawer = openBag;
  (window as any).closeBagDrawer = closeBag;

  // Global Click Delegator (Never breaks on SPA route changes / ClientRouter)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target) return;

    // Open Bag trigger (from header, toast, or buttons)
    if (target.closest('#open-bag-btn, .bag-trigger, #toast-view-btn, .toast-btn-view, [data-action="open-bag"]')) {
      e.preventDefault();
      openBag();
      if (target.closest('#toast-view-btn')) {
        document.getElementById('bag-close-btn')?.focus({ preventScroll: true });
      }
      return;
    }

    // Dismiss Toast
    if (target.closest('[data-action="dismiss-toast"], #toast-close-btn')) {
      e.preventDefault();
      hideToast();
      return;
    }

    if (target.closest('#bag-close-btn, #empty-shop-link, #btn-drawer-checkout')) {
      closeBag();
      return;
    }

    const backdropEl = document.getElementById('bag-backdrop');
    if (backdropEl && target === backdropEl) {
      closeBag();
      return;
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || e.defaultPrevented) return;
    const toast = document.getElementById('toast-notify');
    const drawer = document.getElementById('bag-drawer');
    if (toast && !toast.hidden) {
      hideToast();
    } else if (drawer && !drawer.hidden) {
      closeBag();
    }
  });

  document.addEventListener('astro:page-load', () => {
    updateBagUI();
    closeBag();
  });

  document.addEventListener('astro:before-preparation', () => {
    closeBag();
    hideToast();
  });

  // Global Add to Bag click delegator
  document.addEventListener('click', e => {
    const target = (e.target as HTMLElement).closest('[data-action]');
    if (!target) return;

    const action = target.getAttribute('data-action');
    const id = target.getAttribute('data-id');

    if (action === 'add-to-bag' && id) {
      const qtyToAdd = Math.max(1, parseInt(target.getAttribute('data-qty') || '1', 10));
      const items = getCartItems();
      const existing = items.find(it => it.id === id);
      if (existing) {
        existing.quantity += qtyToAdd;
      } else {
        items.push({ id, quantity: qtyToAdd });
      }
      saveCartItems(items);

      // Use the details on the add button, with the catalog as a fallback.
      let pName = target.getAttribute('data-name') || '';
      let pBrand = target.getAttribute('data-brand') || '';
      let pSize = target.getAttribute('data-size') || target.getAttribute('data-concentration') || '';
      const rawPrice = target.getAttribute('data-price');
      let pPrice = rawPrice ? `${(parseInt(rawPrice, 10) / 100).toFixed(0)} QAR` : '';
      let pImage = target.getAttribute('data-image') || '';

      if (!pName || !pImage) {
        const catalog = getCachedProductCatalog();
        const prod = catalog?.find(p => p.id === id);
        if (prod) {
          pName = pName || prod.name;
          pBrand = pBrand || prod.brand;
          pSize = pSize || [prod.sizeDisplay, prod.concentration].filter(Boolean).join(' · ');
          pPrice = pPrice || `${(prod.priceMinor / 100).toFixed(0)} QAR`;
          pImage = pImage || prod.image;
        }
      }

      showToast({
        kicker: 'Added to your bag',
        name: pName,
        brand: pBrand,
        size: pSize,
        price: pPrice,
        image: pImage
      }, target);

      // Tactile button response on PDP and cards
      const btnLabel = target.querySelector('.btn-text, span:not(.sr-only), span');
      if (btnLabel && !target.classList.contains('quick-add-btn')) {
        const orig = btnLabel.textContent;
        target.classList.add('added-success');
        btnLabel.textContent = '✓ Added to Bag';
        setTimeout(() => {
          target.classList.remove('added-success');
          btnLabel.textContent = orig;
        }, 1400);
      } else if (target.classList.contains('quick-add-btn')) {
        target.classList.add('added-success');
        const plusIcon = target.querySelector('.plus-icon');
        if (plusIcon) plusIcon.textContent = '✓';
        setTimeout(() => {
          target.classList.remove('added-success');
          if (plusIcon) plusIcon.textContent = '+';
        }, 1400);
      }

      // Bump header badge
      const headerCount = document.getElementById('header-bag-count');
      if (headerCount) {
        headerCount.classList.remove('bump');
        void headerCount.offsetWidth;
        headerCount.classList.add('bump');
        setTimeout(() => headerCount.classList.remove('bump'), 300);
      }
    }

    if (action === 'add-duet-to-bag') {
      const id1 = target.getAttribute('data-id-1');
      const id2 = target.getAttribute('data-id-2');
      if (id1 && id2) {
        const items = getCartItems();
        [id1, id2].forEach(id => {
          const existing = items.find(it => it.id === id);
          if (existing) {
            existing.quantity += 1;
          } else {
            items.push({ id, quantity: 1 });
          }
        });
        saveCartItems(items);
        showToast({
          kicker: 'Perfume pair added to your bag',
          name: 'Two-Bottle Fragrance Set',
          brand: 'LUMÈRA LUXE'
        }, target);

        // Tactile button response
        const btnText = target.querySelector('.btn-duet-text') || target.querySelector('span');
        if (btnText) {
          const orig = btnText.textContent;
          target.classList.add('added-success');
          btnText.textContent = '✓ Scent Duet Added';
          setTimeout(() => {
            target.classList.remove('added-success');
            btnText.textContent = orig;
          }, 1500);
        }

        // Bump header badge
        const headerCount = document.getElementById('header-bag-count');
        if (headerCount) {
          headerCount.classList.remove('bump');
          void headerCount.offsetWidth;
          headerCount.classList.add('bump');
          setTimeout(() => headerCount.classList.remove('bump'), 300);
        }

        // Open bag drawer so customer immediately views both bottles
        setTimeout(() => {
          openBag();
        }, 350);
      }
    }

    if (action === 'increment' && id) {
      const items = getCartItems();
      const existing = items.find(it => it.id === id);
      if (existing) {
        existing.quantity += 1;
        saveCartItems(items);
      }
    }

    if (action === 'decrement' && id) {
      let items = getCartItems();
      const existing = items.find(it => it.id === id);
      if (existing) {
        existing.quantity -= 1;
        if (existing.quantity <= 0) {
          items = items.filter(it => it.id !== id);
        }
        saveCartItems(items);
      }
    }

    if (action === 'remove' && id) {
      let items = getCartItems();
      items = items.filter(it => it.id !== id);
      saveCartItems(items);
      showToast({ kicker: 'Removed from your bag' }, target);
    }
  });

  interface ToastOptions {
    kicker: string;
    brand?: string;
    name?: string;
    size?: string;
    price?: string;
    image?: string;
  }

  let toastCountdown: Animation | undefined;
  let toastEvents: AbortController | undefined;
  let toastTrigger: HTMLElement | undefined;

  function showToast({ kicker, brand, name, size, price, image }: ToastOptions, trigger: Element) {
    const toast = document.getElementById('toast-notify');
    const progressBar = document.getElementById('toast-progress-bar');
    if (!toast || !progressBar) return;

    const kickerEl = document.getElementById('toast-kicker');
    const announcement = document.getElementById('toast-announcement');
    const brandEl = document.getElementById('toast-brand');
    const nameEl = document.getElementById('toast-name');
    const sizeEl = document.getElementById('toast-size');
    const priceEl = document.getElementById('toast-price');
    const dotEl = document.getElementById('toast-dot');
    const imgEl = document.getElementById('toast-img') as HTMLImageElement | null;
    const thumbWrap = document.getElementById('toast-thumb-wrap');
    const productBody = document.getElementById('toast-product-body');
    const actions = document.getElementById('toast-actions');
    const viewButton = document.getElementById('toast-view-btn');
    const countEl = document.getElementById('toast-bag-count');

    const totalCount = getCartItems().reduce((sum, it) => sum + (it.quantity || 1), 0);
    const itemCount = `${totalCount} item${totalCount === 1 ? '' : 's'}`;
    if (countEl) countEl.textContent = String(totalCount);
    viewButton?.setAttribute('aria-label', `View bag, ${itemCount}`);
    if (actions) actions.hidden = totalCount === 0;

    if (kickerEl) kickerEl.textContent = kicker;
    if (brandEl) {
      brandEl.textContent = brand || '';
      brandEl.hidden = !brand;
    }
    if (nameEl) nameEl.textContent = name || 'Selected perfume';
    if (sizeEl) {
      sizeEl.textContent = size || '';
      sizeEl.hidden = !size;
    }
    if (priceEl) {
      priceEl.textContent = price || '';
      priceEl.hidden = !price;
    }
    if (dotEl) dotEl.hidden = !size || !price;
    if (imgEl && image && imgEl.getAttribute('src') !== image) imgEl.src = image;
    if (thumbWrap) thumbWrap.hidden = !image;
    if (productBody) productBody.hidden = !(name || brand || image);
    if (announcement) announcement.textContent = [kicker, name, itemCount].filter(Boolean).join('. ');

    toastTrigger = trigger instanceof HTMLElement ? trigger : undefined;
    toast.hidden = false;
    toastCountdown?.cancel();
    toastEvents?.abort();
    toastEvents = new AbortController();
    const { signal } = toastEvents;
    const countdown = progressBar.animate(
      [{ transform: 'scaleX(1)' }, { transform: 'scaleX(0)' }],
      { duration: 6000, fill: 'forwards' }
    );
    toastCountdown = countdown;
    countdown.onfinish = () => {
      if (toastCountdown === countdown) hideToast();
    };

    let hovered = window.matchMedia('(hover: hover)').matches && toast.matches(':hover');
    function syncCountdown() {
      if (toastCountdown !== countdown) return;
      if (hovered || toast?.contains(document.activeElement)) {
        countdown.pause();
      } else {
        countdown.play();
      }
    }

    toast.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch') return;
      hovered = true;
      syncCountdown();
    }, { signal });
    toast.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'touch') return;
      hovered = false;
      syncCountdown();
    }, { signal });
    toast.addEventListener('focusin', syncCountdown, { signal });
    toast.addEventListener('focusout', () => queueMicrotask(syncCountdown), { signal });
    syncCountdown();
  }

  function hideToast() {
    const countdown = toastCountdown;
    toastCountdown = undefined;
    countdown?.cancel();
    toastEvents?.abort();
    toastEvents = undefined;

    const toast = document.getElementById('toast-notify');
    if (!toast || toast.hidden) return;
    const restoreFocus = toast.contains(document.activeElement);
    toast.hidden = true;
    if (restoreFocus && toastTrigger?.isConnected) toastTrigger.focus({ preventScroll: true });
    toastTrigger = undefined;
  }

  // Initial load sync
  updateBagUI();
</script>
