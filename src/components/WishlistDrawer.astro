---
import productsData from '../data/products.json';
---

<div class="wishlist-drawer-backdrop" id="wishlist-backdrop" hidden></div>

<aside
  class="wishlist-drawer"
  id="wishlist-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wishlist-drawer-title"
  hidden
>
  <!-- Header -->
  <div class="wishlist-drawer-header">
    <div class="wishlist-drawer-title-group">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="wishlist-header-heart">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <h2 id="wishlist-drawer-title" class="wishlist-drawer-title">Saved Fragrances</h2>
      <span class="wishlist-drawer-badge" id="wishlist-items-badge">0 saved</span>
    </div>
    <button class="wishlist-close-btn" id="wishlist-close-btn" aria-label="Close wishlist">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Wishlist Items Container -->
  <div class="wishlist-drawer-body">
    <!-- Ultra-Clean Spacious Wishlist Empty State -->
    <div id="wishlist-empty-state" class="wishlist-empty-state">
      <div class="empty-wishlist-stage">
        <div class="empty-wishlist-halo" aria-hidden="true"></div>
        <img
          src="/assets/brand/lumera-wishlist-heart.webp"
          alt="Lumèra Luxe saved fragrances"
          class="empty-wishlist-img"
          width="210"
          height="192"
          loading="eager"
        />
        <div class="empty-wishlist-shadow" aria-hidden="true"></div>
      </div>

      <div class="empty-text-wrap">
        <h3 class="empty-title">Your wishlist is empty</h3>
        <p class="empty-subtitle">Explore our collection and tap the heart on any fragrance to curate your personal favorites.</p>
        <a href="/shop/" class="btn-wishlist-explore" id="wishlist-shop-link">
          <span>BROWSE COLLECTION</span>
        </a>
      </div>
    </div>

    <ul id="wishlist-items-list" class="wishlist-items-list"></ul>
  </div>

  <!-- Wishlist Drawer Footer -->
  <div class="wishlist-drawer-footer" id="wishlist-footer" hidden>
    <a href="/shop/" class="btn-wishlist-continue" id="btn-wishlist-continue">
      <span>EXPLORE MORE FRAGRANCES</span>
    </a>
  </div>
</aside>

<style>
  [hidden] {
    display: none !important;
  }

  .wishlist-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(24, 21, 19, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 105;
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wishlist-drawer-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .wishlist-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background-color: #FFFFFF;
    z-index: 110;
    display: flex;
    flex-direction: column;
    box-shadow: -15px 0 45px rgba(0, 0, 0, 0.08);
    border-left: 1px solid rgba(0, 0, 0, 0.05);
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wishlist-drawer.is-open {
    transform: translateX(0);
  }

  /* Header */
  .wishlist-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.75rem;
    border-bottom: 1px solid #F0ECE6;
    background-color: #FFFFFF;
  }

  .wishlist-drawer-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .wishlist-header-heart {
    color: var(--color-brand-cognac);
    fill: rgba(200, 90, 36, 0.15);
  }

  .wishlist-drawer-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #181513;
    margin: 0;
  }

  .wishlist-drawer-badge {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #76706B;
    background-color: #FAF8F5;
    border: 1px solid #E8E3DC;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .wishlist-close-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #181513;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .wishlist-close-btn:hover {
    background-color: #FAF8F5;
    border-color: #E8E3DC;
    transform: rotate(90deg);
  }

  .wishlist-close-btn:active {
    transform: scale(0.92);
  }

  /* Body */
  .wishlist-drawer-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    padding: 1.5rem 1.25rem;
    background-color: #FFFFFF;
    display: flex;
    flex-direction: column;
    -webkit-overflow-scrolling: touch;
  }

  /* Spacious Minimal Empty State */
  .wishlist-empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
    margin: auto 0;
  }

  .empty-wishlist-stage {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
  }

  .empty-wishlist-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(197, 160, 89, 0.14) 0%, rgba(250, 248, 245, 0.45) 45%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .empty-wishlist-img {
    position: relative;
    z-index: 1;
    width: 195px;
    height: auto;
    max-height: 195px;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(30, 25, 20, 0.08));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .empty-wishlist-stage:hover .empty-wishlist-img {
    transform: translateY(-4px) scale(1.02);
  }

  .empty-wishlist-shadow {
    width: 130px;
    height: 14px;
    background: radial-gradient(ellipse at center, rgba(30, 20, 10, 0.2) 0%, rgba(30, 20, 10, 0.05) 55%, transparent 75%);
    border-radius: 50%;
    filter: blur(3px);
    margin-top: -6px;
    z-index: 0;
  }

  .empty-text-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .empty-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: #181513;
    line-height: 1.3;
    margin-bottom: 0.65rem;
    letter-spacing: 0.01em;
  }

  .empty-subtitle {
    font-size: 0.85rem;
    color: #6D6760;
    line-height: 1.55;
    max-width: 290px;
    margin: 0 auto 1.85rem;
  }

  .btn-wishlist-explore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #181513;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.95rem 2.5rem;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(24, 21, 19, 0.12);
    border: 1px solid #181513;
  }

  .btn-wishlist-explore:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(24, 21, 19, 0.22);
  }

  /* Wishlist Item List */
  .wishlist-items-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  /* GLOBAL RULES FOR CLIENT-SIDE INJECTED ITEMS */
  :global(.wishlist-item-card) {
    display: grid !important;
    grid-template-columns: 70px 1fr !important;
    gap: 1rem !important;
    padding-bottom: 1.25rem !important;
    border-bottom: 1px solid #F0ECE6 !important;
    position: relative !important;
  }

  :global(.wishlist-thumb-box) {
    width: 70px !important;
    height: 88px !important;
    background-color: #FFFFFF !important;
    border: 1px solid #E8E3DC !important;
    border-radius: 2px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0.4rem !important;
    overflow: hidden !important;
  }

  :global(.wishlist-thumb-img) {
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
  }

  :global(.wishlist-item-content) {
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
  }

  :global(.wishlist-item-header) {
    display: flex !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
    gap: 0.5rem !important;
  }

  :global(.wishlist-item-title) {
    font-family: var(--font-display) !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    color: #181513 !important;
    text-decoration: none !important;
    line-height: 1.3 !important;
  }

  :global(.wishlist-item-remove-btn) {
    background: transparent !important;
    border: none !important;
    color: #8F8880 !important;
    font-size: 1rem !important;
    cursor: pointer !important;
    width: 36px !important;
    height: 36px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    touch-action: manipulation !important;
    -webkit-tap-highlight-color: transparent !important;
    border-radius: 50% !important;
    transition: all var(--transition-fast) !important;
  }

  :global(.wishlist-item-remove-btn:hover) {
    color: #181513 !important;
    background-color: #FAF8F5 !important;
  }

  :global(.wishlist-item-remove-btn:active) {
    transform: scale(0.90) !important;
  }

  :global(.wishlist-item-meta) {
    font-size: 0.72rem !important;
    color: #76706B !important;
    margin: 0.15rem 0 0.35rem !important;
  }

  :global(.wishlist-item-price) {
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    color: #181513 !important;
    margin-bottom: 0.5rem !important;
  }

  :global(.wishlist-item-actions) {
    display: flex !important;
    gap: 0.5rem !important;
  }

  :global(.btn-wishlist-buy) {
    background-color: #181513 !important;
    color: #FFFFFF !important;
    text-decoration: none !important;
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    padding: 0.55rem 0.95rem !important;
    border-radius: 2px !important;
    text-align: center !important;
    touch-action: manipulation !important;
    -webkit-tap-highlight-color: transparent !important;
    transition: all var(--transition-fast) !important;
  }

  :global(.btn-wishlist-buy:active) {
    transform: scale(0.95) !important;
  }

  :global(.btn-wishlist-add-bag) {
    background-color: #FAF8F5 !important;
    color: #181513 !important;
    border: 1px solid #E8E3DC !important;
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
    padding: 0.55rem 0.95rem !important;
    border-radius: 2px !important;
    text-align: center !important;
    touch-action: manipulation !important;
    -webkit-tap-highlight-color: transparent !important;
    transition: all var(--transition-fast) !important;
  }

  :global(.btn-wishlist-add-bag:active) {
    transform: scale(0.95) !important;
  }
    border-radius: 2px !important;
    cursor: pointer !important;
  }

  /* Drawer Footer */
  .wishlist-drawer-footer {
    border-top: 1px solid #F0ECE6;
    padding: 1.25rem 1.75rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    background-color: #FFFFFF;
    flex-shrink: 0;
  }

  .btn-wishlist-continue {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    background-color: #FAF8F5;
    color: #181513;
    border: 1px solid #E8E3DC;
    border-radius: 2px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-wishlist-continue:hover {
    border-color: #181513;
    background-color: #FFFFFF;
  }
</style>

<script>
  import productsData from '../data/products.json';
  import { getFavorites, removeFavorite, toggleFavorite } from '../lib/favorites';

  const drawer = document.getElementById('wishlist-drawer');
  const backdrop = document.getElementById('wishlist-backdrop');
  const closeBtn = document.getElementById('wishlist-close-btn');
  const badgeEl = document.getElementById('wishlist-items-badge');
  const emptyState = document.getElementById('wishlist-empty-state');
  const listEl = document.getElementById('wishlist-items-list');
  const footerEl = document.getElementById('wishlist-footer');

  function openWishlist() {
    if (!drawer || !backdrop) return;
    renderWishlist();
    drawer.hidden = false;
    backdrop.hidden = false;
    void drawer.offsetWidth;
    drawer.classList.add('is-open');
    backdrop.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeWishlist() {
    if (!drawer || !backdrop) return;
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    setTimeout(() => {
      drawer.hidden = true;
      backdrop.hidden = true;
      document.body.style.overflow = '';
    }, 320);
  }

  closeBtn?.addEventListener('click', closeWishlist);
  backdrop?.addEventListener('click', closeWishlist);
  document.getElementById('btn-wishlist-continue')?.addEventListener('click', closeWishlist);
  document.getElementById('wishlist-shop-link')?.addEventListener('click', closeWishlist);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
      closeWishlist();
    }
  });

  function renderWishlist() {
    const favIds = getFavorites();
    const items = favIds
      .map((id) => productsData.find((p) => p.id === id || p.slug === id))
      .filter((p): p is (typeof productsData)[0] => Boolean(p));

    const count = items.length;
    if (badgeEl) badgeEl.textContent = `${count} saved`;

    if (count === 0) {
      if (emptyState) emptyState.hidden = false;
      if (listEl) listEl.innerHTML = '';
      if (footerEl) footerEl.hidden = true;
      return;
    }

    if (emptyState) emptyState.hidden = true;
    if (footerEl) footerEl.hidden = false;

    if (listEl) {
      listEl.innerHTML = items
        .map(
          (prod) => `
        <li class="wishlist-item-card" data-id="${prod.id}">
          <div class="wishlist-thumb-box">
            <img
              src="${prod.image}"
              alt="${prod.name}"
              class="wishlist-thumb-img"
              width="70"
              height="88"
              loading="lazy"
              decoding="async"
              onerror="this.onerror=null;this.src='/assets/lumera-logo.svg';"
            />
          </div>
          <div class="wishlist-item-content">
            <div class="wishlist-item-header">
              <a href="/perfumes/${prod.slug}/" class="wishlist-item-title">${prod.name}</a>
              <button type="button" class="wishlist-item-remove-btn" data-action="remove-fav" data-id="${prod.id}" aria-label="Remove from wishlist">✕</button>
            </div>
            <span class="wishlist-item-meta">${prod.brand} · ${prod.sizeDisplay}</span>
            <span class="wishlist-item-price">${prod.priceDisplay}</span>
            <div class="wishlist-item-actions">
              <a href="/checkout/?product=${prod.slug}&qty=1" class="btn-wishlist-buy">BUY</a>
              <button
                type="button"
                class="btn-wishlist-add-bag"
                data-action="add-to-bag"
                data-id="${prod.id}"
                data-name="${prod.name}"
                data-brand="${prod.brand}"
                data-size="${prod.sizeDisplay}"
                data-price="${prod.priceMinor}"
                data-image="${prod.image}"
              >
                + BAG
              </button>
            </div>
          </div>
        </li>
      `
        )
        .join('');

      listEl.querySelectorAll('[data-action="remove-fav"]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const id = target.getAttribute('data-id');
          if (id) {
            removeFavorite(id);
          }
        });
      });
    }
  }

  window.addEventListener('favorites-updated', () => {
    if (drawer && !drawer.hidden) {
      renderWishlist();
    }
  });

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('#open-wishlist-btn, #drawer-open-wishlist-btn, [data-action="open-wishlist"]');
    if (trigger) {
      e.preventDefault();
      openWishlist();
    }
  });
</script>
