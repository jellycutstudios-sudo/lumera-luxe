    var path = window.location.pathname;
    var isDiscoveryPage = path.startsWith('/fragrance-finder') || path.startsWith('/scent-styling') || path.startsWith('/layering');
    if (discBtn && !isDiscoveryPage) discBtn.classList.remove('active');
    if (!document.getElementById('families-modal')?.classList.contains('is-open') &&
        !document.getElementById('support-modal')?.classList.contains('is-open')) {
      if (backdrop) backdrop.classList.remove('is-open');
      document.body.style.overflow = '';
