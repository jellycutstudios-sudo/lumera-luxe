---
import { siteConfig } from '../data/site';
import productsData from '../data/products.json';

const currentPath = Astro.url.pathname;
const isCheckout = currentPath.startsWith('/checkout');
const isPdp = currentPath.startsWith('/perfumes/');
const totalFragrances = productsData.filter((p) => !p.isDraft).length;
---

{
  !isCheckout && (
    <>
      <!-- Shared Bottom Modal Backdrop -->
      <div id="nav-modal-backdrop" class="nav-modal-backdrop" aria-hidden="true"></div>

      <!-- 1. SCENT FAMILIES BOTTOM MODAL -->
      <aside
        id="families-modal"
        class="nav-bottom-sheet"
        role="dialog"
        aria-modal="true"
        aria-label="Olfactive Scent Families"
      >
        <div class="sheet-handle-wrap">
          <div class="sheet-handle"></div>
        </div>

        <div class="sheet-header">
          <div class="sheet-title-group">
            <span class="sheet-kicker">Olfactive Classification</span>
            <h2 class="sheet-title">Scent Families</h2>
          </div>
          <button
            type="button"
            class="sheet-close-btn"
            id="families-modal-close-btn"
            aria-label="Close scent families modal"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="sheet-content">
          <div class="families-list">
            <!-- 1. Floral & Rose -->
            <a href="/shop/?family=floral" class="family-item-card" data-family="floral">
              <div class="family-item-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M12 2a3.5 3.5 0 0 0-3.5 3.5c0 2.5 3.5 5.5 3.5 5.5s3.5-3 3.5-5.5A3.5 3.5 0 0 0 12 2z"></path>
                  <path d="M12 22a3.5 3.5 0 0 0 3.5-3.5c0-2.5-3.5-5.5-3.5-5.5s-3.5 3-3.5 5.5A3.5 3.5 0 0 0 12 22z"></path>
                  <path d="M2 12a3.5 3.5 0 0 0 3.5 3.5c2.5 0 5.5-3.5 5.5-3.5S7.5 8.5 5.5 8.5A3.5 3.5 0 0 0 2 12z"></path>
                  <path d="M22 12a3.5 3.5 0 0 0-3.5-3.5c-2.5 0-5.5 3.5-5.5 3.5s3.5 3.5 5.5 3.5A3.5 3.5 0 0 0 22 12z"></path>
                </svg>
              </div>
              <div class="family-item-text">
                <div class="family-item-headline">
                  <span class="family-item-name">Floral & Rose</span>
                  <span class="family-item-badge">Romantic</span>
                </div>
                <p class="family-item-desc">Damask Rose · Sambac Jasmine · French Peony · Neroli</p>
              </div>
              <svg class="family-item-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- 2. Amber & Oriental -->
            <a href="/shop/?family=oriental" class="family-item-card" data-family="oriental">
              <div class="family-item-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                </svg>
              </div>
              <div class="family-item-text">
                <div class="family-item-headline">
                  <span class="family-item-name">Amber & Oriental</span>
                  <span class="family-item-badge">Opulent</span>
                </div>
                <p class="family-item-desc">Warm Amber · Madagascar Vanilla · Frankincense · Spices</p>
              </div>
              <svg class="family-item-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- 3. Woody & Earthy -->
            <a href="/shop/?family=woody" class="family-item-card" data-family="woody">
              <div class="family-item-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L4 16h5v6h6v-6h5L12 2z"></path>
                </svg>
              </div>
              <div class="family-item-text">
                <div class="family-item-headline">
                  <span class="family-item-name">Woody & Earthy</span>
                  <span class="family-item-badge">Noble</span>
                </div>
                <p class="family-item-desc">Atlas Cedarwood · Sandalwood · Smoky Vetiver · Patchouli</p>
              </div>
              <svg class="family-item-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- 4. Fresh & Citrus -->
            <a href="/shop/?family=fresh" class="family-item-card" data-family="fresh">
              <div class="family-item-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                  <line x1="12" y1="9" x2="12" y2="15"></line>
                  <line x1="9" y1="12" x2="15" y2="12"></line>
                </svg>
              </div>
              <div class="family-item-text">
                <div class="family-item-headline">
                  <span class="family-item-name">Fresh & Citrus</span>
                  <span class="family-item-badge">Crisp</span>
                </div>
                <p class="family-item-desc">Calabrian Bergamot · Sparkling Citrus · Aquatic Breeze</p>
              </div>
              <svg class="family-item-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </div>

          <div class="sheet-footer">
            <a href="/shop/" class="btn-sheet-primary">
              <span>View All Fragrances ({totalFragrances})</span>
            </a>
            <a href="/#scent-families" id="sheet-view-showcase" class="link-sheet-subtle">
              <span>View Editorial Showcase on Homepage</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </aside>

      <!-- 2. DISCOVERY & CONSULTATION BOTTOM MODAL -->
      <aside
        id="discovery-modal"
        class="nav-bottom-sheet"
        role="dialog"
        aria-modal="true"
        aria-label="Curated Fragrance Discovery"
      >
        <div class="sheet-handle-wrap">
          <div class="sheet-handle"></div>
        </div>

        <div class="sheet-header">
          <div class="sheet-title-group">
            <span class="sheet-kicker">Curated Experiences</span>
            <h2 class="sheet-title">Discovery Menu</h2>
          </div>
          <button
            type="button"
            class="sheet-close-btn"
            id="discovery-modal-close-btn"
            aria-label="Close discovery modal"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="sheet-content">
          <div class="discovery-list">
            <!-- 1. Fragrance Finder Quiz -->
            <a href="/fragrance-finder/" class="discovery-item-card" data-astro-prefetch>
              <div class="discovery-item-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <path d="M11 8v6M8 11h6"></path>
                </svg>
              </div>
              <div class="discovery-item-text">
                <div class="discovery-item-headline">
                  <span class="discovery-item-name">Fragrance Finder</span>
                  <span class="discovery-item-badge quiz-pill">Quiz</span>
                </div>
                <p class="discovery-item-desc">4-question bespoke consultation to pinpoint your signature flacon</p>
              </div>
              <svg class="discovery-item-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- 2. Scent & Style Alignment -->
            <a href="/scent-styling/" class="discovery-item-card" data-astro-prefetch>
              <div class="discovery-item-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <div class="discovery-item-text">
                <div class="discovery-item-headline">
                  <span class="discovery-item-name">Scent & Style Alignment</span>
                  <span class="discovery-item-badge">Jewelry</span>
                </div>
                <p class="discovery-item-desc">Curated perfumes paired with Yellow Gold, Silver & Rose Gold</p>
              </div>
              <svg class="discovery-item-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- 3. The Art of Layering -->
            <a href="/layering/" class="discovery-item-card" data-astro-prefetch>
              <div class="discovery-item-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
              </div>
              <div class="discovery-item-text">
                <div class="discovery-item-headline">
                  <span class="discovery-item-name">The Art of Layering</span>
                  <span class="discovery-item-badge">10 Duets</span>
                </div>
                <p class="discovery-item-desc">Master fragrance duets paired harmoniously with 1-click bundle discovery</p>
              </div>
              <svg class="discovery-item-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- Quick Wardrobe Filter Chips -->
            <div class="discovery-quick-filters">
              <span class="quick-filters-label">Curated Wardrobe Filters</span>
              <div class="quick-filters-pills">
                <a href="/shop/?style=gold" class="style-filter-pill">
                  <span class="filter-dot gold-dot"></span>
                  <span>Wear with Gold</span>
                </a>
                <a href="/shop/?style=silver" class="style-filter-pill">
                  <span class="filter-dot silver-dot"></span>
                  <span>Wear with Silver</span>
                </a>
                <a href="/shop/?style=rose-gold" class="style-filter-pill">
                  <span class="filter-dot rose-dot"></span>
                  <span>Wear with Rose Gold</span>
                </a>
                <a href="/shop/?style=majlis" class="style-filter-pill">
                  <span class="filter-dot majlis-dot"></span>
                  <span>Majlis & Evening</span>
                </a>
              </div>
            </div>
          </div>

          <div class="sheet-footer discovery-footer">
            <button type="button" class="btn-sheet-concierge" id="discovery-concierge-trigger">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Need Concierge Advice? Talk on WhatsApp</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- 3. BOUTIQUE SUPPORT MODAL (ORGANIZED WHATSAPP TEMPLATE) -->
      <aside
        id="support-modal"
        class="nav-bottom-sheet"
        role="dialog"
        aria-modal="true"
        aria-label="Boutique Support and Concierge"
      >
        <div class="sheet-handle-wrap">
          <div class="sheet-handle"></div>
        </div>

        <div class="sheet-header">
          <div class="sheet-title-group">
            <span class="sheet-kicker">Personal Concierge · Doha</span>
            <h2 class="sheet-title">Boutique Support</h2>
          </div>
          <button
            type="button"
            class="sheet-close-btn"
            id="support-modal-close-btn"
            aria-label="Close support modal"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="sheet-content">
          <p class="support-intro-text">
            Send us your inquiry and our fragrance specialist in Qatar will respond directly on WhatsApp within minutes.
          </p>

          <form id="support-inquiry-form" class="support-form">
            <!-- Topic Selector Chips -->
            <div class="form-field-group">
              <label class="form-field-label">How can we assist you?</label>
              <div class="support-topic-chips" id="support-topic-chips">
                <button type="button" class="topic-chip is-selected" data-topic="Fragrance Advice">Fragrance Advice</button>
                <button type="button" class="topic-chip" data-topic="Order & Delivery">Order & Delivery</button>
                <button type="button" class="topic-chip" data-topic="Perfume Stock">Perfume Stock</button>
                <button type="button" class="topic-chip" data-topic="Luxury Gifting">Luxury Gifting</button>
              </div>
            </div>

            <!-- Client Name -->
            <div class="form-field-group">
              <label for="support-name-input" class="form-field-label">Your Name</label>
              <input
                type="text"
                id="support-name-input"
                class="support-text-input"
                placeholder="e.g. Fatima Al-Kuwari"
                autocomplete="name"
              />
            </div>

            <!-- Client Phone (Optional) -->
            <div class="form-field-group">
              <label for="support-phone-input" class="form-field-label">
                WhatsApp Phone <span class="label-optional">(Optional)</span>
              </label>
              <input
                type="tel"
                id="support-phone-input"
                class="support-text-input"
                placeholder="+974 5555 1234"
                autocomplete="tel"
              />
            </div>

            <!-- Inquiry Details -->
            <div class="form-field-group">
              <label for="support-message-input" class="form-field-label">Your Message or Scent Preference</label>
              <textarea
                id="support-message-input"
                class="support-textarea"
                rows="3"
                placeholder="Describe the notes you love, the occasion, or any specific questions about our collection..."
              ></textarea>
            </div>

            <!-- Submit CTA Button -->
            <div class="support-form-actions">
              <button type="button" id="support-submit-btn" class="btn-support-whatsapp" onclick="window.sendSupportToWhatsApp()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
                  <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
                </svg>
                <span>Send to WhatsApp Concierge</span>
              </button>
              <span class="support-security-note">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Opens WhatsApp with your pre-formatted luxury template
              </span>
            </div>
          </form>
        </div>
      </aside>

      <!-- 4. MOBILE BOTTOM NAVIGATION BAR -->
      <nav class:list={['mobile-bottom-nav', { 'hide-on-pdp': isPdp }]} aria-label="Mobile Navigation">
        <div class="bottom-nav-container">
          <!-- Tab 1: Home -->
          <a
            href="/"
            class:list={['bottom-nav-item', { active: currentPath === '/' }]}
            aria-label="Home"
            id="bottom-nav-home-link"
            data-astro-prefetch
          >
            <div class="bottom-nav-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"></path>
                <polyline points="9 21 9 12 15 12 15 21"></polyline>
              </svg>
            </div>
            <span class="bottom-nav-label">Home</span>
            <span class="active-gold-dot nav-home-dot" style={currentPath === '/' ? '' : 'display: none;'}></span>
          </a>

          <!-- Tab 2: Fragrances Collection (Perfume Flacon Line Icon) -->
          <a
            href="/shop/"
            class:list={['bottom-nav-item', { active: currentPath.startsWith('/shop') }]}
            aria-label="Fragrances Collection"
            id="bottom-nav-collection-link"
            data-astro-prefetch
          >
            <div class="bottom-nav-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="2" width="6" height="4" rx="0.5"></rect>
                <line x1="8" y1="6" x2="16" y2="6"></line>
                <rect x="5" y="8" width="14" height="13" rx="2"></rect>
                <line x1="9" y1="13" x2="15" y2="13"></line>
              </svg>
            </div>
            <span class="bottom-nav-label">Collection</span>
            <span class="active-gold-dot nav-collection-dot" style={currentPath.startsWith('/shop') ? '' : 'display: none;'}></span>
          </a>

          <!-- Tab 3: Scent Families / Notes (Fragrance Droplet Icon) -->
          <button
            type="button"
            class="bottom-nav-item"
            aria-label="Explore Scent Families"
            id="bottom-nav-families-btn"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <div class="bottom-nav-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                <circle cx="12" cy="14" r="2.5"></circle>
              </svg>
            </div>
            <span class="bottom-nav-label">Families</span>
            <span class="active-gold-dot nav-families-dot" style="display: none;"></span>
          </button>

          <!-- Tab 4: Discovery Menu (Compass Line Icon & Discovery Sheet Modal) -->
          <button
            type="button"
            class:list={['bottom-nav-item', 'discovery-tab', { active: currentPath.startsWith('/fragrance-finder') || currentPath.startsWith('/scent-styling') || currentPath.startsWith('/layering') }]}
            id="bottom-nav-discovery-btn"
            aria-label="Curated Fragrance Discovery"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <div class="bottom-nav-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
            </div>
            <span class="bottom-nav-label">Discovery</span>
            <span class="active-gold-dot nav-discovery-dot" style={(currentPath.startsWith('/fragrance-finder') || currentPath.startsWith('/scent-styling') || currentPath.startsWith('/layering')) ? '' : 'display: none;'}></span>
          </button>
        </div>
      </nav>
    </>
  )
}

<style>
  .mobile-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid var(--color-gold-border);
    box-shadow: 0 -4px 20px rgba(24, 21, 19, 0.05);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms ease;
  }

  /* Hide on desktop */
  @media (min-width: 768px) {
    .mobile-bottom-nav,
    .nav-bottom-sheet,
    .nav-modal-backdrop {
      display: none !important;
    }
  }

  /* On PDP, let the focused product purchase bar take bottom stage */
  @media (max-width: 767px) {
    .mobile-bottom-nav.hide-on-pdp {
      display: none !important;
    }
  }

  .bottom-nav-container {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 58px;
    max-width: 500px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 100%;
    color: var(--color-text-muted);
    text-decoration: none;
    position: relative;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 200ms ease, transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0.35rem 0;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  /* Native App Tactile Press Feedback */
  .bottom-nav-item:active {
    transform: scale(0.88);
  }

  .bottom-nav-item.active {
    color: var(--color-brand-cognac);
  }

  .bottom-nav-item.active .bottom-nav-icon-wrap svg {
    transform: translateY(-2px) scale(1.08);
    stroke-width: 1.85;
  }

  .bottom-nav-item:hover {
    color: var(--color-text-main);
  }

  .bottom-nav-icon-wrap {
