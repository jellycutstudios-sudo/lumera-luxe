    var clientMsg = (msgInput && msgInput.value.trim()) || 'I would like personal assistance with fragrance selection and boutique availability.';

    var template =
      '⚜️ *LUMÈRA LUXE · CONCIERGE SUPPORT*\n' +
      '────────────────────────\n' +
      '📋 *Topic:* ' + currentSupportTopic + '\n' +
      (clientName ? '👤 *Customer:* ' + clientName + '\n' : '') +
      (clientPhone ? '📱 *Phone:* ' + clientPhone + '\n' : '') +
      '📍 *Location:* Doha, Qatar\n' +
      '────────────────────────\n' +
      '💬 *Inquiry:*\n' +
      clientMsg + '\n\n' +
      '────────────────────────\n' +
      'Hello LUMÈRA LUXE Concierge, looking forward to your assistance. Thank you!';

    var encoded = encodeURIComponent(template);
    var waUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encoded;

    window.closeSupportModal();
    window.open(waUrl, '_blank', 'noopener,noreferrer');
  };

  // Event delegation to catch clicks anywhere on the document
  document.addEventListener('click', function (e) {
    var target = e.target;
    if (!target) return;

    // 1. Families bottom nav button
    var famTrigger = target.closest('#bottom-nav-families-btn');
    if (famTrigger) {
      e.preventDefault();
      e.stopPropagation();
      window.toggleFamiliesModal(e);
      return;
    }

    // 2. Discovery bottom nav button
    var discTrigger = target.closest('#bottom-nav-discovery-btn');
    if (discTrigger) {
      e.preventDefault();
      e.stopPropagation();
      window.toggleDiscoveryModal(e);
      return;
    }

    // 3. Support button (concierge button in drawer or elsewhere)
    var supTrigger = target.closest('#bottom-nav-support-btn');
    if (supTrigger) {
      e.preventDefault();
      e.stopPropagation();
      window.toggleSupportModal(e);
      return;
    }

    // 4. Modal close buttons
    if (target.closest('#discovery-modal-close-btn')) {
      e.preventDefault();
      window.closeDiscoveryModal();
      return;
    }
    if (target.closest('#families-modal-close-btn')) {
      e.preventDefault();
      window.closeFamiliesModal();
      return;
    }
    if (target.closest('#support-modal-close-btn')) {
      e.preventDefault();
      window.closeSupportModal();
      return;
    }

    // 5. Trigger Concierge from Discovery Sheet
    if (target.closest('#discovery-concierge-trigger')) {
      e.preventDefault();
      window.closeDiscoveryModal();
      window.openSupportModal();
      return;
    }

    // 6. Modal backdrop click to dismiss
    if (target.id === 'nav-modal-backdrop') {
      e.preventDefault();
      window.closeAllNavModals();
      return;
    }

    // 7. Topic chip selection inside Support modal
    var topicChip = target.closest('.topic-chip');
    if (topicChip) {
      e.preventDefault();
      var chips = document.querySelectorAll('.topic-chip');
      chips.forEach(function (c) { c.classList.remove('is-selected'); });
      topicChip.classList.add('is-selected');
      currentSupportTopic = topicChip.getAttribute('data-topic') || 'Fragrance Advice';
      return;
    }

    // 8. Family card click inside Families modal
    var famCard = target.closest('.family-item-card');
    if (famCard) {
      var fam = famCard.getAttribute('data-family') || '';
      var isShop = window.location.pathname.startsWith('/shop');

      if (isShop && typeof window.setShopFamily === 'function') {
        e.preventDefault();
        window.setShopFamily(fam);
        window.closeFamiliesModal();
        return;
      }
      // Natural navigation to /shop/?family=...
      window.closeFamiliesModal();
      return;
    }

    // 9. Discovery link click inside Discovery modal
    var discCard = target.closest('.discovery-item-card') || target.closest('.style-filter-pill');
    if (discCard) {
      window.closeDiscoveryModal();
      return;
    }

    // Auto-close any nav bottom modal when clicking any navigation link inside
    if (target.closest('.nav-bottom-sheet a')) {
      window.closeAllNavModals();
      return;
    }

    // 10. Homepage showcase scroll link
    var showcaseLink = target.closest('#sheet-view-showcase');
    if (showcaseLink) {
      var isHome = window.location.pathname === '/' || window.location.pathname === '';
      if (isHome) {
        e.preventDefault();
        window.closeFamiliesModal();
        var scSec = document.getElementById('scent-families');
        if (scSec) {
          var y = scSec.getBoundingClientRect().top + window.pageYOffset - 64;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
        return;
      }
    }
  });

  // Support inquiry form submission
  var supForm = document.getElementById('support-inquiry-form');
  supForm?.addEventListener('submit', function (e) {
    e.preventDefault();
    if (typeof window.sendSupportToWhatsApp === 'function') {
      window.sendSupportToWhatsApp();
    }
  });

  // Escape key dismisses modals
  window.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      window.closeAllNavModals();
    }
  });

  // Smooth App View Transition Tab Synchronizer
  function syncBottomNavTab() {
    var path = window.location.pathname;
    var homeLink = document.getElementById('bottom-nav-home-link');
    var colLink = document.getElementById('bottom-nav-collection-link');
    var discBtn = document.getElementById('bottom-nav-discovery-btn');

    var homeDot = homeLink ? homeLink.querySelector('.active-gold-dot') : null;
    var colDot = colLink ? colLink.querySelector('.active-gold-dot') : null;
    var discDot = discBtn ? discBtn.querySelector('.active-gold-dot') : null;

    var isHome = path === '/' || path === '';
    var isCol = path.startsWith('/shop');
    var isDiscovery = path.startsWith('/fragrance-finder') || path.startsWith('/scent-styling') || path.startsWith('/layering');

    if (homeLink) homeLink.classList.toggle('active', isHome);
    if (homeDot) homeDot.style.display = isHome ? '' : 'none';

    if (colLink) colLink.classList.toggle('active', isCol);
    if (colDot) colDot.style.display = isCol ? '' : 'none';

    if (discBtn) discBtn.classList.toggle('active', isDiscovery);
    if (discDot) discDot.style.display = isDiscovery ? '' : 'none';

    // Check PDP and checkout states
    var navBar = document.querySelector('.mobile-bottom-nav');
    if (navBar) {
      var isCheckout = path.startsWith('/checkout');
      var isPdp = path.startsWith('/perfumes/');
      navBar.classList.toggle('hide-on-pdp', isPdp);
      navBar.style.display = isCheckout ? 'none' : '';
    }
  }

  // Initial sync
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncBottomNavTab);
  } else {
    syncBottomNavTab();
  }
  document.addEventListener('astro:page-load', function () {
    syncBottomNavTab();
    if (typeof window.closeAllNavModals === 'function') {
      window.closeAllNavModals();
    }
  });
  document.addEventListener('astro:before-preparation', function () {
    if (typeof window.closeAllNavModals === 'function') {
      window.closeAllNavModals();
    }
  });
</script>
